<Window x:Class="Lumisense.IslandPlayerWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Lumisense"
        Title="Lumisense"
        Width="540" Height="330"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextHintingMode="Animated"
        TextOptions.TextRenderingMode="Grayscale"
        WindowStartupLocation="Manual"
        UseLayoutRounding="False"
        SnapsToDevicePixels="False">

    <Window.Resources>
        <!-- Остров всегда чёрный, поэтому свой шаблон кнопок: стили WPF-UI зависят от темы окна. -->
        <Style x:Key="IslandIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.86" ScaleY="0.86" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="False">
                                <Setter Property="Opacity" Value="0.92" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Островок: форму (ширину, высоту, радиус) каждый кадр ведут пружины в IslandPlayerWindow.ApplyShape;
         виды внутри лежат в Host и обрезаются по той же форме. -->
    <Grid x:Name="Island" Width="460" Height="262" HorizontalAlignment="Center" VerticalAlignment="Top"
          RenderTransformOrigin="0.5,0"
          MouseEnter="Island_MouseEnter" MouseLeave="Island_MouseLeave"
          MouseLeftButtonDown="Island_MouseLeftButtonDown" MouseMove="Island_MouseMove"
          MouseDown="Island_MouseDown" MouseRightButtonUp="Island_MouseRightButtonUp" MouseWheel="Island_MouseWheel"
          MouseLeftButtonUp="Island_MouseLeftButtonUp" LostMouseCapture="Island_LostMouseCapture">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="IslandScale" />
                <TranslateTransform x:Name="IslandLean" />
                <TranslateTransform x:Name="IslandOffset" Y="6" />
            </TransformGroup>
        </Grid.RenderTransform>

        <!-- Тень из двух полупрозрачных контуров: размытие эффектом на каждом кадре растяжения давало микрофризы. -->
        <Path x:Name="ShadowFar" Fill="Black" Stroke="Black" StrokeThickness="34" StrokeLineJoin="Round" Opacity="0" IsHitTestVisible="False" />
        <Path x:Name="ShadowNear" Fill="Black" Stroke="Black" StrokeThickness="16" StrokeLineJoin="Round" Opacity="0" IsHitTestVisible="False" />

        <Grid x:Name="Host">
            <Path x:Name="Body" Fill="#FF000000" Stroke="#24FFFFFF" StrokeThickness="0.8" />

            <Grid x:Name="CompactView" Width="210" Height="34" HorizontalAlignment="Center" VerticalAlignment="Top">
                <TextBlock x:Name="CompactTitle" Foreground="White" FontSize="12.5" FontWeight="SemiBold"
                           Margin="36,0,41,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           IsHitTestVisible="False" />
                <StackPanel x:Name="EqualizerPanel" Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Height="16" Margin="0,0,13,0" IsHitTestVisible="False" />
            </Grid>

            <Grid x:Name="ToastView" Width="340" Height="68" HorizontalAlignment="Center" VerticalAlignment="Top" Opacity="0" Visibility="Collapsed">
                <StackPanel Margin="68,0,26,0" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock x:Name="ToastTitle" Foreground="White" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="ToastArtist" Foreground="#99FFFFFF" FontSize="12" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>

            <Grid x:Name="VolumeView" Width="250" Height="34" HorizontalAlignment="Center" VerticalAlignment="Top" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="162" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <local:SvgPathIcon x:Name="VolumeIcon" Icon="IconSpeaker2" Size="16" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                <!-- Полоска растягивается и сплющивается, когда громкость упёрлась в предел (ApplyShape). -->
                <Grid x:Name="VolumeTrack" Grid.Column="1" Height="5" VerticalAlignment="Center">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="VolumeStretch" />
                    </Grid.RenderTransform>
                    <Border CornerRadius="2.5" Background="#33FFFFFF" />
                    <Border x:Name="VolumeFill" CornerRadius="2.5" Background="White" HorizontalAlignment="Stretch"
                            RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="VolumeScale" ScaleX="0" />
                        </Border.RenderTransform>
                    </Border>
                </Grid>
                <local:RollingDigits x:Name="VolumeText" Grid.Column="2" FontSize="12.5" FontWeight="SemiBold" Foreground="White"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>

            <Grid x:Name="OpenView" Width="380" Height="176" HorizontalAlignment="Center" VerticalAlignment="Top" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
                <StackPanel Margin="98,20,52,0" Height="64" VerticalAlignment="Top" IsHitTestVisible="False">
                    <TextBlock x:Name="OpenTitle" Foreground="White" FontSize="16" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" Margin="0,11,0,0" />
                    <TextBlock x:Name="OpenArtist" Foreground="#99FFFFFF" FontSize="13" Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Grid Height="20" Margin="20,0,20,59" VerticalAlignment="Bottom">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ElapsedText" Foreground="#99FFFFFF" FontSize="11" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" Text="0:00" />
                    <!-- Прозрачный фон: мышь ловит вся высота 20 px, а не только тонкая полоса. -->
                    <Grid x:Name="SeekHost" Grid.Column="1" Background="Transparent" Cursor="Hand"
                          MouseLeftButtonDown="SeekHost_MouseLeftButtonDown" MouseMove="SeekHost_MouseMove"
                          MouseLeftButtonUp="SeekHost_MouseLeftButtonUp" SizeChanged="SeekHost_SizeChanged">
                        <Border x:Name="SeekTrack" Height="5" CornerRadius="2.5" Background="#33FFFFFF"
                                VerticalAlignment="Center" IsHitTestVisible="False" />
                        <Border x:Name="SeekFill" Height="5" CornerRadius="2.5" Background="White" Width="0"
                                HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>
                    <TextBlock x:Name="RemainingText" Grid.Column="2" Foreground="#99FFFFFF" FontSize="11" Typography.NumeralAlignment="Tabular"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Text="–0:00" />
                </Grid>

                <StackPanel x:Name="OpenVolume" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                            Margin="22,0,0,24" Opacity="0" IsHitTestVisible="False">
                    <local:SvgPathIcon x:Name="OpenVolumeIcon" Icon="IconSpeaker2" Size="13" Foreground="#99FFFFFF" VerticalAlignment="Center" />
                    <local:RollingDigits x:Name="OpenVolumeText" FontSize="11" Foreground="#99FFFFFF" Margin="5,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8">
                    <Button Style="{StaticResource IslandIconButtonStyle}" Click="PrevButton_Click">
                        <Grid>
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="PrevNudge" />
                            </Grid.RenderTransform>
                            <Path Data="M0,1 L10,10 L0,19 Z M10,1 L20,10 L10,19 Z" Fill="White" Stroke="White" StrokeThickness="2"
                                  StrokeLineJoin="Round" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <ScaleTransform ScaleX="-1" />
                                </Path.RenderTransform>
                            </Path>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource IslandIconButtonStyle}" Width="52" Height="52" Margin="16,0" Click="PlayPauseButton_Click">
                        <Grid>
                            <Path x:Name="PlayIcon" Data="M2,1 L16,10 L2,19 Z" Fill="White" Stroke="White" StrokeThickness="2.5"
                                  StrokeLineJoin="Round" Margin="4,0,0,0" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <ScaleTransform />
                                </Path.RenderTransform>
                            </Path>
                            <Path x:Name="PauseIcon" Data="M1,1 H6 V19 H1 Z M12,1 H17 V19 H12 Z" Fill="White" Stroke="White"
                                  StrokeThickness="2" StrokeLineJoin="Round" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <ScaleTransform />
                                </Path.RenderTransform>
                            </Path>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource IslandIconButtonStyle}" Click="NextButton_Click">
                        <Grid>
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="NextNudge" />
                            </Grid.RenderTransform>
                            <Path Data="M0,1 L10,10 L0,19 Z M10,1 L20,10 L10,19 Z" Fill="White" Stroke="White" StrokeThickness="2"
                                  StrokeLineJoin="Round" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>

            <Canvas IsHitTestVisible="False">
                <Grid x:Name="CoverHost" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="CoverScale" />
                    </Grid.RenderTransform>
                </Grid>
            </Canvas>
        </Grid>
    </Grid>
</Window>
