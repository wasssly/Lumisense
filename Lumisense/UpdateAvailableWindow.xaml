<ui:FluentWindow x:Class="AudioPlayer.UpdateAvailableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:AudioPlayer"
        Title="Lumisense"
        Icon="/Icons/app/lumisense.ico"
        Height="360" Width="600"
        MinHeight="360" MinWidth="560"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <!-- Диалог "доступно обновление" — показывается и автоматически при старте (если давно не
         отклоняли эту же версию, см. AppSettings.SkippedUpdateVersion), и по кнопке "Проверить
         обновления" на странице "Обновления" в настройках, и по кнопке "Установить" в списке
         "Все версии" там же. Два способа установки (см. InstallMethodPanel и
         InstallButton_Click в коде):
         — ZIP: скачивается и распаковывается, дальше всё делает Updater — отдельное маленькое
           приложение, которое дожидается закрытия плеера, копирует новые файлы поверх старой
           установки и запускает обновлённый Lumisense.exe (см. подробный комментарий в
           UpdateChecker и в Updater/Program.cs). Быстрее и без отдельного мастера установки.
         — .exe: обычный установщик (Inno Setup) — тот же, что и для самой первой установки "с
           нуля", просто закачанный и запущенный поверх уже стоящей версии. -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Lumisense" ShowMaximize="False" ShowMinimize="False" />

        <Grid Grid.Row="1" Margin="20,4,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10"
                        Background="{DynamicResource ControlStrongFillColorDefaultBrush}"
                        Margin="0,0,12,0">
                    <local:SvgPathIcon Icon="IconInfo" Size="18"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Доступно обновление" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionsText" Text="Версия 1.1.0 (у вас 1.0.0)"
                               FontSize="12" Opacity="0.6" />
                </StackPanel>
            </Grid>

            <TextBlock Grid.Row="1" Text="Что нового:" FontSize="12" FontWeight="SemiBold"
                       Opacity="0.8" Margin="0,12,0,6"
                       Visibility="{Binding ElementName=NotesText, Path=Visibility}" />

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="NotesText" TextWrapping="Wrap" FontSize="13" Opacity="0.85"
                           Text="" />
            </ScrollViewer>

            <!-- Выбор способа установки — показывается, только если у релиза есть ОБА варианта
                 (см. RefreshInstallMethodUi в коде): ZIP через встроенный автообновлятор
                 (Updater.exe, без отдельного мастера установки) или обычный .exe-установщик
                 (Inno Setup, с собственным мастером). Если доступен только один — выбирать
                 не из чего, этот блок скрыт целиком. -->
            <StackPanel x:Name="InstallMethodPanel" Grid.Row="3" Orientation="Horizontal"
                        Margin="0,10,0,0" Visibility="Collapsed">
                <TextBlock Text="Установить через:" FontSize="12" Opacity="0.7"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <RadioButton x:Name="InstallMethodZipRadio" Content="ZIP (быстрее)" GroupName="InstallMethod"
                             IsChecked="True" Margin="0,0,12,0" VerticalAlignment="Center" />
                <RadioButton x:Name="InstallMethodExeRadio" Content="Установщик (.exe)" GroupName="InstallMethod"
                             VerticalAlignment="Center" />
            </StackPanel>

            <!-- Раньше DownloadProgressBar/PhaseText/StatusText делили одну и ту же строку Grid
                 (Grid.Row="4") без какого-либо разделения — при обычной, короткой фазе
                 "Подготовка…" это почти не было заметно, но с подробным текстом хода
                 скачивания (см. UpdateDownloadProgressUi в коде), который теперь виден все
                 скачивание целиком, а не долю секунды, текст и полоса прогресса всё это время
                 отрисовывались друг поверх друга. Теперь у каждого своя строка. -->
            <ProgressBar x:Name="DownloadProgressBar" Grid.Row="4" Height="4" Margin="0,10,0,0"
                         Minimum="0" Maximum="1" Visibility="Collapsed" />

            <TextBlock x:Name="PhaseText" Grid.Row="5" Margin="0,6,0,0" FontSize="12" Opacity="0.6"
                       Visibility="Collapsed" />

            <TextBlock x:Name="StatusText" Grid.Row="6" Margin="0,10,0,0" FontSize="12"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       TextWrapping="Wrap" Visibility="Collapsed" />

            <!-- Все три кнопки одной ширины (см. запрос пользователя) — через равные Grid-колонки,
                 а не фиксированный Width на каждой: подгоняется под фактическую ширину окна,
                 вместо того чтобы держать наугад подобранное число пикселей, которое могло бы
                 обрезать самый длинный текст ("Скачать и установить") при других настройках
                 масштабирования Windows. -->
            <Grid Grid.Row="7" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ui:Button x:Name="LaterButton" Grid.Column="0" Content="Позже" Appearance="Secondary"
                           HorizontalAlignment="Stretch" Margin="0,0,8,0" Click="LaterButton_Click" />
                <ui:Button x:Name="MoreButton" Grid.Column="1" Content="Подробнее" Appearance="Secondary"
                           HorizontalAlignment="Stretch" Margin="0,0,8,0" Click="MoreButton_Click" />
                <ui:Button x:Name="InstallButton" Grid.Column="2" Content="Скачать и установить" Appearance="Primary"
                           HorizontalAlignment="Stretch" Click="InstallButton_Click" />
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
