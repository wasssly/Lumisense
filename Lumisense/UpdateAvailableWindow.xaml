<ui:FluentWindow x:Class="Lumisense.UpdateAvailableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:Lumisense"
        Title="Lumisense"
        Icon="/Icons/app/lumisense.ico"
        Height="560" Width="600"
        MinHeight="470" MinWidth="560"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <!-- Диалог «доступно обновление» обслуживает два безопасных пути: legacy Inno Setup
         скачивает проверенный EXE/MSI, а Velopack-managed установка применяет full/delta
         packages и показывает расчётный план до начала загрузки. -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Lumisense" ShowMaximize="False" ShowMinimize="False" />

        <Grid Grid.Row="1" Margin="20,4,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10"
                        Background="{DynamicResource ControlStrongFillColorDefaultBrush}"
                        Margin="0,0,12,0">
                    <local:SvgPathIcon Icon="IconInfo" Size="18"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="DialogTitleText" Text="Доступно обновление" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionsText" Text="Версия 1.1.0 (у вас 1.0.0)"
                               FontSize="12" Opacity="0.6" />
                </StackPanel>
            </Grid>

            <TextBlock x:Name="NotesHeaderText" Grid.Row="1" Text="Что нового:" FontSize="12" FontWeight="SemiBold"
                       Opacity="0.8" Margin="0,12,0,6"
                       Visibility="{Binding ElementName=NotesText, Path=Visibility}" />

            <ScrollViewer x:Name="NotesScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Margin="0,0,4,0">
                <TextBlock x:Name="NotesText" TextWrapping="Wrap" FontSize="13" LineHeight="18"
                           Opacity="0.85" Text="" />
            </ScrollViewer>

            <Border x:Name="MsiMigrationPanel" Grid.Row="3" Margin="0,12,0,0" Padding="12,10"
                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                    CornerRadius="8" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="MsiMigrationHintText" TextWrapping="Wrap" FontSize="12" Opacity="0.78" />
                    <ui:Button x:Name="MigrateToMsiButton" Appearance="Secondary" Margin="0,10,0,0"
                               HorizontalAlignment="Stretch" Click="MigrateToMsiButton_Click" />
                </StackPanel>
            </Border>

            <!-- Диагностика нужна для разбора обновлений, но не должна занимать место в
                 обычном сценарии. FluentExpander свёрнут по умолчанию, а его заголовок
                 остаётся явной кликабельной точкой входа к плану пакетов и журналам. -->
            <Expander x:Name="VelopackDiagnosticsPanel" Grid.Row="4"
                      Style="{StaticResource FluentExpanderStyle}" HorizontalAlignment="Stretch"
                      Margin="0,12,0,0" Visibility="Collapsed" IsExpanded="False">
                <Expander.Header>
                    <TextBlock x:Name="VelopackDiagnosticsTitleText"
                               FontSize="14" FontWeight="SemiBold" Margin="0" />
                </Expander.Header>
                <StackPanel>
                    <TextBlock x:Name="VelopackDeliveryText" FontSize="12" TextWrapping="Wrap" Opacity="0.82" />
                    <TextBlock x:Name="VelopackPlanText" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap" Opacity="0.82" />
                    <TextBlock x:Name="VelopackRuntimeStateText" Margin="0,8,0,0" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="VelopackRuntimeProgressText" Margin="0,3,0,0" FontSize="12" TextWrapping="Wrap" Opacity="0.82" />
                    <TextBlock x:Name="VelopackFallbackText" Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap" Opacity="0.66" />
                    <TextBlock x:Name="VelopackTelemetryLimitText" Margin="0,5,0,0" FontSize="11" TextWrapping="Wrap" Opacity="0.66" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <ui:Button x:Name="CopyVelopackDiagnosticsButton" Appearance="Secondary" Margin="0,0,8,0"
                                   Click="CopyVelopackDiagnosticsButton_Click" />
                        <ui:Button x:Name="OpenVelopackLogsButton" Appearance="Secondary"
                                   Click="OpenVelopackLogsButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Expander>

            <ProgressBar x:Name="DownloadProgressBar" Grid.Row="5" Height="4" Margin="0,10,0,0"
                         Minimum="0" Maximum="1" Visibility="Collapsed" />

            <TextBlock x:Name="PhaseText" Grid.Row="6" Margin="0,6,0,0" FontSize="12" Opacity="0.6"
                       Visibility="Collapsed" />

            <TextBlock x:Name="StatusText" Grid.Row="7" Margin="0,10,0,0" FontSize="12"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       TextWrapping="Wrap" Visibility="Collapsed" />

            <!-- Смена mirror всегда перезапускает EXE/MSI с нуля: partial-файл от прошлого
                 URL не используется. Кнопка отдельной строкой, чтобы две главные кнопки
                 Pause/Cancel оставались широкими и не теснились. -->
            <ui:Button x:Name="ChangeDownloadSourceButton" Grid.Row="7" Margin="0,10,0,0"
                       Appearance="Secondary" HorizontalAlignment="Left" Visibility="Collapsed"
                       Click="ChangeDownloadSourceButton_Click" />

            <!-- Основной EXE-путь сохранён без изменений; отдельная длинная MSI-кнопка выше
                 показывается только для legacy-копии с опубликованным проверенным MSI.
                 При загрузке InstallButton скрывается, а CancelDownloadButton занимает его
                 место: отмена видна явно и не требует повторного клика по другой кнопке. -->
            <Grid Grid.Row="8" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ui:Button x:Name="LaterButton" Grid.Column="0" Grid.ColumnSpan="2" Content="Позже" Appearance="Secondary"
                           HorizontalAlignment="Stretch" Margin="0,0,8,0" Click="LaterButton_Click" />
                <ui:Button x:Name="MoreButton" Grid.Column="2" Grid.ColumnSpan="2" Content="Подробнее" Appearance="Secondary"
                           HorizontalAlignment="Stretch" Click="MoreButton_Click" />
                <ui:Button x:Name="InstallButton" Grid.Column="2" Grid.ColumnSpan="2"
                           Content="Скачать и установить" Appearance="Primary"
                           HorizontalAlignment="Stretch" Click="InstallButton_Click" />
                <ui:Button x:Name="PauseDownloadButton" Grid.Column="0" Grid.ColumnSpan="2"
                           Content="Приостановить" Appearance="Secondary" HorizontalAlignment="Stretch"
                           Margin="0,0,8,0" Visibility="Collapsed" Click="PauseDownloadButton_Click" />
                <ui:Button x:Name="CancelDownloadButton" Grid.Column="2" Grid.ColumnSpan="2"
                           Content="Отменить загрузку" Appearance="Secondary" HorizontalAlignment="Stretch"
                           Visibility="Collapsed" Click="CancelDownloadButton_Click" />
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
