<ui:FluentWindow x:Class="AudioPlayer.FullScreenPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:AudioPlayer"
        Title="Lumisense — полноэкранный режим"
        Icon="/Icons/app/lumisense.ico"
        WindowState="Maximized"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="Manual"
        PreviewKeyDown="FullScreenPlayerWindow_PreviewKeyDown">

    <!-- Отдельное окно на весь экран с боковой панелью — не путать с "полноэкранным режимом"
         MainWindow (ApplyFullscreenLayout), который просто укрупняет содержимое ЭТОГО ЖЕ окна
         при разворачивании. Открывается через MainWindow.EnterFullScreenMode (F11 или пункт
         меню), скрывает MainWindow на время своей работы и полностью синхронизируется с ней
         через её публичные события/методы (TrackInfoChanged, ProgressChanged, External* и
         т.д. — тот же набор, которым уже пользуется MiniPlayerWindow, см. её код-behind как
         образец для этого же приёма). -->

    <Window.Resources>
        <local:FileNameConverter x:Key="FileNameConverter" />
        <local:IsFavoriteMultiConverter x:Key="IsFavoriteMultiConverter" />
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />

        <!-- Тот же NavItemStyle, что и в SettingsWindow.xaml — сюда не вынесен в общий файл
             ресурсов специально, чтобы не создавать связность между двумя независимыми окнами
             ради полутора десятков строк стиля; при правке в одном месте стоит помнить про
             второе. -->
        <Style x:Key="NavItemStyle" TargetType="RadioButton">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" CornerRadius="8" Padding="{TemplateBinding Padding}"
                                Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Строка трека в "Библиотеке" — название файла + сердечко избранного. Двойной клик
             запускает трек (LibraryTrack_MouseLeftButtonDown), одиночный клик по сердечку
             переключает избранное без запуска (LibraryFavoriteButton_Click, Handled в
             code-behind не выставляется намеренно: MultiBinding сам перевычислится по Epoch,
             а второй клик "сквозь" по всей строке проигрыванию не мешает — плеер и так уже
             играет тот же трек, если по нему кликнули). -->
        <DataTemplate x:Key="LibraryTrackRowTemplate">
            <Border Padding="10,8" CornerRadius="6" Background="Transparent" Cursor="Hand"
                    MouseLeftButtonDown="LibraryTrack_MouseLeftButtonDown" Tag="{Binding}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Text="{Binding Converter={StaticResource FileNameConverter}}" />

                    <ui:Button Grid.Column="1" x:Name="FavoriteButton" Appearance="Transparent"
                               Width="30" Height="30" Padding="0" Tag="{Binding}"
                               Click="LibraryFavoriteButton_Click">
                        <ui:Button.Icon>
                            <local:SvgPathIcon x:Name="FavoriteIcon" Icon="IconHeart" Size="14"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Opacity="0.55" />
                        </ui:Button.Icon>
                    </ui:Button>
                </Grid>
            </Border>

            <!-- MultiBinding, а не обычный Binding по одному только пути — путь у трека
                 никогда не меняется, обычный Binding никогда бы не перевызвался заново при
                 смене избранного (тот же приём, что и в MainWindow.xaml, TrackFavoriteIcon). -->
            <DataTemplate.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource IsFavoriteMultiConverter}">
                            <Binding Path="." />
                            <Binding Source="{x:Static local:FavoritesChangeNotifier.Instance}" Path="Epoch" />
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter TargetName="FavoriteIcon" Property="Icon" Value="IconHeartFilled" />
                    <Setter TargetName="FavoriteIcon" Property="Foreground" Value="#E53935" />
                    <Setter TargetName="FavoriteIcon" Property="Opacity" Value="1" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Lumisense" ShowMaximize="True" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Боковая панель -->
            <Border Grid.Column="0" Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderThickness="0,0,1,0" BorderBrush="{DynamicResource ControlStrongFillColorDefaultBrush}"
                    Padding="14,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="6,0,0,28">
                        <Image Source="/Icons/app/lumisense.png" Width="22" Height="22" />
                        <TextBlock Text="Lumisense" FontSize="16" FontWeight="SemiBold"
                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <RadioButton x:Name="NavNowPlaying" Style="{StaticResource NavItemStyle}"
                                     GroupName="FullScreenNav" IsChecked="True" Tag="NowPlaying"
                                     Checked="NavItem_Checked">
                            <StackPanel Orientation="Horizontal">
                                <local:SvgPathIcon Icon="IconSpeaker2" Size="18" VerticalAlignment="Center" />
                                <TextBlock Text="Сейчас играет" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavLibrary" Style="{StaticResource NavItemStyle}"
                                     GroupName="FullScreenNav" Tag="Library"
                                     Checked="NavItem_Checked">
                            <StackPanel Orientation="Horizontal">
                                <local:SvgPathIcon Icon="IconLibrary" Size="18" VerticalAlignment="Center" />
                                <TextBlock Text="Библиотека" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <ui:Button Grid.Row="2" Appearance="Secondary" HorizontalAlignment="Stretch"
                               Click="ExitFullScreenButton_Click" ToolTip="Escape">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <local:SvgPathIcon Icon="IconMinimizeWindow" Size="14" VerticalAlignment="Center" />
                            <TextBlock Text="Выйти из полноэкранного режима" Margin="8,0,0,0"
                                       TextWrapping="Wrap" TextAlignment="Center" />
                        </StackPanel>
                    </ui:Button>
                </Grid>
            </Border>

            <!-- Контент + закреплённая внизу панель управления -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <!-- Сейчас играет — большая обложка по центру, без органов управления
                         (они всегда доступны в закреплённой нижней панели, общей для обеих
                         страниц — дублировать их здесь незачем). -->
                    <Grid x:Name="PageNowPlaying" Visibility="Visible">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
                            <Border x:Name="NowPlayingArtBorder" Width="340" Height="340" CornerRadius="20"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    HorizontalAlignment="Center">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.28" Color="Black" />
                                </Border.Effect>
                                <local:SvgPathIcon x:Name="NowPlayingArtIcon" Icon="IconMusicNote" Size="80"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Border>

                            <TextBlock x:Name="NowPlayingTitleText" Text="Файл не выбран"
                                       FontSize="26" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                       HorizontalAlignment="Center" TextAlignment="Center" Margin="0,26,0,6" />
                            <TextBlock x:Name="NowPlayingArtistText" Text="—"
                                       FontSize="15" Opacity="0.65" TextTrimming="CharacterEllipsis"
                                       HorizontalAlignment="Center" TextAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- Библиотека — все папки плейлиста и их треки, сгруппированные так же,
                         как в обычном плейлисте главного окна. Живая привязка прямо к
                         MainWindow.PlaylistFolders (ObservableCollection) — добавление/удаление
                         папки или трека в обычном плейлисте отражается тут само, без
                         дополнительной синхронизации. -->
                    <Grid x:Name="PageLibrary" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="40,28,40,28">
                                <TextBlock Text="Библиотека" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock Text="Все папки, добавленные в плейлист — дважды щёлкните по треку, чтобы включить его."
                                           Opacity="0.6" FontSize="13" Margin="0,0,0,22" />

                                <ItemsControl x:Name="LibraryFoldersList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,26">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                <TextBlock Text="{Binding SubtitleText}" Opacity="0.55" FontSize="12" Margin="0,0,0,8" />
                                                <ItemsControl ItemsSource="{Binding Tracks}"
                                                              ItemTemplate="{StaticResource LibraryTrackRowTemplate}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Плейлист пуст — добавьте папки с музыкой в обычном окне плеера."
                                           Opacity="0.5" FontSize="13" Margin="0,20,0,0"
                                           Visibility="{Binding ElementName=LibraryFoldersList, Path=HasItems,
                                                        Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- Закреплённая панель управления — видна на обеих страницах одинаково -->
                <Border Grid.Row="1" Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrongFillColorDefaultBrush}"
                        Padding="24,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>

                        <!-- Мини-обложка + название/исполнитель -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="BarArtBorder" Width="46" Height="46" CornerRadius="8"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                <local:SvgPathIcon x:Name="BarArtIcon" Icon="IconMusicNote" Size="20"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="BarTitleText" Text="Файл не выбран" FontSize="13"
                                           TextTrimming="CharacterEllipsis" MaxWidth="180" />
                                <TextBlock x:Name="BarArtistText" Text="—" FontSize="11" Opacity="0.6"
                                           TextTrimming="CharacterEllipsis" MaxWidth="180" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Транспорт + прогресс -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                                <ui:Button x:Name="BarShuffleButton" Appearance="Secondary" Width="34" Height="34"
                                           Padding="0" Margin="0,0,6,0" Click="ShuffleButton_Click" ToolTip="Перемешать" />
                                <ui:Button x:Name="BarPrevButton" Appearance="Secondary" Width="34" Height="34"
                                           Padding="0" Margin="0,0,6,0" Click="PrevButton_Click" ToolTip="Предыдущий">
                                    <ui:Button.Icon>
                                        <local:SvgPathIcon Icon="IconPrevious" Size="15" />
                                    </ui:Button.Icon>
                                </ui:Button>
                                <ui:Button x:Name="BarPlayPauseButton" Appearance="Secondary" Width="42" Height="42"
                                           Padding="0" Margin="0,0,6,0" Click="PlayPauseButton_Click" ToolTip="Пуск/пауза" />
                                <ui:Button x:Name="BarNextButton" Appearance="Secondary" Width="34" Height="34"
                                           Padding="0" Margin="0,0,6,0" Click="NextButton_Click" ToolTip="Следующий">
                                    <ui:Button.Icon>
                                        <local:SvgPathIcon Icon="IconNext" Size="15" />
                                    </ui:Button.Icon>
                                </ui:Button>
                                <ui:Button x:Name="BarRepeatButton" Appearance="Secondary" Width="34" Height="34"
                                           Padding="0" Click="RepeatButton_Click" ToolTip="Повтор" />
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="BarCurrentTimeText" Grid.Column="0" Text="00:00" FontSize="11"
                                           Opacity="0.6" VerticalAlignment="Center" Margin="0,0,10,0" />

                                <!-- Тот же приём "заливка Border-ом вместо Slider", что и в
                                     MiniPlayerWindow (ProgressBackground/ProgressFill,
                                     ProgressBar_MouseLeftButtonDown/MouseMove/Up) — см. код-behind. -->
                                <Grid Grid.Column="1" VerticalAlignment="Center" Height="20">
                                    <Border x:Name="BarProgressTrack" Height="4" CornerRadius="2"
                                            Background="{DynamicResource ControlStrongFillColorDefaultBrush}"
                                            VerticalAlignment="Center" />
                                    <Border x:Name="BarProgressFill" Height="4" CornerRadius="2" Width="0"
                                            Background="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                            HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
                                    <Border Background="Transparent"
                                            MouseLeftButtonDown="BarProgress_MouseLeftButtonDown"
                                            MouseMove="BarProgress_MouseMove"
                                            MouseLeftButtonUp="BarProgress_MouseLeftButtonUp" />
                                </Grid>

                                <TextBlock x:Name="BarTotalTimeText" Grid.Column="2" Text="00:00" FontSize="11"
                                           Opacity="0.6" VerticalAlignment="Center" Margin="10,0,0,0" />
                            </Grid>
                        </StackPanel>

                        <!-- Громкость -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                    HorizontalAlignment="Right">
                            <ui:Button x:Name="BarMuteButton" Appearance="Secondary" Width="30" Height="30"
                                       Padding="0" Margin="0,0,8,0" Click="MuteButton_Click" ToolTip="Без звука" />
                            <Grid Width="100" Height="20" VerticalAlignment="Center">
                                <Border x:Name="BarVolumeTrack" Height="4" CornerRadius="2"
                                        Background="{DynamicResource ControlStrongFillColorDefaultBrush}"
                                        VerticalAlignment="Center" />
                                <Border x:Name="BarVolumeFill" Height="4" CornerRadius="2" Width="0"
                                        Background="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                        HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
                                <Border Background="Transparent"
                                        MouseLeftButtonDown="BarVolume_MouseLeftButtonDown"
                                        MouseMove="BarVolume_MouseMove"
                                        MouseLeftButtonUp="BarVolume_MouseLeftButtonUp" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
