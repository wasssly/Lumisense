<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Icons\app\lumisense.ico</ApplicationIcon>
    <RootNamespace>Lumisense</RootNamespace>
    <AssemblyName>Lumisense</AssemblyName>
    <!-- Velopack должен обработать hooks до WPF App; generated App.Main не используется. -->
    <StartupObject>Lumisense.Program</StartupObject>
    <!-- Базовая версия локальной сборки; release workflow передаёт -p:Version из vX.Y.Z тега. -->
    <Version>1.21.0</Version>
    <InformationalVersion>$(Version)</InformationalVersion>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>false</PublishReadyToRun>

  </PropertyGroup>

  <!-- Локальный Velopack feed компилируется только в ручных тестовых сборках. Обычные
       и tag-релизы не содержат этот код даже при наличии переменной среды. -->
  <PropertyGroup Condition="'$(VelopackLocalFeedTest)' == 'true'">
    <DefineConstants>$(DefineConstants);VELOPACK_LOCAL_FEED_TEST</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="WPF-UI.Tray" Version="4.3.0" />
    <!-- NAudio 3 требует net9. Локальный SoundTouchSampleProvider использует public API
         SoundTouch.Net напрямую, потому что SoundTouch.Net.NAudioSupport.Core собран для ABI NAudio 2.x. -->
    <PackageReference Include="NAudio" Version="3.1.0" />
    <PackageReference Include="SoundTouch.Net" Version="2.3.2" />
    <PackageReference Include="z440.atl.core" Version="7.16" />
    <PackageReference Include="SharpVectors.Wpf" Version="1.8.6" />
    <!-- Локальный Discord IPC / Rich Presence; фиксированная версия делает восстановление сборки воспроизводимым. -->
    <PackageReference Include="DiscordRichPresence" Version="1.6.1.70" />
    <!-- Прототип delta-обновлений; CLI vpk в workflow закреплён на ту же версию. -->
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Icons\svg\**\*.svg" />
    <Resource Include="Icons\app\lumisense.ico" />
    <Resource Include="Icons\app\lumisense.png" />
    <Resource Include="Icons\app\lumisense-aurora.ico" />
    <Resource Include="Icons\app\lumisense-aurora.png" />
    <Resource Include="Icons\app\lumisense-lavender.ico" />
    <Resource Include="Icons\app\lumisense-lavender.png" />
    <Resource Include="Icons\app\lumisense-settings.ico" />
    <Resource Include="Icons\app\lumisense-settings.png" />
    <Resource Include="Icons\app\developer-avatar-placeholder.png" />
  </ItemGroup>

  <!-- Необязательно: собственный MP3-кодировщик (см. LameMp3Encoder.cs), не зависящий от того,
       установлен ли в Windows системный кодировщик Media Foundation. Файла здесь нет по
       умолчанию — Condition просто пропускает этот ItemGroup, если его никто не положил, без
       ошибки сборки. Чтобы включить: положить 64-битную libmp3lame.dll в lib\libmp3lame.dll
       (например, через `vcpkg install lame:x64-windows`, оттуда скопировать
       installed\x64-windows\bin\libmp3lame.dll). Без неё экспорт MP3 просто продолжит
       использовать Media Foundation, как раньше. -->
  <ItemGroup Condition="Exists('lib\libmp3lame.dll')">
    <None Include="lib\libmp3lame.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- changelog.json встроен В САМУ сборку (EmbeddedResource), а не лежит рядом с .exe как
         обычный файл — раньше он копировался в папку установки как есть (CopyToOutputDirectory),
         и любой желающий мог открыть его в блокноте и подправить историю изменений или номер
         версии. Embedded resource запекается прямо в exe при сборке (см. ChangelogLoader.Load) —
         в установленной программе отдельного Changelog/changelog.json на диске больше нет. -->
    <EmbeddedResource Include="Changelog\changelog.json" />
  </ItemGroup>

</Project>