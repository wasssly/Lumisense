<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Icons\app\lumisense.ico</ApplicationIcon>
    <RootNamespace>AudioPlayer</RootNamespace>
    <AssemblyName>Lumisense</AssemblyName>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>false</PublishReadyToRun>

  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="3.0.5" />
    <PackageReference Include="NAudio" Version="1.9.0" />
    <PackageReference Include="SoundTouch.Net.NAudioSupport" Version="2.3.2" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
    <PackageReference Include="SharpVectors.Wpf" Version="1.8.5" />
    <!-- Локальный Discord IPC / Rich Presence; фиксированная версия делает восстановление сборки воспроизводимым. -->
    <PackageReference Include="DiscordRichPresence" Version="1.6.1.70" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Icons\svg\**\*.svg" />
    <Resource Include="Icons\app\lumisense.ico" />
    <Resource Include="Icons\app\lumisense.png" />
    <Resource Include="Icons\app\lumisense-settings.ico" />
    <Resource Include="Icons\app\lumisense-settings.png" />
    <Resource Include="Icons\app\developer-avatar-placeholder.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- changelog.json встроен В САМУ сборку (EmbeddedResource), а не лежит рядом с .exe как
         обычный файл — раньше он копировался в папку установки как есть (CopyToOutputDirectory),
         и любой желающий мог открыть его в блокноте и подправить историю изменений или номер
         версии. Embedded resource запекается прямо в exe при сборке (см. ChangelogLoader.Load) —
         в установленной программе отдельного Changelog/changelog.json на диске больше нет. -->
    <EmbeddedResource Include="Changelog\changelog.json" />
  </ItemGroup>

</Project>