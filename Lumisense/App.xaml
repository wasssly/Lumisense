<Application x:Class="Lumisense.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:Lumisense">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Стили и цвета Fluent Design (WPF-UI) -->
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />

            </ResourceDictionary.MergedDictionaries>

            <!-- SVG-иконки лежат в Icons/svg/{Pack}/IconXxx.svg (рендер через SharpVectors, SvgPathIcon.cs) и встраиваются через
                 <Resource Include="Icons\svg\**\*.svg" /> в csproj; на экране — local:SvgPathIcon Icon="IconXxx" (Pack — для превью в настройках). -->

            <local:IsOddIndexConverter x:Key="IsOddIndexConverter" />

            <!-- Общий стиль заголовков секций доступен отдельным окнам, включая
                 UpdateAvailableWindow, а не только SettingsWindow. -->
            <Style x:Key="SettingsSectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,6" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>

            <!-- Скруглённая focus-рамка для маленьких иконок-кнопок (TrackFavoriteButton/TrackPinButton): штатная прямоугольная выглядела как баг
                 поверх скруглённого выделения строки. -->
            <Style x:Key="RoundedIconButtonFocusVisualStyle">
                <Setter Property="Control.Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Border BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                    BorderThickness="2" CornerRadius="6" Margin="-2"
                                    SnapsToDevicePixels="True" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Кастомный тонкий Fluent-ползунок: применяется ко ВСЕМ Slider в приложении -->
            <Style TargetType="Slider">
                <Setter Property="Height" Value="24" />
                <Setter Property="Focusable" Value="True" />
                <!-- Ключевая настройка: клик по треку сразу переносит ползунок в точку клика,
                     а не сдвигает его пошагово на LargeChange -->
                <Setter Property="IsMoveToPointEnabled" Value="True" />
                <!-- Деления рисуются только там, где Slider задаёт TickPlacement; TickBar резервирует половину Thumb с краёв,
                     поэтому крайние точки совпадают с достижимыми позициями бегунка. -->
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <!-- Grid и Track всегда Stretch по обеим осям: иначе у вертикальных слайдеров EQ (Height="140") диапазон перетаскивания схлопнется.
                                 Тонкость полосы (4px) и выравнивание задаёт только Style, не локальные атрибуты: они приоритетнее сеттеров и триггеров стиля. -->
                            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent">
                                <!-- Фоновая полоса трека: тонкая поперёк оси движения, на всю длину вдоль неё;
                                     оси зависят от Slider.Orientation, отсюда триггер. -->
                                <Border CornerRadius="2.5" Background="{DynamicResource ControlStrongFillColorDefaultBrush}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Height" Value="5" />
                                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Slider}, Path=Orientation}" Value="Vertical">
                                                    <Setter Property="Height" Value="Auto" />
                                                    <Setter Property="Width" Value="5" />
                                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                                    <Setter Property="VerticalAlignment" Value="Stretch" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <!-- Orientation="{TemplateBinding Orientation}": у Track своё свойство Orientation (Horizontal по умолчанию), из Slider оно не наследуется —
                                     без привязки на вертикальных слайдерах EQ перетаскивание мапилось на X, а не на Y. -->
                                <Track x:Name="PART_Track" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                       Orientation="{TemplateBinding Orientation}">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="Slider.DecreaseLarge" Background="Transparent" BorderThickness="0">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <!-- Как у фоновой полосы: заполненная часть трека тонкая поперёк оси движения и растянута вдоль неё. -->
                                                    <!-- Скругляется только внешний старт заполнения; край у Thumb
                                                         остаётся прямым, чтобы не образовывать вторую капсулу. -->
                                                    <Border Background="{DynamicResource AccentFillColorDefaultBrush}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius" Value="2.5,0,0,2.5" />
                                                                <Setter Property="Height" Value="5" />
                                                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Slider}, Path=Orientation}" Value="Vertical">
                                                                        <Setter Property="CornerRadius" Value="0,0,2.5,2.5" />
                                                                        <Setter Property="Height" Value="Auto" />
                                                                        <Setter Property="Width" Value="5" />
                                                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                                                        <Setter Property="VerticalAlignment" Value="Stretch" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.DecreaseRepeatButton>

                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="Slider.IncreaseLarge" Background="Transparent" BorderThickness="0">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <!-- Растягивается на всю область Track (Height/Width не заданы), триггер по Orientation не нужен:
                                                         эта прозрачная половина только ловит клики мимо бегунка. -->
                                                    <Border Background="Transparent" />
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.IncreaseRepeatButton>

                                    <Track.Thumb>
                                        <Thumb Width="16" Height="16" Cursor="Hand">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Ellipse Fill="{DynamicResource AccentFillColorDefaultBrush}"
                                                             Stroke="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                                             StrokeThickness="1.5" />
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                                <!-- Точки рисуются только у Slider с SliderMilestoneMarkers.IsEnabled; Overlay после Track, поэтому виден на заполненной и незаполненной частях. -->
                                <local:SliderMilestoneOverlay x:Name="PART_MilestoneOverlay"
                                                              MarkerBrush="{DynamicResource TextFillColorSecondaryBrush}"
                                                              Opacity="0.88" IsHitTestVisible="False"
                                                              SnapsToDevicePixels="True" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <!-- Строки плейлиста: скруглённые карточки, ховер, акцентное выделение; zebra striping — триггер по AlternationIndex (нужен
                 ListView.AlternationCount > 0, см. MainWindow.xaml); триггеры шаблона приоритетнее стиля, поэтому ховер/выбор перекрывают полосу. -->
            <Style TargetType="ListViewItem">
                <Setter Property="Padding" Value="10,9" />
                <Setter Property="Margin" Value="2,3" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <!-- ClipToBounds: при малом расхождении измеренной ширины содержимого и карточки (округление при виртуализации) кнопка "избранное"
                                 у правого края могла бы отрисоваться за скруглённым фоном; с клипом обрезается по границе карточки. -->
                            <Border x:Name="ItemBorder" CornerRadius="8" ClipToBounds="True"
                                    Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background"
                                            Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background"
                                            Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Value="True">
                        <DataTrigger.Binding>
                            <Binding RelativeSource="{RelativeSource Self}"
                                     Path="(ItemsControl.AlternationIndex)"
                                     Converter="{StaticResource IsOddIndexConverter}" />
                        </DataTrigger.Binding>
                        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Fluent-аккордеон на штатном Expander с собственным ControlTemplate (не зависит от WPF-UI, который тут негде проверить сборкой);
                 раскрытие мгновенное (WPF не анимирует Auto-высоту без хрупких трюков), плавно только поворот шеврона на 180°. -->
            <Style x:Key="FluentExpanderStyle" TargetType="Expander">
                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Expander">
                            <Border CornerRadius="10" Background="{TemplateBinding Background}">
                                <StackPanel>
                                    <!-- Заголовок — ToggleButton с двусторонней привязкой IsChecked к Expander.IsExpanded, поэтому клик и программное изменение
                                         согласованы без кода в code-behind. -->
                                    <ToggleButton x:Name="HeaderToggle"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                  Content="{TemplateBinding Header}"
                                                  Cursor="Hand" Background="Transparent" BorderThickness="0"
                                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                  Padding="16,14">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="{TemplateBinding Background}"
                                                        Padding="{TemplateBinding Padding}"
                                                        HorizontalAlignment="Stretch">
                                                    <Grid HorizontalAlignment="Stretch">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <ContentPresenter Grid.Column="0" VerticalAlignment="Center"
                                                                          Content="{TemplateBinding Content}" />

                                                        <local:SvgPathIcon x:Name="Chevron" Grid.Column="1"
                                                                            Icon="IconChevronDown" Size="14"
                                                                            VerticalAlignment="Center" Opacity="0.6"
                                                                            RenderTransformOrigin="0.5,0.5">
                                                            <local:SvgPathIcon.RenderTransform>
                                                                <RotateTransform x:Name="ChevronRotate" Angle="0" />
                                                            </local:SvgPathIcon.RenderTransform>
                                                        </local:SvgPathIcon>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="ChevronRotate"
                                                                                     Storyboard.TargetProperty="Angle"
                                                                                     To="180" Duration="0:0:0.15" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                        <Trigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="ChevronRotate"
                                                                                     Storyboard.TargetProperty="Angle"
                                                                                     To="0" Duration="0:0:0.15" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.ExitActions>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>

                                    <ContentPresenter x:Name="ContentHost" Content="{TemplateBinding Content}"
                                                      Visibility="Collapsed" Margin="16,0,16,14" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsExpanded" Value="True">
                                    <Setter TargetName="ContentHost" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
