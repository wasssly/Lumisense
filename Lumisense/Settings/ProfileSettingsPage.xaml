<UserControl x:Class="Lumisense.ProfileSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:Lumisense">
    <StackPanel x:Name="PageProfile">
        <TextBlock Text="Профиль" Style="{StaticResource PageTitleStyle}" />
        <TextBlock Text="Перенос параметров и безопасный сброс настроек." Style="{StaticResource PageDescriptionStyle}" />
        <TextBlock Text="Перенос настроек плеера на другой компьютер одним файлом — тема, акцентный цвет, эквалайзер, горячие клавиши и остальные переключатели на этих страницах. Плейлист, избранное и история прослушиваний сюда не входят, как и настройки конкретного компьютера: положение окон, устройство вывода и режим WASAPI."
                   Opacity="0.6" FontSize="12" Margin="0,0,0,16" TextWrapping="Wrap" />

        <ui:Button x:Name="ExportProfileButton" Appearance="Secondary"
                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                   Padding="16,14" Margin="0,0,0,12" Click="ExportProfileButton_Click">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8"
                        Background="{DynamicResource ControlStrongFillColorDefaultBrush}"
                        Margin="0,0,12,0">
                    <local:SvgPathIcon Icon="IconCopy" Size="16"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Экспортировать настройки…" FontWeight="SemiBold" />
                    <TextBlock Text="Сохранить в один .lumi-файл" FontSize="12" Opacity="0.6" />
                </StackPanel>
            </Grid>
        </ui:Button>

        <ui:Button x:Name="ImportProfileButton" Appearance="Secondary"
                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                   Padding="16,14" Click="ImportProfileButton_Click">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8"
                        Background="{DynamicResource ControlStrongFillColorDefaultBrush}"
                        Margin="0,0,12,0">
                    <local:SvgPathIcon Icon="IconAddFile" Size="16"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Импортировать настройки…" FontWeight="SemiBold" />
                    <TextBlock Text="Из .lumi-файла, экспортированного на другом компьютере" FontSize="12" Opacity="0.6" />
                </StackPanel>
            </Grid>
        </ui:Button>

        <!-- См. SettingsWindow.ResetPlayerButton_Click / AppSettings.ResetToDefaults. -->
        <TextBlock Text="Сброс" Style="{StaticResource SettingsSectionTitleStyle}" Margin="0,26,0,8" />
        <TextBlock Text="Возвращает настройки внешнего вида и поведения к исходным. Плейлист, избранное, статистика и пресеты остаются без изменений."
                   Opacity="0.6" FontSize="12" Margin="0,0,0,16" TextWrapping="Wrap" />

        <ui:Button x:Name="ResetPlayerButton" Appearance="Secondary"
                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                   Padding="16,14" Click="ResetPlayerButton_Click">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8"
                        Background="{DynamicResource ControlStrongFillColorDefaultBrush}"
                        Margin="0,0,12,0">
                    <local:SvgPathIcon Icon="IconRefresh" Size="16"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Сбросить плеер к исходному состоянию" FontWeight="SemiBold" />
                    <TextBlock Text="Настройки внешнего вида и поведения — к значениям по умолчанию" FontSize="12" Opacity="0.6" />
                </StackPanel>
            </Grid>
        </ui:Button>

        <ui:Button x:Name="RestoreResetSnapshotButton" Appearance="Secondary"
                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                   Padding="16,14" Margin="0,14,0,0" Click="RestoreResetSnapshotButton_Click">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8"
                        Background="{DynamicResource ControlStrongFillColorDefaultBrush}"
                        Margin="0,0,12,0">
                    <local:SvgPathIcon Icon="IconRefresh" Size="16"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Вернуть состояние до последнего сброса" FontWeight="SemiBold" />
                    <TextBlock Text="Вернуть настройки и сохранённые данные из локальной точки восстановления" FontSize="12" Opacity="0.6" />
                </StackPanel>
            </Grid>
        </ui:Button>

        <ui:Button x:Name="ResetAllDataButton" Appearance="Secondary"
                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                   Padding="16,14" Margin="0,14,0,0" Click="ResetAllDataButton_Click">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8"
                        Background="{DynamicResource ControlStrongFillColorDefaultBrush}"
                        Margin="0,0,12,0">
                    <local:SvgPathIcon Icon="IconDelete" Size="16"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Полный сброс данных" FontWeight="SemiBold" />
                    <TextBlock Text="Очистить настройки, плейлисты, избранное, историю и пресеты" FontSize="12" Opacity="0.6" />
                </StackPanel>
            </Grid>
        </ui:Button>
    </StackPanel>
</UserControl>
