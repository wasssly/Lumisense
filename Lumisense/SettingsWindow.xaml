                                        TickFrequency="10" local:SliderMilestoneMarkers.IsEnabled="True"
                                        local:SliderMilestoneMarkers.MarkerFrequency="50"
                                        IsSnapToTickEnabled="True"
                                        ValueChanged="ToastWidthSlider_ValueChanged" Margin="0,0,0,16" />

                                <TextBlock Text="Монитор" Style="{StaticResource SettingsFieldLabelStyle}" />
                                <ComboBox x:Name="ToastMonitorCombo" SelectionChanged="ToastMonitorCombo_SelectionChanged"
                                          HorizontalAlignment="Left" MinWidth="220" />
                                <TextBlock Text="Автоматический выбор использует экран, на котором находится окно плеера."
                                           Style="{StaticResource SettingsHelperTextStyle}" Margin="0,8,0,0" />
