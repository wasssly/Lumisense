                                    <TextBlock Text="Очистить кэш" />
                                </StackPanel>
                            </ui:Button>
                        </Grid>

                        <!-- См. SettingsWindow.ResetPlayerButton_Click / AppSettings.ResetToDefaults. -->
                        <TextBlock Text="Сброс" Style="{StaticResource SettingsSectionTitleStyle}" Margin="0,26,0,8" />
                        <TextBlock Text="Возвращает настройки внешнего вида и поведения к исходным. Плейлист, избранное, статистика и пресеты остаются без изменений."
