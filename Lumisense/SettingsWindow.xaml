                                                <StackPanel Visibility="Collapsed">
                                                    <RadioButton x:Name="BackdropMicaRadio" Content="Mica (лёгкое размытие, по умолчанию)"
                                                    GroupName="Backdrop" Checked="WindowBackdropRadio_Changed" />
                                                    <RadioButton x:Name="BackdropMicaAltRadio" Content="Mica Alt (более плотная и контрастная основа, Windows 11 22H2+)"
                                                    GroupName="Backdrop" Checked="WindowBackdropRadio_Changed" />
                                                    <RadioButton x:Name="BackdropAcrylicRadio" Content="Acrylic (сильнее размытие и прозрачность)"
                                                    GroupName="Backdrop" Checked="WindowBackdropRadio_Changed" />
                                                    <RadioButton x:Name="BackdropBlurRadio" Content="Размытие"
                                                    GroupName="Backdrop" Checked="WindowBackdropRadio_Changed" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Padding="20,0,20,14">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SettingsHelperTextStyle}" Margin="0,0,0,6" Text="Основа применяется к главному окну, окну настроек и статистике." />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
