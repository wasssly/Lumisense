                    <!-- Эквалайзер -->
                    <StackPanel x:Name="PageEqualizer" Visibility="Collapsed">
                        <TextBlock Text="Эквалайзер" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="Точная настройка звучания и сохранённые пресеты." Style="{StaticResource PageDescriptionStyle}" />

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <CheckBox x:Name="EqualizerEnabledCheckBox" Content="Включить эквалайзер"
                                          Checked="EqualizerEnabledCheckBox_Changed" Unchecked="EqualizerEnabledCheckBox_Changed"
                                          Margin="0,0,0,10" />
                                <TextBlock Text="10 полос графического эквалайзера — регулировки применяются сразу же, без перезапуска трека."
                                           FontSize="12" Opacity="0.6" TextWrapping="Wrap" Margin="0,8,0,16" />

                                <CheckBox x:Name="EqualizerBypassCheckBox"
                                          Content="EQ Bypass (временно отключить обработку)"
                                          Checked="EqualizerBypassCheckBox_Changed"
                                          Unchecked="EqualizerBypassCheckBox_Changed"
                                          Margin="0,0,0,0" />
                                <TextBlock Text="Пропускает сигнал мимо фильтров, не меняя настройки полос. Удобно для быстрого сравнения звука с EQ и без."
                                           FontSize="12" Opacity="0.6" TextWrapping="Wrap" Margin="0,8,0,16" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 10 одинаковых колонок: значение в дБ сверху, вертикальный слайдер
                                         посередине, частота полосы снизу. Все десять слайдеров используют
                                         ОДИН общий обработчик (EqualizerBandSlider_ValueChanged) — номер
                                         полосы передаётся через Tag, а не десятью отдельными методами. -->
                                    <!-- Width="46" TextAlignment="Center" на EqBandXValueText (а не просто
                                         HorizontalAlignment="Center" на тексте переменной длины) — иначе
                                         во время перетаскивания слайдера, пока текст скачет между "0 дБ",
                                         "-3.5 дБ", "+12 дБ" и т.п. (разная длина строки), StackPanel без
                                         фиксированной ширины пересчитывал свою auto-ширину под самый
                                         широкий момент — и слайдер, центрированный внутри той же StackPanel,
                                         визуально дёргался влево-вправо вслед за этим пересчётом на каждом
                                         кадре перетаскивания. Фиксированная ширина текста делает ширину
                                         StackPanel постоянной, и дёргание пропадает. -->
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <TextBlock x:Name="EqBand0ValueText" Text="0 дБ" FontSize="11" Opacity="0.6" Width="46" TextAlignment="Center" Margin="0,0,0,4" />
                                        <Slider x:Name="EqBand0Slider" Style="{StaticResource SettingsEqualizerSliderStyle}" Tag="0" Orientation="Vertical" Height="140"
                                                Minimum="-12" Maximum="12" TickFrequency="3" SmallChange="0.5"
                                                ValueChanged="EqualizerBandSlider_ValueChanged"
                                                MouseWheel="EqualizerBandSlider_MouseWheel" />
                                        <TextBlock Text="31" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock x:Name="EqBand1ValueText" Text="0 дБ" FontSize="11" Opacity="0.6" Width="46" TextAlignment="Center" Margin="0,0,0,4" />
                                        <Slider x:Name="EqBand1Slider" Style="{StaticResource SettingsEqualizerSliderStyle}" Tag="1" Orientation="Vertical" Height="140"
                                                Minimum="-12" Maximum="12" TickFrequency="3" SmallChange="0.5"
                                                ValueChanged="EqualizerBandSlider_ValueChanged"
                                                MouseWheel="EqualizerBandSlider_MouseWheel" />
                                        <TextBlock Text="62" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                        <TextBlock x:Name="EqBand2ValueText" Text="0 дБ" FontSize="11" Opacity="0.6" Width="46" TextAlignment="Center" Margin="0,0,0,4" />
                                        <Slider x:Name="EqBand2Slider" Style="{StaticResource SettingsEqualizerSliderStyle}" Tag="2" Orientation="Vertical" Height="140"
                                                Minimum="-12" Maximum="12" TickFrequency="3" SmallChange="0.5"
                                                ValueChanged="EqualizerBandSlider_ValueChanged"
                                                MouseWheel="EqualizerBandSlider_MouseWheel" />
                                        <TextBlock Text="125" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                        <TextBlock x:Name="EqBand3ValueText" Text="0 дБ" FontSize="11" Opacity="0.6" Width="46" TextAlignment="Center" Margin="0,0,0,4" />
                                        <Slider x:Name="EqBand3Slider" Style="{StaticResource SettingsEqualizerSliderStyle}" Tag="3" Orientation="Vertical" Height="140"
                                                Minimum="-12" Maximum="12" TickFrequency="3" SmallChange="0.5"
                                                ValueChanged="EqualizerBandSlider_ValueChanged"
                                                MouseWheel="EqualizerBandSlider_MouseWheel" />
                                        <TextBlock Text="250" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                                        <TextBlock x:Name="EqBand4ValueText" Text="0 дБ" FontSize="11" Opacity="0.6" Width="46" TextAlignment="Center" Margin="0,0,0,4" />
                                        <Slider x:Name="EqBand4Slider" Style="{StaticResource SettingsEqualizerSliderStyle}" Tag="4" Orientation="Vertical" Height="140"
                                                Minimum="-12" Maximum="12" TickFrequency="3" SmallChange="0.5"
                                                ValueChanged="EqualizerBandSlider_ValueChanged"
                                                MouseWheel="EqualizerBandSlider_MouseWheel" />
                                        <TextBlock Text="500" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="5" HorizontalAlignment="Center">
                                        <TextBlock x:Name="EqBand5ValueText" Text="0 дБ" FontSize="11" Opacity="0.6" Width="46" TextAlignment="Center" Margin="0,0,0,4" />
                                        <Slider x:Name="EqBand5Slider" Style="{StaticResource SettingsEqualizerSliderStyle}" Tag="5" Orientation="Vertical" Height="140"
                                                Minimum="-12" Maximum="12" TickFrequency="3" SmallChange="0.5"
                                                ValueChanged="EqualizerBandSlider_ValueChanged"
                                                MouseWheel="EqualizerBandSlider_MouseWheel" />
                                        <TextBlock Text="1к" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="6" HorizontalAlignment="Center">
                                        <TextBlock x:Name="EqBand6ValueText" Text="0 дБ" FontSize="11" Opacity="0.6" Width="46" TextAlignment="Center" Margin="0,0,0,4" />
                                        <Slider x:Name="EqBand6Slider" Style="{StaticResource SettingsEqualizerSliderStyle}" Tag="6" Orientation="Vertical" Height="140"
                                                Minimum="-12" Maximum="12" TickFrequency="3" SmallChange="0.5"
                                                ValueChanged="EqualizerBandSlider_ValueChanged"
                                                MouseWheel="EqualizerBandSlider_MouseWheel" />
                                        <TextBlock Text="2к" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="7" HorizontalAlignment="Center">
                                        <TextBlock x:Name="EqBand7ValueText" Text="0 дБ" FontSize="11" Opacity="0.6" Width="46" TextAlignment="Center" Margin="0,0,0,4" />
                                        <Slider x:Name="EqBand7Slider" Style="{StaticResource SettingsEqualizerSliderStyle}" Tag="7" Orientation="Vertical" Height="140"
                                                Minimum="-12" Maximum="12" TickFrequency="3" SmallChange="0.5"
                                                ValueChanged="EqualizerBandSlider_ValueChanged"
                                                MouseWheel="EqualizerBandSlider_MouseWheel" />
                                        <TextBlock Text="4к" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="8" HorizontalAlignment="Center">
                                        <TextBlock x:Name="EqBand8ValueText" Text="0 дБ" FontSize="11" Opacity="0.6" Width="46" TextAlignment="Center" Margin="0,0,0,4" />
                                        <Slider x:Name="EqBand8Slider" Style="{StaticResource SettingsEqualizerSliderStyle}" Tag="8" Orientation="Vertical" Height="140"
                                                Minimum="-12" Maximum="12" TickFrequency="3" SmallChange="0.5"
                                                ValueChanged="EqualizerBandSlider_ValueChanged"
                                                MouseWheel="EqualizerBandSlider_MouseWheel" />
                                        <TextBlock Text="8к" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="9" HorizontalAlignment="Center">
                                        <TextBlock x:Name="EqBand9ValueText" Text="0 дБ" FontSize="11" Opacity="0.6" Width="46" TextAlignment="Center" Margin="0,0,0,4" />
                                        <Slider x:Name="EqBand9Slider" Style="{StaticResource SettingsEqualizerSliderStyle}" Tag="9" Orientation="Vertical" Height="140"
                                                Minimum="-12" Maximum="12" TickFrequency="3" SmallChange="0.5"
                                                ValueChanged="EqualizerBandSlider_ValueChanged"
                                                MouseWheel="EqualizerBandSlider_MouseWheel" />
                                        <TextBlock Text="16к" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>

                                <Button x:Name="EqualizerResetButton" Content="Сбросить всё" HorizontalAlignment="Left"
                                        Margin="0,14,0,0" Click="EqualizerResetButton_Click" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Пресеты" Style="{StaticResource SettingsFieldLabelStyle}" Margin="0,4,0,8" />
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Сохрани текущие настройки полос как пресет, переключайся между ними или поделись файлом пресета с кем-то ещё."
                                           FontSize="12" Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,12" />

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="EqualizerPresetComboBox" Grid.Column="0"
                                              DisplayMemberPath="Name" Margin="0,0,8,0"
                                              SelectionChanged="EqualizerPresetComboBox_SelectionChanged" />
                                    <Button x:Name="EqualizerApplyPresetButton" Grid.Column="1" Content="Применить"
                                            Click="EqualizerApplyPresetButton_Click" />
                                </Grid>

                                <WrapPanel>
                                    <Button x:Name="EqualizerSavePresetButton" Content="Сохранить как пресет…"
                                            Margin="0,0,8,8" Click="EqualizerSavePresetButton_Click" />
                                    <Button x:Name="EqualizerDeletePresetButton" Content="Удалить"
                                            Margin="0,0,8,8" Click="EqualizerDeletePresetButton_Click" />
                                    <Button x:Name="EqualizerExportPresetButton" Content="Поделиться…"
                                            ToolTip="Сохранить выбранный пресет в файл, чтобы переслать его кому-то ещё"
                                            Margin="0,0,8,8" Click="EqualizerExportPresetButton_Click" />
                                    <Button x:Name="EqualizerImportPresetButton" Content="Импортировать…"
                                            ToolTip="Добавить пресет из файла, полученного от кого-то ещё"
                                            Margin="0,0,8,8" Click="EqualizerImportPresetButton_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Мини-плеер -->
                    <StackPanel x:Name="PageMiniPlayer" Visibility="Collapsed">
                        <TextBlock Text="Мини-плеер" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="Компактный режим, оформление и поведение мини-плеера." Style="{StaticResource PageDescriptionStyle}" />

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Прозрачность окна" Style="{StaticResource SettingsSectionTitleStyle}" VerticalAlignment="Center" Margin="0" />
                                    <TextBlock x:Name="MiniOpacityValueText" Grid.Column="1" Text="100%"
                                               Opacity="0.6" FontSize="12" VerticalAlignment="Center" />
                                </Grid>

                                <!-- Тот же приём, что и у ползунка громкости в главном окне: сам Slider не
                                     ловит мышь, поверх него прозрачный Border обрабатывает клик/перетаскивание
                                     в любой точке трека целиком, без зависимости от того, куда именно попали
                                     (в шарик или в любую другую точку полосы). -->
                                <Grid Margin="0,0,0,16">
                                    <Slider x:Name="MiniOpacitySlider" Style="{StaticResource SettingsAccentSliderStyle}" IsHitTestVisible="False"
                                            Minimum="0.3" Maximum="1.0" Value="1.0"
                                            ValueChanged="MiniOpacitySlider_ValueChanged" VerticalAlignment="Center" />

                                    <Border Background="Transparent" Height="24" VerticalAlignment="Center"
                                            MouseLeftButtonDown="MiniOpacityOverlay_MouseLeftButtonDown"
                                            MouseMove="MiniOpacityOverlay_MouseMove"
                                            MouseLeftButtonUp="MiniOpacityOverlay_MouseLeftButtonUp" />
                                </Grid>

                                <CheckBox x:Name="MiniAlwaysOnTopCheckBox" Content="Поверх всех окон (мини-плеер)"
                                          Checked="MiniAlwaysOnTopCheckBox_Changed" Unchecked="MiniAlwaysOnTopCheckBox_Changed" />
                                <TextBlock Text="Мини-плеер остаётся видимым, пока вы работаете в других приложениях."
                                           Style="{StaticResource SettingsHelperTextStyle}" Margin="0,8,0,16" />
                                <CheckBox x:Name="MiniPinnedCheckBox" Content="Закрепить положение (запретить перетаскивание)"
                                          Checked="MiniPinnedCheckBox_Changed" Unchecked="MiniPinnedCheckBox_Changed" />
                                <TextBlock Text="Защищает выбранную позицию мини-плеера при изменении режима экрана или запуске игры."
                                           Style="{StaticResource SettingsHelperTextStyle}" Margin="0,8,0,16" />
                                <!-- См. AppSettings.MiniPlayerSnapToEdges / WindowSnapHelper. Действует, только
                                     пока положение НЕ закреплено чекбоксом выше — если перетаскивания нет
                                     вообще, прилипать уже нечему. -->
                                <CheckBox x:Name="MiniSnapToEdgesCheckBox" Content="Прилипание к краям экрана"
                                          Checked="MiniSnapToEdgesCheckBox_Changed" Unchecked="MiniSnapToEdgesCheckBox_Changed" />
                                <TextBlock Text="При перетаскивании мини-плеер выравнивается по ближайшему краю экрана."
                                           Style="{StaticResource SettingsHelperTextStyle}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- В компактном окне мини-плеера, в отличие от основного, место есть только
                             под одну "вторую" кнопку рядом с play/pause и next/prev — выбираем здесь,
                             какую из трёх функций она выполняет (см. AppSettings.MiniPlayerSecondaryButton
                             и MiniPlayerWindow.UpdateSecondaryButton). -->
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Вторая кнопка в мини-плеере" Style="{StaticResource SettingsSectionTitleStyle}" />
                                <RadioButton x:Name="MiniSecondaryRepeatRadio" Content="Повтор" GroupName="MiniSecondaryButton"
                                             Checked="MiniSecondaryButtonRadio_Changed" Margin="0,0,0,10" />
                                <RadioButton x:Name="MiniSecondaryShuffleRadio" Content="Перемешать" GroupName="MiniSecondaryButton"
                                             Checked="MiniSecondaryButtonRadio_Changed" Margin="0,0,0,10" />
                                <RadioButton x:Name="MiniSecondaryFavoriteRadio" Content="Избранное" GroupName="MiniSecondaryButton"
                                             Checked="MiniSecondaryButtonRadio_Changed" />
                                <TextBlock Text="Выберите действие дополнительной кнопки рядом с основными элементами управления."
                                           Style="{StaticResource SettingsHelperTextStyle}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- См. AppSettings.MiniPlayerButtonsLayout и MiniPlayerWindow.ApplyButtonsLayoutMode
                             за подробностями, чем отличаются режимы. -->
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Расположение кнопок управления" Style="{StaticResource SettingsSectionTitleStyle}" />
                                <RadioButton x:Name="MiniButtonsBelowRadio"
                                             Content="Снизу (окно немного подрастает при наведении)"
                                             GroupName="MiniButtonsLayout" Checked="MiniButtonsLayoutRadio_Changed"
                                             Margin="0,0,0,10" />
                                <RadioButton x:Name="MiniButtonsOverlayRadio"
                                             Content="На месте обложки и названия (размер окна не меняется)"
                                             GroupName="MiniButtonsLayout" Checked="MiniButtonsLayoutRadio_Changed" />
                                <TextBlock Text="Нижний вариант раскрывает управление при наведении, а вариант поверх обложки сохраняет постоянный размер окна."
                                           Style="{StaticResource SettingsHelperTextStyle}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Отображение обложки" Style="{StaticResource SettingsSectionTitleStyle}" />
                                <RadioButton x:Name="MiniArtworkDefaultRadio" Content="По умолчанию"
                                             GroupName="MiniPlayerArtworkStyle"
                                             Checked="MiniArtworkStyleRadio_Changed" Margin="0,0,0,10" />
                                <RadioButton x:Name="MiniArtworkVinylRadio" Content="Винил (медленное вращение во время воспроизведения)"
                                             GroupName="MiniPlayerArtworkStyle"
                                             Checked="MiniArtworkStyleRadio_Changed" />
                                <TextBlock Text="Виниловый режим делает обложку круглой и приостанавливает её вращение вместе с треком."
                                           FontSize="12" Opacity="0.6" TextWrapping="Wrap" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- См. AppSettings.MiniPlayerShowProgress и MiniPlayerWindow.ApplyProgressBarVisibility. -->
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <CheckBox x:Name="MiniShowProgressCheckBox" Content="Показывать полосу прогресса"
                                          Checked="MiniShowProgressCheckBox_Changed" Unchecked="MiniShowProgressCheckBox_Changed" />
                                <TextBlock Text="Окно мини-плеера становится немного компактнее, если полоса не нужна. Перемотка кликом по обложке/названию по-прежнему недоступна — только сама полоса."
                                           FontSize="12" Opacity="0.6" TextWrapping="Wrap" Margin="0,8,0,0" />
                                <CheckBox x:Name="MiniShowArtworkProgressCheckBox" Content="Показывать прогресс вокруг обложки"
                                          Checked="MiniShowArtworkProgressCheckBox_Changed"
                                          Unchecked="MiniShowArtworkProgressCheckBox_Changed"
                                          Margin="0,14,0,0" />
                                <TextBlock Text="Тонкий акцентный контур повторяет скруглённую форму обложки и показывает прогресс текущего трека. Его можно включить отдельно от обычной полосы прогресса."
                                           FontSize="12" Opacity="0.6" TextWrapping="Wrap" Margin="0,8,0,0" />

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="MiniArtworkProgressThicknessLabelText" Grid.Column="0"
                                               Style="{StaticResource SettingsFieldLabelStyle}" />
                                    <TextBlock x:Name="MiniArtworkProgressThicknessValueText" Grid.Column="1"
                                               VerticalAlignment="Center" FontSize="12" Opacity="0.7" />
                                </Grid>
                                <!-- Точечный overlay читает фактический Track и Thumb этого Slider,
                                     поэтому отметки совпадают с достижимыми позициями по всему диапазону. -->
                                <Grid Height="28" Margin="0,0,0,0">
                                    <Slider x:Name="MiniArtworkProgressThicknessSlider" Style="{StaticResource SettingsAccentSliderStyle}"
                                            Minimum="1" Maximum="4" TickFrequency="0.5" SmallChange="0.5" LargeChange="0.5"
                                            local:SliderMilestoneMarkers.IsEnabled="True"
                                            IsMoveToPointEnabled="True" IsSnapToTickEnabled="True"
                                            ValueChanged="MiniArtworkProgressThicknessSlider_ValueChanged" />
                                </Grid>
                                <TextBlock x:Name="MiniArtworkProgressThicknessDescriptionText"
                                           FontSize="12" Opacity="0.6" TextWrapping="Wrap" Margin="0,2,0,0" />

