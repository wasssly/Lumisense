                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsRowTitleStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEnabled, ElementName=CoverBaseFromCoverCheckBox}" Value="False">
