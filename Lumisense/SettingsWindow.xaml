                                    <TextBlock Text="Вернуть настройки и сохранённые данные из локальной точки восстановления" FontSize="12" Opacity="0.6" />
                                </StackPanel>
                            </Grid>
                        </ui:Button>

                        <ui:Button x:Name="ResetAllDataButton" Appearance="Secondary"
                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                   Padding="16,14" Margin="0,14,0,0" Click="ResetAllDataButton_Click">
