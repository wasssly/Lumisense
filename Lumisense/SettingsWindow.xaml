                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8"
                                        Background="{DynamicResource ControlStrongFillColorDefaultBrush}"
                                        Margin="0,0,12,0">
                                    <local:SvgPathIcon Icon="IconCopy" Size="16"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Экспортировать настройки…" FontWeight="SemiBold" />
                                    <TextBlock Text="Сохранить в один .lumi-файл" FontSize="12" Opacity="0.6" />
                                </StackPanel>
                            </Grid>
                        </ui:Button>

                        <ui:Button x:Name="ImportProfileButton" Appearance="Secondary"
                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                   Padding="16,14" Click="ImportProfileButton_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8"
                                        Background="{DynamicResource ControlStrongFillColorDefaultBrush}"
                                        Margin="0,0,12,0">
                                    <local:SvgPathIcon Icon="IconAddFile" Size="16"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Импортировать настройки…" FontWeight="SemiBold" />
                                    <TextBlock Text="Из .lumi-файла, экспортированного на другом компьютере" FontSize="12" Opacity="0.6" />
                                </StackPanel>
                            </Grid>
                        </ui:Button>

                        <TextBlock Text="Кэш текстов песен" Style="{StaticResource SettingsSectionTitleStyle}" Margin="0,26,0,8" />
                        <TextBlock Text="Вставленные тексты хранятся только на этом устройстве. Кэш очищается через 180 дней и ограничен 200 текстами или 32 МБ."
                                   Opacity="0.6" FontSize="12" Margin="0,0,0,12" TextWrapping="Wrap" />
