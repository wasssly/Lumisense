                                    <Border Style="{StaticResource SettingsRowStyle}" BorderThickness="0" Visibility="{Binding Visibility, ElementName=InterfaceScaleSlider}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                                <TextBlock Text="Масштаб интерфейса" Style="{StaticResource SettingsRowTitleStyle}" />
                                                <TextBlock Style="{StaticResource SettingsHelperTextStyle}" Margin="0,4,0,0" Text="Увеличивает базовый текст и стандартные элементы во всех основных окнах." />
