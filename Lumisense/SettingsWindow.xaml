                    <!-- Профиль — раньше жила на странице "Экспериментальное" вместе со
                         случайным набором мелких переключателей: перенос настроек на другой
                         компьютер в один .lumi-файл (обычный JSON, см. LumiProfile.cs) — это
                         обычная, завершённая функция, а не что-то экспериментальное, ей
                         просто не хватало собственного места. Плейлист и избранное в профиль
                         не входят — только тема, акцент, эквалайзер, хоткеи и т.п. -->
                    <StackPanel x:Name="PageProfile" Visibility="Collapsed">
                        <TextBlock Text="Профиль" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="Перенос настроек плеера на другой компьютер одним файлом — тема, акцентный цвет, эквалайзер, горячие клавиши и остальные переключатели на этих страницах. Плейлист, избранное и история прослушиваний сюда не входят."
                                   Opacity="0.6" FontSize="12" Margin="0,0,0,16" TextWrapping="Wrap" />

                        <ui:Button x:Name="ExportProfileButton" Appearance="Secondary"
                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                   Padding="16,14" Margin="0,0,0,8" Click="ExportProfileButton_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8"
                                        Background="{DynamicResource ControlStrongFillColorDefaultBrush}"
                                        Margin="0,0,12,0">
                                    <local:SvgPathIcon Icon="IconCopy" Size="16"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Экспортировать настройки…" FontWeight="SemiBold" />
                                    <TextBlock Text="Сохранить в один .lumi-файл" FontSize="12" Opacity="0.6" />
                                </StackPanel>
                            </Grid>
                        </ui:Button>

                        <ui:Button x:Name="ImportProfileButton" Appearance="Secondary"
                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                   Padding="16,14" Click="ImportProfileButton_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8"
                                        Background="{DynamicResource ControlStrongFillColorDefaultBrush}"
                                        Margin="0,0,12,0">
                                    <local:SvgPathIcon Icon="IconAddFile" Size="16"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Импортировать настройки…" FontWeight="SemiBold" />
                                    <TextBlock Text="Из .lumi-файла, экспортированного на другом компьютере" FontSize="12" Opacity="0.6" />
                                </StackPanel>
                            </Grid>
                        </ui:Button>

                        <!-- См. SettingsWindow.ResetPlayerButton_Click / AppSettings.ResetToDefaults. -->
                        <TextBlock Text="Сброс" Style="{StaticResource PageTitleStyle}" FontSize="16" Margin="0,24,0,8" />
                        <TextBlock Text="Возвращает тему, акцент, подложку окна, вид и размер плеера, громкость, шафл/повтор, горячие клавиши, мини-плеер и остальные переключатели к значениям по умолчанию. Плейлист, избранное, история прослушиваний, статистика и сохранённые пресеты эквалайзера не затрагиваются."
                                   Opacity="0.6" FontSize="12" Margin="0,0,0,16" TextWrapping="Wrap" />

                        <ui:Button x:Name="ResetPlayerButton" Appearance="Secondary"
                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                   Padding="16,14" Click="ResetPlayerButton_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8"
                                        Background="{DynamicResource ControlStrongFillColorDefaultBrush}"
                                        Margin="0,0,12,0">
                                    <local:SvgPathIcon Icon="IconRefresh" Size="16"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Сбросить плеер к исходному состоянию" FontWeight="SemiBold" />
                                    <TextBlock Text="Настройки внешнего вида и поведения — к значениям по умолчанию" FontSize="12" Opacity="0.6" />
                                </StackPanel>
                            </Grid>
                        </ui:Button>
                    </StackPanel>

                    <!-- О плеере (+ Патчноуты) -->
                    <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                        <TextBlock Text="О плеере" Style="{StaticResource PageTitleStyle}" />

                        <!-- 1. Описание приложения — без изменений -->
                        <Border Style="{StaticResource SettingsCardStyle}" x:Name="AboutInfoCard">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Image Grid.Column="0" Source="/Icons/app/lumisense.png" Width="44" Height="44"
                                           Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                           Margin="0,0,12,0" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Lumisense" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock x:Name="AppVersionText" Text="Версия" Opacity="0.6" FontSize="12" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Аудиоплеер в стиле Fluent Design для Windows 11: плейлисты по папкам с избранным и поиском, 10-полосный эквалайзер, три вида окна — включая мини-плеер с закреплением, прилипанием к краям экрана и настраиваемой прозрачностью, — светлая и тёмная тема, редактирование тегов и обложек, глобальные горячие клавиши и интеграция с «Сейчас воспроизводится»."
                                           TextWrapping="Wrap" Opacity="0.85" Margin="0,12,0,12" />

                                <TextBlock Text="Собрано на .NET 8, WPF-UI и NAudio." TextWrapping="Wrap"
                                           FontSize="12" Opacity="0.6" />
                            </StackPanel>
                        </Border>

                        <!-- 2. "Проверить обновления" — сразу после описания (раньше была ниже, под
                             отдельным заголовком "Обновления"; сам заголовок убран за ненадобностью —
                             кнопка теперь и так стоит на видном месте прямо под описанием) -->
                        <ui:Button x:Name="CheckUpdatesButton" Appearance="Secondary"
                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                   Padding="16,14" Margin="0,20,0,0" Click="CheckUpdatesButton_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8"
                                        Background="{DynamicResource ControlStrongFillColorDefaultBrush}"
                                        Margin="0,0,12,0">
                                    <local:SvgPathIcon Icon="IconCheckmark" Size="16"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="CheckUpdatesButtonTitle" Text="Проверить обновления" FontWeight="SemiBold" />
                                    <TextBlock x:Name="CheckUpdatesButtonSubtitle" Text="Сверить версию с GitHub" FontSize="12" Opacity="0.6" />
                                </StackPanel>
                            </Grid>
                        </ui:Button>

                        <!-- 3. "Источник загрузки обновлений" — теперь аккордеон, свёрнут по
                             умолчанию (IsExpanded не задан → false): выбор зеркала — не то, что
                             нужно видеть/трогать большинству, кому GitHub и так доступен напрямую. -->
                        <Expander Style="{StaticResource FluentExpanderStyle}" HorizontalAlignment="Stretch" Margin="0,20,0,0">
                            <Expander.Header>
                                <TextBlock Text="Источник загрузки обновлений" FontSize="14" FontWeight="SemiBold" />
                            </Expander.Header>
                            <StackPanel>
                                <TextBlock Text="Откуда скачивать ZIP-архив обновления. По умолчанию — напрямую с GitHub; если он у вас недоступен или скачивается очень медленно, можно выбрать одно из зеркал gh-proxy. На саму проверку версии эта настройка не влияет."
                                           TextWrapping="Wrap" FontSize="12" Opacity="0.6" Margin="0,0,0,12" />

                                <RadioButton x:Name="UpdateSourceGitHubRadio" GroupName="UpdateSource" Tag="GitHub"
                                             Content="GitHub (напрямую)" Margin="0,0,0,8"
                                             Checked="UpdateSourceRadio_Checked" />
                                <RadioButton x:Name="UpdateSourceGhProxyRadio" GroupName="UpdateSource" Tag="GhProxy"
                                             Content="gh-proxy.org (зеркало)" Margin="0,0,0,8"
                                             Checked="UpdateSourceRadio_Checked" />
                                <RadioButton x:Name="UpdateSourceGhProxyV4Radio" GroupName="UpdateSource" Tag="GhProxyV4"
                                             Content="v4.gh-proxy.org (зеркало, только IPv4)" Margin="0,0,0,8"
                                             Checked="UpdateSourceRadio_Checked" />
                                <RadioButton x:Name="UpdateSourceGhProxyV6Radio" GroupName="UpdateSource" Tag="GhProxyV6"
                                             Content="v6.gh-proxy.org (зеркало, только IPv6)" Margin="0,0,0,8"
                                             Checked="UpdateSourceRadio_Checked" />
                                <RadioButton x:Name="UpdateSourceGhProxyCdnRadio" GroupName="UpdateSource" Tag="GhProxyCdn"
                                             Content="cdn.gh-proxy.org (зеркало, через CDN)"
                                             Checked="UpdateSourceRadio_Checked" />
                            </StackPanel>
                        </Expander>

                        <!-- 4. "Разработчик" — тоже аккордеон, тоже свёрнут по умолчанию: ссылки на
                             автора любопытны, но далеко не первое, что человек ищет в настройках
                             плеера — прятать их за один клик логичнее, чем держать всегда на виду
                             сразу под описанием и обновлениями. -->
                        <Expander Style="{StaticResource FluentExpanderStyle}" HorizontalAlignment="Stretch" Margin="0,12,0,0">
                            <Expander.Header>
                                <TextBlock Text="Разработчик" FontSize="14" FontWeight="SemiBold" />
                            </Expander.Header>
                            <StackPanel>
                                <ui:Button x:Name="DeveloperGitHubButton" Appearance="Secondary"
                                           HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                           Padding="16,14" Click="DeveloperGitHubButton_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8"
                                                Background="{DynamicResource ControlStrongFillColorDefaultBrush}"
                                                Margin="0,0,12,0">
                                            <local:SvgPathIcon Icon="IconGitHub" Size="16"
                                                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="GitHub" FontWeight="SemiBold" />
                                            <TextBlock Text="github.com/wasssly" FontSize="12" Opacity="0.6" />
                                        </StackPanel>
                                    </Grid>
                                </ui:Button>

                                <ui:Button x:Name="DeveloperTelegramButton" Appearance="Secondary"
                                           HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                           Padding="16,14" Margin="0,8,0,0" Click="DeveloperTelegramButton_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8"
                                                Background="{DynamicResource ControlStrongFillColorDefaultBrush}"
                                                Margin="0,0,12,0">
                                            <local:SvgPathIcon Icon="IconTelegram" Size="16"
                                                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Telegram" FontWeight="SemiBold" />
                                            <TextBlock Text="t.me/dontwritetoblame" FontSize="12" Opacity="0.6" />
                                        </StackPanel>
                                    </Grid>
                                </ui:Button>
                            </StackPanel>
                        </Expander>

                        <!-- 5. "Список изменений" — перенесён в самый низ страницы -->
                        <TextBlock Text="Список изменений" FontSize="14" FontWeight="SemiBold" Margin="4,20,0,10" />

                        <ui:Button x:Name="ChangelogButton" Appearance="Secondary"
                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                   Padding="16,14" Click="ChangelogButton_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8"
                                        Background="{DynamicResource ControlStrongFillColorDefaultBrush}"
                                        Margin="0,0,12,0">
                                    <local:SvgPathIcon Icon="IconInfo" Size="16"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Список изменений" FontWeight="SemiBold" />
                                    <TextBlock Text="Что нового в текущей версии" FontSize="12" Opacity="0.6" />
                                </StackPanel>
                            </Grid>
                        </ui:Button>
                    </StackPanel>

                </Grid>
            </ScrollViewer>

        </Grid>
    </Grid>
</ui:FluentWindow>
