<ui:FluentWindow x:Class="Lumisense.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:Lumisense"
        Title="Настройки"
        Icon="/Icons/app/lumisense-settings.ico"
        Height="860" Width="1180"
        MinHeight="680" MinWidth="980"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="Manual"
        ResizeMode="CanResize"
        PreviewKeyDown="SettingsWindow_PreviewKeyDown">

    <ui:FluentWindow.Resources>

        <!-- Подписи CheckBox/RadioButton всегда переносятся по доступной ширине. Это исключает
             выход длинного текста за границы карточки на узком окне и в английской локализации. -->
        <DataTemplate x:Key="SettingsChoiceContentTemplate">
            <TextBlock Text="{Binding}" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DataTemplate>

        <!-- Явные шаблоны контролов выбора. Они читают кисти как DynamicResource, поэтому
             цвет индикатора обновляется сразу после смены cover-акцента. -->
        <Style TargetType="CheckBox">
            <Setter Property="local:SpringMotion.SpringCheck" Value="True" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Box" Width="20" Height="20" CornerRadius="4"
                                    BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    Background="Transparent" VerticalAlignment="Center">
                                <Grid>
                                    <Border x:Name="AccentFill" CornerRadius="3"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                                            Opacity="0" RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="0.82" ScaleY="0.82" />
                                        </Border.RenderTransform>
                                    </Border>
                                    <Path x:Name="Mark" Data="M 4,10 L 8,14 L 16,5" StrokeThickness="2"
                                          Width="12" Height="12" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Stroke="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                          Opacity="0" RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform>
                                            <ScaleTransform ScaleX="0.55" ScaleY="0.55" />
                                        </Path.RenderTransform>
                                    </Path>
                                </Grid>
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                              ContentTemplate="{StaticResource SettingsChoiceContentTemplate}"
                                              RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Вариант чекбокса для строки настроек: подпись слева, флажок справа. -->
        <Style x:Key="SettingsRowCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid SnapsToDevicePixels="True" Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Box" Grid.Column="1" Width="20" Height="20" CornerRadius="4"
                                    BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    Background="Transparent" VerticalAlignment="Center">
                                <Grid>
                                    <Border x:Name="AccentFill" CornerRadius="3"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                                            Opacity="0" RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="0.82" ScaleY="0.82" />
                                        </Border.RenderTransform>
                                    </Border>
                                    <Path x:Name="Mark" Data="M 4,10 L 8,14 L 16,5" StrokeThickness="2"
                                          Width="12" Height="12" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Stroke="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                          Opacity="0" RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform>
                                            <ScaleTransform ScaleX="0.55" ScaleY="0.55" />
                                        </Path.RenderTransform>
                                    </Path>
                                </Grid>
                            </Border>
                            <ContentPresenter Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Center"
                                              ContentTemplate="{StaticResource SettingsChoiceContentTemplate}"
                                              RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        

        <!-- Spring dropdown (designbookmark.com/motion): шаблон ComboBox остаётся стандартным шаблоном WPF-UI, поверх него SpringMotion
             раскрывает меню на пружине, роняет строки по очереди и растягивает подсветку. Строки переопределены ради галочки. -->
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="local:SpringMotion.SpringDropdown" Value="True" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Margin" Value="4,1" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Bd" MinHeight="34" Padding="12,0,10,0" CornerRadius="8" Background="Transparent">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter VerticalAlignment="Center" Margin="0,6" />
                                            <Path x:Name="Tick" Grid.Column="1" Margin="14,0,0,0" Width="16" Height="14" VerticalAlignment="Center"
                                                  Data="M 1,7 L 6,12 L 15,2" Stretch="Uniform" StrokeThickness="2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  StrokeDashArray="9.4,100" StrokeDashOffset="9.4" Opacity="0"
                                                  Stroke="{DynamicResource TextFillColorPrimaryBrush}" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Tick" Property="Opacity" Value="1" />
                                            <Setter TargetName="Tick" Property="StrokeDashOffset" Value="0" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                                        </Trigger>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <!-- Прозрачный Border — единая hit-test область: декоративные элементы не перехватывают PointerDown,
                             поэтому клик по кругу и подписи доходит до RadioButton. -->
                        <Border Background="Transparent">
                            <Grid SnapsToDevicePixels="True" IsHitTestVisible="False">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="20" Height="20" VerticalAlignment="Center">
                                    <Ellipse x:Name="Ring" StrokeThickness="1"
                                             Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                    <!-- Почти замкнутая дуга: длина штриха равна окружности, поэтому сдвиг StrokeDashOffset дорисовывает акцентную обводку по кругу. -->
                                    <Path x:Name="DrawRing" Data="M 10,1 A 9,9 0 1 1 9.99,1"
                                          Stroke="{DynamicResource AccentFillColorDefaultBrush}"
                                          Opacity="0" StrokeThickness="2" StrokeDashArray="28.3,100"
                                          StrokeDashOffset="28.3" StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" />
                                    <Ellipse x:Name="Dot" Width="10" Height="10"
                                             Fill="{DynamicResource AccentFillColorDefaultBrush}"
                                             Opacity="0" />
                                </Grid>
                                <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                                  ContentTemplate="{StaticResource SettingsChoiceContentTemplate}"
                                                  RecognizesAccessKey="True" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Обводка: акцентный контур дорисовывается по окружности,
                                 затем появляется центральная точка. -->
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <!-- Явно возвращаем непрозрачность после предыдущего
                                                 снятия выбора, прежде чем начнётся прорисовка. -->
                                            <DoubleAnimation Storyboard.TargetName="DrawRing" Storyboard.TargetProperty="Opacity"
                                                             From="1" To="1" Duration="0:0:0.24" />
                                            <DoubleAnimation Storyboard.TargetName="DrawRing" Storyboard.TargetProperty="StrokeDashOffset"
                                                             From="28.3" To="0" Duration="0:0:0.24"
                                                             AccelerationRatio="0.08" DecelerationRatio="0.72" />
                                            <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.10" BeginTime="0:0:0.13"
                                                             AccelerationRatio="0.12" DecelerationRatio="0.72" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="DrawRing" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.14"
                                                             AccelerationRatio="0.12" DecelerationRatio="0.72" />
                                            <DoubleAnimation Storyboard.TargetName="DrawRing" Storyboard.TargetProperty="StrokeDashOffset"
                                                             To="28.3" Duration="0:0:0.01" BeginTime="0:0:0.14" />
                                            <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.10" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Вариант радиокнопки для строки настроек: подпись слева, кружок справа. -->
        <Style x:Key="SettingsRowRadioButtonStyle" TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <!-- Прозрачный Border — единая hit-test область: декоративные элементы не перехватывают PointerDown,
                             поэтому клик по кругу и подписи доходит до RadioButton. -->
                        <Border Background="Transparent">
                            <Grid SnapsToDevicePixels="True" IsHitTestVisible="False">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="1" Width="20" Height="20" VerticalAlignment="Center">
                                    <Ellipse x:Name="Ring" StrokeThickness="1"
                                             Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                    <!-- Почти замкнутая дуга: длина штриха равна окружности, поэтому сдвиг StrokeDashOffset дорисовывает акцентную обводку по кругу. -->
                                    <Path x:Name="DrawRing" Data="M 10,1 A 9,9 0 1 1 9.99,1"
                                          Stroke="{DynamicResource AccentFillColorDefaultBrush}"
                                          Opacity="0" StrokeThickness="2" StrokeDashArray="28.3,100"
                                          StrokeDashOffset="28.3" StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" />
                                    <Ellipse x:Name="Dot" Width="10" Height="10"
                                             Fill="{DynamicResource AccentFillColorDefaultBrush}"
                                             Opacity="0" />
                                </Grid>
                                <ContentPresenter Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Center"
                                                  ContentTemplate="{StaticResource SettingsChoiceContentTemplate}"
                                                  RecognizesAccessKey="True" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Обводка: акцентный контур дорисовывается по окружности,
                                 затем появляется центральная точка. -->
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <!-- Явно возвращаем непрозрачность после предыдущего
                                                 снятия выбора, прежде чем начнётся прорисовка. -->
                                            <DoubleAnimation Storyboard.TargetName="DrawRing" Storyboard.TargetProperty="Opacity"
                                                             From="1" To="1" Duration="0:0:0.24" />
                                            <DoubleAnimation Storyboard.TargetName="DrawRing" Storyboard.TargetProperty="StrokeDashOffset"
                                                             From="28.3" To="0" Duration="0:0:0.24"
                                                             AccelerationRatio="0.08" DecelerationRatio="0.72" />
                                            <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.10" BeginTime="0:0:0.13"
                                                             AccelerationRatio="0.12" DecelerationRatio="0.72" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="DrawRing" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.14"
                                                             AccelerationRatio="0.12" DecelerationRatio="0.72" />
                                            <DoubleAnimation Storyboard.TargetName="DrawRing" Storyboard.TargetProperty="StrokeDashOffset"
                                                             To="28.3" Duration="0:0:0.01" BeginTime="0:0:0.14" />
                                            <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.10" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TransparentSliderRepeatButtonStyle" TargetType="RepeatButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentSliderDecreaseRepeatButtonStyle" TargetType="RepeatButton" BasedOn="{StaticResource TransparentSliderRepeatButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <!-- Старт заполнения — та же полукапсула радиуса 2,5 DIP, что и
                             внешний конец фоновой дорожки. У Thumb край остаётся прямым. -->
                        <Border Height="5" CornerRadius="2.5,0,0,2.5" Background="{DynamicResource AccentFillColorDefaultBrush}"
                                HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                SnapsToDevicePixels="True" UseLayoutRounding="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Строка списка, который можно переставлять перетаскиванием (пункты контекстных меню). -->
        <Style x:Key="ReorderRowStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Padding" Value="2,4,10,4" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ReorderGripStyle" TargetType="TextBlock">
            <Setter Property="Text" Value="⋮⋮" />
            <Setter Property="FontFamily" Value="Segoe UI Symbol" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="SizeAll" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="ToolTip" Value="Перетащите, чтобы изменить порядок" />
        </Style>

        <Style x:Key="SettingsAccentSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="28" />
            <Setter Property="local:SliderSmoothing.IsEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Margin="0,5" SnapsToDevicePixels="True">
                            <Border x:Name="PART_MilestoneRail" Height="5" CornerRadius="2.5" Background="{DynamicResource ControlFillColorTertiaryBrush}"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Center" IsHitTestVisible="False"
                                    SnapsToDevicePixels="True" UseLayoutRounding="True" />
                                <Track x:Name="PART_Track" VerticalAlignment="Center" Orientation="{TemplateBinding Orientation}"
                                       SnapsToDevicePixels="True" UseLayoutRounding="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton x:Name="LegacyFill" Style="{StaticResource AccentSliderDecreaseRepeatButtonStyle}"
                                                  Command="Slider.DecreaseLarge" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="LegacyThumb" Width="14" Height="14" SnapsToDevicePixels="True" UseLayoutRounding="True">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{DynamicResource AccentFillColorDefaultBrush}"
                                                         Stroke="{DynamicResource TextOnAccentFillColorPrimaryBrush}" StrokeThickness="1" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource TransparentSliderRepeatButtonStyle}"
                                                  Command="Slider.IncreaseLarge" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                            <!-- Material-вид (AppSettings.SliderStyle): рисует всё сам, поэтому обычные части ниже в этом режиме скрываются триггером. -->
                            <local:MaterialSliderVisual x:Name="PART_MaterialVisual" Visibility="Collapsed" IsHitTestVisible="False"
                                                         ActiveBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                                         InactiveBrush="{DynamicResource ControlStrongFillColorDefaultBrush}"
                                                         ActiveTickBrush="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                                         InactiveTickBrush="{DynamicResource TextFillColorSecondaryBrush}" />
                            <!-- Overlay расположен после Track, поэтому точки видны и поверх
                                 акцентной части дорожки, но активный шаг остаётся за Thumb. -->
                            <local:SliderMilestoneOverlay x:Name="PART_MilestoneOverlay"
                                                          MarkerBrush="{DynamicResource TextFillColorSecondaryBrush}"
                                                          Opacity="0.88" IsHitTestVisible="False"
                                                          SnapsToDevicePixels="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Value="True">
                                    <DataTrigger.Binding>
                                        <MultiBinding Converter="{x:Static local:SliderMaterialConverter.Instance}">
                                            <Binding Source="{x:Static local:SliderAppearance.Instance}" Path="IsMaterial" />
                                            <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="(local:SliderAppearance.Override)" />
                                        </MultiBinding>
                                    </DataTrigger.Binding>
                                <Setter TargetName="PART_MaterialVisual" Property="Visibility" Value="Visible" />
                                <Setter TargetName="PART_MilestoneRail" Property="Visibility" Value="Hidden" />
                                <Setter TargetName="PART_MilestoneOverlay" Property="Visibility" Value="Hidden" />
                                <Setter TargetName="LegacyFill" Property="Opacity" Value="0" />
                                <Setter TargetName="LegacyThumb" Property="Opacity" Value="0" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Вертикальный вариант эталонного слайдера: та же 5 DIP дорожка, 14 DIP Thumb
             и спокойная палитра, но с заполнением от нижней (минимальной) точки к Thumb. -->
        <Style x:Key="SettingsEqualizerSliderStyle" TargetType="Slider">
            <Setter Property="Width" Value="28" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="local:SliderSmoothing.IsEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <!-- Прозрачный фон делает всю колонку областью нажатия и колеса мыши, а не только кружок. -->
                        <Grid Margin="5,0" Background="Transparent" SnapsToDevicePixels="True" UseLayoutRounding="True">
                            <Border x:Name="LegacyRail" Width="5" CornerRadius="2.5"
                                    Background="{DynamicResource ControlFillColorTertiaryBrush}"
                                    HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                    IsHitTestVisible="False" SnapsToDevicePixels="True"
                                    UseLayoutRounding="True" />
                            <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}"
                                   IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                   SnapsToDevicePixels="True" UseLayoutRounding="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton x:Name="LegacyFill" Command="Slider.DecreaseLarge" Background="Transparent" BorderThickness="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <!-- Внешнее (нижнее) начало заполнения округлено;
                                                     граница у Thumb прямая и визуально чистая. -->
                                                <Grid Background="Transparent">
                                                    <Border Width="5" CornerRadius="0,0,2.5,2.5"
                                                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                            HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                                            SnapsToDevicePixels="True" UseLayoutRounding="True" />
                                                </Grid>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="LegacyThumb" Width="14" Height="14" Cursor="Hand"
                                           SnapsToDevicePixels="True" UseLayoutRounding="True">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{DynamicResource AccentFillColorDefaultBrush}"
                                                         Stroke="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                                         StrokeThickness="1" SnapsToDevicePixels="True" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Background="Transparent" BorderThickness="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                            <!-- Material-вид (AppSettings.SliderStyle): рисует всё сам, поэтому обычные части ниже в этом режиме скрываются триггером. -->
                            <local:MaterialSliderVisual x:Name="PART_MaterialVisual" Visibility="Collapsed" IsHitTestVisible="False" IsCentered="True"
                                                         ActiveBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                                         InactiveBrush="{DynamicResource ControlStrongFillColorDefaultBrush}"
                                                         ActiveTickBrush="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                                         InactiveTickBrush="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Value="True">
                                    <DataTrigger.Binding>
                                        <MultiBinding Converter="{x:Static local:SliderMaterialConverter.Instance}">
                                            <Binding Source="{x:Static local:SliderAppearance.Instance}" Path="IsMaterial" />
                                            <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="(local:SliderAppearance.Override)" />
                                        </MultiBinding>
                                    </DataTrigger.Binding>
                                <Setter TargetName="PART_MaterialVisual" Property="Visibility" Value="Visible" />
                                <Setter TargetName="LegacyRail" Property="Visibility" Value="Hidden" />
                                <Setter TargetName="LegacyFill" Property="Opacity" Value="0" />
                                <Setter TargetName="LegacyThumb" Property="Opacity" Value="0" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Вертикальная навигация нового окна: активный раздел получает отдельную
             акцентную полосу и поверхность, но остаётся спокойным для длинного списка. -->
        <Style x:Key="NavItemStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" CornerRadius="10" Background="Transparent" Padding="0">
                            <Grid Height="38">
                                <Border x:Name="Indicator" Width="3" CornerRadius="2"
                                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                                        HorizontalAlignment="Left" Margin="6,7,0,7" Opacity="0" />
                                <ContentPresenter Margin="15,0,10,0" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                <Setter TargetName="Indicator" Property="Opacity" Value="1" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="10,14,10,5" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>

        <!-- Горизонтальные виды навигации («Навигация в настройках»): те же RadioButton, что и в боковой панели, но с другим
             стилем; SettingsWindow.ApplyNavigationStyle переносит их между контейнерами. Скругления согласованы по высоте:
             таблетка 36 → её полоса 36 + 2·4 + 2·1 = 46 (радиус 23); плавающий пункт 40 → панель 54 (радиус 27). -->
        <!-- Выбранная таблетка не рисует фон сама: акцентную подсветку плавно переносит SettingsWindow.UpdatePillHighlight. -->
        <Style x:Key="NavPillStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" CornerRadius="18" Background="Transparent">
                            <Grid Height="36">
                                <ContentPresenter Margin="14,0" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsChecked" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                            </MultiTrigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Плавающая панель: пункт высотой 40 и шириной не меньше 40 (иконка 18 + поля 11 = 40: ровный круг, радиус 20); у выбранного
             пункта в режиме «рядом с иконкой» ширина растёт на подпись. Поля у пунктов нулевые, чтобы отступы панели слева и справа были
             такими же, как сверху и снизу. Подсветку рисует и двигает ExpressiveNavPanel. -->
        <Style x:Key="NavFloatingStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" CornerRadius="20" Background="Transparent">
                            <Grid Height="40" MinWidth="40">
                                <ContentPresenter Margin="11,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsChecked" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                            </MultiTrigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Та же панель с названиями: иконка над подписью, высота 56 (радиус 28 = половина), ширина по подписи. Радиусы панели и
             подсветки выставляет ApplyNavigationStyle: радиус панели = радиус пункта + отступ 7. -->
        <Style x:Key="NavFloatingLabelStyle" TargetType="RadioButton" BasedOn="{StaticResource NavFloatingStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" CornerRadius="28" Background="Transparent">
                            <Grid Height="56" MinWidth="56">
                                <ContentPresenter Margin="8,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsChecked" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                            </MultiTrigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Режим «подпись рядом с иконкой у выбранного пункта»: значок прижат влево с полем 11 (в свёрнутом пункте шириной 40 он
             оказывается по центру), подпись видна по мере раскрытия пункта; ширину задаёт ExpressiveNavPanel, лишнее обрезается. -->
        <Style x:Key="NavFloatingInlineStyle" TargetType="RadioButton" BasedOn="{StaticResource NavFloatingStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" CornerRadius="20" Background="Transparent">
                            <Grid Height="40">
                                <ContentPresenter Margin="11,0,14,0" HorizontalAlignment="Left" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsChecked" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                            </MultiTrigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стрелки по краям полосы таблеток: видны, только когда пункты не помещаются; удержание листает дальше. -->
        <Style x:Key="NavArrowButtonStyle" TargetType="RepeatButton">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Delay" Value="350" />
            <Setter Property="Interval" Value="70" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border x:Name="Bg" CornerRadius="18" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Карточка-превью вида плеера: RadioButton с миниатюрой, выбранный подсвечивается акцентной рамкой (PlayerViewModeCard). -->
        <Style x:Key="ViewModeThumbStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" CornerRadius="10" BorderThickness="2"
                                BorderBrush="Transparent" Padding="8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush"
                                        Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Группа настроек в стиле Windows 11: заголовок над карточкой, внутри строки «подпись слева, контрол справа». -->
        <Style x:Key="SettingsGroupTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="4,0,0,8" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="SettingsGroupCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Margin" Value="0,0,0,24" />
        </Style>

        <Style x:Key="SettingsRowStyle" TargetType="Border">
            <Setter Property="Padding" Value="20,12" />
            <Setter Property="MinHeight" Value="56" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        </Style>

        <Style x:Key="SettingsRowTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <!-- Переключатель: дорожка 44x24, кружок 12. Цвет «включено» — акцент приложения (AccentFillColorDefaultBrush),
             он меняется вместе с настройкой акцентного цвета. Подписи нет: она стоит в строке слева. -->
        <Style TargetType="{x:Type ui:ToggleSwitch}">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="local:SpringMotion.SpringToggle" Value="True" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ui:ToggleSwitch}">
                        <Grid x:Name="Root" Width="44" Height="24" Background="Transparent">
                            <Border x:Name="Track" CornerRadius="12" BorderThickness="2" Background="Transparent"
                                    BorderBrush="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Ellipse x:Name="Knob" Width="12" Height="12" HorizontalAlignment="Left" Margin="6,0,0,0"
                                     Fill="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Карточка-секция настроек: единый спокойный фон, тонкая обводка и увеличенная
             внутренняя сетка делают длинные страницы легче для сканирования. -->
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="28,24" />
            <Setter Property="Margin" Value="0,0,0,24" />
        </Style>

        <!-- Заголовок и подзаголовок формируют устойчивую иерархию каждой страницы. -->
        <Style x:Key="PageTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="PageDescriptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,30" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <!-- Первый уровень внутри карточки — название группы параметров; второй — краткое
             пояснение. Это отделяет подписи от самих вариантов выбора. -->
        <Style x:Key="SettingsSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="SettingsFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,24,0,8" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="SettingsHelperTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <!-- Строка результата поиска настроек: прозрачная кнопка на всю ширину со скруглённой
             подсветкой при наведении, как у пунктов навигации -->
        <Style x:Key="SearchResultItemStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Padding" Value="0" />
            <!-- Стиль без BasedOn не получает цвет текста от WPF-UI, и текст внутри кнопки становился чёрным. -->
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="8" Background="{TemplateBinding Background}">
                            <ContentPresenter Margin="12,9" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </ui:FluentWindow.Resources>

    <Grid x:Name="RootLayout"
          PreviewMouseWheel="SettingsRoot_PreviewMouseWheel"
>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Fluent TitleBar с той же раскладкой кнопок, что в главном окне (AppTitleBar); ShowMaximize="True", раз окно CanResize. -->
        <ui:TitleBar Grid.Row="0" Title="Настройки" ShowMaximize="True" />

        <Grid Grid.Row="1" Background="{DynamicResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="236" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border x:Name="SidebarBorder" Grid.Row="1" Grid.Column="0" Margin="14,14,0,16" Padding="10"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel x:Name="SidebarHeaderPanel" Grid.Row="0" Margin="1,1,1,8">
                        <TextBlock Text="НАСТРОЙКИ" FontSize="9" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="Lumisense" FontSize="14" FontWeight="SemiBold"
                                   Margin="0,2,0,8" />
                        <ui:TextBox x:Name="SettingsSearchBox"
                                PlaceholderText="Поиск настроек"
                                ClearButtonEnabled="True"
                                TextChanged="SettingsSearchBox_TextChanged">
                            <ui:TextBox.Icon>
                                <local:SvgPathIcon Icon="IconSearch" />
                            </ui:TextBox.Icon>
                        </ui:TextBox>
                    </StackPanel>

                    <Grid x:Name="SidebarNavHost" Grid.Row="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Padding="0,0,12,0">
                        <StackPanel x:Name="NavCategoriesPanel" Margin="0,0,2,8">

                    <TextBlock Text="ОСНОВНОЕ" Style="{StaticResource NavSectionTitleStyle}" />

                    <RadioButton x:Name="NavAppearance" Style="{StaticResource NavItemStyle}"
                                 GroupName="SettingsNav" Tag="Appearance"
                                 Checked="NavItem_Checked">
                        <StackPanel Orientation="Horizontal">
                            <local:SvgPathIcon Icon="IconSun" Size="18" VerticalAlignment="Center" />
                            <TextBlock Text="Оформление" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavCover" Style="{StaticResource NavItemStyle}"
                                 GroupName="SettingsNav" Tag="Cover" Checked="NavItem_Checked">
                        <StackPanel Orientation="Horizontal">
                            <local:SvgPathIcon Icon="IconMusicNote" Size="18" VerticalAlignment="Center" />
                            <TextBlock x:Name="NavCoverText" Text="Обложка и Now Playing" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavLyrics" Style="{StaticResource NavItemStyle}"
                                 GroupName="SettingsNav" Tag="Lyrics" Checked="NavItem_Checked">
                        <StackPanel Orientation="Horizontal">
                            <local:SvgPathIcon Icon="IconLyrics" Size="18" VerticalAlignment="Center" />
                            <TextBlock Text="Тексты песен" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

