                        <!-- См. AppSettings.MiniPlayerStyle/IslandMonitor и IslandPlayerWindow. -->
                        <StackPanel x:Name="MiniStyleCard" Margin="0,0,0,24">
                            <Border Style="{StaticResource SettingsGroupCardStyle}" Margin="0,0,0,0">
                                <StackPanel>
                                    <Border Style="{StaticResource SettingsRowStyle}" BorderThickness="0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
