                    <!-- Профиль — раньше жила на странице "Экспериментальное" вместе со
                         случайным набором мелких переключателей: перенос настроек на другой
                         компьютер в один .lumi-файл (обычный JSON, см. LumiProfile.cs) — это
                         обычная, завершённая функция, а не что-то экспериментальное, ей
                         просто не хватало собственного места. Плейлист и избранное в профиль
                         не входят — только тема, акцент, эквалайзер, хоткеи и т.п. -->
                    <StackPanel x:Name="PageProfile" Visibility="Collapsed">
                        <TextBlock Text="Профиль" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="Перенос параметров и безопасный сброс настроек." Style="{StaticResource PageDescriptionStyle}" />
                        <TextBlock Text="Перенос настроек плеера на другой компьютер одним файлом — тема, акцентный цвет, эквалайзер, горячие клавиши и остальные переключатели на этих страницах. Плейлист, избранное и история прослушиваний сюда не входят."
                                   Opacity="0.6" FontSize="12" Margin="0,0,0,16" TextWrapping="Wrap" />

                        <ui:Button x:Name="ExportProfileButton" Appearance="Secondary"
                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                   Padding="16,14" Margin="0,0,0,10" Click="ExportProfileButton_Click">
