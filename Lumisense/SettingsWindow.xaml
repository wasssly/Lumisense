                                    <TextBlock Text="Сбросить плеер к исходному состоянию" FontWeight="SemiBold" />
                                    <TextBlock Text="Настройки внешнего вида и поведения — к значениям по умолчанию" FontSize="12" Opacity="0.6" />
                                </StackPanel>
                            </Grid>
                        </ui:Button>

                        <ui:Button x:Name="RestoreResetSnapshotButton" Appearance="Secondary"
