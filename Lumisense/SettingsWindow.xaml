                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEnabled, ElementName=MiniPlayerStyleRadioCombo}" Value="False">
                                                                    <Setter Property="Opacity" Value="0.45" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel x:Name="MiniPlayerStyleRadioGroup" Grid.Column="1" VerticalAlignment="Center">
                                                <ComboBox x:Name="MiniPlayerStyleRadioCombo" Tag="RadioGroup" AutomationProperties.Name="Вид мини-плеера" MinWidth="220" HorizontalAlignment="Right">
                                                    <ComboBoxItem Content="Карточка (по умолчанию)" Tag="MiniStyleClassicRadio" />
                                                    <ComboBoxItem Content="Остров — капсула у верхнего края экрана, раскрывается по клику" Tag="MiniStyleIslandRadio" />
                                                </ComboBox>
                                                <StackPanel Visibility="Collapsed">
                                                    <RadioButton x:Name="MiniStyleClassicRadio" Content="Карточка (по умолчанию)" GroupName="MiniPlayerStyle"
                                                    Checked="MiniStyleRadio_Changed" />
                                                    <RadioButton x:Name="MiniStyleIslandRadio" Content="Остров — капсула у верхнего края экрана, раскрывается по клику"
                                                    GroupName="MiniPlayerStyle" Checked="MiniStyleRadio_Changed" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,24">
                            <Border Style="{StaticResource SettingsGroupCardStyle}" Margin="0,0,0,0">
                                <StackPanel>
                                    <Border Style="{StaticResource SettingsRowStyle}" BorderThickness="0" Visibility="{Binding Visibility, ElementName=MiniOpacitySlider}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                                <TextBlock Text="Прозрачность окна" Style="{StaticResource SettingsRowTitleStyle}" />
                                            </StackPanel>
                                            <Grid Grid.Column="1" Width="340" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock MinWidth="48" TextAlignment="Right" Margin="14,0,0,0" x:Name="MiniOpacityValueText" Grid.Column="1" Text="100%"
                                                Opacity="0.6" FontSize="12" VerticalAlignment="Center" />
                                                <Grid Grid.Column="0">
                                                    <Slider x:Name="MiniOpacitySlider" AutomationProperties.Name="Прозрачность окна мини-плеера" Style="{StaticResource SettingsAccentSliderStyle}" IsHitTestVisible="False"
                                                            Minimum="0.3" Maximum="1.0" Value="1.0"
                                                            ValueChanged="MiniOpacitySlider_ValueChanged" VerticalAlignment="Center" />

                                                    <Border Background="Transparent" Height="24" VerticalAlignment="Center"
                                                            MouseLeftButtonDown="MiniOpacityOverlay_MouseLeftButtonDown"
                                                            MouseMove="MiniOpacityOverlay_MouseMove"
                                                            MouseLeftButtonUp="MiniOpacityOverlay_MouseLeftButtonUp" />
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingsRowStyle}" Visibility="{Binding Visibility, ElementName=MiniAlwaysOnTopCheckBox}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                                <TextBlock Text="Поверх всех окон (мини-плеер)">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsRowTitleStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEnabled, ElementName=MiniAlwaysOnTopCheckBox}" Value="False">
                                                                    <Setter Property="Opacity" Value="0.45" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource SettingsHelperTextStyle}" Margin="0,4,0,0" Text="Мини-плеер остаётся видимым, пока вы работаете в других приложениях." />
                                            </StackPanel>
                                            <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" x:Name="MiniAlwaysOnTopCheckBox" AutomationProperties.Name="Поверх всех окон (мини-плеер)"
                                            Checked="MiniAlwaysOnTopCheckBox_Changed" Unchecked="MiniAlwaysOnTopCheckBox_Changed" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingsRowStyle}" Visibility="{Binding Visibility, ElementName=GameOverlayAutoDetectCheckBox}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                                <TextBlock Text="Включать автоматически при обнаружении игры или оверлея">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsRowTitleStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEnabled, ElementName=GameOverlayAutoDetectCheckBox}" Value="False">
                                                                    <Setter Property="Opacity" Value="0.45" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource SettingsHelperTextStyle}" Margin="0,4,0,0" Text="Lumisense периодически проверяет, не развёрнута ли сейчас игра на весь экран и не запущен ли известный оверлей (RTSS, Xbox Game Bar, NVIDIA/AMD оверлей), и на время включает режим совместимости сам. Определение эвристическое и не гарантирует 100% точности — не задетектит игру в оконном режиме или незнакомый оверлей." />
                                            </StackPanel>
                                            <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" x:Name="GameOverlayAutoDetectCheckBox"
                                            AutomationProperties.Name="Включать автоматически при обнаружении игры или оверлея"
                                            Checked="GameOverlayAutoDetectCheckBox_Changed"
                                            Unchecked="GameOverlayAutoDetectCheckBox_Changed" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingsRowStyle}" Visibility="{Binding Visibility, ElementName=GameOverlayCompatibilityCheckBox}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                                <TextBlock Text="Держать включённым всегда">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsRowTitleStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEnabled, ElementName=GameOverlayCompatibilityCheckBox}" Value="False">
                                                                    <Setter Property="Opacity" Value="0.45" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource SettingsHelperTextStyle}" Margin="0,4,0,0" Text="Держит режим совместимости включённым постоянно, независимо от автоопределения выше — на случай, если игру или оверлей не удалось обнаружить автоматически. Не обязателен, если автоопределение справляется само." />
                                            </StackPanel>
                                            <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" x:Name="GameOverlayCompatibilityCheckBox"
                                            AutomationProperties.Name="Держать включённым всегда"
                                            Checked="GameOverlayCompatibilityCheckBox_Changed"
                                            Unchecked="GameOverlayCompatibilityCheckBox_Changed" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingsRowStyle}" Visibility="{Binding Visibility, ElementName=MiniPinnedCheckBox}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                                <TextBlock Text="Закрепить положение (запретить перетаскивание)">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsRowTitleStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEnabled, ElementName=MiniPinnedCheckBox}" Value="False">
                                                                    <Setter Property="Opacity" Value="0.45" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource SettingsHelperTextStyle}" Margin="0,4,0,0" Text="Защищает выбранную позицию мини-плеера при изменении режима экрана или запуске игры." />
                                            </StackPanel>
                                            <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" x:Name="MiniPinnedCheckBox" AutomationProperties.Name="Закрепить положение (запретить перетаскивание)"
                                            Checked="MiniPinnedCheckBox_Changed" Unchecked="MiniPinnedCheckBox_Changed" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingsRowStyle}" Visibility="{Binding Visibility, ElementName=MiniSnapToEdgesCheckBox}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                                <TextBlock Text="Прилипание к краям экрана">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsRowTitleStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEnabled, ElementName=MiniSnapToEdgesCheckBox}" Value="False">
                                                                    <Setter Property="Opacity" Value="0.45" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource SettingsHelperTextStyle}" Margin="0,4,0,0" Text="При перетаскивании мини-плеер выравнивается по ближайшему краю экрана." />
                                            </StackPanel>
                                            <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" x:Name="MiniSnapToEdgesCheckBox" AutomationProperties.Name="Прилипание к краям экрана"
                                            Checked="MiniSnapToEdgesCheckBox_Changed" Unchecked="MiniSnapToEdgesCheckBox_Changed" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Тот же механизм, что у пунктов меню трека (TrackContextMenuActions),
                             но для контекстного меню мини-плеера (ПКМ по мини-плееру). -->
                        <StackPanel Margin="0,0,0,24">
                            <TextBlock Text="Контекстное меню мини-плеера" Style="{StaticResource SettingsGroupTitleStyle}" />
                            <Border Style="{StaticResource SettingsGroupCardStyle}" Margin="0,0,0,0">
                                <StackPanel>
                                    <Border Style="{StaticResource SettingsRowStyle}" BorderThickness="0">
                                        <ui:Button Tag="Mini" Content="Порядок по умолчанию" Appearance="Secondary"
                                        HorizontalAlignment="Left" Margin="0,0,0,0"
                                        Click="ContextMenuOrderReset_Click" />
                                    </Border>
                                    <Border Style="{StaticResource SettingsRowStyle}" Visibility="{Binding Visibility, ElementName=MiniContextMenuActionsPanel}">
                                        <UniformGrid x:Name="MiniContextMenuActionsPanel" Columns="1" Margin="0,0,0,0">
                                            <Border Tag="Settings" Style="{StaticResource ReorderRowStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Style="{StaticResource ReorderGripStyle}" />
                                                    <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="0" x:Name="MiniContextSettingsCheckBox" Tag="Settings" Content="Настройки" Checked="MiniPlayerContextMenuActionCheckBox_Changed" Unchecked="MiniPlayerContextMenuActionCheckBox_Changed" />
                                                </Grid>
                                            </Border>
                                            <Border Tag="NowPlaying" Style="{StaticResource ReorderRowStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Style="{StaticResource ReorderGripStyle}" />
                                                    <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="0" x:Name="MiniContextNowPlayingCheckBox" Tag="NowPlaying" Content="Now Playing (полный экран)" Checked="MiniPlayerContextMenuActionCheckBox_Changed" Unchecked="MiniPlayerContextMenuActionCheckBox_Changed" />
                                                </Grid>
                                            </Border>
                                            <Border Tag="Pin" Style="{StaticResource ReorderRowStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Style="{StaticResource ReorderGripStyle}" />
                                                    <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="0" x:Name="MiniContextPinCheckBox" Tag="Pin" Content="Закрепить" Checked="MiniPlayerContextMenuActionCheckBox_Changed" Unchecked="MiniPlayerContextMenuActionCheckBox_Changed" />
                                                </Grid>
                                            </Border>
                                            <Border Tag="Topmost" Style="{StaticResource ReorderRowStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Style="{StaticResource ReorderGripStyle}" />
                                                    <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="0" x:Name="MiniContextTopmostCheckBox" Tag="Topmost" Content="Поверх окон" Checked="MiniPlayerContextMenuActionCheckBox_Changed" Unchecked="MiniPlayerContextMenuActionCheckBox_Changed" />
                                                </Grid>
                                            </Border>
                                            <Border Tag="OverlayCompatibility" Style="{StaticResource ReorderRowStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Style="{StaticResource ReorderGripStyle}" />
                                                    <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="0" x:Name="MiniContextOverlayCompatibilityCheckBox" Tag="OverlayCompatibility" Content="Совместимость с играми и оверлеем" Checked="MiniPlayerContextMenuActionCheckBox_Changed" Unchecked="MiniPlayerContextMenuActionCheckBox_Changed" />
                                                </Grid>
                                            </Border>
                                            <Border Tag="SecondaryButton" Style="{StaticResource ReorderRowStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Style="{StaticResource ReorderGripStyle}" />
                                                    <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="0" x:Name="MiniContextSecondaryButtonCheckBox" Tag="SecondaryButton" Content="Выбор второй кнопки" Checked="MiniPlayerContextMenuActionCheckBox_Changed" Unchecked="MiniPlayerContextMenuActionCheckBox_Changed" />
                                                </Grid>
                                            </Border>
                                            <Border Tag="PlaybackRate" Style="{StaticResource ReorderRowStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Style="{StaticResource ReorderGripStyle}" />
                                                    <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="0" x:Name="MiniContextPlaybackRateCheckBox" Tag="PlaybackRate" Content="Скорость" Checked="MiniPlayerContextMenuActionCheckBox_Changed" Unchecked="MiniPlayerContextMenuActionCheckBox_Changed" />
                                                </Grid>
                                            </Border>
                                            <Border Tag="Pitch" Style="{StaticResource ReorderRowStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Style="{StaticResource ReorderGripStyle}" />
                                                    <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="0" x:Name="MiniContextPitchCheckBox" Tag="Pitch" Content="Тон" Checked="MiniPlayerContextMenuActionCheckBox_Changed" Unchecked="MiniPlayerContextMenuActionCheckBox_Changed" />
                                                </Grid>
                                            </Border>
                                            <Border Tag="Opacity" Style="{StaticResource ReorderRowStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Style="{StaticResource ReorderGripStyle}" />
                                                    <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="0" x:Name="MiniContextOpacityCheckBox" Tag="Opacity" Content="Прозрачность" Checked="MiniPlayerContextMenuActionCheckBox_Changed" Unchecked="MiniPlayerContextMenuActionCheckBox_Changed" />
                                                </Grid>
                                            </Border>
                                            <Border Tag="SnapToEdges" Style="{StaticResource ReorderRowStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Style="{StaticResource ReorderGripStyle}" />
                                                    <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="0" x:Name="MiniContextSnapToEdgesCheckBox" Tag="SnapToEdges" Content="Прилипание к краям экрана" Checked="MiniPlayerContextMenuActionCheckBox_Changed" Unchecked="MiniPlayerContextMenuActionCheckBox_Changed" />
                                                </Grid>
                                            </Border>
                                            <Border Tag="ShowProgress" Style="{StaticResource ReorderRowStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Style="{StaticResource ReorderGripStyle}" />
                                                    <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="0" x:Name="MiniContextShowProgressCheckBox" Tag="ShowProgress" Content="Показывать полосу прогресса" Checked="MiniPlayerContextMenuActionCheckBox_Changed" Unchecked="MiniPlayerContextMenuActionCheckBox_Changed" />
                                                </Grid>
                                            </Border>
                                            <Border Tag="ShowArtworkProgress" Style="{StaticResource ReorderRowStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Style="{StaticResource ReorderGripStyle}" />
                                                    <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="0" x:Name="MiniContextShowArtworkProgressCheckBox" Tag="ShowArtworkProgress" Content="Прогресс вокруг обложки" Checked="MiniPlayerContextMenuActionCheckBox_Changed" Unchecked="MiniPlayerContextMenuActionCheckBox_Changed" />
                                                </Grid>
                                            </Border>
                                            <Border Tag="ArtworkStyle" Style="{StaticResource ReorderRowStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Style="{StaticResource ReorderGripStyle}" />
                                                    <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="0" x:Name="MiniContextArtworkStyleCheckBox" Tag="ArtworkStyle" Content="Отображение обложки" Checked="MiniPlayerContextMenuActionCheckBox_Changed" Unchecked="MiniPlayerContextMenuActionCheckBox_Changed" />
                                                </Grid>
                                            </Border>
                                            <Border Tag="ButtonsLayout" Style="{StaticResource ReorderRowStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Style="{StaticResource ReorderGripStyle}" />
                                                    <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="0" x:Name="MiniContextButtonsLayoutCheckBox" Tag="ButtonsLayout" Content="Расположение кнопок" Checked="MiniPlayerContextMenuActionCheckBox_Changed" Unchecked="MiniPlayerContextMenuActionCheckBox_Changed" />
                                                </Grid>
                                            </Border>
                                        </UniformGrid>
                                    </Border>
                                    <Border Padding="20,0,20,14">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SettingsHelperTextStyle}" Margin="0,0,0,6" Text="Отключенные пункты не показываются по ПКМ на мини-плеере." />
                                            <TextBlock Style="{StaticResource SettingsHelperTextStyle}" Margin="0,0,0,6" Text="Чтобы изменить порядок, перетаскивайте пункты за значок ⋮⋮ слева." />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- В компактном мини-плеере места хватает лишь на одну "вторую" кнопку: здесь выбираем её функцию из трёх
                             (AppSettings.MiniPlayerSecondaryButton, MiniPlayerWindow.UpdateSecondaryButton). -->
                        <StackPanel Margin="0,0,0,24">
                            <Border Style="{StaticResource SettingsGroupCardStyle}" Margin="0,0,0,0">
                                <StackPanel>
                                    <Border Style="{StaticResource SettingsRowStyle}" BorderThickness="0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                                <TextBlock Text="Вторая кнопка в мини-плеере">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsRowTitleStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEnabled, ElementName=MiniSecondaryButtonRadioCombo}" Value="False">
                                                                    <Setter Property="Opacity" Value="0.45" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel x:Name="MiniSecondaryButtonRadioGroup" Grid.Column="1" VerticalAlignment="Center">
                                                <ComboBox x:Name="MiniSecondaryButtonRadioCombo" Tag="RadioGroup" AutomationProperties.Name="Вторая кнопка в мини-плеере" MinWidth="220" HorizontalAlignment="Right">
                                                    <ComboBoxItem Content="Повтор" Tag="MiniSecondaryRepeatRadio" />
                                                    <ComboBoxItem Content="Перемешать" Tag="MiniSecondaryShuffleRadio" />
                                                    <ComboBoxItem Content="Избранное" Tag="MiniSecondaryFavoriteRadio" />
                                                </ComboBox>
                                                <StackPanel Visibility="Collapsed">
                                                    <RadioButton x:Name="MiniSecondaryRepeatRadio" Content="Повтор" GroupName="MiniSecondaryButton"
                                                    Checked="MiniSecondaryButtonRadio_Changed" />
                                                    <RadioButton x:Name="MiniSecondaryShuffleRadio" Content="Перемешать" GroupName="MiniSecondaryButton"
                                                    Checked="MiniSecondaryButtonRadio_Changed" />
                                                    <RadioButton x:Name="MiniSecondaryFavoriteRadio" Content="Избранное" GroupName="MiniSecondaryButton"
                                                    Checked="MiniSecondaryButtonRadio_Changed" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Padding="20,0,20,14">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SettingsHelperTextStyle}" Margin="0,0,0,6" Text="Выберите действие дополнительной кнопки рядом с основными элементами управления." />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- См. AppSettings.MiniPlayerButtonsLayout и MiniPlayerWindow.ApplyButtonsLayoutMode
                             за подробностями, чем отличаются режимы. -->
                        <StackPanel Margin="0,0,0,24">
                            <Border Style="{StaticResource SettingsGroupCardStyle}" Margin="0,0,0,0">
                                <StackPanel>
                                    <Border Style="{StaticResource SettingsRowStyle}" BorderThickness="0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                                <TextBlock Text="Расположение кнопок управления">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsRowTitleStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEnabled, ElementName=MiniButtonsLayoutRadioCombo}" Value="False">
                                                                    <Setter Property="Opacity" Value="0.45" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
