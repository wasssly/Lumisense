                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8"
                                        Background="{DynamicResource ControlStrongFillColorDefaultBrush}"
                                        Margin="0,0,12,0">
                                    <local:SvgPathIcon Icon="IconCheckmark" Size="16"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="CheckUpdatesButtonTitle" Text="Проверить обновления" FontWeight="SemiBold" />
                                    <TextBlock x:Name="CheckUpdatesButtonSubtitle" Text="Сверить версию с GitHub" FontSize="12" Opacity="0.6" />
                                </StackPanel>
                            </Grid>
                        </ui:Button>

                        <Expander x:Name="VelopackBasePackageExpander" Style="{StaticResource FluentExpanderStyle}"
                                  HorizontalAlignment="Stretch" Margin="0,14,0,0" Visibility="Collapsed">
                            <Expander.Header>
                                <TextBlock x:Name="VelopackBasePackageTitleText" Text="Подготовить компактные обновления"
                                           Style="{StaticResource SettingsSectionTitleStyle}" Margin="0" />
                            </Expander.Header>
                            <StackPanel>
                                <TextBlock x:Name="VelopackBasePackageDescriptionText"
                                           Text="Добровольно скачайте полный пакет текущей MSI-версии один раз. Он станет локальной базой, и следующие совместимые обновления смогут использовать значительно меньшие delta-пакеты. Плеер не будет обновлён или перезапущен."
                                           TextWrapping="Wrap" FontSize="12" Opacity="0.6" Margin="0,0,0,12" />
                                <ui:Button x:Name="PrepareVelopackBasePackageButton" Appearance="Secondary"
                                           HorizontalAlignment="Left" Padding="12,8"
                                           Click="PrepareVelopackBasePackageButton_Click">
                                    <TextBlock x:Name="PrepareVelopackBasePackageButtonText" Text="Скачать базовый пакет" />
                                </ui:Button>
                                <TextBlock x:Name="VelopackBasePackageStatusText" Margin="0,10,0,0"
                                           FontSize="12" Opacity="0.78" TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander>

                        <Expander x:Name="LegacyInnoCleanupExpander" Style="{StaticResource FluentExpanderStyle}"
                                  HorizontalAlignment="Stretch" Margin="0,14,0,0" Visibility="Collapsed">
                            <Expander.Header>
                                <TextBlock x:Name="LegacyInnoCleanupTitleText" Text="Удалить старую EXE-копию"
                                           Style="{StaticResource SettingsSectionTitleStyle}" Margin="0" />
                            </Expander.Header>
                            <StackPanel>
                                <TextBlock x:Name="LegacyInnoCleanupDescriptionText"
                                           Text="Удалите прежнюю Inno Setup-установку после перехода на MSI. В мастере удаления выберите «Нет» при вопросе об удалении пользовательских данных."
                                           TextWrapping="Wrap" FontSize="12" Opacity="0.6" Margin="0,0,0,12" />
                                <ui:Button x:Name="RemoveLegacyInnoButton" Appearance="Secondary"
                                           HorizontalAlignment="Left" Padding="12,8"
                                           Click="RemoveLegacyInnoButton_Click">
                                    <TextBlock x:Name="RemoveLegacyInnoButtonText" Text="Открыть мастер удаления" />
                                </ui:Button>
                                <TextBlock x:Name="LegacyInnoCleanupStatusText" Margin="0,10,0,0"
                                           FontSize="12" Opacity="0.78" TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander>

                        <!-- "Источник загрузки обновлений" — аккордеон, свёрнут по умолчанию
                             (IsExpanded не задан → false): выбор зеркала — не то, что нужно
                             видеть/трогать большинству, кому GitHub и так доступен напрямую. -->
                        <Expander Style="{StaticResource FluentExpanderStyle}" HorizontalAlignment="Stretch" Margin="0,20,0,0">
                            <Expander.Header>
                                <TextBlock Text="Источник загрузки обновлений" Style="{StaticResource SettingsSectionTitleStyle}" Margin="0" />
                            </Expander.Header>
                            <StackPanel>
                                <TextBlock Text="Откуда скачивать обновление. По умолчанию — напрямую с GitHub; если он у вас недоступен или скачивается очень медленно, можно выбрать одно из перечисленных зеркал. На саму проверку версии эта настройка не влияет."
                                           TextWrapping="Wrap" FontSize="12" Opacity="0.6" Margin="0,0,0,12" />

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <RadioButton x:Name="UpdateSourceGitHubRadio" Grid.Column="0" GroupName="UpdateSource" Tag="GitHub"
                                                 Content="GitHub (напрямую)" Checked="UpdateSourceRadio_Checked" />
                                    <TextBlock x:Name="UpdateSourceGitHubProbeText" Grid.Column="1" VerticalAlignment="Center"
                                               FontSize="12" FontWeight="SemiBold" Visibility="Collapsed" />
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <RadioButton x:Name="UpdateSourceGhProxyRadio" Grid.Column="0" GroupName="UpdateSource" Tag="GhProxy"
                                                 Content="gh-proxy.org (зеркало)" Checked="UpdateSourceRadio_Checked" />
                                    <TextBlock x:Name="UpdateSourceGhProxyProbeText" Grid.Column="1" VerticalAlignment="Center"
                                               FontSize="12" FontWeight="SemiBold" Visibility="Collapsed" />
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <RadioButton x:Name="UpdateSourceGhProxyV4Radio" Grid.Column="0" GroupName="UpdateSource" Tag="GhProxyV4"
                                                 Content="v4.gh-proxy.org (зеркало, только IPv4)" Checked="UpdateSourceRadio_Checked" />
                                    <TextBlock x:Name="UpdateSourceGhProxyV4ProbeText" Grid.Column="1" VerticalAlignment="Center"
                                               FontSize="12" FontWeight="SemiBold" Visibility="Collapsed" />
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <RadioButton x:Name="UpdateSourceGhProxyV6Radio" Grid.Column="0" GroupName="UpdateSource" Tag="GhProxyV6"
                                                 Content="v6.gh-proxy.org (зеркало, только IPv6)" Checked="UpdateSourceRadio_Checked" />
                                    <TextBlock x:Name="UpdateSourceGhProxyV6ProbeText" Grid.Column="1" VerticalAlignment="Center"
                                               FontSize="12" FontWeight="SemiBold" Visibility="Collapsed" />
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <RadioButton x:Name="UpdateSourceGhProxyCdnRadio" Grid.Column="0" GroupName="UpdateSource" Tag="GhProxyCdn"
                                                 Content="cdn.gh-proxy.org (зеркало, через CDN)" Checked="UpdateSourceRadio_Checked" />
                                    <TextBlock x:Name="UpdateSourceGhProxyCdnProbeText" Grid.Column="1" VerticalAlignment="Center"
                                               FontSize="12" FontWeight="SemiBold" Visibility="Collapsed" />
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <RadioButton x:Name="UpdateSourceGhProxyComRadio" Grid.Column="0" GroupName="UpdateSource" Tag="GhProxyCom"
                                                 Content="gh-proxy.com (зеркало)" Checked="UpdateSourceRadio_Checked" />
                                    <TextBlock x:Name="UpdateSourceGhProxyComProbeText" Grid.Column="1" VerticalAlignment="Center"
                                               FontSize="12" FontWeight="SemiBold" Visibility="Collapsed" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <RadioButton x:Name="UpdateSourceGhFastRadio" Grid.Column="0" GroupName="UpdateSource" Tag="GhFast"
                                                 Content="ghfast.top (зеркало)" Checked="UpdateSourceRadio_Checked" />
                                    <TextBlock x:Name="UpdateSourceGhFastProbeText" Grid.Column="1" VerticalAlignment="Center"
                                               FontSize="12" FontWeight="SemiBold" Visibility="Collapsed" />
                                </Grid>

                                <ui:Button x:Name="ProbeUpdateSourcesButton" Appearance="Secondary" Margin="0,16,0,0"
                                           HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                           Padding="12,10" Click="ProbeUpdateSourcesButton_Click">
                                    <StackPanel>
                                        <TextBlock x:Name="ProbeUpdateSourcesTitleText" Text="Проверить зеркала" FontWeight="SemiBold" />
                                        <TextBlock x:Name="ProbeUpdateSourcesSubtitleText"
                                                   Text="Измерить отклик и скорость небольшого безопасного фрагмента release-файла"
                                                   FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:Button>
                                <TextBlock x:Name="UpdateSourceProbeStatusText" Margin="0,10,0,0"
                                           FontSize="12" Opacity="0.78" TextWrapping="Wrap"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </Expander>

                        <!-- "Все версии" — список всех релизов с GitHub, каждый со своей кнопкой
                             "Установить": можно поставить не только последнюю версию, но и любую
                             предыдущую (откатиться) или любую вышедшую (например, пропущенный
                             пререлиз). Раскрыт по умолчанию (IsExpanded="True") — список всё
                             равно подгружается по тому же самому событию Expanded, что и раньше
                             при ручном раскрытии, но раз аккордеон открыт сразу, загрузка
                             стартует сразу при открытии страницы "Обновления", а не по клику. -->
                        <Expander x:Name="AllVersionsExpanderControl" Style="{StaticResource FluentExpanderStyle}" HorizontalAlignment="Stretch"
                                  Margin="0,14,0,0" IsExpanded="True" Expanded="AllVersionsExpander_Expanded">
                            <Expander.Header>
                                <TextBlock Text="Все версии" Style="{StaticResource SettingsSectionTitleStyle}" Margin="0" />
                            </Expander.Header>
                            <StackPanel>
                                <TextBlock Text="Полный список версий плеера с GitHub — можно поставить не только последнюю, но и любую другую, в том числе более старую."
                                           TextWrapping="Wrap" FontSize="12" Opacity="0.6" Margin="0,0,0,12" />

                                <TextBlock x:Name="AllVersionsLoadingText" Text="Загружаем список версий…"
                                           FontSize="12" Opacity="0.6" />
                                <TextBlock x:Name="AllVersionsErrorText" Text="" Visibility="Collapsed"
                                           TextWrapping="Wrap" FontSize="12" Opacity="0.6" />

                                <ItemsControl x:Name="AllVersionsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                    CornerRadius="8" Padding="12,10" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding TitleText}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding SubtitleText}" FontSize="11" Opacity="0.6" Margin="0,2,0,0" TextWrapping="Wrap" />
                                                    </StackPanel>

                                                    <ui:Button Grid.Column="1" Content="{Binding ActionText}" Appearance="Secondary"
                                                               IsEnabled="{Binding CanInstall}" Padding="12,6" VerticalAlignment="Center"
                                                               Click="VersionListItem_Click" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>
                    </StackPanel>

                    <!-- О плеере (+ Патчноуты) -->
                    <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                        <TextBlock Text="О плеере" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="Сведения о приложении, разработчике и диагностике." Style="{StaticResource PageDescriptionStyle}" />

                        <!-- 1. Описание приложения — без изменений -->
                        <Border Style="{StaticResource SettingsCardStyle}" x:Name="AboutInfoCard">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Image Grid.Column="0" Source="/Icons/app/lumisense.png" Width="44" Height="44"
                                           Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                           Margin="0,0,12,0" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Lumisense" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock x:Name="AppVersionText" Text="Версия" Opacity="0.6" FontSize="12" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Lumisense — настраиваемый аудиоплеер для Windows 11 в стиле Fluent Design. Он помогает удобно управлять музыкальной библиотекой, настраивать звучание и адаптировать интерфейс под себя — от мини-плеера и горячих клавиш до темы, зависящей от текущей обложки."
                                           TextWrapping="Wrap" Opacity="0.85" Margin="0,12,0,12" />

                                <TextBlock Text="Собрано на .NET 8, WPF-UI и NAudio." TextWrapping="Wrap"
                                           FontSize="12" Opacity="0.6" />
                            </StackPanel>
                        </Border>

                        <!-- 2. Разработчик — компактная карточка (аватар, ник, иконки-ссылки),
                             раньше был аккордеон с двумя большими кнопками-строками; см.
                             SettingsWindow.LoadDeveloperAvatar/DeveloperGitHubButton_Click. -->
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- ImageBrush на Background, а не дочерний Image — у Border с
                                     CornerRadius скругляются края только СОБСТВЕННОЙ заливки
                                     (Background/BorderBrush), ClipToBounds на дочерних элементах
                                     клипует лишь по прямоугольным границам, а не по скруглённой
                                     геометрии. Дочерний Image поверх такого Border выглядел
                                     обычным квадратом, торчащим из-под скруглённых углов. -->
                                <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24" Margin="0,0,12,0">
                                    <Border.Background>
                                        <ImageBrush x:Name="DeveloperAvatarBrush" Stretch="UniformToFill"
                                                    ImageSource="/Icons/app/developer-avatar-placeholder.png" />
                                    </Border.Background>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Разработчик" FontSize="12" Opacity="0.6" />
                                    <TextBlock Text="wasssly" FontWeight="SemiBold" FontSize="15" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Padding="0" обязателен — без него внутренний отступ
                                         кнопки (рассчитанный на кнопки с текстом) съедал часть
                                         площади под иконку при таком небольшом фиксированном
                                         размере кнопки, и иконка визуально обрезалась о край.
                                         Тот же приём уже используется у TrackFavoriteButton/
                                         TrackPinButton в MainWindow.xaml. -->
                                    <ui:Button x:Name="DeveloperGitHubButton" Appearance="Secondary"
                                               Width="40" Height="40" Padding="0" Margin="0,0,8,0"
                                               Click="DeveloperGitHubButton_Click" ToolTip="github.com/wasssly">
                                        <ui:Button.Icon>
                                            <local:SvgPathIcon Icon="IconGitHub" Size="21" />
                                        </ui:Button.Icon>
                                    </ui:Button>
                                    <ui:Button x:Name="DeveloperTelegramButton" Appearance="Secondary"
                                               Width="40" Height="40" Padding="0"
                                               Click="DeveloperTelegramButton_Click" ToolTip="t.me/dontwritetoblame">
                                        <ui:Button.Icon>
                                            <local:SvgPathIcon Icon="IconTelegram" Size="21" />
                                        </ui:Button.Icon>
                                    </ui:Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Логи — см. Logger.cs. Диагностика на случай сбоев/падений: файл на
                             сессию в %AppData%\Lumisense\logs, кнопка ниже просто открывает эту
                             папку в Проводнике, чтобы её было легко найти и приложить куда-нибудь
                             при сообщении о проблеме. -->
                        <ui:Button x:Name="OpenLogsButton" Appearance="Secondary"
                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                   Padding="16,14" Margin="0,14,0,0" Click="OpenLogsButton_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8"
                                        Background="{DynamicResource ControlStrongFillColorDefaultBrush}"
                                        Margin="0,0,12,0">
                                    <local:SvgPathIcon Icon="IconWrench" Size="16"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Открыть папку с логами" FontWeight="SemiBold" />
                                    <TextBlock Text="Пригодится, если плеер упал или повёл себя странно" FontSize="12" Opacity="0.6" />
                                </StackPanel>
                            </Grid>
                        </ui:Button>

                        <ui:Button x:Name="OpenRepositoryButton" Appearance="Secondary"
                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                   Padding="16,14" Margin="0,14,0,0" Click="OpenRepositoryButton_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8"
                                        Background="{DynamicResource ControlStrongFillColorDefaultBrush}"
                                        Margin="0,0,12,0">
                                    <local:SvgPathIcon Icon="IconGitHub" Size="16"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Открытый исходный код" FontWeight="SemiBold" />
                                    <TextBlock Text="Открыть репозиторий Lumisense на GitHub" FontSize="12" Opacity="0.6" />
                                </StackPanel>
                            </Grid>
                        </ui:Button>

                        <!-- 3. "Список изменений" — в самом низу страницы -->
                        <TextBlock Text="Список изменений" FontSize="14" FontWeight="SemiBold" Margin="4,20,0,10" />

                        <ui:Button x:Name="ChangelogButton" Appearance="Secondary"
                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                   Padding="16,14" Click="ChangelogButton_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8"
                                        Background="{DynamicResource ControlStrongFillColorDefaultBrush}"
                                        Margin="0,0,12,0">
                                    <local:SvgPathIcon Icon="IconInfo" Size="16"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Список изменений" FontWeight="SemiBold" />
                                    <TextBlock Text="Что нового в текущей версии" FontSize="12" Opacity="0.6" />
                                </StackPanel>
                            </Grid>
                        </ui:Button>
                    </StackPanel>

                    </Grid>
                </ScrollViewer>
            </Border>

        </Grid>
    </Grid>
</ui:FluentWindow>
