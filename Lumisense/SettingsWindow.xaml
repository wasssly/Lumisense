                                                                  Checked="AnimationAreaCheckBox_Changed" Unchecked="AnimationAreaCheckBox_Changed" />
                                                        <CheckBox Tag="Cover" Content="Смена и сворачивание обложки"
                                                                  Checked="AnimationAreaCheckBox_Changed" Unchecked="AnimationAreaCheckBox_Changed" />
                                                        <CheckBox Tag="Lyrics" Content="Текст песни: прокрутка и подсветка строк"
                                                                  Checked="AnimationAreaCheckBox_Changed" Unchecked="AnimationAreaCheckBox_Changed" />
                                                        <CheckBox Tag="Progress" Content="Полоса воспроизведения"
                                                                  Checked="AnimationAreaCheckBox_Changed" Unchecked="AnimationAreaCheckBox_Changed" />
                                                        <CheckBox x:Name="AnimationNowPlayingCheckBox" Tag="NowPlaying" Content="Now Playing: фон и переходы"
                                                                  Checked="AnimationAreaCheckBox_Changed" Unchecked="AnimationAreaCheckBox_Changed" />
                                                        <CheckBox Tag="MiniPlayer" Content="Мини-плеер: бегущая строка"
                                                                  Checked="AnimationAreaCheckBox_Changed" Unchecked="AnimationAreaCheckBox_Changed" />
                                                        <CheckBox x:Name="AnimationIslandCheckBox" Tag="Island" Content="Остров"
                                                                  Checked="AnimationAreaCheckBox_Changed" Unchecked="AnimationAreaCheckBox_Changed" />
                                                        <CheckBox Tag="Tray" Content="Меню трея"
                                                                  Checked="AnimationAreaCheckBox_Changed" Unchecked="AnimationAreaCheckBox_Changed" />
                                                        <CheckBox Tag="Heart" Content="Анимация сердечка"
                                                                  Checked="AnimationAreaCheckBox_Changed" Unchecked="AnimationAreaCheckBox_Changed" />
                                                        <CheckBox Tag="Loading" Content="Индикаторы загрузки"
                                                                  Checked="AnimationAreaCheckBox_Changed" Unchecked="AnimationAreaCheckBox_Changed" />
                                                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- См. AppSettings.WindowBackdropType. На Windows 10 карточка скрыта (WindowBackdropOptions.IsSelectionSupportedNow). -->
                        <StackPanel x:Name="BackdropCard" Margin="0,0,0,24">
                            <Border Style="{StaticResource SettingsGroupCardStyle}" Margin="0,0,0,16">
                                <StackPanel>
                                    <Border Style="{StaticResource SettingsRowStyle}" BorderThickness="0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
