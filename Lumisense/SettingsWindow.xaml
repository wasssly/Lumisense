<ui:FluentWindow x:Class="AudioPlayer.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:AudioPlayer"
        Title="Настройки"
        Icon="/Icons/app/lumisense-settings.ico"
        Height="860" Width="1180"
        MinHeight="680" MinWidth="980"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="Manual"
        ResizeMode="CanResize"
        PreviewKeyDown="SettingsWindow_PreviewKeyDown">

    <ui:FluentWindow.Resources>

        <!-- Подписи CheckBox/RadioButton всегда переносятся по доступной ширине. Это исключает
             выход длинного текста за границы карточки на узком окне и в английской локализации. -->
        <DataTemplate x:Key="SettingsChoiceContentTemplate">
            <TextBlock Text="{Binding}" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DataTemplate>

        <!-- Явные шаблоны контролов выбора. Они читают кисти как DynamicResource, поэтому
             цвет индикатора обновляется сразу после смены cover-акцента. -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Box" Width="20" Height="20" CornerRadius="4"
                                    BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    Background="Transparent" VerticalAlignment="Center">
                                <Grid>
                                    <Border x:Name="AccentFill" CornerRadius="3"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                                            Opacity="0" RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="0.82" ScaleY="0.82" />
                                        </Border.RenderTransform>
                                    </Border>
                                    <Path x:Name="Mark" Data="M 4,10 L 8,14 L 16,5" StrokeThickness="2"
                                          Width="12" Height="12" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Stroke="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                          Opacity="0" RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform>
                                            <ScaleTransform ScaleX="0.55" ScaleY="0.55" />
                                        </Path.RenderTransform>
                                    </Path>
                                </Grid>
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                              ContentTemplate="{StaticResource SettingsChoiceContentTemplate}"
                                              RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="AccentFill" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.18"
                                                             AccelerationRatio="0.12" DecelerationRatio="0.72" />
                                            <DoubleAnimation Storyboard.TargetName="AccentFill"
                                                             Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                             To="1" Duration="0:0:0.18"
                                                             AccelerationRatio="0.12" DecelerationRatio="0.72" />
                                            <DoubleAnimation Storyboard.TargetName="AccentFill"
                                                             Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                             To="1" Duration="0:0:0.18"
                                                             AccelerationRatio="0.12" DecelerationRatio="0.72" />
                                            <DoubleAnimation Storyboard.TargetName="Mark" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.16"
                                                             AccelerationRatio="0.08" DecelerationRatio="0.78" />
                                            <DoubleAnimation Storyboard.TargetName="Mark"
                                                             Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                             To="1" Duration="0:0:0.16"
                                                             AccelerationRatio="0.08" DecelerationRatio="0.78" />
                                            <DoubleAnimation Storyboard.TargetName="Mark"
                                                             Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                             To="1" Duration="0:0:0.16"
                                                             AccelerationRatio="0.08" DecelerationRatio="0.78" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="AccentFill" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="AccentFill"
                                                             Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                             To="0.82" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="AccentFill"
                                                             Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                             To="0.82" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="Mark" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="Mark"
                                                             Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                             To="0.55" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="Mark"
                                                             Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                             To="0.55" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <!-- Прозрачный Border формирует единую hit-test область. Внутренние
                             декоративные элементы не перехватывают PointerDown, поэтому клик
                             по кругу и по подписи гарантированно доходит до RadioButton. -->
                        <Border Background="Transparent">
                            <Grid SnapsToDevicePixels="True" IsHitTestVisible="False">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="20" Height="20" VerticalAlignment="Center">
                                    <Ellipse x:Name="Ring" StrokeThickness="1"
                                             Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                    <!-- Почти замкнутая дуга: длина штриха равна окружности,
                                         поэтому сдвиг StrokeDashOffset визуально дорисовывает
                                         акцентную обводку по кругу. -->
                                    <Path x:Name="DrawRing" Data="M 10,1 A 9,9 0 1 1 9.99,1"
                                          Stroke="{DynamicResource AccentFillColorDefaultBrush}"
                                          Opacity="0" StrokeThickness="2" StrokeDashArray="28.3,100"
                                          StrokeDashOffset="28.3" StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" />
                                    <Ellipse x:Name="Dot" Width="10" Height="10"
                                             Fill="{DynamicResource AccentFillColorDefaultBrush}"
                                             Opacity="0" />
                                </Grid>
                                <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                                  ContentTemplate="{StaticResource SettingsChoiceContentTemplate}"
                                                  RecognizesAccessKey="True" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Обводка: акцентный контур дорисовывается по окружности,
                                 затем появляется центральная точка. -->
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <!-- Явно возвращаем непрозрачность после предыдущего
                                                 снятия выбора, прежде чем начнётся прорисовка. -->
                                            <DoubleAnimation Storyboard.TargetName="DrawRing" Storyboard.TargetProperty="Opacity"
                                                             From="1" To="1" Duration="0:0:0.24" />
                                            <DoubleAnimation Storyboard.TargetName="DrawRing" Storyboard.TargetProperty="StrokeDashOffset"
                                                             From="28.3" To="0" Duration="0:0:0.24"
                                                             AccelerationRatio="0.08" DecelerationRatio="0.72" />
                                            <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.10" BeginTime="0:0:0.13"
                                                             AccelerationRatio="0.12" DecelerationRatio="0.72" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="DrawRing" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.14"
                                                             AccelerationRatio="0.12" DecelerationRatio="0.72" />
                                            <DoubleAnimation Storyboard.TargetName="DrawRing" Storyboard.TargetProperty="StrokeDashOffset"
                                                             To="28.3" Duration="0:0:0.01" BeginTime="0:0:0.14" />
                                            <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.10" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TransparentSliderRepeatButtonStyle" TargetType="RepeatButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentSliderDecreaseRepeatButtonStyle" TargetType="RepeatButton" BasedOn="{StaticResource TransparentSliderRepeatButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <!-- Старт заполнения — та же полукапсула радиуса 2,5 DIP, что и
                             внешний конец фоновой дорожки. У Thumb край остаётся прямым. -->
                        <Border Height="5" CornerRadius="2.5,0,0,2.5" Background="{DynamicResource AccentFillColorDefaultBrush}"
                                HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                SnapsToDevicePixels="True" UseLayoutRounding="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsAccentSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="28" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Margin="0,5" SnapsToDevicePixels="True">
                            <Border Height="5" CornerRadius="2.5" Background="{DynamicResource ControlFillColorTertiaryBrush}"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Center" IsHitTestVisible="False"
                                    SnapsToDevicePixels="True" UseLayoutRounding="True" />
                                <Track x:Name="PART_Track" VerticalAlignment="Center" Orientation="{TemplateBinding Orientation}"
                                       SnapsToDevicePixels="True" UseLayoutRounding="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource AccentSliderDecreaseRepeatButtonStyle}"
                                                  Command="Slider.DecreaseLarge" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14" SnapsToDevicePixels="True" UseLayoutRounding="True">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{DynamicResource AccentFillColorDefaultBrush}"
                                                         Stroke="{DynamicResource TextOnAccentFillColorPrimaryBrush}" StrokeThickness="1" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource TransparentSliderRepeatButtonStyle}"
                                                  Command="Slider.IncreaseLarge" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                            <!-- Overlay расположен после Track, поэтому точки видны и поверх
                                 акцентной части дорожки, но активный шаг остаётся за Thumb. -->
                            <local:SliderMilestoneOverlay x:Name="PART_MilestoneOverlay"
                                                          MarkerBrush="{DynamicResource TextFillColorSecondaryBrush}"
                                                          Opacity="0.88" IsHitTestVisible="False"
                                                          SnapsToDevicePixels="True" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Вертикальный вариант эталонного слайдера: та же 5 DIP дорожка, 14 DIP Thumb
             и спокойная палитра, но с заполнением от нижней (минимальной) точки к Thumb. -->
        <Style x:Key="SettingsEqualizerSliderStyle" TargetType="Slider">
            <Setter Property="Width" Value="28" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Margin="5,0" SnapsToDevicePixels="True" UseLayoutRounding="True">
                            <Border Width="5" CornerRadius="2.5"
                                    Background="{DynamicResource ControlFillColorTertiaryBrush}"
                                    HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                    IsHitTestVisible="False" SnapsToDevicePixels="True"
                                    UseLayoutRounding="True" />
                            <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}"
                                   IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                   SnapsToDevicePixels="True" UseLayoutRounding="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Background="Transparent" BorderThickness="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <!-- Внешнее (нижнее) начало заполнения округлено;
                                                     граница у Thumb прямая и визуально чистая. -->
                                                <Border Width="5" CornerRadius="0,0,2.5,2.5"
                                                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                        HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                                        SnapsToDevicePixels="True" UseLayoutRounding="True" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14" Cursor="Hand"
                                           SnapsToDevicePixels="True" UseLayoutRounding="True">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{DynamicResource AccentFillColorDefaultBrush}"
                                                         Stroke="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                                         StrokeThickness="1" SnapsToDevicePixels="True" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Background="Transparent" BorderThickness="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Вертикальная навигация нового окна: активный раздел получает отдельную
             акцентную полосу и поверхность, но остаётся спокойным для длинного списка. -->
        <Style x:Key="NavItemStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" CornerRadius="10" Background="Transparent" Padding="0">
                            <Grid Height="38">
                                <Border x:Name="Indicator" Width="3" CornerRadius="2"
                                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                                        HorizontalAlignment="Left" Margin="6,7,0,7" Opacity="0" />
                                <ContentPresenter Margin="15,0,10,0" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                <Setter TargetName="Indicator" Property="Opacity" Value="1" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="10,14,10,5" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>

        <!-- Карточка-превью вида плеера в настройках: RadioButton с картинкой-миниатюрой
             внутри, подсвечивается акцентной рамкой, когда выбран (см. PageWindow /
             PlayerViewModeCard). -->
        <Style x:Key="ViewModeThumbStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" CornerRadius="10" BorderThickness="2"
                                BorderBrush="Transparent" Padding="8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush"
                                        Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Карточка-секция настроек: единый спокойный фон, тонкая обводка и увеличенная
             внутренняя сетка делают длинные страницы легче для сканирования. -->
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="28,24" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>

        <!-- Заголовок и подзаголовок формируют устойчивую иерархию каждой страницы. -->
        <Style x:Key="PageTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="PageDescriptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,30" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <!-- Первый уровень внутри карточки — название группы параметров; второй — краткое
             пояснение. Это отделяет подписи от самих вариантов выбора. -->
        <Style x:Key="SettingsSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="SettingsFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,18,0,8" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="SettingsHelperTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <!-- Строка результата поиска настроек: прозрачная кнопка на всю ширину со скруглённой
             подсветкой при наведении, как у пунктов навигации -->
        <Style x:Key="SearchResultItemStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="8" Background="{TemplateBinding Background}">
                            <ContentPresenter Margin="12,9" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Заголовок окна (Fluent TitleBar) — та же стандартная раскладка кнопок
             свернуть/развернуть/закрыть, что и в главном окне (см. MainWindow.xaml,
             AppTitleBar): ShowMaximize="True", раз окно и так уже CanResize. -->
        <ui:TitleBar Grid.Row="0" Title="Настройки" ShowMaximize="True" />

        <Grid Grid.Row="1" Background="{DynamicResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== Навигация: отдельная скруглённая поверхность ===== -->
            <Border Grid.Column="0" Margin="14,14,0,16" Padding="10"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="1,1,1,8">
                        <TextBlock Text="НАСТРОЙКИ" FontSize="9" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="Lumisense" FontSize="14" FontWeight="SemiBold"
                                   Margin="0,2,0,8" />
                        <ui:TextBox x:Name="SettingsSearchBox"
                                PlaceholderText="Поиск настроек"
                                ClearButtonEnabled="True"
                                TextChanged="SettingsSearchBox_TextChanged">
                            <ui:TextBox.Icon>
                                <local:SvgPathIcon Icon="IconSearch" />
                            </ui:TextBox.Icon>
                        </ui:TextBox>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Padding="0,0,12,0">
                        <StackPanel x:Name="NavCategoriesPanel" Margin="0,0,2,8">

                    <TextBlock Text="ОСНОВНОЕ" Style="{StaticResource NavSectionTitleStyle}" />

                    <RadioButton x:Name="NavAppearance" Style="{StaticResource NavItemStyle}"
                                 GroupName="SettingsNav" Tag="Appearance"
                                 Checked="NavItem_Checked">
                        <StackPanel Orientation="Horizontal">
                            <local:SvgPathIcon Icon="IconSun" Size="18" VerticalAlignment="Center" />
                            <TextBlock Text="Оформление" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavWindow" Style="{StaticResource NavItemStyle}"
                                 GroupName="SettingsNav" Tag="Window" Checked="NavItem_Checked">
                        <StackPanel Orientation="Horizontal">
                            <local:SvgPathIcon Icon="IconWindow" Size="18" VerticalAlignment="Center" />
                            <TextBlock Text="Окно и запуск" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <TextBlock Text="ЗВУК И ВОСПРОИЗВЕДЕНИЕ" Style="{StaticResource NavSectionTitleStyle}" />

                    <RadioButton x:Name="NavPlayback" Style="{StaticResource NavItemStyle}"
                                 GroupName="SettingsNav" Tag="Playback" Checked="NavItem_Checked">
                        <StackPanel Orientation="Horizontal">
                            <local:SvgPathIcon Icon="IconPlay" Size="16" VerticalAlignment="Center" />
                            <TextBlock Text="Воспроизведение" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <!-- Интеграции вынесены отдельно: Discord не относится к аудиообработке,
                         а объединяет подключение внешнего сервиса, приватность и диагностику. -->
                    <RadioButton x:Name="NavIntegrations" Style="{StaticResource NavItemStyle}"
                                 GroupName="SettingsNav" Tag="Integrations" Checked="NavItem_Checked">
                        <StackPanel Orientation="Horizontal">
                            <local:SvgPathIcon Icon="IconWrench" Size="18" VerticalAlignment="Center" />
                            <TextBlock Text="Интеграции" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <!-- Вынесено в отдельную страницу из "Воспроизведение" — карточек про
                         всплывающее уведомление о смене трека (вкл/выкл, расположение, размер,
                         монитор) набралось достаточно, чтобы не мешать настройкам громкости и
                         шаффла на той же странице. -->
                    <RadioButton x:Name="NavNotifications" Style="{StaticResource NavItemStyle}"
                                 GroupName="SettingsNav" Tag="Notifications" Checked="NavItem_Checked">
                        <StackPanel Orientation="Horizontal">
                            <local:SvgPathIcon Icon="IconBell" Size="18" VerticalAlignment="Center" />
                            <TextBlock Text="Уведомления" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavEqualizer" Style="{StaticResource NavItemStyle}"
                                 GroupName="SettingsNav" Tag="Equalizer" Checked="NavItem_Checked">
                        <StackPanel Orientation="Horizontal">
                            <local:SvgPathIcon Icon="IconSpeaker2" Size="18" VerticalAlignment="Center" />
                            <TextBlock Text="Эквалайзер" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavMiniPlayer" Style="{StaticResource NavItemStyle}"
                                 GroupName="SettingsNav" Tag="MiniPlayer" Checked="NavItem_Checked">
                        <StackPanel Orientation="Horizontal">
                            <local:SvgPathIcon Icon="IconPictureInPicture" Size="18" VerticalAlignment="Center" />
                            <TextBlock Text="Мини-плеер" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavHotkeys" Style="{StaticResource NavItemStyle}"
                                 GroupName="SettingsNav" Tag="Hotkeys" Checked="NavItem_Checked">
                        <StackPanel Orientation="Horizontal">
                            <local:SvgPathIcon Icon="IconKeyboard" Size="18" VerticalAlignment="Center" />
                            <TextBlock Text="Горячие клавиши" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <!-- Вынесено в отдельную страницу из "Экспериментальное" — экспорт/импорт
                         настроек в .lumi-файл (см. LumiProfile.cs) это не экспериментальная
                         функция, а обычная и завершённая, ей просто не хватало собственного
                         места вместо соседства со случайным набором мелких переключателей. -->
                    <RadioButton x:Name="NavProfile" Style="{StaticResource NavItemStyle}"
                                 GroupName="SettingsNav" Tag="Profile" Checked="NavItem_Checked">
                        <StackPanel Orientation="Horizontal">
                            <local:SvgPathIcon Icon="IconSync" Size="18" VerticalAlignment="Center" />
                            <TextBlock Text="Профиль" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <TextBlock Text="СИСТЕМА" Style="{StaticResource NavSectionTitleStyle}" />

                    <!-- Вынесено в отдельную страницу из "О плеере" — проверка обновлений,
                         выбор источника загрузки и полный список версий разрослись до трёх
                         самостоятельных блоков, которым тесно соседствовать с описанием
                         приложения и карточкой разработчика на одной странице. -->
                    <RadioButton x:Name="NavUpdates" Style="{StaticResource NavItemStyle}"
                                 GroupName="SettingsNav" Tag="Updates" Checked="NavItem_Checked">
                        <StackPanel Orientation="Horizontal">
                            <local:SvgPathIcon Icon="IconRefresh" Size="18" VerticalAlignment="Center" />
                            <TextBlock Text="Обновления" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavAbout" Style="{StaticResource NavItemStyle}"
                                 GroupName="SettingsNav" Tag="About" Checked="NavItem_Checked">
                        <StackPanel Orientation="Horizontal">
                            <local:SvgPathIcon Icon="IconInfo" Size="18" VerticalAlignment="Center" />
                            <TextBlock Text="О плеере" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                        </StackPanel>
                        </ScrollViewer>

                        <!-- ===== Результаты поиска настроек (заменяют список категорий, пока идёт поиск) ===== -->
                        <Grid x:Name="SearchResultsHost" Visibility="Collapsed">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                                <ItemsControl x:Name="SearchResultsList" Margin="0,0,2,12">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource SearchResultItemStyle}" Click="SearchResultItem_Click">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Label}" FontSize="13" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding PageTitle}" FontSize="11" Opacity="0.55" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <StackPanel x:Name="SearchEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                <local:SvgPathIcon Icon="IconSearch" Size="22" Opacity="0.35" HorizontalAlignment="Center" />
                                <TextBlock Text="Ничего не найдено" Opacity="0.5" FontSize="12" Margin="0,8,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <!-- ===== Содержимое выбранной страницы =====
                 Один и тот же ScrollViewer используется для ВСЕХ страниц — переключение вкладки
                 (см. NavItem_Checked) просто скрывает один StackPanel и показывает другой, сам
                 ScrollViewer при этом не пересоздаётся. Из-за этого его VerticalOffset раньше
                 сохранялся между вкладками: если долистать вниз на одной странице и переключиться
                 на другую, та открывалась не сверху, а с той же прокруткой, что осталась от
                 предыдущей — см. явный сброс в PART_ContentScroll.ScrollToTop() в NavItem_Checked. -->
            <Border Grid.Column="1" Margin="18,14,18,16" Padding="0"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="22">
                <ScrollViewer x:Name="PART_ContentScroll" VerticalScrollBarVisibility="Auto">
                    <Grid Margin="46,40,46,44" HorizontalAlignment="Stretch">

                    <!-- Оформление -->
                    <StackPanel x:Name="PageAppearance">
                        <TextBlock Text="Оформление" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="Внешний вид, акцент и взаимодействие с текстом." Style="{StaticResource PageDescriptionStyle}" />

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Язык интерфейса" Style="{StaticResource SettingsSectionTitleStyle}" />
                                <RadioButton x:Name="LanguageRussianRadio" Content="Русский" GroupName="InterfaceLanguage"
                                             Checked="LanguageRadio_Changed" Margin="0,0,0,10" />
                                <RadioButton x:Name="LanguageEnglishRadio" Content="English" GroupName="InterfaceLanguage"
                                             Checked="LanguageRadio_Changed" />
                                <TextBlock Text="Выберите язык Lumisense. Изменение применяется сразу ко всем открытым окнам."
                                           FontSize="12" Opacity="0.6" TextWrapping="Wrap" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Тема" Style="{StaticResource SettingsSectionTitleStyle}" />
                                <RadioButton x:Name="ThemeDarkRadio" Content="Тёмная" GroupName="Theme"
                                             Checked="ThemeRadio_Changed" Margin="0,0,0,10" />
                                <RadioButton x:Name="ThemeLightRadio" Content="Светлая" GroupName="Theme"
                                             Checked="ThemeRadio_Changed" />
                            </StackPanel>
                        </Border>

                        <!-- См. AppSettings.AccentColorMode/AccentColorHex. Пресеты — просто восемь
                             готовых hex-цветов; "Свой" открывает стандартный системный ColorDialog. У
                             выбранного сейчас цвета (если это один из пресетов) рамка подсвечена белым —
                             см. RefreshAccentSwatchSelection. -->
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Акцентный цвет" Style="{StaticResource SettingsSectionTitleStyle}" />
                                <RadioButton x:Name="AccentSystemRadio" Content="Системный (как в Windows)"
                                             GroupName="AccentMode" Checked="AccentModeRadio_Changed" Margin="0,0,0,10" />
                                <RadioButton x:Name="AccentCoverRadio" Content="От текущей обложки"
                                             GroupName="AccentMode" Checked="AccentModeRadio_Changed" Margin="0,0,0,10" />
                                <RadioButton x:Name="AccentManualRadio" Content="Свой" GroupName="AccentMode"
                                             Checked="AccentModeRadio_Changed" Margin="0,0,0,10" />

                                <WrapPanel x:Name="AccentSwatchesPanel" Margin="26,0,0,0">
                                    <Border x:Name="AccentSwatch0" Width="26" Height="26" CornerRadius="6"
                                            Margin="0,0,8,8" Background="#0078D4" BorderThickness="2"
                                            BorderBrush="Transparent" Cursor="Hand"
                                            MouseLeftButtonDown="AccentSwatch_MouseLeftButtonDown" />
                                    <Border x:Name="AccentSwatch1" Width="26" Height="26" CornerRadius="6"
                                            Margin="0,0,8,8" Background="#8764B8" BorderThickness="2"
                                            BorderBrush="Transparent" Cursor="Hand"
                                            MouseLeftButtonDown="AccentSwatch_MouseLeftButtonDown" />
                                    <Border x:Name="AccentSwatch2" Width="26" Height="26" CornerRadius="6"
                                            Margin="0,0,8,8" Background="#E3008C" BorderThickness="2"
                                            BorderBrush="Transparent" Cursor="Hand"
                                            MouseLeftButtonDown="AccentSwatch_MouseLeftButtonDown" />
                                    <Border x:Name="AccentSwatch3" Width="26" Height="26" CornerRadius="6"
                                            Margin="0,0,8,8" Background="#E81123" BorderThickness="2"
                                            BorderBrush="Transparent" Cursor="Hand"
                                            MouseLeftButtonDown="AccentSwatch_MouseLeftButtonDown" />
                                    <Border x:Name="AccentSwatch4" Width="26" Height="26" CornerRadius="6"
                                            Margin="0,0,8,8" Background="#FF8C00" BorderThickness="2"
                                            BorderBrush="Transparent" Cursor="Hand"
                                            MouseLeftButtonDown="AccentSwatch_MouseLeftButtonDown" />
                                    <Border x:Name="AccentSwatch5" Width="26" Height="26" CornerRadius="6"
                                            Margin="0,0,8,8" Background="#FFB900" BorderThickness="2"
                                            BorderBrush="Transparent" Cursor="Hand"
                                            MouseLeftButtonDown="AccentSwatch_MouseLeftButtonDown" />
                                    <Border x:Name="AccentSwatch6" Width="26" Height="26" CornerRadius="6"
                                            Margin="0,0,8,8" Background="#107C10" BorderThickness="2"
                                            BorderBrush="Transparent" Cursor="Hand"
                                            MouseLeftButtonDown="AccentSwatch_MouseLeftButtonDown" />
                                    <Border x:Name="AccentSwatch7" Width="26" Height="26" CornerRadius="6"
                                            Margin="0,0,8,8" Background="#00B7C3" BorderThickness="2"
                                            BorderBrush="Transparent" Cursor="Hand"
                                            MouseLeftButtonDown="AccentSwatch_MouseLeftButtonDown" />

                                    <ui:Button x:Name="AccentCustomButton" Width="26" Height="26" Padding="0"
                                               Margin="0,0,8,8" Appearance="Secondary" ToolTip="Свой цвет через палитру"
                                               Click="AccentCustomButton_Click">
                                        <ui:Button.Icon>
                                            <local:SvgPathIcon Icon="IconEdit" Size="12" />
                                        </ui:Button.Icon>
                                    </ui:Button>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="AccessibilityCard" Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Доступность" Style="{StaticResource SettingsSectionTitleStyle}" />
                                <TextBlock Text="Масштаб интерфейса" Style="{StaticResource SettingsFieldLabelStyle}" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" Height="28">
                                        <Slider x:Name="InterfaceScaleSlider" Style="{StaticResource SettingsAccentSliderStyle}" Minimum="85" Maximum="135"
                                                TickFrequency="5" local:SliderMilestoneMarkers.IsEnabled="True"
                                                IsMoveToPointEnabled="True" IsSnapToTickEnabled="True"
                                                ValueChanged="InterfaceScaleSlider_ValueChanged" />
                                    </Grid>
                                    <Border Grid.Column="1" MinWidth="64" Margin="14,0,0,0" Padding="10,5" CornerRadius="8"
                                            Background="{DynamicResource ControlFillColorTertiaryBrush}">
                                        <TextBlock x:Name="InterfaceScaleValueText" HorizontalAlignment="Center"
                                                   FontWeight="SemiBold" TextAlignment="Center" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="Увеличивает базовый текст и стандартные элементы во всех основных окнах."
                                           Style="{StaticResource SettingsHelperTextStyle}" Margin="0,8,0,16" />
                                <CheckBox x:Name="ReduceMotionCheckBox" Content="Снизить движение"
                                          Checked="ReduceMotionCheckBox_Changed" Unchecked="ReduceMotionCheckBox_Changed" />
                                <TextBlock Text="Отключает переход обложки и движение фона Now Playing. Воспроизведение и управление не меняются."
                                           Style="{StaticResource SettingsHelperTextStyle}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- См. AppSettings.SyncedLyricsFontSize/SyncedLyricsHighlightEffect. -->
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Синхронный текст" Style="{StaticResource SettingsSectionTitleStyle}" />

                                <TextBlock Text="Размер шрифта" Style="{StaticResource SettingsFieldLabelStyle}" Margin="0,0,0,8" />
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" Height="28">
                                        <Slider x:Name="SyncedLyricsFontSizeSlider" Style="{StaticResource SettingsAccentSliderStyle}"
                                                Minimum="12" Maximum="20" TickFrequency="1"
                                                local:SliderMilestoneMarkers.IsEnabled="True"
                                                IsMoveToPointEnabled="True" IsSnapToTickEnabled="True"
                                                ValueChanged="SyncedLyricsFontSizeSlider_ValueChanged" />
                                    </Grid>
                                    <Border Grid.Column="1" MinWidth="64" Margin="14,0,0,0" Padding="10,5" CornerRadius="8"
                                            Background="{DynamicResource ControlFillColorTertiaryBrush}">
                                        <TextBlock x:Name="SyncedLyricsFontSizeValueText"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"
                                                   TextAlignment="Center" />
                                    </Border>
                                </Grid>

                                <Border Margin="0,16,0,0" Padding="14,12" CornerRadius="10"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                    <StackPanel>
                                        <TextBlock Text="Эффект активной строки" Style="{StaticResource SettingsFieldLabelStyle}" Margin="0,0,0,8" />
                                        <RadioButton x:Name="SyncedLyricsEffectNoneRadio" Content="Без эффекта"
                                                     GroupName="SyncedLyricsEffect" Checked="SyncedLyricsEffectRadio_Changed"
                                                     Margin="0,0,0,8" />
                                        <RadioButton x:Name="SyncedLyricsEffectGlowRadio" Content="Мягкое свечение"
                                                     GroupName="SyncedLyricsEffect" Checked="SyncedLyricsEffectRadio_Changed" />
                                        <TextBlock Text="Активная строка остаётся белой, неактивные — приглушённо-серыми. Настройки применяются сразу в панели текста главного окна."
                                                   Style="{StaticResource SettingsHelperTextStyle}" Margin="0,10,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Поиск текста песен" Style="{StaticResource SettingsSectionTitleStyle}" />
                                <RadioButton x:Name="LyricsPolicyLocalOnlyRadio" Content="Только локальные тексты"
                                             GroupName="LyricsPolicy" Checked="LyricsPolicyRadio_Changed" Margin="0,0,0,8" />
                                <RadioButton x:Name="LyricsPolicyAutoExactRadio" Content="Автоматически искать точное совпадение"
                                             GroupName="LyricsPolicy" Checked="LyricsPolicyRadio_Changed" Margin="0,0,0,8" />
                                <RadioButton x:Name="LyricsPolicyManualOnlyRadio" Content="Искать только по моему запросу"
                                             GroupName="LyricsPolicy" Checked="LyricsPolicyRadio_Changed" />
                                <TextBlock Text="Локальные .lrc, .txt, теги и сохранённый кэш используются всегда. При онлайн-поиске в LRCLIB отправляются только название и исполнитель; путь к файлу и сам аудиофайл не передаются."
                                           Style="{StaticResource SettingsHelperTextStyle}" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- См. AppSettings.WindowBackdropType. -->
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Основа окна" Style="{StaticResource SettingsSectionTitleStyle}" />
                                <RadioButton x:Name="BackdropMicaRadio" Content="Mica (лёгкое размытие, по умолчанию)"
                                             GroupName="Backdrop" Checked="WindowBackdropRadio_Changed" Margin="0,0,0,10" />
                                <RadioButton x:Name="BackdropAcrylicRadio" Content="Acrylic (сильнее размытие и прозрачность)"
                                             GroupName="Backdrop" Checked="WindowBackdropRadio_Changed" />
                                <TextBlock Text="Mica и Acrylic применяются к главному окну, окну настроек и статистике."
                                           Style="{StaticResource SettingsHelperTextStyle}" Margin="0,8,0,16" />
                                <CheckBox x:Name="CoverBaseFromCoverCheckBox" Content="Цвет основы от текущей обложки"
                                          Checked="CoverBaseFromCoverCheckBox_Changed"
                                          Unchecked="CoverBaseFromCoverCheckBox_Changed" Margin="0,0,0,10" />
                                <TextBlock Text="Цвет основы от обложки можно включить независимо от акцентного цвета или совместить с любым акцентом."
                                           Style="{StaticResource SettingsHelperTextStyle}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- См. AppSettings.AlbumArtTransitionEnabled. -->
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Анимация смены обложки" Style="{StaticResource SettingsSectionTitleStyle}" />
                                <RadioButton x:Name="AlbumArtTransitionOffRadio" Content="Без анимации" GroupName="AlbumArtTransition"
                                             Checked="AlbumArtTransitionRadio_Changed" Margin="0,0,0,10" />
                                <RadioButton x:Name="AlbumArtTransitionOnRadio" Content="С анимацией" GroupName="AlbumArtTransition"
                                             Checked="AlbumArtTransitionRadio_Changed" />
                                <TextBlock Text="При переключении трека старая обложка «улетает» в сторону, а новая «влетает» с противоположной — как в iTunes."
                                           FontSize="12" Opacity="0.6" TextWrapping="Wrap" Margin="0,8,0,8" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <CheckBox x:Name="AlbumArtGesturesCheckBox" Content="Включить жесты на обложке"
                                          Checked="AlbumArtGesturesCheckBox_Changed"
                                          Unchecked="AlbumArtGesturesCheckBox_Changed" />
                                <TextBlock Text="Касание — пуск/пауза; свайп влево или вправо — смена трека; свайп вверх или вниз — громкость. При отключении клик снова открывает обложку."
                                           FontSize="12" Opacity="0.6" TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                    </StackPanel>

                    <!-- Окно и запуск -->
                    <StackPanel x:Name="PageWindow" Visibility="Collapsed">
                        <TextBlock Text="Окно и запуск" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="Режим окна и поведение приложения при запуске." Style="{StaticResource PageDescriptionStyle}" />

                        <Border x:Name="PlayerViewModeCard" Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Вид плеера" Style="{StaticResource SettingsSectionTitleStyle}" />
                                <TextBlock Text="Как выглядит и какого размера главное окно плеера"
                                           Style="{StaticResource SettingsHelperTextStyle}" Margin="0,0,0,14" />

                                <StackPanel Orientation="Horizontal">

                                    <!-- Квадратный вид: крупный контент + открытый по умолчанию плейлист,
                                         занимающий всю ширину окна -->
                                    <RadioButton x:Name="ViewModeSquareRadio" Style="{StaticResource ViewModeThumbStyle}"
                                                 GroupName="PlayerViewModeGroup" Tag="Square" Margin="0,0,10,0"
                                                 Checked="PlayerViewModeRadio_Checked">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Border Width="64" Height="64" CornerRadius="6"
                                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                    BorderBrush="{DynamicResource ControlStrongFillColorDefaultBrush}"
                                                    BorderThickness="1">
                                                <Grid Margin="6">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="26" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>
                                                    <Ellipse Grid.Row="0" Width="22" Height="22"
                                                             Fill="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                    <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Margin="0,4,0,0">
                                                        <Rectangle Height="5" Margin="0,0,0,3"
                                                                   Fill="{DynamicResource ControlStrongFillColorDefaultBrush}" />
                                                        <Rectangle Height="5" Margin="0,0,0,3"
                                                                   Fill="{DynamicResource ControlStrongFillColorDefaultBrush}" />
                                                        <Rectangle Height="5"
                                                                   Fill="{DynamicResource ControlStrongFillColorDefaultBrush}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="Квадратный" Foreground="White" FontSize="12" Margin="0,6,0,0"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>

                                    <!-- Прямоугольный вид: обычные размеры элементов, плейлист виден сбоку/снизу -->
                                    <RadioButton x:Name="ViewModeRectangularRadio" Style="{StaticResource ViewModeThumbStyle}"
                                                 GroupName="PlayerViewModeGroup" Tag="Rectangular" Margin="0,0,10,0"
                                                 Checked="PlayerViewModeRadio_Checked">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Border Width="44" Height="64" CornerRadius="6"
                                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                    BorderBrush="{DynamicResource ControlStrongFillColorDefaultBrush}"
                                                    BorderThickness="1">
                                                <Grid Margin="5">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="18" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>
                                                    <Ellipse Grid.Row="0" Width="14" Height="14"
                                                             HorizontalAlignment="Center"
                                                             Fill="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                    <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Margin="0,4,0,0">
                                                        <Rectangle Height="4" Margin="0,0,0,3"
                                                                   Fill="{DynamicResource ControlStrongFillColorDefaultBrush}" />
                                                        <Rectangle Height="4" Margin="0,0,0,3"
                                                                   Fill="{DynamicResource ControlStrongFillColorDefaultBrush}" />
                                                        <Rectangle Height="4" Margin="0,0,0,3"
                                                                   Fill="{DynamicResource ControlStrongFillColorDefaultBrush}" />
                                                        <Rectangle Height="4"
                                                                   Fill="{DynamicResource ControlStrongFillColorDefaultBrush}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="Прямоугольный" Foreground="White" FontSize="12" Margin="0,6,0,0"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>

                                    <!-- Мини-плеер: узкая горизонтальная плашка без плейлиста -->
                                    <RadioButton x:Name="ViewModeMiniRadio" Style="{StaticResource ViewModeThumbStyle}"
                                                 GroupName="PlayerViewModeGroup" Tag="Mini"
                                                 Checked="PlayerViewModeRadio_Checked">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Border Width="76" Height="64" CornerRadius="6"
                                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                    BorderBrush="{DynamicResource ControlStrongFillColorDefaultBrush}"
                                                    BorderThickness="1">
                                                <Border Width="60" Height="20" CornerRadius="10"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                        BorderBrush="{DynamicResource ControlStrongFillColorDefaultBrush}"
                                                        BorderThickness="1">
                                                    <Grid Margin="4,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Ellipse Grid.Column="0" Width="10" Height="10"
                                                                 VerticalAlignment="Center"
                                                                 Fill="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                        <Rectangle Grid.Column="1" Height="4" Margin="4,0,0,0"
                                                                   VerticalAlignment="Center"
                                                                   Fill="{DynamicResource ControlStrongFillColorDefaultBrush}" />
                                                    </Grid>
                                                </Border>
                                            </Border>
                                            <TextBlock Text="Мини-плеер" Foreground="White" FontSize="12" Margin="0,6,0,0"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>

                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <CheckBox x:Name="AlwaysOnTopCheckBox" Content="Поверх всех окон"
                                          Checked="AlwaysOnTopCheckBox_Changed" Unchecked="AlwaysOnTopCheckBox_Changed" />
                                <TextBlock Text="Окно плеера остаётся видимым поверх других приложений."
                                           Style="{StaticResource SettingsHelperTextStyle}" Margin="0,8,0,16" />
                                <CheckBox x:Name="MinimizeToTrayCheckBox" Content="Сворачивать в трей при закрытии"
                                          Checked="MinimizeToTrayCheckBox_Changed" Unchecked="MinimizeToTrayCheckBox_Changed" />
                                <TextBlock Text="Кнопка закрытия не завершает Lumisense: плеер остаётся доступен через значок в области уведомлений."
                                           Style="{StaticResource SettingsHelperTextStyle}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <CheckBox x:Name="LaunchOnStartupCheckBox" Content="Запускать вместе с Windows"
                                          Checked="LaunchOnStartupCheckBox_Changed" Unchecked="LaunchOnStartupCheckBox_Changed" />
                                <TextBlock Text="Lumisense будет открываться после входа в Windows."
                                           Style="{StaticResource SettingsHelperTextStyle}" Margin="0,8,0,16" />
                                <CheckBox x:Name="StartHiddenInTrayCheckBox" Content="Запускать свёрнутым в трей"
                                          Checked="StartHiddenInTrayCheckBox_Changed" Unchecked="StartHiddenInTrayCheckBox_Changed" />
                                <TextBlock Text="При запуске появляется только значок в области уведомлений; плеер можно открыть из него в любой момент."
                                           Style="{StaticResource SettingsHelperTextStyle}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Воспроизведение -->
                    <StackPanel x:Name="PagePlayback" Visibility="Collapsed">
                        <TextBlock Text="Воспроизведение" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="Громкость, продолжение воспроизведения и поведение плейлиста." Style="{StaticResource PageDescriptionStyle}" />

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <CheckBox x:Name="RememberVolumeCheckBox" Content="Запоминать громкость между запусками"
                                          Checked="RememberVolumeCheckBox_Changed" Unchecked="RememberVolumeCheckBox_Changed" />
                                <TextBlock Text="При следующем запуске плеер восстановит последний выбранный уровень громкости."
                                           Style="{StaticResource SettingsHelperTextStyle}" Margin="0,8,0,16" />
                                <CheckBox x:Name="LogarithmicVolumeCheckBox" Content="Логарифмическая регулировка громкости"
                                          Checked="LogarithmicVolumeCheckBox_Changed" Unchecked="LogarithmicVolumeCheckBox_Changed" />
                                <TextBlock Text="Ползунок громкости меняет уровень так, как его воспринимает слух: заметный на глаз ход в начале и в конце шкалы звучит одинаково плавно, без резкого скачка на малой громкости."
                                           FontSize="12" Opacity="0.6" TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Устройство вывода" Style="{StaticResource SettingsSectionTitleStyle}" />
                                <ComboBox x:Name="OutputDeviceCombo" SelectionChanged="OutputDeviceCombo_SelectionChanged"
                                          HorizontalAlignment="Left" MinWidth="300" Margin="0,2,0,8" />
                                <TextBlock Text="Системное устройство по умолчанию следует настройкам Windows. Если выбранные наушники или колонки отключены, Lumisense переключится на него автоматически."
                                           Style="{StaticResource SettingsHelperTextStyle}" TextWrapping="Wrap" />
                                <TextBlock x:Name="OutputDeviceStatusText" FontSize="12" Opacity="0.62" TextWrapping="Wrap"
                                           Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- См. AppSettings.NeverAutoPlayLastTrackOnStartup / WasPlayingOnClose. -->
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <CheckBox x:Name="NeverAutoPlayLastTrackOnStartupCheckBox"
                                          Content="Никогда не запускать трек при старте"
                                          Checked="NeverAutoPlayLastTrackOnStartupCheckBox_Changed"
                                          Unchecked="NeverAutoPlayLastTrackOnStartupCheckBox_Changed" />
                                <TextBlock Text="По умолчанию Lumisense продолжает трек с сохранённой позиции, только если он играл при закрытии приложения. С этой настройкой трек всё равно откроется, но останется на паузе."
                                           FontSize="12" Opacity="0.6" TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Кэш обложек из CoverArtSearchWindow хранится локально в %AppData%\Lumisense\cover-cache. -->
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Кэш интернет-обложек" Style="{StaticResource SettingsSectionTitleStyle}" />
                                <TextBlock Text="Повторно открытые варианты обложек берутся из локальной папки, чтобы не скачивать изображения заново."
                                           Style="{StaticResource SettingsHelperTextStyle}" Margin="0,0,0,0" />
                                <ui:Button x:Name="ClearArtworkCacheButton" Appearance="Secondary"
                                           HorizontalAlignment="Left" Margin="0,12,0,0"
                                           Click="ClearArtworkCacheButton_Click"
                                           Content="Очистить кэш обложек" />
                                <TextBlock x:Name="ArtworkCacheClearResultText" Visibility="Collapsed"
                                           FontSize="12" Opacity="0.7" TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Нормализация меняет только имена уже добавленных файлов после явного
                             предпросмотра и подтверждения; см. FileNameNormalizer/MainWindow. -->
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Нормализация имён файлов" Style="{StaticResource SettingsSectionTitleStyle}" />
                                <TextBlock Text="Переименовывает файлы в исходных папках по тегам. Перед изменением Lumisense покажет примеры и пропустит занятые имена или текущий трек."
                                           FontSize="12" Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,12" />
                                <TextBlock Text="Шаблон" Style="{StaticResource SettingsFieldLabelStyle}" Margin="0,0,0,8" />
                                <ui:TextBox x:Name="FileNameNormalizationTemplateTextBox"
                                            PlaceholderText="Например: {Artist} - {Title}{Extension}"
                                            TextChanged="FileNameNormalizationTemplateTextBox_TextChanged">
                                    <ui:TextBox.Icon>
                                        <local:SvgPathIcon Icon="IconEdit" />
                                    </ui:TextBox.Icon>
                                </ui:TextBox>
                                <TextBlock Text="Токены: {Artist}, {Title}, {Album}, {Track}, {Extension}. Расширение исходного файла сохраняется автоматически."
                                           FontSize="12" Opacity="0.6" TextWrapping="Wrap" Margin="0,8,0,0" />
                                <Button x:Name="NormalizePlaylistFileNamesButton" Content="Показать предпросмотр и нормализовать"
                                        HorizontalAlignment="Left" Margin="0,12,0,0"
                                        Click="NormalizePlaylistFileNamesButton_Click" />
                                <TextBlock x:Name="FileNameNormalizationResultText" Visibility="Collapsed"
                                           FontSize="12" Opacity="0.7" TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Действия контекстного меню трека" Style="{StaticResource SettingsSectionTitleStyle}" />
                                <TextBlock Text="Снимите галочки, чтобы скрыть ненужные действия при нажатии правой кнопкой по треку в плейлисте. «Воспроизвести» остаётся доступным всегда."
                                           FontSize="12" Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,12" />
                                <UniformGrid Columns="1" Margin="0,2,0,0">
                                    <CheckBox x:Name="TrackContextPlayNextCheckBox" Tag="PlayNext" Content="Играть следующим"
                                              Checked="TrackContextMenuActionCheckBox_Changed" Unchecked="TrackContextMenuActionCheckBox_Changed" />
                                    <CheckBox x:Name="TrackContextAddToQueueCheckBox" Tag="AddToQueue" Content="Добавить в очередь"
                                              Checked="TrackContextMenuActionCheckBox_Changed" Unchecked="TrackContextMenuActionCheckBox_Changed" />
                                    <CheckBox x:Name="TrackContextFavoriteCheckBox" Tag="Favorite" Content="Избранное"
                                              Checked="TrackContextMenuActionCheckBox_Changed" Unchecked="TrackContextMenuActionCheckBox_Changed" />
                                    <CheckBox x:Name="TrackContextShowInExplorerCheckBox" Tag="ShowInExplorer" Content="Показать в проводнике"
                                              Checked="TrackContextMenuActionCheckBox_Changed" Unchecked="TrackContextMenuActionCheckBox_Changed" />
                                    <CheckBox x:Name="TrackContextCopyNameCheckBox" Tag="CopyTrackName" Content="Копировать имя трека"
                                              Checked="TrackContextMenuActionCheckBox_Changed" Unchecked="TrackContextMenuActionCheckBox_Changed" />
                                    <CheckBox x:Name="TrackContextCopyPathCheckBox" Tag="CopyPath" Content="Копировать путь к файлу"
                                              Checked="TrackContextMenuActionCheckBox_Changed" Unchecked="TrackContextMenuActionCheckBox_Changed" />
                                    <CheckBox x:Name="TrackContextCopyFileCheckBox" Tag="CopyFile" Content="Копировать файл"
                                              Checked="TrackContextMenuActionCheckBox_Changed" Unchecked="TrackContextMenuActionCheckBox_Changed" />
                                    <CheckBox x:Name="TrackContextPropertiesCheckBox" Tag="Properties" Content="Свойства"
                                              Checked="TrackContextMenuActionCheckBox_Changed" Unchecked="TrackContextMenuActionCheckBox_Changed" />
                                    <CheckBox x:Name="TrackContextEditTagsCheckBox" Tag="EditTags" Content="Изменить теги"
                                              Checked="TrackContextMenuActionCheckBox_Changed" Unchecked="TrackContextMenuActionCheckBox_Changed" />
                                    <CheckBox x:Name="TrackContextNormalizeFileNameCheckBox" Tag="NormalizeFileName" Content="Нормализовать имя файла"
                                              Checked="TrackContextMenuActionCheckBox_Changed" Unchecked="TrackContextMenuActionCheckBox_Changed" />
                                    <CheckBox x:Name="TrackContextRemoveFromPlaylistCheckBox" Tag="RemoveFromPlaylist" Content="Убрать из плейлиста"
                                              Checked="TrackContextMenuActionCheckBox_Changed" Unchecked="TrackContextMenuActionCheckBox_Changed" />
                                    <CheckBox x:Name="TrackContextDeleteFromDiskCheckBox" Tag="DeleteFromDisk" Content="Удалить с диска"
                                              Checked="TrackContextMenuActionCheckBox_Changed" Unchecked="TrackContextMenuActionCheckBox_Changed" />
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- Раньше называлась "Улучшенный шаффл" и жила на странице "Экспериментальное" —
                             имя настройки в AppSettings (UseImprovedShuffle) осталось прежним, чтобы не
                             сбрасывать выбор тем, у кого он уже был включён, изменилось только то, как
                             это называется в интерфейсе. -->
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <CheckBox x:Name="ImprovedShuffleCheckBox" Content="Шаффл без повторов"
                                          Checked="ImprovedShuffleCheckBox_Changed" Unchecked="ImprovedShuffleCheckBox_Changed" />
                                <TextBlock Text="Вместо чисто случайного выбора трека на каждом шаге сначала тасуется весь плейлист целиком, а треки проигрываются по порядку из этой тасовки — так один и тот же трек не может повториться, пока не сыграют все остальные."
                                           FontSize="12" Opacity="0.6" TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <CheckBox x:Name="SaveQueueBetweenRestartsCheckBox" Content="Сохранять очередь «Играть следующим» между запусками"
                                          Checked="SaveQueueBetweenRestartsCheckBox_Changed" Unchecked="SaveQueueBetweenRestartsCheckBox_Changed" />
                                <TextBlock Text="По умолчанию очередь не переживает перезапуск приложения. Если включить — она сохранится и восстановится при следующем запуске (пропавшие с диска файлы будут тихо убраны)."
                                           FontSize="12" Opacity="0.6" TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- См. AppSettings.ProgressBarStyle / WaveformView / WaveformGenerator. -->
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Полоса воспроизведения" Style="{StaticResource SettingsSectionTitleStyle}" />
                                <RadioButton x:Name="ProgressBarSliderRadio" Content="Обычная (по умолчанию)"
                                             GroupName="ProgressBarStyle" Checked="ProgressBarStyleRadio_Changed" Margin="0,0,0,10" />
                                <RadioButton x:Name="ProgressBarWaveformRadio" Content="Waveform (форма звука, как в SoundCloud)"
                                             GroupName="ProgressBarStyle" Checked="ProgressBarStyleRadio_Changed" Margin="0,0,0,10" />
                                <TextBlock Text="Форма звука считается один раз при загрузке трека и держится в памяти, пока плеер открыт — на длинных файлах (FLAC/WAV) первый расчёт может занять секунду-другую."
                                           FontSize="12" Opacity="0.6" TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- См. AppSettings.ReplayGainEnabled / ReplayGainReader. -->
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <CheckBox x:Name="ReplayGainCheckBox" Content="ReplayGain"
                                          Checked="ReplayGainCheckBox_Changed" Unchecked="ReplayGainCheckBox_Changed" />
                                <TextBlock Text="Выравнивает субъективную громкость между треками по тегам REPLAYGAIN_TRACK_GAIN, если они есть в файле — без этого более тихо смастеренные треки в одном плейлисте с громкими звучат заметно тише. У треков без таких тегов ничего не меняется."
                                           FontSize="12" Opacity="0.6" TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Интеграции -->
                    <StackPanel x:Name="PageIntegrations" Visibility="Collapsed">
                        <TextBlock Text="Интеграции" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="Внешние сервисы, приватность и диагностика подключений." Style="{StaticResource PageDescriptionStyle}" />

                        <!-- Discord Rich Presence — локальный Discord IPC, см. DiscordRichPresenceManager. -->
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <CheckBox x:Name="DiscordRichPresenceEnabledCheckBox" Content="Discord Rich Presence"
                                          Checked="DiscordRichPresenceEnabledCheckBox_Changed"
                                          Unchecked="DiscordRichPresenceEnabledCheckBox_Changed"
                                          Margin="0,0,0,10" />
                                <TextBlock Text="Показывает активность Lumisense в профиле Discord через локальное соединение. Discord и обмен статусами должны быть включены в самом клиенте Discord."
                                           FontSize="12" Opacity="0.6" TextWrapping="Wrap" Margin="0,8,0,14" />

                                <ui:Button x:Name="ConnectDiscordButton" Appearance="Secondary" HorizontalAlignment="Left"
                                           Content="Подключить Discord"
                                           Click="ConnectDiscordButton_Click" />
                                <TextBlock x:Name="DiscordRichPresenceConnectionStatusText"
                                           FontSize="12" Opacity="0.6" TextWrapping="Wrap" Margin="0,8,0,0" />
                                <ui:Button x:Name="OpenDiscordDiagnosticsLogButton" Appearance="Secondary" HorizontalAlignment="Left" Margin="0,10,0,0"
                                           Content="Открыть журнал Discord"
                                           Click="OpenDiscordDiagnosticsLogButton_Click" />
                                <TextBlock Text="Журнал сохраняет события подключения, отправки статуса и ошибки Discord Rich Presence — он поможет при диагностике проблем интеграции."
                                           FontSize="12" Opacity="0.6" TextWrapping="Wrap" Margin="0,8,0,0" />

                                <TextBlock Text="Приватность" Style="{StaticResource SettingsFieldLabelStyle}" />
                                <CheckBox x:Name="DiscordRichPresenceShowTrackInfoCheckBox"
                                          Content="Показывать название и исполнителя"
                                          Checked="DiscordRichPresencePrivacyCheckBox_Changed"
                                          Unchecked="DiscordRichPresencePrivacyCheckBox_Changed"
                                          Margin="0,0,0,10" />
                                <CheckBox x:Name="DiscordRichPresenceShowTimelineCheckBox"
                                          Content="Показывать таймлайн воспроизведения"
                                          Checked="DiscordRichPresencePrivacyCheckBox_Changed"
                                          Unchecked="DiscordRichPresencePrivacyCheckBox_Changed" />
                                <TextBlock Text="Локальные файлы и обложки не загружаются в Discord. Обложка может отображаться только как заранее добавленный asset приложения Lumisense."
                                           FontSize="12" Opacity="0.6" TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                    </StackPanel>

                    <!-- Уведомления — раньше жили на странице "Воспроизведение", вынесены на
                         отдельную страницу: набралось три карточки только про всплывающее
                         уведомление о смене трека (вкл/выкл, расположение, размер, монитор). -->
                    <StackPanel x:Name="PageNotifications" Visibility="Collapsed">
                        <TextBlock Text="Уведомления" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="Всплывающие карточки о смене трека." Style="{StaticResource PageDescriptionStyle}" />

                        <!-- См. AppSettings.ShowTrackChangeToast и TrackChangeToastWindow. -->
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <CheckBox x:Name="TrackChangeToastCheckBox" Content="Уведомление о смене трека"
                                          Checked="TrackChangeToastCheckBox_Changed" Unchecked="TrackChangeToastCheckBox_Changed"
                                          Margin="0,0,0,10" />
                                <TextBlock Text="Карточка с обложкой и названием появляется на несколько секунд и скрывается сама."
                                           FontSize="12" Opacity="0.6" TextWrapping="Wrap" Margin="0,8,0,14" />

                                <TextBlock Text="Когда показывать" Style="{StaticResource SettingsFieldLabelStyle}" />
                                <StackPanel>
                                    <RadioButton x:Name="ToastPolicyEveryTrackChangeRadio" Content="При каждой смене трека"
                                                 GroupName="ToastPolicy" Checked="ToastPolicyRadio_Changed" Margin="0,0,0,8" />
                                    <RadioButton x:Name="ToastPolicyPlaybackOnlyRadio" Content="Только при начале воспроизведения"
                                                 GroupName="ToastPolicy" Checked="ToastPolicyRadio_Changed" Margin="0,0,0,8" />
                                    <RadioButton x:Name="ToastPolicyManualOnlyRadio" Content="Только при моём выборе"
                                                 GroupName="ToastPolicy" Checked="ToastPolicyRadio_Changed" />
                                </StackPanel>
                                <TextBlock Text="Последний вариант не показывает карточку при автопереходе, восстановлении сессии или обновлении трека после редактирования."
                                           Style="{StaticResource SettingsHelperTextStyle}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- См. AppSettings.TrackChangeToastPosition/TrackChangeToastMonitor/TrackChangeToastWidth.
                             Список мониторов в ToastMonitorCombo заполняется в code-behind (InitializeSettings) —
                             в разметке заранее известен только первый пункт "Автоматически". -->
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Расположение уведомления" Style="{StaticResource SettingsSectionTitleStyle}" />
                                <Grid Margin="0,2,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,18,0">
                                        <RadioButton x:Name="ToastPosTopLeftRadio" Content="Сверху слева"
                                                     GroupName="ToastPosition" Checked="ToastPositionRadio_Changed" Margin="0,0,0,10" />
                                        <RadioButton x:Name="ToastPosTopCenterRadio" Content="Сверху по центру"
                                                     GroupName="ToastPosition" Checked="ToastPositionRadio_Changed" Margin="0,0,0,10" />
                                        <RadioButton x:Name="ToastPosTopRightRadio" Content="Сверху справа"
                                                     GroupName="ToastPosition" Checked="ToastPositionRadio_Changed" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <RadioButton x:Name="ToastPosBottomLeftRadio" Content="Снизу слева"
                                                     GroupName="ToastPosition" Checked="ToastPositionRadio_Changed" Margin="0,0,0,10" />
                                        <RadioButton x:Name="ToastPosBottomCenterRadio" Content="Снизу по центру"
                                                     GroupName="ToastPosition" Checked="ToastPositionRadio_Changed" Margin="0,0,0,10" />
                                        <RadioButton x:Name="ToastPosBottomRightRadio" Content="Снизу справа"
                                                     GroupName="ToastPosition" Checked="ToastPositionRadio_Changed" />
