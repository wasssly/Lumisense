                                               MinWidth="140" Margin="8,0,4,0" Click="HotkeySeekBackwardButton_Click" />
                                    <ui:Button Grid.Column="2" Appearance="Secondary" Width="28" Height="28" Padding="0"
                                               Click="HotkeySeekBackwardClearButton_Click" ToolTip="Очистить">
