                                        <Border Style="{StaticResource SettingsRowStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                                    <TextBlock Text="Строки песни в свёрнутом острове катаются по буквам" Style="{StaticResource SettingsRowTitleStyle}" />
                                                </StackPanel>
                                                <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" x:Name="IslandLyricsWordRollCheckBox" AutomationProperties.Name="Строки песни в свёрнутом острове катаются по буквам"
                                                Checked="IslandOption_Changed" Unchecked="IslandOption_Changed" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource SettingsRowStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                                    <TextBlock Text="Подсветка слов в тексте песни (бета)" Style="{StaticResource SettingsRowTitleStyle}" />
                                                    <TextBlock Text="Слова подсвечиваются приблизительно: в тексте песни нет точных таймингов слов, поэтому время строки делится между словами по их длине. Подсветка может чуть опережать голос или отставать от него."
                                                               Style="{StaticResource SettingsHelperTextStyle}" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" x:Name="IslandReadAlongCheckBox" AutomationProperties.Name="Подсветка слов в тексте песни (бета)"
                                                Checked="IslandOption_Changed" Unchecked="IslandOption_Changed" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Эффекты" Style="{StaticResource SettingsGroupTitleStyle}" />
                                <Border Style="{StaticResource SettingsGroupCardStyle}">
                                    <StackPanel>
                                        <Border Style="{StaticResource SettingsRowStyle}" BorderThickness="0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                                    <TextBlock Text="Размытие при смене вида" Style="{StaticResource SettingsRowTitleStyle}" />
                                                </StackPanel>
                                                <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" x:Name="IslandBlurTransitionsCheckBox" AutomationProperties.Name="Размытие при смене вида"
                                                Checked="IslandOption_Changed" Unchecked="IslandOption_Changed" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource SettingsRowStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                                    <TextBlock Text="Размытие движения при растяжении" Style="{StaticResource SettingsRowTitleStyle}" />
                                                                                    <TextBlock Text="Размытия нагружают видеокарту: если остров подтормаживает, отключите их."
                                                                                               Style="{StaticResource SettingsHelperTextStyle}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" x:Name="IslandMotionBlurCheckBox" AutomationProperties.Name="Размытие движения при растяжении"
                                                Checked="IslandOption_Changed" Unchecked="IslandOption_Changed" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Пункты контекстного меню острова" Style="{StaticResource SettingsGroupTitleStyle}" />
                                <Border Style="{StaticResource SettingsGroupCardStyle}">
                                    <StackPanel>
                                        <Border Style="{StaticResource SettingsRowStyle}" BorderThickness="0">
                                            <StackPanel>
                                                <TextBlock Text="Чтобы изменить порядок, перетаскивайте пункты за значок ⋮⋮ слева."
                                                                                           Style="{StaticResource SettingsHelperTextStyle}" Margin="0,0,0,12" />
                                                                                <ui:Button Tag="Island" Content="Порядок по умолчанию" Appearance="Secondary"
                                                                                           HorizontalAlignment="Left" Margin="0,0,0,12"
                                                                                           Click="ContextMenuOrderReset_Click" />
                                                                                <StackPanel x:Name="IslandMenuActionsPanel">
                                                                                <Border Tag="PlayPause" Style="{StaticResource ReorderRowStyle}">
                                                                                        <Grid>
                                                                                            <Grid.ColumnDefinitions>
                                                                                                <ColumnDefinition Width="24" />
                                                                                                <ColumnDefinition Width="*" />
                                                                                            </Grid.ColumnDefinitions>
                                                                                            <TextBlock Style="{StaticResource ReorderGripStyle}" />
                                                                                            <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="0" x:Name="IslandMenuPlayPauseCheckBox" Tag="PlayPause" Content="Пауза / продолжить" Checked="IslandMenuAction_Changed" Unchecked="IslandMenuAction_Changed" />
                                                                                        </Grid>
                                                                                    </Border>
                                                                                <Border Tag="Next" Style="{StaticResource ReorderRowStyle}">
                                                                                        <Grid>
                                                                                            <Grid.ColumnDefinitions>
                                                                                                <ColumnDefinition Width="24" />
                                                                                                <ColumnDefinition Width="*" />
                                                                                            </Grid.ColumnDefinitions>
                                                                                            <TextBlock Style="{StaticResource ReorderGripStyle}" />
                                                                                            <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="0" x:Name="IslandMenuNextCheckBox" Tag="Next" Content="Следующий трек" Checked="IslandMenuAction_Changed" Unchecked="IslandMenuAction_Changed" />
                                                                                        </Grid>
                                                                                    </Border>
                                                                                <Border Tag="Previous" Style="{StaticResource ReorderRowStyle}">
                                                                                        <Grid>
                                                                                            <Grid.ColumnDefinitions>
                                                                                                <ColumnDefinition Width="24" />
                                                                                                <ColumnDefinition Width="*" />
                                                                                            </Grid.ColumnDefinitions>
                                                                                            <TextBlock Style="{StaticResource ReorderGripStyle}" />
                                                                                            <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="0" x:Name="IslandMenuPreviousCheckBox" Tag="Previous" Content="Предыдущий трек" Checked="IslandMenuAction_Changed" Unchecked="IslandMenuAction_Changed" />
                                                                                        </Grid>
                                                                                    </Border>
                                                                                <Border Tag="Hide" Style="{StaticResource ReorderRowStyle}">
                                                                                        <Grid>
                                                                                            <Grid.ColumnDefinitions>
                                                                                                <ColumnDefinition Width="24" />
                                                                                                <ColumnDefinition Width="*" />
                                                                                            </Grid.ColumnDefinitions>
                                                                                            <TextBlock Style="{StaticResource ReorderGripStyle}" />
                                                                                            <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="0" x:Name="IslandMenuHideCheckBox" Tag="Hide" Content="Скрыть остров" Checked="IslandMenuAction_Changed" Unchecked="IslandMenuAction_Changed" />
                                                                                        </Grid>
                                                                                    </Border>
                                                                                <Border Tag="Expand" Style="{StaticResource ReorderRowStyle}">
                                                                                        <Grid>
                                                                                            <Grid.ColumnDefinitions>
                                                                                                <ColumnDefinition Width="24" />
                                                                                                <ColumnDefinition Width="*" />
                                                                                            </Grid.ColumnDefinitions>
                                                                                            <TextBlock Style="{StaticResource ReorderGripStyle}" />
                                                                                            <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="0" x:Name="IslandMenuExpandCheckBox" Tag="Expand" Content="Развернуть плеер" Checked="IslandMenuAction_Changed" Unchecked="IslandMenuAction_Changed" />
                                                                                        </Grid>
                                                                                    </Border>
                                                                                <Border Tag="NowPlaying" Style="{StaticResource ReorderRowStyle}">
                                                                                        <Grid>
                                                                                            <Grid.ColumnDefinitions>
                                                                                                <ColumnDefinition Width="24" />
                                                                                                <ColumnDefinition Width="*" />
                                                                                            </Grid.ColumnDefinitions>
                                                                                            <TextBlock Style="{StaticResource ReorderGripStyle}" />
                                                                                            <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="0" x:Name="IslandMenuNowPlayingCheckBox" Tag="NowPlaying" Content="Now Playing (полный экран)" Checked="IslandMenuAction_Changed" Unchecked="IslandMenuAction_Changed" />
                                                                                        </Grid>
                                                                                    </Border>
                                                                                <Border Tag="Speed" Style="{StaticResource ReorderRowStyle}">
                                                                                        <Grid>
                                                                                            <Grid.ColumnDefinitions>
                                                                                                <ColumnDefinition Width="24" />
                                                                                                <ColumnDefinition Width="*" />
                                                                                            </Grid.ColumnDefinitions>
                                                                                            <TextBlock Style="{StaticResource ReorderGripStyle}" />
                                                                                            <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="0" x:Name="IslandMenuSpeedCheckBox" Tag="Speed" Content="Скорость" Checked="IslandMenuAction_Changed" Unchecked="IslandMenuAction_Changed" />
                                                                                        </Grid>
                                                                                    </Border>
                                                                                <Border Tag="Pitch" Style="{StaticResource ReorderRowStyle}">
                                                                                        <Grid>
                                                                                            <Grid.ColumnDefinitions>
                                                                                                <ColumnDefinition Width="24" />
                                                                                                <ColumnDefinition Width="*" />
                                                                                            </Grid.ColumnDefinitions>
                                                                                            <TextBlock Style="{StaticResource ReorderGripStyle}" />
                                                                                            <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="0" x:Name="IslandMenuPitchCheckBox" Tag="Pitch" Content="Тон" Checked="IslandMenuAction_Changed" Unchecked="IslandMenuAction_Changed" />
                                                                                        </Grid>
                                                                                    </Border>
                                                                                <Border Tag="Overlay" Style="{StaticResource ReorderRowStyle}">
                                                                                        <Grid>
                                                                                            <Grid.ColumnDefinitions>
                                                                                                <ColumnDefinition Width="24" />
                                                                                                <ColumnDefinition Width="*" />
                                                                                            </Grid.ColumnDefinitions>
                                                                                            <TextBlock Style="{StaticResource ReorderGripStyle}" />
                                                                                            <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="0" x:Name="IslandMenuOverlayCheckBox" Tag="Overlay" Content="Совместимость с играми и оверлеем" Checked="IslandMenuAction_Changed" Unchecked="IslandMenuAction_Changed" />
                                                                                        </Grid>
                                                                                    </Border>
                                                                                <Border Tag="Settings" Style="{StaticResource ReorderRowStyle}">
                                                                                        <Grid>
                                                                                            <Grid.ColumnDefinitions>
                                                                                                <ColumnDefinition Width="24" />
                                                                                                <ColumnDefinition Width="*" />
                                                                                            </Grid.ColumnDefinitions>
                                                                                            <TextBlock Style="{StaticResource ReorderGripStyle}" />
                                                                                            <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="0" x:Name="IslandMenuSettingsCheckBox" Tag="Settings" Content="Настройки острова" Checked="IslandMenuAction_Changed" Unchecked="IslandMenuAction_Changed" />
                                                                                        </Grid>
                                                                                    </Border>
                                                                                </StackPanel>
                                                                                <TextBlock Text="Если скрыть все пункты, меню по правой кнопке мыши не откроется."
                                                                                           Style="{StaticResource SettingsHelperTextStyle}" Margin="0,6,0,16" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="PageHotkeys" Visibility="Collapsed">
                    </StackPanel>

                    <!-- Профиль: перенос настроек на другой компьютер одним .lumi-файлом (JSON, LumiProfile.cs) — завершённая функция, а не экспериментальная;
                         плейлист и избранное не входят, только тема, акцент, эквалайзер, хоткеи и т.п. -->
                    <StackPanel x:Name="PageProfile" Visibility="Collapsed">
                    </StackPanel>

                    <StackPanel x:Name="PageUpdates" Visibility="Collapsed" />

                    <!-- О плеере (+ Патчноуты) -->
                    <StackPanel x:Name="PageAbout" Visibility="Collapsed" />

                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- Вид навигации «Таблетки»: панель сверху + поиск справа (SettingsWindow.ApplyNavigationStyle). -->
            <Grid x:Name="TopNavBar" Grid.Row="0" Grid.ColumnSpan="2" Margin="18,12,18,10" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- Отступы выровнены: Padding 2,4 + поля пунктов 2 + рамка 1 = 5 со всех сторон, поэтому слева, справа, сверху и снизу
                     подсветка отстоит от края одинаково, а радиус 23 = половина высоты 46. -->
                <Border x:Name="TopNavStrip" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center"
                        Padding="2,4" CornerRadius="23" BorderThickness="1" TextOptions.TextHintingMode="Animated"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <RepeatButton x:Name="TopNavLeftArrow" Grid.Column="0" Tag="-1" Visibility="Collapsed"
                                      Style="{StaticResource NavArrowButtonStyle}" Click="TopNavArrow_Click">
                            <Path Data="M 6,1 L 1.5,6 L 6,11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RepeatButton}}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </RepeatButton>
                        <!-- Полоса прокрутки скрыта: листать можно стрелками и колесом, выбранный пункт прокручивается в зону видимости. -->
                        <ScrollViewer x:Name="TopNavScroll" Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                      PreviewMouseWheel="NavScroll_PreviewMouseWheel" ScrollChanged="TopNavScroll_ScrollChanged">
                            <Grid>
                                <!-- Скользящая акцентная подсветка выбранной таблетки; позицию задаёт UpdatePillHighlight. -->
                                <Border x:Name="PillHighlight" HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Height="36" Width="0" CornerRadius="18" IsHitTestVisible="False" Visibility="Collapsed"
                                        Background="{DynamicResource AccentFillColorDefaultBrush}">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="PillHighlightTranslate" />
                                    </Border.RenderTransform>
                                </Border>
                                <StackPanel x:Name="TopNavPanel" Orientation="Horizontal" SizeChanged="TopNavPanel_SizeChanged" />
                            </Grid>
                        </ScrollViewer>
                        <RepeatButton x:Name="TopNavRightArrow" Grid.Column="2" Tag="1" Visibility="Collapsed"
                                      Style="{StaticResource NavArrowButtonStyle}" Click="TopNavArrow_Click">
                            <Path Data="M 1.5,1 L 6,6 L 1.5,11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RepeatButton}}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </RepeatButton>
                    </Grid>
                </Border>
                <Border x:Name="TopSearchHost" Grid.Column="1" Width="240" Margin="12,0,0,0" VerticalAlignment="Center" />
            </Grid>

            <!-- Плавающая нижняя панель; не занимает места в раскладке, поэтому странице оставляется нижний отступ. -->
            <local:SoftShadowBorder x:Name="FloatingNavBar" Grid.Row="1" Grid.ColumnSpan="2" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,42" Padding="6"
                    CornerRadius="27" Panel.ZIndex="20" TextOptions.TextRenderingMode="Grayscale" TextOptions.TextHintingMode="Animated"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                <!-- Тень рисует сама рамка слоями (SoftShadowBorder), а не DropShadowEffect: встроенный эффект считается программно и
                     пересчитывался на каждом кадре движения панели. Нижний отступ 42 = отступ карточки страницы (16) + запас 26: панель
                     целиком лежит внутри карточки и тень не пересекает её нижнюю границу.
                     Padding 6 + рамка 1 = 7 со всех сторон; радиус панели = радиус пункта + 7 (ApplyNavigationStyle).
                     Прокручиваемая область обрезается капсулой в том же радиусе (FloatingNavScroll_SizeChanged). ScrollViewer нужен на случай,
                     когда панель с названиями шире окна: полоса скрыта, листается колесом. -->
                <ScrollViewer x:Name="FloatingNavScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"
                              PreviewMouseWheel="NavScroll_PreviewMouseWheel" SizeChanged="FloatingNavScroll_SizeChanged">
                    <ScrollViewer.RenderTransform>
                        <TranslateTransform x:Name="FloatingNavShift" />
                    </ScrollViewer.RenderTransform>
                    <!-- Панель сама рисует скользящую подсветку и раскладывает пункты по степени выбора каждого из них (его двигает пружина).
                         Текст в панели — в оттенках серого и с режимом Animated (без привязки глифов к сетке пикселей): у движущегося текста
                         ClearType даёт мерцание окантовки, а привязка к сетке — шаги по целому пикселю. -->
                    <local:ExpressiveNavPanel x:Name="FloatingNavPanel" HighlightBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                              SizeChanged="FloatingNavPanel_SizeChanged" />
                </ScrollViewer>
            </local:SoftShadowBorder>

            <!-- Результаты поиска, когда боковой панели нет: SearchResultsHost переезжает сюда. -->
            <Border x:Name="SearchOverlayHost" Grid.Row="1" Grid.ColumnSpan="2" Visibility="Collapsed"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,32,0" Width="330" MaxHeight="380"
                    Padding="8" CornerRadius="16" Panel.ZIndex="30"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.28" />
                </Border.Effect>
            </Border>

        </Grid>

    </Grid>
</ui:FluentWindow>
