                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsRowTitleStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEnabled, ElementName=BackdropRadioCombo}" Value="False">
                                                                    <Setter Property="Opacity" Value="0.45" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel x:Name="BackdropRadioGroup" Grid.Column="1" VerticalAlignment="Center">
                                                <ComboBox x:Name="BackdropRadioCombo" Tag="RadioGroup" AutomationProperties.Name="Основа окна" MinWidth="220" HorizontalAlignment="Right">
                                                    <ComboBoxItem Content="Mica (лёгкое размытие, по умолчанию)" Tag="BackdropMicaRadio" />
                                                    <ComboBoxItem Content="Mica Alt (более плотная и контрастная основа, Windows 11 22H2+)" Tag="BackdropMicaAltRadio" />
                                                    <ComboBoxItem Content="Acrylic (сильнее размытие и прозрачность)" Tag="BackdropAcrylicRadio" />
                                                    <ComboBoxItem Content="Размытие" Tag="BackdropBlurRadio" />
