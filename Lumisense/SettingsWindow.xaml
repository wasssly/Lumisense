<ui:FluentWindow x:Class="AudioPlayer.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:AudioPlayer"
        Title="Настройки"
        Icon="/Icons/app/lumisense-settings.ico"
        Height="760" Width="920"
        MinHeight="600" MinWidth="800"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="Manual"
        ResizeMode="CanResize"
        PreviewKeyDown="SettingsWindow_PreviewKeyDown">

    <ui:FluentWindow.Resources>

        <!-- Стиль пунктов панели навигации слева: RadioButton без "кружка", вместо этого
             вся строка (иконка + подпись) подсвечивается фоном, когда пункт выбран. -->
        <Style x:Key="NavItemStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" CornerRadius="8" Background="Transparent">
                            <ContentPresenter Margin="12,10" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource ControlFillColorDefaultBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Карточка-превью вида плеера в настройках: RadioButton с картинкой-миниатюрой
             внутри, подсвечивается акцентной рамкой, когда выбран (см. PageWindow /
             PlayerViewModeCard). -->
        <Style x:Key="ViewModeThumbStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" CornerRadius="10" BorderThickness="2"
                                BorderBrush="Transparent" Padding="8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush"
                                        Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Карточка-секция настроек: используется на каждой странице -->
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <!-- Заголовок страницы настроек -->
        <Style x:Key="PageTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <!-- Строка результата поиска настроек: прозрачная кнопка на всю ширину со скруглённой
             подсветкой при наведении, как у пунктов навигации -->
        <Style x:Key="SearchResultItemStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="8" Background="{TemplateBinding Background}">
                            <ContentPresenter Margin="12,9" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Заголовок окна (Fluent TitleBar) — та же стандартная раскладка кнопок
             свернуть/развернуть/закрыть, что и в главном окне (см. MainWindow.xaml,
             AppTitleBar): ShowMaximize="True", раз окно и так уже CanResize. -->
        <ui:TitleBar Grid.Row="0" Title="Настройки" ShowMaximize="True" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== Панель навигации ===== -->
            <Border Grid.Column="0" Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="12,12,12,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <ui:TextBox x:Name="SettingsSearchBox" Grid.Row="0" Margin="0,0,0,10"
                                PlaceholderText="Поиск настроек"
                                ClearButtonEnabled="True"
                                TextChanged="SettingsSearchBox_TextChanged">
                        <ui:TextBox.Icon>
                            <local:SvgPathIcon Icon="IconSearch" />
                        </ui:TextBox.Icon>
                    </ui:TextBox>

                    <Grid Grid.Row="1">
                        <StackPanel x:Name="NavCategoriesPanel">

                    <RadioButton x:Name="NavAppearance" Style="{StaticResource NavItemStyle}"
                                 GroupName="SettingsNav" Tag="Appearance"
                                 Checked="NavItem_Checked">
                        <StackPanel Orientation="Horizontal">
                            <local:SvgPathIcon Icon="IconSun" Size="18" VerticalAlignment="Center" />
                            <TextBlock Text="Оформление" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavWindow" Style="{StaticResource NavItemStyle}"
                                 GroupName="SettingsNav" Tag="Window" Checked="NavItem_Checked">
                        <StackPanel Orientation="Horizontal">
                            <local:SvgPathIcon Icon="IconWindow" Size="18" VerticalAlignment="Center" />
                            <TextBlock Text="Окно" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavPlayback" Style="{StaticResource NavItemStyle}"
                                 GroupName="SettingsNav" Tag="Playback" Checked="NavItem_Checked">
                        <StackPanel Orientation="Horizontal">
                            <local:SvgPathIcon Icon="IconPlay" Size="16" VerticalAlignment="Center" />
                            <TextBlock Text="Воспроизведение" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <!-- Вынесено в отдельную страницу из "Воспроизведение" — карточек про
                         всплывающее уведомление о смене трека (вкл/выкл, расположение, размер,
                         монитор) набралось достаточно, чтобы не мешать настройкам громкости и
                         шаффла на той же странице. -->
                    <RadioButton x:Name="NavNotifications" Style="{StaticResource NavItemStyle}"
                                 GroupName="SettingsNav" Tag="Notifications" Checked="NavItem_Checked">
                        <StackPanel Orientation="Horizontal">
                            <local:SvgPathIcon Icon="IconBell" Size="18" VerticalAlignment="Center" />
                            <TextBlock Text="Уведомления" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavEqualizer" Style="{StaticResource NavItemStyle}"
                                 GroupName="SettingsNav" Tag="Equalizer" Checked="NavItem_Checked">
                        <StackPanel Orientation="Horizontal">
                            <local:SvgPathIcon Icon="IconSpeaker2" Size="18" VerticalAlignment="Center" />
                            <TextBlock Text="Эквалайзер" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavMiniPlayer" Style="{StaticResource NavItemStyle}"
                                 GroupName="SettingsNav" Tag="MiniPlayer" Checked="NavItem_Checked">
                        <StackPanel Orientation="Horizontal">
                            <local:SvgPathIcon Icon="IconPictureInPicture" Size="18" VerticalAlignment="Center" />
                            <TextBlock Text="Мини-плеер" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavHotkeys" Style="{StaticResource NavItemStyle}"
                                 GroupName="SettingsNav" Tag="Hotkeys" Checked="NavItem_Checked">
                        <StackPanel Orientation="Horizontal">
                            <local:SvgPathIcon Icon="IconKeyboard" Size="18" VerticalAlignment="Center" />
                            <TextBlock Text="Горячие клавиши" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <!-- Вынесено в отдельную страницу из "Экспериментальное" — экспорт/импорт
                         настроек в .lumi-файл (см. LumiProfile.cs) это не экспериментальная
                         функция, а обычная и завершённая, ей просто не хватало собственного
                         места вместо соседства со случайным набором мелких переключателей. -->
                    <RadioButton x:Name="NavProfile" Style="{StaticResource NavItemStyle}"
                                 GroupName="SettingsNav" Tag="Profile" Checked="NavItem_Checked">
                        <StackPanel Orientation="Horizontal">
                            <local:SvgPathIcon Icon="IconSync" Size="18" VerticalAlignment="Center" />
                            <TextBlock Text="Профиль" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <Separator Margin="4,8" Background="{DynamicResource ControlStrongFillColorDefaultBrush}" />

                    <RadioButton x:Name="NavAbout" Style="{StaticResource NavItemStyle}"
                                 GroupName="SettingsNav" Tag="About" Checked="NavItem_Checked">
                        <StackPanel Orientation="Horizontal">
                            <local:SvgPathIcon Icon="IconInfo" Size="18" VerticalAlignment="Center" />
                            <TextBlock Text="О плеере" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                        </StackPanel>

                        <!-- ===== Результаты поиска настроек (заменяют список категорий, пока идёт поиск) ===== -->
                        <Grid x:Name="SearchResultsHost" Visibility="Collapsed">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="SearchResultsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource SearchResultItemStyle}" Click="SearchResultItem_Click">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Label}" FontSize="13" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding PageTitle}" FontSize="11" Opacity="0.55" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <StackPanel x:Name="SearchEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                <local:SvgPathIcon Icon="IconSearch" Size="22" Opacity="0.35" HorizontalAlignment="Center" />
                                <TextBlock Text="Ничего не найдено" Opacity="0.5" FontSize="12" Margin="0,8,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <!-- ===== Содержимое выбранной страницы =====
                 Один и тот же ScrollViewer используется для ВСЕХ страниц — переключение вкладки
                 (см. NavItem_Checked) просто скрывает один StackPanel и показывает другой, сам
                 ScrollViewer при этом не пересоздаётся. Из-за этого его VerticalOffset раньше
                 сохранялся между вкладками: если долистать вниз на одной странице и переключиться
                 на другую, та открывалась не сверху, а с той же прокруткой, что осталась от
                 предыдущей — см. явный сброс в PART_ContentScroll.ScrollToTop() в NavItem_Checked. -->
            <ScrollViewer x:Name="PART_ContentScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <Grid Margin="24,20,24,20">

                    <!-- Оформление -->
                    <StackPanel x:Name="PageAppearance">
                        <TextBlock Text="Оформление" Style="{StaticResource PageTitleStyle}" />

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Тема" Margin="0,0,0,8" />
                                <RadioButton x:Name="ThemeDarkRadio" Content="Тёмная" GroupName="Theme"
                                             Checked="ThemeRadio_Changed" Margin="0,0,0,8" />
                                <RadioButton x:Name="ThemeLightRadio" Content="Светлая" GroupName="Theme"
                                             Checked="ThemeRadio_Changed" />
                            </StackPanel>
                        </Border>

                        <!-- См. AppSettings.AccentColorMode/AccentColorHex. Пресеты — просто восемь
                             готовых hex-цветов; "Свой" открывает стандартный системный ColorDialog. У
                             выбранного сейчас цвета (если это один из пресетов) рамка подсвечена белым —
                             см. RefreshAccentSwatchSelection. -->
                        <Border Style="{StaticResource SettingsCardStyle}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Акцентный цвет" Margin="0,0,0,8" />
                                <RadioButton x:Name="AccentSystemRadio" Content="Системный (как в Windows)"
                                             GroupName="AccentMode" Checked="AccentModeRadio_Changed" Margin="0,0,0,10" />
                                <RadioButton x:Name="AccentManualRadio" Content="Свой" GroupName="AccentMode"
                                             Checked="AccentModeRadio_Changed" Margin="0,0,0,10" />

                                <WrapPanel x:Name="AccentSwatchesPanel" Margin="26,0,0,0">
                                    <Border x:Name="AccentSwatch0" Width="26" Height="26" CornerRadius="6"
                                            Margin="0,0,8,8" Background="#0078D4" BorderThickness="2"
                                            BorderBrush="Transparent" Cursor="Hand"
                                            MouseLeftButtonDown="AccentSwatch_MouseLeftButtonDown" />
                                    <Border x:Name="AccentSwatch1" Width="26" Height="26" CornerRadius="6"
                                            Margin="0,0,8,8" Background="#8764B8" BorderThickness="2"
                                            BorderBrush="Transparent" Cursor="Hand"
                                            MouseLeftButtonDown="AccentSwatch_MouseLeftButtonDown" />
                                    <Border x:Name="AccentSwatch2" Width="26" Height="26" CornerRadius="6"
                                            Margin="0,0,8,8" Background="#E3008C" BorderThickness="2"
                                            BorderBrush="Transparent" Cursor="Hand"
                                            MouseLeftButtonDown="AccentSwatch_MouseLeftButtonDown" />
                                    <Border x:Name="AccentSwatch3" Width="26" Height="26" CornerRadius="6"
                                            Margin="0,0,8,8" Background="#E81123" BorderThickness="2"
                                            BorderBrush="Transparent" Cursor="Hand"
                                            MouseLeftButtonDown="AccentSwatch_MouseLeftButtonDown" />
                                    <Border x:Name="AccentSwatch4" Width="26" Height="26" CornerRadius="6"
                                            Margin="0,0,8,8" Background="#FF8C00" BorderThickness="2"
                                            BorderBrush="Transparent" Cursor="Hand"
                                            MouseLeftButtonDown="AccentSwatch_MouseLeftButtonDown" />
                                    <Border x:Name="AccentSwatch5" Width="26" Height="26" CornerRadius="6"
                                            Margin="0,0,8,8" Background="#FFB900" BorderThickness="2"
                                            BorderBrush="Transparent" Cursor="Hand"
                                            MouseLeftButtonDown="AccentSwatch_MouseLeftButtonDown" />
                                    <Border x:Name="AccentSwatch6" Width="26" Height="26" CornerRadius="6"
                                            Margin="0,0,8,8" Background="#107C10" BorderThickness="2"
                                            BorderBrush="Transparent" Cursor="Hand"
                                            MouseLeftButtonDown="AccentSwatch_MouseLeftButtonDown" />
                                    <Border x:Name="AccentSwatch7" Width="26" Height="26" CornerRadius="6"
                                            Margin="0,0,8,8" Background="#00B7C3" BorderThickness="2"
                                            BorderBrush="Transparent" Cursor="Hand"
                                            MouseLeftButtonDown="AccentSwatch_MouseLeftButtonDown" />

                                    <ui:Button x:Name="AccentCustomButton" Width="26" Height="26" Padding="0"
                                               Margin="0,0,8,8" Appearance="Secondary" ToolTip="Свой цвет через палитру"
                                               Click="AccentCustomButton_Click">
                                        <ui:Button.Icon>
                                            <local:SvgPathIcon Icon="IconEdit" Size="12" />
                                        </ui:Button.Icon>
                                    </ui:Button>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- См. AppSettings.WindowBackdropType. -->
                        <Border Style="{StaticResource SettingsCardStyle}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Основа окна" Margin="0,0,0,8" />
                                <RadioButton x:Name="BackdropMicaRadio" Content="Mica (лёгкое размытие, по умолчанию)"
                                             GroupName="Backdrop" Checked="WindowBackdropRadio_Changed" Margin="0,0,0,8" />
                                <RadioButton x:Name="BackdropAcrylicRadio" Content="Acrylic (сильнее размытие и прозрачность)"
                                             GroupName="Backdrop" Checked="WindowBackdropRadio_Changed" Margin="0,0,0,4" />
                                <TextBlock Text="Применяется к главному окну, окну настроек и статистике."
                                           FontSize="12" Opacity="0.6" TextWrapping="Wrap" Margin="26,0,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- См. AppSettings.AlbumArtTransitionEnabled. -->
                        <Border Style="{StaticResource SettingsCardStyle}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Анимация смены обложки" Margin="0,0,0,8" />
                                <RadioButton x:Name="AlbumArtTransitionOnRadio" Content="С анимацией" GroupName="AlbumArtTransition"
                                             Checked="AlbumArtTransitionRadio_Changed" Margin="0,0,0,8" />
                                <RadioButton x:Name="AlbumArtTransitionOffRadio" Content="Без анимации" GroupName="AlbumArtTransition"
                                             Checked="AlbumArtTransitionRadio_Changed" Margin="0,0,0,4" />
                                <TextBlock Text="При переключении трека старая обложка «улетает» в сторону, а новая «влетает» с противоположной — как в iTunes."
                                           FontSize="12" Opacity="0.6" TextWrapping="Wrap" Margin="26,0,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Раньше жила на странице "Экспериментальное" — по сути обычная
                             визуальная настройка кнопок, а не что-то экспериментальное. -->
                        <Border Style="{StaticResource SettingsCardStyle}" Margin="0,12,0,0">
                            <StackPanel>
                                <CheckBox x:Name="HidePlaybackButtonsCheckBox"
                                          Checked="HidePlaybackButtonsCheckBox_Changed" Unchecked="HidePlaybackButtonsCheckBox_Changed">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Убрать фон у кнопок управления воспроизведением" VerticalAlignment="Center" />
                                        <!-- Настройка недавно вынесена с прежней страницы "Экспериментальное" (см.
                                             комментарий выше) — сама функция ещё не так давно обкатывается, поэтому
                                             помечена как бета, чтобы это было сразу видно, а не только в описании ниже. -->
                                        <Border Background="{DynamicResource AccentTextFillColorPrimaryBrush}" CornerRadius="4"
                                                Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="БЕТА" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="White" />
                                        </Border>
                                    </StackPanel>
                                </CheckBox>
                                <TextBlock Text="Убирает фон у кнопок «Перемешать», «Повтор», «Предыдущий», «Пуск/Пауза», «Следующий», «Стоп» и перехода в мини-плеер в главном окне — сами кнопки остаются на месте и работают как раньше, просто фон становится прозрачным и сливается с фоном плеера, видна только иконка."
                                           FontSize="12" Opacity="0.6" TextWrapping="Wrap" Margin="26,4,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Окно -->
                    <StackPanel x:Name="PageWindow" Visibility="Collapsed">
                        <TextBlock Text="Окно" Style="{StaticResource PageTitleStyle}" />

                        <Border x:Name="PlayerViewModeCard" Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Вид плеера" FontWeight="SemiBold" Margin="0,0,0,2" />
                                <TextBlock Text="Как выглядит и какого размера главное окно плеера"
                                           Opacity="0.6" FontSize="12" Margin="0,0,0,12" TextWrapping="Wrap" />

                                <StackPanel Orientation="Horizontal">

                                    <!-- Квадратный вид: крупный контент + открытый по умолчанию плейлист,
                                         занимающий всю ширину окна -->
                                    <RadioButton x:Name="ViewModeSquareRadio" Style="{StaticResource ViewModeThumbStyle}"
                                                 GroupName="PlayerViewModeGroup" Tag="Square" Margin="0,0,10,0"
                                                 Checked="PlayerViewModeRadio_Checked">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Border Width="64" Height="64" CornerRadius="6"
                                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                    BorderBrush="{DynamicResource ControlStrongFillColorDefaultBrush}"
                                                    BorderThickness="1">
                                                <Grid Margin="6">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="26" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>
                                                    <Ellipse Grid.Row="0" Width="22" Height="22"
                                                             Fill="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                    <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Margin="0,4,0,0">
                                                        <Rectangle Height="5" Margin="0,0,0,3"
                                                                   Fill="{DynamicResource ControlStrongFillColorDefaultBrush}" />
                                                        <Rectangle Height="5" Margin="0,0,0,3"
                                                                   Fill="{DynamicResource ControlStrongFillColorDefaultBrush}" />
                                                        <Rectangle Height="5"
                                                                   Fill="{DynamicResource ControlStrongFillColorDefaultBrush}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="Квадратный" Foreground="White" FontSize="12" Margin="0,6,0,0"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>

                                    <!-- Прямоугольный вид: обычные размеры элементов, плейлист виден сбоку/снизу -->
                                    <RadioButton x:Name="ViewModeRectangularRadio" Style="{StaticResource ViewModeThumbStyle}"
                                                 GroupName="PlayerViewModeGroup" Tag="Rectangular" Margin="0,0,10,0"
                                                 Checked="PlayerViewModeRadio_Checked">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Border Width="44" Height="64" CornerRadius="6"
                                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                    BorderBrush="{DynamicResource ControlStrongFillColorDefaultBrush}"
                                                    BorderThickness="1">
                                                <Grid Margin="5">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="18" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>
                                                    <Ellipse Grid.Row="0" Width="14" Height="14"
                                                             HorizontalAlignment="Center"
                                                             Fill="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                    <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Margin="0,4,0,0">
                                                        <Rectangle Height="4" Margin="0,0,0,3"
                                                                   Fill="{DynamicResource ControlStrongFillColorDefaultBrush}" />
                                                        <Rectangle Height="4" Margin="0,0,0,3"
                                                                   Fill="{DynamicResource ControlStrongFillColorDefaultBrush}" />
                                                        <Rectangle Height="4" Margin="0,0,0,3"
                                                                   Fill="{DynamicResource ControlStrongFillColorDefaultBrush}" />
                                                        <Rectangle Height="4"
                                                                   Fill="{DynamicResource ControlStrongFillColorDefaultBrush}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="Прямоугольный" Foreground="White" FontSize="12" Margin="0,6,0,0"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>

                                    <!-- Мини-плеер: узкая горизонтальная плашка без плейлиста -->
                                    <RadioButton x:Name="ViewModeMiniRadio" Style="{StaticResource ViewModeThumbStyle}"
                                                 GroupName="PlayerViewModeGroup" Tag="Mini"
                                                 Checked="PlayerViewModeRadio_Checked">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Border Width="76" Height="64" CornerRadius="6"
                                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                    BorderBrush="{DynamicResource ControlStrongFillColorDefaultBrush}"
                                                    BorderThickness="1">
                                                <Border Width="60" Height="20" CornerRadius="10"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                        BorderBrush="{DynamicResource ControlStrongFillColorDefaultBrush}"
                                                        BorderThickness="1">
                                                    <Grid Margin="4,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Ellipse Grid.Column="0" Width="10" Height="10"
                                                                 VerticalAlignment="Center"
                                                                 Fill="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                        <Rectangle Grid.Column="1" Height="4" Margin="4,0,0,0"
                                                                   VerticalAlignment="Center"
                                                                   Fill="{DynamicResource ControlStrongFillColorDefaultBrush}" />
                                                    </Grid>
                                                </Border>
                                            </Border>
                                            <TextBlock Text="Мини-плеер" Foreground="White" FontSize="12" Margin="0,6,0,0"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>

                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <CheckBox x:Name="AlwaysOnTopCheckBox" Content="Поверх всех окон"
                                          Checked="AlwaysOnTopCheckBox_Changed" Unchecked="AlwaysOnTopCheckBox_Changed"
                                          Margin="0,0,0,8" />
                                <CheckBox x:Name="MinimizeToTrayCheckBox" Content="Сворачивать в трей при закрытии"
                                          Checked="MinimizeToTrayCheckBox_Changed" Unchecked="MinimizeToTrayCheckBox_Changed" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}" Margin="0,12,0,0">
                            <StackPanel>
                                <CheckBox x:Name="LaunchOnStartupCheckBox" Content="Запускать вместе с Windows"
                                          Checked="LaunchOnStartupCheckBox_Changed" Unchecked="LaunchOnStartupCheckBox_Changed"
                                          Margin="0,0,0,8" />
                                <CheckBox x:Name="StartHiddenInTrayCheckBox" Content="Запускать свёрнутым в трей"
                                          Checked="StartHiddenInTrayCheckBox_Changed" Unchecked="StartHiddenInTrayCheckBox_Changed" />
                                <TextBlock Text="Окно плеера не появляется при запуске — сразу только значок в трее. Работает и без автозапуска с Windows: например, вместе с ярлыком в папке автозагрузки, если предпочитаете такой способ."
                                           FontSize="12" Opacity="0.6" TextWrapping="Wrap" Margin="26,4,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Воспроизведение -->
                    <StackPanel x:Name="PagePlayback" Visibility="Collapsed">
                        <TextBlock Text="Воспроизведение" Style="{StaticResource PageTitleStyle}" />

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <CheckBox x:Name="RememberVolumeCheckBox" Content="Запоминать громкость между запусками"
                                          Checked="RememberVolumeCheckBox_Changed" Unchecked="RememberVolumeCheckBox_Changed"
                                          Margin="0,0,0,8" />
                                <CheckBox x:Name="LogarithmicVolumeCheckBox" Content="Логарифмическая регулировка громкости"
                                          Checked="LogarithmicVolumeCheckBox_Changed" Unchecked="LogarithmicVolumeCheckBox_Changed" />
                                <TextBlock Text="Ползунок громкости меняет уровень так, как его воспринимает слух: заметный на глаз ход в начале и в конце шкалы звучит одинаково плавно, без резкого скачка на малой громкости."
                                           FontSize="12" Opacity="0.6" TextWrapping="Wrap" Margin="26,4,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Раньше называлась "Улучшенный шаффл" и жила на странице "Экспериментальное" —
                             имя настройки в AppSettings (UseImprovedShuffle) осталось прежним, чтобы не
                             сбрасывать выбор тем, у кого он уже был включён, изменилось только то, как
                             это называется в интерфейсе. -->
                        <Border Style="{StaticResource SettingsCardStyle}" Margin="0,12,0,0">
                            <StackPanel>
                                <CheckBox x:Name="ImprovedShuffleCheckBox" Content="Шаффл без повторов"
                                          Checked="ImprovedShuffleCheckBox_Changed" Unchecked="ImprovedShuffleCheckBox_Changed" />
                                <TextBlock Text="Вместо чисто случайного выбора трека на каждом шаге сначала тасуется весь плейлист целиком, а треки проигрываются по порядку из этой тасовки — так один и тот же трек не может повториться, пока не сыграют все остальные."
                                           FontSize="12" Opacity="0.6" TextWrapping="Wrap" Margin="26,4,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Уведомления — раньше жили на странице "Воспроизведение", вынесены на
                         отдельную страницу: набралось три карточки только про всплывающее
                         уведомление о смене трека (вкл/выкл, расположение, размер, монитор). -->
                    <StackPanel x:Name="PageNotifications" Visibility="Collapsed">
                        <TextBlock Text="Уведомления" Style="{StaticResource PageTitleStyle}" />

                        <!-- См. AppSettings.ShowTrackChangeToast и TrackChangeToastWindow. -->
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <CheckBox x:Name="TrackChangeToastCheckBox" Content="Уведомление о смене трека"
                                          Checked="TrackChangeToastCheckBox_Changed" Unchecked="TrackChangeToastCheckBox_Changed"
                                          Margin="0,0,0,4" />
                                <TextBlock Text="Маленькая карточка с обложкой и названием в углу экрана — появляется на пару секунд при каждом переключении трека и пропадает сама."
                                           FontSize="12" Opacity="0.6" TextWrapping="Wrap" Margin="26,0,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- См. AppSettings.TrackChangeToastPosition/TrackChangeToastMonitor/TrackChangeToastWidth.
                             Список мониторов в ToastMonitorCombo заполняется в code-behind (InitializeSettings) —
                             в разметке заранее известен только первый пункт "Автоматически". -->
                        <Border Style="{StaticResource SettingsCardStyle}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Расположение уведомления" Margin="0,0,0,8" />
                                <UniformGrid Columns="3" Margin="0,0,0,14">
                                    <RadioButton x:Name="ToastPosTopLeftRadio" Content="Сверху слева"
                                                 GroupName="ToastPosition" Checked="ToastPositionRadio_Changed" Margin="0,0,0,8" />
                                    <RadioButton x:Name="ToastPosTopCenterRadio" Content="Сверху по центру"
                                                 GroupName="ToastPosition" Checked="ToastPositionRadio_Changed" Margin="0,0,0,8" />
                                    <RadioButton x:Name="ToastPosTopRightRadio" Content="Сверху справа"
                                                 GroupName="ToastPosition" Checked="ToastPositionRadio_Changed" Margin="0,0,0,8" />
                                    <RadioButton x:Name="ToastPosBottomLeftRadio" Content="Снизу слева"
                                                 GroupName="ToastPosition" Checked="ToastPositionRadio_Changed" />
                                    <RadioButton x:Name="ToastPosBottomCenterRadio" Content="Снизу по центру"
                                                 GroupName="ToastPosition" Checked="ToastPositionRadio_Changed" />
                                    <RadioButton x:Name="ToastPosBottomRightRadio" Content="Снизу справа"
                                                 GroupName="ToastPosition" Checked="ToastPositionRadio_Changed" />
                                </UniformGrid>

                                <TextBlock Text="Размер" Margin="0,0,0,8" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <RadioButton x:Name="ToastSizeSmallRadio" Content="Маленький"
                                                 GroupName="ToastSize" Checked="ToastSizeRadio_Changed" Margin="0,0,16,0" />
                                    <RadioButton x:Name="ToastSizeMediumRadio" Content="Средний"
                                                 GroupName="ToastSize" Checked="ToastSizeRadio_Changed" Margin="0,0,16,0" />
                                    <RadioButton x:Name="ToastSizeLargeRadio" Content="Большой"
                                                 GroupName="ToastSize" Checked="ToastSizeRadio_Changed" />
                                </StackPanel>

                                <!-- См. AppSettings.TrackChangeToastWidth — независимо от размера выше,
                                     только ширина карточки (и то, сколько текста влезает в строку). -->
                                <TextBlock Text="Ширина" Margin="0,0,0,8" />
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" x:Name="ToastWidthValueText" Text="300 px"
                                               Opacity="0.6" FontSize="12" VerticalAlignment="Center" />
                                </Grid>
                                <Slider x:Name="ToastWidthSlider" Minimum="220" Maximum="420" Value="300"
                                        TickFrequency="10" IsSnapToTickEnabled="True"
                                        ValueChanged="ToastWidthSlider_ValueChanged" Margin="0,0,0,14" />

                                <TextBlock Text="Монитор" Margin="0,0,0,8" />
                                <ComboBox x:Name="ToastMonitorCombo" SelectionChanged="ToastMonitorCombo_SelectionChanged"
                                          HorizontalAlignment="Left" MinWidth="220" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Эквалайзер -->
                    <StackPanel x:Name="PageEqualizer" Visibility="Collapsed">
                        <TextBlock Text="Эквалайзер" Style="{StaticResource PageTitleStyle}" />

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <CheckBox x:Name="EqualizerEnabledCheckBox" Content="Включить эквалайзер"
                                          Checked="EqualizerEnabledCheckBox_Changed" Unchecked="EqualizerEnabledCheckBox_Changed"
                                          Margin="0,0,0,4" />
                                <TextBlock Text="10 полос графического эквалайзера — регулировки применяются сразу же, без перезапуска трека."
                                           FontSize="12" Opacity="0.6" TextWrapping="Wrap" Margin="26,0,0,16" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 10 одинаковых колонок: значение в дБ сверху, вертикальный слайдер
                                         посередине, частота полосы снизу. Все десять слайдеров используют
                                         ОДИН общий обработчик (EqualizerBandSlider_ValueChanged) — номер
                                         полосы передаётся через Tag, а не десятью отдельными методами. -->
                                    <!-- Width="46" TextAlignment="Center" на EqBandXValueText (а не просто
                                         HorizontalAlignment="Center" на тексте переменной длины) — иначе
                                         во время перетаскивания слайдера, пока текст скачет между "0 дБ",
                                         "-3.5 дБ", "+12 дБ" и т.п. (разная длина строки), StackPanel без
                                         фиксированной ширины пересчитывал свою auto-ширину под самый
                                         широкий момент — и слайдер, центрированный внутри той же StackPanel,
                                         визуально дёргался влево-вправо вслед за этим пересчётом на каждом
                                         кадре перетаскивания. Фиксированная ширина текста делает ширину
                                         StackPanel постоянной, и дёргание пропадает. -->
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <TextBlock x:Name="EqBand0ValueText" Text="0 дБ" FontSize="11" Opacity="0.6" Width="46" TextAlignment="Center" Margin="0,0,0,4" />
                                        <Slider x:Name="EqBand0Slider" Tag="0" Orientation="Vertical" Height="140"
                                                Minimum="-12" Maximum="12" TickFrequency="3" SmallChange="0.5"
                                                ValueChanged="EqualizerBandSlider_ValueChanged"
                                                MouseWheel="EqualizerBandSlider_MouseWheel" />
                                        <TextBlock Text="31" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock x:Name="EqBand1ValueText" Text="0 дБ" FontSize="11" Opacity="0.6" Width="46" TextAlignment="Center" Margin="0,0,0,4" />
                                        <Slider x:Name="EqBand1Slider" Tag="1" Orientation="Vertical" Height="140"
                                                Minimum="-12" Maximum="12" TickFrequency="3" SmallChange="0.5"
                                                ValueChanged="EqualizerBandSlider_ValueChanged"
                                                MouseWheel="EqualizerBandSlider_MouseWheel" />
                                        <TextBlock Text="62" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                        <TextBlock x:Name="EqBand2ValueText" Text="0 дБ" FontSize="11" Opacity="0.6" Width="46" TextAlignment="Center" Margin="0,0,0,4" />
                                        <Slider x:Name="EqBand2Slider" Tag="2" Orientation="Vertical" Height="140"
                                                Minimum="-12" Maximum="12" TickFrequency="3" SmallChange="0.5"
                                                ValueChanged="EqualizerBandSlider_ValueChanged"
                                                MouseWheel="EqualizerBandSlider_MouseWheel" />
                                        <TextBlock Text="125" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                        <TextBlock x:Name="EqBand3ValueText" Text="0 дБ" FontSize="11" Opacity="0.6" Width="46" TextAlignment="Center" Margin="0,0,0,4" />
                                        <Slider x:Name="EqBand3Slider" Tag="3" Orientation="Vertical" Height="140"
                                                Minimum="-12" Maximum="12" TickFrequency="3" SmallChange="0.5"
                                                ValueChanged="EqualizerBandSlider_ValueChanged"
                                                MouseWheel="EqualizerBandSlider_MouseWheel" />
                                        <TextBlock Text="250" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                                        <TextBlock x:Name="EqBand4ValueText" Text="0 дБ" FontSize="11" Opacity="0.6" Width="46" TextAlignment="Center" Margin="0,0,0,4" />
                                        <Slider x:Name="EqBand4Slider" Tag="4" Orientation="Vertical" Height="140"
                                                Minimum="-12" Maximum="12" TickFrequency="3" SmallChange="0.5"
                                                ValueChanged="EqualizerBandSlider_ValueChanged"
                                                MouseWheel="EqualizerBandSlider_MouseWheel" />
                                        <TextBlock Text="500" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="5" HorizontalAlignment="Center">
                                        <TextBlock x:Name="EqBand5ValueText" Text="0 дБ" FontSize="11" Opacity="0.6" Width="46" TextAlignment="Center" Margin="0,0,0,4" />
                                        <Slider x:Name="EqBand5Slider" Tag="5" Orientation="Vertical" Height="140"
                                                Minimum="-12" Maximum="12" TickFrequency="3" SmallChange="0.5"
                                                ValueChanged="EqualizerBandSlider_ValueChanged"
                                                MouseWheel="EqualizerBandSlider_MouseWheel" />
                                        <TextBlock Text="1к" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="6" HorizontalAlignment="Center">
                                        <TextBlock x:Name="EqBand6ValueText" Text="0 дБ" FontSize="11" Opacity="0.6" Width="46" TextAlignment="Center" Margin="0,0,0,4" />
                                        <Slider x:Name="EqBand6Slider" Tag="6" Orientation="Vertical" Height="140"
                                                Minimum="-12" Maximum="12" TickFrequency="3" SmallChange="0.5"
                                                ValueChanged="EqualizerBandSlider_ValueChanged"
                                                MouseWheel="EqualizerBandSlider_MouseWheel" />
                                        <TextBlock Text="2к" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="7" HorizontalAlignment="Center">
                                        <TextBlock x:Name="EqBand7ValueText" Text="0 дБ" FontSize="11" Opacity="0.6" Width="46" TextAlignment="Center" Margin="0,0,0,4" />
                                        <Slider x:Name="EqBand7Slider" Tag="7" Orientation="Vertical" Height="140"
                                                Minimum="-12" Maximum="12" TickFrequency="3" SmallChange="0.5"
                                                ValueChanged="EqualizerBandSlider_ValueChanged"
                                                MouseWheel="EqualizerBandSlider_MouseWheel" />
                                        <TextBlock Text="4к" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="8" HorizontalAlignment="Center">
                                        <TextBlock x:Name="EqBand8ValueText" Text="0 дБ" FontSize="11" Opacity="0.6" Width="46" TextAlignment="Center" Margin="0,0,0,4" />
                                        <Slider x:Name="EqBand8Slider" Tag="8" Orientation="Vertical" Height="140"
                                                Minimum="-12" Maximum="12" TickFrequency="3" SmallChange="0.5"
                                                ValueChanged="EqualizerBandSlider_ValueChanged"
                                                MouseWheel="EqualizerBandSlider_MouseWheel" />
                                        <TextBlock Text="8к" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="9" HorizontalAlignment="Center">
                                        <TextBlock x:Name="EqBand9ValueText" Text="0 дБ" FontSize="11" Opacity="0.6" Width="46" TextAlignment="Center" Margin="0,0,0,4" />
                                        <Slider x:Name="EqBand9Slider" Tag="9" Orientation="Vertical" Height="140"
                                                Minimum="-12" Maximum="12" TickFrequency="3" SmallChange="0.5"
                                                ValueChanged="EqualizerBandSlider_ValueChanged"
                                                MouseWheel="EqualizerBandSlider_MouseWheel" />
                                        <TextBlock Text="16к" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>

                                <Button x:Name="EqualizerResetButton" Content="Сбросить всё" HorizontalAlignment="Left"
                                        Margin="0,16,0,0" Click="EqualizerResetButton_Click" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Пресеты" FontSize="12" FontWeight="SemiBold" Opacity="0.55" Margin="0,4,0,8" />
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Сохрани текущие настройки полос как пресет, переключайся между ними или поделись файлом пресета с кем-то ещё."
                                           FontSize="12" Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,12" />

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="EqualizerPresetComboBox" Grid.Column="0"
                                              DisplayMemberPath="Name" Margin="0,0,8,0"
                                              SelectionChanged="EqualizerPresetComboBox_SelectionChanged" />
                                    <Button x:Name="EqualizerApplyPresetButton" Grid.Column="1" Content="Применить"
                                            Click="EqualizerApplyPresetButton_Click" />
                                </Grid>

                                <WrapPanel>
                                    <Button x:Name="EqualizerSavePresetButton" Content="Сохранить как пресет…"
                                            Margin="0,0,8,8" Click="EqualizerSavePresetButton_Click" />
                                    <Button x:Name="EqualizerDeletePresetButton" Content="Удалить"
                                            Margin="0,0,8,8" Click="EqualizerDeletePresetButton_Click" />
                                    <Button x:Name="EqualizerExportPresetButton" Content="Поделиться…"
                                            ToolTip="Сохранить выбранный пресет в файл, чтобы переслать его кому-то ещё"
                                            Margin="0,0,8,8" Click="EqualizerExportPresetButton_Click" />
                                    <Button x:Name="EqualizerImportPresetButton" Content="Импортировать…"
                                            ToolTip="Добавить пресет из файла, полученного от кого-то ещё"
                                            Margin="0,0,8,8" Click="EqualizerImportPresetButton_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Мини-плеер -->
                    <StackPanel x:Name="PageMiniPlayer" Visibility="Collapsed">
                        <TextBlock Text="Мини-плеер" Style="{StaticResource PageTitleStyle}" />

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Прозрачность окна" VerticalAlignment="Center" />
                                    <TextBlock x:Name="MiniOpacityValueText" Grid.Column="1" Text="100%"
                                               Opacity="0.6" FontSize="12" VerticalAlignment="Center" />
                                </Grid>

                                <!-- Тот же приём, что и у ползунка громкости в главном окне: сам Slider не
                                     ловит мышь, поверх него прозрачный Border обрабатывает клик/перетаскивание
                                     в любой точке трека целиком, без зависимости от того, куда именно попали
                                     (в шарик или в любую другую точку полосы). -->
                                <Grid Margin="0,0,0,14">
                                    <Slider x:Name="MiniOpacitySlider" IsHitTestVisible="False"
                                            Minimum="0.3" Maximum="1.0" Value="1.0"
                                            ValueChanged="MiniOpacitySlider_ValueChanged" VerticalAlignment="Center" />

                                    <Border Background="Transparent" Height="24" VerticalAlignment="Center"
                                            MouseLeftButtonDown="MiniOpacityOverlay_MouseLeftButtonDown"
                                            MouseMove="MiniOpacityOverlay_MouseMove"
                                            MouseLeftButtonUp="MiniOpacityOverlay_MouseLeftButtonUp" />
                                </Grid>

                                <CheckBox x:Name="MiniAlwaysOnTopCheckBox" Content="Поверх всех окон (мини-плеер)"
                                          Checked="MiniAlwaysOnTopCheckBox_Changed" Unchecked="MiniAlwaysOnTopCheckBox_Changed"
                                          Margin="0,0,0,8" />
                                <CheckBox x:Name="MiniPinnedCheckBox" Content="Закрепить положение (запретить перетаскивание)"
                                          Checked="MiniPinnedCheckBox_Changed" Unchecked="MiniPinnedCheckBox_Changed"
                                          Margin="0,0,0,8" />
                                <!-- См. AppSettings.MiniPlayerSnapToEdges / WindowSnapHelper. Действует, только
                                     пока положение НЕ закреплено чекбоксом выше — если перетаскивания нет
                                     вообще, прилипать уже нечему. -->
                                <CheckBox x:Name="MiniSnapToEdgesCheckBox" Content="Прилипание к краям экрана"
                                          Checked="MiniSnapToEdgesCheckBox_Changed" Unchecked="MiniSnapToEdgesCheckBox_Changed" />
                            </StackPanel>
                        </Border>

                        <!-- В компактном окне мини-плеера, в отличие от основного, место есть только
                             под одну "вторую" кнопку рядом с play/pause и next/prev — выбираем здесь,
                             какую из трёх функций она выполняет (см. AppSettings.MiniPlayerSecondaryButton
                             и MiniPlayerWindow.UpdateSecondaryButton). -->
                        <Border Style="{StaticResource SettingsCardStyle}" Margin="0,12,0,0">
                            <StackPanel>
