<UserControl x:Class="Lumisense.CoverSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:Lumisense">
    <StackPanel x:Name="PageCover">
        <TextBlock x:Name="CoverPageTitle" Text="Обложка и Now Playing" Style="{StaticResource PageTitleStyle}" />
        <TextBlock x:Name="CoverPageDescription" Text="Фон Now Playing, обложка, избранное и подпись под названием трека." Style="{StaticResource PageDescriptionStyle}" />

        <!-- См. AppSettings.NowPlayingBackground и NowPlayingWindow.Backdrop.cs. -->
        <StackPanel x:Name="NowPlayingBackgroundCard" Margin="0,0,0,24">
            <TextBlock Text="Фон Now Playing" Style="{StaticResource SettingsGroupTitleStyle}" />
            <Border Style="{StaticResource SettingsGroupCardStyle}" Margin="0,0,0,0">
                <StackPanel>
                    <Border Style="{StaticResource SettingsRowStyle}" BorderThickness="0" Visibility="{Binding Visibility, ElementName=NowPlayingBackgroundCloudsRadio}">
                        <RadioButton Style="{StaticResource SettingsRowRadioButtonStyle}" x:Name="NowPlayingBackgroundCloudsRadio" Content="Облака из цветов обложки"
                        GroupName="NowPlayingBackground" Checked="NowPlayingBackgroundRadio_Changed" />
                    </Border>
                    <Border Style="{StaticResource SettingsRowStyle}" Visibility="{Binding Visibility, ElementName=NowPlayingBackgroundOrbsRadio}">
                        <StackPanel>
                            <RadioButton Style="{StaticResource SettingsRowRadioButtonStyle}" x:Name="NowPlayingBackgroundOrbsRadio" Content="Цветные шары"
                            GroupName="NowPlayingBackground" Checked="NowPlayingBackgroundRadio_Changed" />
                            <TextBlock Style="{StaticResource SettingsHelperTextStyle}" Margin="0,2,40,0" Text="«Цветные шары» плавно движутся по орбитам, «Волны» размыты и реагируют на громкость. Оба фона останавливаются на паузе и при «Меньше анимации»." TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SettingsRowStyle}" Visibility="{Binding Visibility, ElementName=NowPlayingBackgroundWavesRadio}">
                        <RadioButton Style="{StaticResource SettingsRowRadioButtonStyle}" x:Name="NowPlayingBackgroundWavesRadio" Content="Волны"
                        GroupName="NowPlayingBackground" Checked="NowPlayingBackgroundRadio_Changed" />
                    </Border>
                    <Border Style="{StaticResource SettingsRowStyle}" Visibility="{Binding Visibility, ElementName=NowPlayingBackgroundCoverRadio}">
                        <StackPanel>
                            <RadioButton Style="{StaticResource SettingsRowRadioButtonStyle}" x:Name="NowPlayingBackgroundCoverRadio" Content="Размытая обложка"
                            GroupName="NowPlayingBackground" Checked="NowPlayingBackgroundRadio_Changed" />
                            <TextBlock Style="{StaticResource SettingsHelperTextStyle}" Margin="0,2,40,0" Text="«Размытая обложка», «Один цвет» и «Без фона» неподвижны и почти не нагружают систему." TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SettingsRowStyle}" Visibility="{Binding Visibility, ElementName=NowPlayingBackgroundSolidRadio}">
                        <RadioButton Style="{StaticResource SettingsRowRadioButtonStyle}" x:Name="NowPlayingBackgroundSolidRadio" Content="Один цвет"
                        GroupName="NowPlayingBackground" Checked="NowPlayingBackgroundRadio_Changed" />
                    </Border>
                    <Border Style="{StaticResource SettingsRowStyle}" Visibility="{Binding Visibility, ElementName=NowPlayingBackgroundColorPanel}">
                        <StackPanel x:Name="NowPlayingBackgroundColorPanel" Orientation="Horizontal" Margin="26,0,0,0">
                            <Border x:Name="NowPlayingBackgroundColorSwatch" Width="26" Height="26" CornerRadius="6"
                                    BorderThickness="1" BorderBrush="#40FFFFFF" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <ui:Button Appearance="Secondary" Content="Выбрать цвет…"
                                       Click="NowPlayingBackgroundColorButton_Click" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SettingsRowStyle}" Visibility="{Binding Visibility, ElementName=NowPlayingBackgroundNoneRadio}">
                        <RadioButton Style="{StaticResource SettingsRowRadioButtonStyle}" x:Name="NowPlayingBackgroundNoneRadio" Content="Без фона (простой тёмный)"
                        GroupName="NowPlayingBackground" Checked="NowPlayingBackgroundRadio_Changed" />
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Margin="0,0,0,24">
            <TextBlock Text="Анимация избранного" Style="{StaticResource SettingsGroupTitleStyle}" />
            <Border Style="{StaticResource SettingsGroupCardStyle}" Margin="0,0,0,0">
                <StackPanel>
                    <Border Style="{StaticResource SettingsRowStyle}" BorderThickness="0">
                        <WrapPanel>
                            <RadioButton x:Name="FavoriteHeartFillRadio" Content="Заливка"
                                         GroupName="FavoriteHeartAnimation" Checked="FavoriteHeartAnimationRadio_Changed"
                                         Margin="0,0,16,0" VerticalAlignment="Center" />
                            <RadioButton x:Name="FavoriteHeartSparksRadio" Content="Искры"
                                         GroupName="FavoriteHeartAnimation" Checked="FavoriteHeartAnimationRadio_Changed"
                                         Margin="0,0,16,0" VerticalAlignment="Center" />
                            <RadioButton x:Name="FavoriteHeartRingRadio" Content="Кольцо"
                                         GroupName="FavoriteHeartAnimation" Checked="FavoriteHeartAnimationRadio_Changed"
                                         Margin="0,0,16,0" VerticalAlignment="Center" />
                            <RadioButton x:Name="FavoriteHeartNoneRadio" Content="Без анимации"
                                         GroupName="FavoriteHeartAnimation" Checked="FavoriteHeartAnimationRadio_Changed"
                                         Margin="0" VerticalAlignment="Center" />
                        </WrapPanel>
                    </Border>
                    <Border Padding="20,0,20,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingsHelperTextStyle}" Margin="0,0,0,6" Text="Показывается при добавлении трека в избранное кнопкой-сердечком в плейлисте и в мини-плеере. При включённом «Меньше анимации» не воспроизводится." TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- См. AppSettings.AlbumArtTransitionEnabled. -->
        <StackPanel Margin="0,0,0,24">
            <TextBlock Text="Анимация смены обложки" Style="{StaticResource SettingsGroupTitleStyle}" />
            <Border Style="{StaticResource SettingsGroupCardStyle}" Margin="0,0,0,0">
                <StackPanel>
                    <Border Style="{StaticResource SettingsRowStyle}" BorderThickness="0" Visibility="{Binding Visibility, ElementName=AlbumArtTransitionOffRadio}">
                        <RadioButton Style="{StaticResource SettingsRowRadioButtonStyle}" x:Name="AlbumArtTransitionOffRadio" Content="Без анимации" GroupName="AlbumArtTransition"
                        Checked="AlbumArtTransitionRadio_Changed" />
                    </Border>
                    <Border Style="{StaticResource SettingsRowStyle}" Visibility="{Binding Visibility, ElementName=AlbumArtTransitionOnRadio}">
                        <StackPanel>
                            <RadioButton Style="{StaticResource SettingsRowRadioButtonStyle}" x:Name="AlbumArtTransitionOnRadio" Content="Слайд" GroupName="AlbumArtTransition"
                            Checked="AlbumArtTransitionRadio_Changed" />
                            <TextBlock Style="{StaticResource SettingsHelperTextStyle}" Margin="0,2,40,0" Text="«Слайд»: старая обложка «улетает» в сторону, а новая «влетает» с противоположной — как в iTunes. «Карусель»: по бокам видны предыдущая и следующая обложки, приглушённые затемнением, и вся лента сдвигается на один шаг. В шаффле будущая обложка заранее неизвестна, вместо неё показывается заглушка." TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SettingsRowStyle}" Visibility="{Binding Visibility, ElementName=AlbumArtTransitionStyleCarouselRadio}">
                        <RadioButton Style="{StaticResource SettingsRowRadioButtonStyle}" x:Name="AlbumArtTransitionStyleCarouselRadio" Content="Карусель" GroupName="AlbumArtTransition"
                        Checked="AlbumArtTransitionRadio_Changed" />
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Margin="0,0,0,24">
            <Border Style="{StaticResource SettingsGroupCardStyle}" Margin="0,0,0,0">
                <StackPanel>
                    <Border Style="{StaticResource SettingsRowStyle}" BorderThickness="0" Visibility="{Binding Visibility, ElementName=AlbumArtGesturesCheckBox}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="Включить жесты на обложке">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsRowTitleStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled, ElementName=AlbumArtGesturesCheckBox}" Value="False">
                                                    <Setter Property="Opacity" Value="0.45" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Style="{StaticResource SettingsHelperTextStyle}" Margin="0,4,0,0" Text="Касание — пуск/пауза; свайп влево или вправо — смена трека; свайп вверх или вниз — громкость. При отключении клик снова открывает обложку." TextWrapping="Wrap" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" x:Name="AlbumArtGesturesCheckBox" AutomationProperties.Name="Включить жесты на обложке"
                            Checked="AlbumArtGesturesCheckBox_Changed"
                            Unchecked="AlbumArtGesturesCheckBox_Changed" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- См. AppSettings.TrackStateBadgeMode / MainWindow.UpdateTrackUserStatePresentation. -->
        <StackPanel Margin="0,0,0,24">
            <Border Style="{StaticResource SettingsGroupCardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Border Style="{StaticResource SettingsRowStyle}" BorderThickness="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="Подпись под названием трека">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsRowTitleStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled, ElementName=TrackStateBadgeModeRadioCombo}" Value="False">
                                                    <Setter Property="Opacity" Value="0.45" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel x:Name="TrackStateBadgeModeRadioGroup" Grid.Column="1" VerticalAlignment="Center">
                                <ComboBox x:Name="TrackStateBadgeModeRadioCombo" Tag="RadioGroup" AutomationProperties.Name="Подпись под названием трека" MinWidth="220" HorizontalAlignment="Right">
                                    <ComboBoxItem Content="Состояние трека (по умолчанию)" Tag="BadgeModeStateRadio" />
                                    <ComboBoxItem Content="Расширение файла (FLAC, MP3…)" Tag="BadgeModeExtensionRadio" />
                                    <ComboBoxItem Content="Качество (битрейт и частота)" Tag="BadgeModeQualityRadio" />
                                    <ComboBoxItem Content="Размер файла" Tag="BadgeModeFileSizeRadio" />
                                    <ComboBoxItem Content="Свой набор (отметить, что показывать)" Tag="BadgeModeCustomRadio" />
                                </ComboBox>
                                <StackPanel Visibility="Collapsed">
                                    <RadioButton x:Name="BadgeModeStateRadio" Content="Состояние трека (по умолчанию)"
                                    GroupName="TrackStateBadgeMode" Checked="TrackStateBadgeModeRadio_Changed" />
                                    <RadioButton x:Name="BadgeModeExtensionRadio" Content="Расширение файла (FLAC, MP3…)"
                                    GroupName="TrackStateBadgeMode" Checked="TrackStateBadgeModeRadio_Changed" />
                                    <RadioButton x:Name="BadgeModeQualityRadio" Content="Качество (битрейт и частота)"
                                    GroupName="TrackStateBadgeMode" Checked="TrackStateBadgeModeRadio_Changed" />
                                    <RadioButton x:Name="BadgeModeFileSizeRadio" Content="Размер файла"
                                    GroupName="TrackStateBadgeMode" Checked="TrackStateBadgeModeRadio_Changed" />
                                    <RadioButton x:Name="BadgeModeCustomRadio" Content="Свой набор (отметить, что показывать)"
                                    GroupName="TrackStateBadgeMode" Checked="TrackStateBadgeModeRadio_Changed" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <StackPanel x:Name="BadgeCustomPartsPanel" Visibility="Collapsed">
                        <Border Style="{StaticResource SettingsRowStyle}" Visibility="{Binding Visibility, ElementName=BadgePartStateCheckBox}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                    <TextBlock Text="Состояние">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsRowTitleStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEnabled, ElementName=BadgePartStateCheckBox}" Value="False">
                                                        <Setter Property="Opacity" Value="0.45" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" x:Name="BadgePartStateCheckBox" AutomationProperties.Name="Состояние" MinHeight="32"
                                Checked="BadgePartCheckBox_Changed" Unchecked="BadgePartCheckBox_Changed" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsRowStyle}" Visibility="{Binding Visibility, ElementName=BadgePartExtensionCheckBox}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                    <TextBlock Text="Расширение файла">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsRowTitleStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEnabled, ElementName=BadgePartExtensionCheckBox}" Value="False">
                                                        <Setter Property="Opacity" Value="0.45" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" x:Name="BadgePartExtensionCheckBox" AutomationProperties.Name="Расширение файла" MinHeight="32"
                                Checked="BadgePartCheckBox_Changed" Unchecked="BadgePartCheckBox_Changed" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsRowStyle}" Visibility="{Binding Visibility, ElementName=BadgePartBitrateCheckBox}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                    <TextBlock Text="Битрейт">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsRowTitleStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEnabled, ElementName=BadgePartBitrateCheckBox}" Value="False">
                                                        <Setter Property="Opacity" Value="0.45" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" x:Name="BadgePartBitrateCheckBox" AutomationProperties.Name="Битрейт" MinHeight="32"
                                Checked="BadgePartCheckBox_Changed" Unchecked="BadgePartCheckBox_Changed" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsRowStyle}" Visibility="{Binding Visibility, ElementName=BadgePartSampleRateCheckBox}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                    <TextBlock Text="Частота дискретизации">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsRowTitleStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEnabled, ElementName=BadgePartSampleRateCheckBox}" Value="False">
                                                        <Setter Property="Opacity" Value="0.45" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" x:Name="BadgePartSampleRateCheckBox" AutomationProperties.Name="Частота дискретизации" MinHeight="32"
                                Checked="BadgePartCheckBox_Changed" Unchecked="BadgePartCheckBox_Changed" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsRowStyle}" Visibility="{Binding Visibility, ElementName=BadgePartFileSizeCheckBox}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                    <TextBlock Text="Размер файла">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsRowTitleStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEnabled, ElementName=BadgePartFileSizeCheckBox}" Value="False">
                                                        <Setter Property="Opacity" Value="0.45" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" x:Name="BadgePartFileSizeCheckBox" AutomationProperties.Name="Размер файла" MinHeight="32"
                                Checked="BadgePartCheckBox_Changed" Unchecked="BadgePartCheckBox_Changed" />
                            </Grid>
                        </Border>
                    </StackPanel>
                    <Border Padding="20,0,20,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingsHelperTextStyle}" Margin="0,0,0,6" Text="Загрузка и ошибка всегда показываются как состояние. Если для файла нет нужных данных, остаётся состояние; его же видно во всплывающей подсказке." TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SettingsGroupCardStyle}" Margin="0,0,0,0">
                <StackPanel>
                    <Border Style="{StaticResource SettingsRowStyle}" BorderThickness="0">
                        <StackPanel>
                            <TextBlock Margin="0,0,0,8" Text="Предпросмотр" Style="{StaticResource SettingsFieldLabelStyle}" />
                            <Border CornerRadius="8" Padding="8,3" HorizontalAlignment="Left"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                <TextBlock x:Name="BadgePreviewText" FontSize="11" Opacity="0.78" />
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>

    </StackPanel>
</UserControl>
