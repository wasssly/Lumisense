<Window x:Class="Lumisense.IconPackPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Lumisense"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Lumisense"
        Width="560" Height="620"
        MinWidth="420" MinHeight="360"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border Margin="8"
            Padding="22"
            CornerRadius="16"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.32" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,16" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock x:Name="TitleText" Text="Все иконки — Duotone"
                           FontSize="17" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <ui:Button Width="30" Height="30" Padding="0" Opacity="0.6"
                           Appearance="Secondary" HorizontalAlignment="Right"
                           ToolTip="Закрыть" Click="CloseButton_Click">
                    <ui:Button.Icon>
                        <local:SvgPathIcon Icon="IconDismiss" Size="13" />
                    </ui:Button.Icon>
                </ui:Button>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="IconsItemsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="108" Margin="4" HorizontalAlignment="Center">
                                <Border Width="52" Height="52" CornerRadius="10"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                        HorizontalAlignment="Center">
                                    <local:SvgPathIcon Icon="{Binding}" Pack="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Tag}"
                                                        Size="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding}" HorizontalAlignment="Center" Margin="0,6,0,0"
                                           FontSize="10" Opacity="0.65" TextWrapping="Wrap" TextAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
