<Window x:Class="AudioPlayer.TrackChangeToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AudioPlayer"
        Title=""
        Width="300" Height="72"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStartupLocation="Manual">

    <!-- ============================================================================
         Всплывающее уведомление о смене трека (по образцу Spotify) — маленькая карточка
         в углу экрана с обложкой и названием, которая сама появляется и пропадает через
         пару секунд. ShowActivated="False" — принципиально: уведомление не должно
         перехватывать фокус у того, чем человек занят в данный момент, оно просто
         показывается поверх (Topmost) и не мешает. Окно переиспользуется на каждую смену
         трека (Show/Hide, а не создание нового), см. TrackChangeToastWindow.ShowToast.

         Ресурсы темы (TextFillColorPrimaryBrush и т.д.) переопределены тут же, как и у
         MiniPlayerWindow — по той же причине: фон карточки не берётся из Mica/Acrylic
         подложки FluentWindow, а рисуется сам (см. ToastBackgroundBrush в code-behind),
         поэтому и контраст текста задаётся вручную, а не берётся из системной темы.
         ============================================================================ -->

    <Window.Resources>
        <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#C5FFFFFF" />
        <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#1AFFFFFF" />
    </Window.Resources>

    <Border x:Name="RootBorder" CornerRadius="12" Padding="12" Opacity="0">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.35" BlurRadius="18" ShadowDepth="4" Direction="270" />
        </Border.Effect>
        <Border.Background>
            <SolidColorBrush x:Name="ToastBackgroundBrush" />
        </Border.Background>

        <StackPanel Orientation="Horizontal">
            <Border x:Name="ArtBorder" Width="48" Height="48" CornerRadius="8"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                <local:SvgPathIcon x:Name="ArtIcon" Icon="IconMusicNote" Size="20" Opacity="0.5"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <StackPanel VerticalAlignment="Center" Margin="12,0,0,0" MaxWidth="200">
                <TextBlock x:Name="ToastTitleText" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="ToastArtistText" FontSize="11" Margin="0,3,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
