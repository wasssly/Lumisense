<UserControl x:Class="Lumisense.MiniPlayerSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:Lumisense">
    <StackPanel x:Name="PageMiniPlayer">
        <TextBlock Text="Мини-плеер" Style="{StaticResource PageTitleStyle}" />
        <TextBlock Text="Компактный режим, оформление и поведение мини-плеера." Style="{StaticResource PageDescriptionStyle}" />

        <!-- См. AppSettings.MiniPlayerStyle/IslandMonitor и IslandPlayerWindow. -->
        <StackPanel x:Name="MiniStyleCard" Margin="0,0,0,24">
            <Border Style="{StaticResource SettingsGroupCardStyle}" Margin="0,0,0,0">
                <StackPanel>
                    <Border Style="{StaticResource SettingsRowStyle}" BorderThickness="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="Вид мини-плеера">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsRowTitleStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled, ElementName=MiniPlayerStyleRadioCombo}" Value="False">
                                                    <Setter Property="Opacity" Value="0.45" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel x:Name="MiniPlayerStyleRadioGroup" Grid.Column="1" VerticalAlignment="Center">
                                <ComboBox x:Name="MiniPlayerStyleRadioCombo" Tag="RadioGroup" AutomationProperties.Name="Вид мини-плеера" MinWidth="420" HorizontalAlignment="Right">
                                    <ComboBoxItem Content="Карточка (по умолчанию)" Tag="MiniStyleClassicRadio" />
                                    <ComboBoxItem Content="Остров — капсула у верхнего края экрана, раскрывается по клику" Tag="MiniStyleIslandRadio" />
                                </ComboBox>
                                <StackPanel Visibility="Collapsed">
                                    <RadioButton x:Name="MiniStyleClassicRadio" Content="Карточка (по умолчанию)" GroupName="MiniPlayerStyle"
                                    Checked="MiniStyleRadio_Changed" />
                                    <RadioButton x:Name="MiniStyleIslandRadio" Content="Остров — капсула у верхнего края экрана, раскрывается по клику"
                                    GroupName="MiniPlayerStyle" Checked="MiniStyleRadio_Changed" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Margin="0,0,0,24">
            <Border Style="{StaticResource SettingsGroupCardStyle}" Margin="0,0,0,0">
                <StackPanel>
                    <Border Style="{StaticResource SettingsRowStyle}" BorderThickness="0" Visibility="{Binding Visibility, ElementName=MiniOpacitySlider}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="Прозрачность окна" Style="{StaticResource SettingsRowTitleStyle}" />
                            </StackPanel>
                            <Grid Grid.Column="1" Width="340" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock MinWidth="48" TextAlignment="Right" Margin="14,0,0,0" x:Name="MiniOpacityValueText" Grid.Column="1" Text="100%"
                                Opacity="0.6" FontSize="12" VerticalAlignment="Center" />
                                <Grid Grid.Column="0">
                                    <Slider x:Name="MiniOpacitySlider" AutomationProperties.Name="Прозрачность окна мини-плеера" Style="{StaticResource SettingsAccentSliderStyle}" IsHitTestVisible="False"
                                            Minimum="0.3" Maximum="1.0" Value="1.0"
                                            ValueChanged="MiniOpacitySlider_ValueChanged" VerticalAlignment="Center" />

                                    <Border Background="Transparent" Height="24" VerticalAlignment="Center"
                                            MouseLeftButtonDown="MiniOpacityOverlay_MouseLeftButtonDown"
                                            MouseMove="MiniOpacityOverlay_MouseMove"
                                            MouseLeftButtonUp="MiniOpacityOverlay_MouseLeftButtonUp" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingsRowStyle}" Visibility="{Binding Visibility, ElementName=MiniAlwaysOnTopCheckBox}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="Поверх всех окон (мини-плеер)">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsRowTitleStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled, ElementName=MiniAlwaysOnTopCheckBox}" Value="False">
                                                    <Setter Property="Opacity" Value="0.45" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Style="{StaticResource SettingsHelperTextStyle}" Margin="0,4,0,0" Text="Мини-плеер остаётся видимым, пока вы работаете в других приложениях." />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" x:Name="MiniAlwaysOnTopCheckBox" AutomationProperties.Name="Поверх всех окон (мини-плеер)"
                            Checked="MiniAlwaysOnTopCheckBox_Changed" Unchecked="MiniAlwaysOnTopCheckBox_Changed" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingsRowStyle}" Visibility="{Binding Visibility, ElementName=GameOverlayAutoDetectCheckBox}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="Включать автоматически при обнаружении игры или оверлея">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsRowTitleStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled, ElementName=GameOverlayAutoDetectCheckBox}" Value="False">
                                                    <Setter Property="Opacity" Value="0.45" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Style="{StaticResource SettingsHelperTextStyle}" Margin="0,4,0,0" Text="Lumisense периодически проверяет, не развёрнута ли сейчас игра на весь экран и не запущен ли известный оверлей (RTSS, Xbox Game Bar, NVIDIA/AMD оверлей), и на время включает режим совместимости сам. Определение эвристическое и не гарантирует 100% точности — не задетектит игру в оконном режиме или незнакомый оверлей." />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" x:Name="GameOverlayAutoDetectCheckBox"
                            AutomationProperties.Name="Включать автоматически при обнаружении игры или оверлея"
                            Checked="GameOverlayAutoDetectCheckBox_Changed"
                            Unchecked="GameOverlayAutoDetectCheckBox_Changed" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingsRowStyle}" Visibility="{Binding Visibility, ElementName=GameOverlayCompatibilityCheckBox}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="Держать включённым всегда">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsRowTitleStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled, ElementName=GameOverlayCompatibilityCheckBox}" Value="False">
                                                    <Setter Property="Opacity" Value="0.45" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Style="{StaticResource SettingsHelperTextStyle}" Margin="0,4,0,0" Text="Держит режим совместимости включённым постоянно, независимо от автоопределения выше — на случай, если игру или оверлей не удалось обнаружить автоматически. Не обязателен, если автоопределение справляется само." />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" x:Name="GameOverlayCompatibilityCheckBox"
                            AutomationProperties.Name="Держать включённым всегда"
                            Checked="GameOverlayCompatibilityCheckBox_Changed"
                            Unchecked="GameOverlayCompatibilityCheckBox_Changed" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingsRowStyle}" Visibility="{Binding Visibility, ElementName=MiniPinnedCheckBox}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="Закрепить положение (запретить перетаскивание)">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsRowTitleStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled, ElementName=MiniPinnedCheckBox}" Value="False">
                                                    <Setter Property="Opacity" Value="0.45" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Style="{StaticResource SettingsHelperTextStyle}" Margin="0,4,0,0" Text="Защищает выбранную позицию мини-плеера при изменении режима экрана или запуске игры." />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" x:Name="MiniPinnedCheckBox" AutomationProperties.Name="Закрепить положение (запретить перетаскивание)"
                            Checked="MiniPinnedCheckBox_Changed" Unchecked="MiniPinnedCheckBox_Changed" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingsRowStyle}" Visibility="{Binding Visibility, ElementName=MiniSnapToEdgesCheckBox}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="Прилипание к краям экрана">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsRowTitleStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled, ElementName=MiniSnapToEdgesCheckBox}" Value="False">
                                                    <Setter Property="Opacity" Value="0.45" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Style="{StaticResource SettingsHelperTextStyle}" Margin="0,4,0,0" Text="При перетаскивании мини-плеер выравнивается по ближайшему краю экрана." />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" x:Name="MiniSnapToEdgesCheckBox" AutomationProperties.Name="Прилипание к краям экрана"
                            Checked="MiniSnapToEdgesCheckBox_Changed" Unchecked="MiniSnapToEdgesCheckBox_Changed" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Тот же механизм, что у пунктов меню трека (TrackContextMenuActions),
             но для контекстного меню мини-плеера (ПКМ по мини-плееру). -->
        <StackPanel Margin="0,0,0,24">
            <TextBlock Text="Контекстное меню мини-плеера" Style="{StaticResource SettingsGroupTitleStyle}" />
            <Border Style="{StaticResource SettingsGroupCardStyle}" Margin="0,0,0,0">
                <StackPanel>
                    <Border Style="{StaticResource SettingsRowStyle}" BorderThickness="0">
                        <ui:Button Tag="Mini" Content="Порядок по умолчанию" Appearance="Secondary"
                        HorizontalAlignment="Left" Margin="0,0,0,0"
                        Click="ContextMenuOrderReset_Click" />
                    </Border>
                    <Border Style="{StaticResource SettingsRowStyle}" Visibility="{Binding Visibility, ElementName=MiniContextMenuActionsPanel}">
                        <UniformGrid x:Name="MiniContextMenuActionsPanel" Columns="1" Margin="0,0,0,0">
                            <Border Tag="Settings" Style="{StaticResource ReorderRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource ReorderGripStyle}" />
                                    <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="0" x:Name="MiniContextSettingsCheckBox" Tag="Settings" Content="Настройки" Checked="MiniPlayerContextMenuActionCheckBox_Changed" Unchecked="MiniPlayerContextMenuActionCheckBox_Changed" />
                                </Grid>
                            </Border>
                            <Border Tag="NowPlaying" Style="{StaticResource ReorderRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource ReorderGripStyle}" />
                                    <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="0" x:Name="MiniContextNowPlayingCheckBox" Tag="NowPlaying" Content="Now Playing (полный экран)" Checked="MiniPlayerContextMenuActionCheckBox_Changed" Unchecked="MiniPlayerContextMenuActionCheckBox_Changed" />
                                </Grid>
                            </Border>
                            <Border Tag="Pin" Style="{StaticResource ReorderRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource ReorderGripStyle}" />
                                    <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="0" x:Name="MiniContextPinCheckBox" Tag="Pin" Content="Закрепить" Checked="MiniPlayerContextMenuActionCheckBox_Changed" Unchecked="MiniPlayerContextMenuActionCheckBox_Changed" />
                                </Grid>
                            </Border>
                            <Border Tag="Topmost" Style="{StaticResource ReorderRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource ReorderGripStyle}" />
                                    <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="0" x:Name="MiniContextTopmostCheckBox" Tag="Topmost" Content="Поверх окон" Checked="MiniPlayerContextMenuActionCheckBox_Changed" Unchecked="MiniPlayerContextMenuActionCheckBox_Changed" />
                                </Grid>
                            </Border>
                            <Border Tag="OverlayCompatibility" Style="{StaticResource ReorderRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource ReorderGripStyle}" />
                                    <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="0" x:Name="MiniContextOverlayCompatibilityCheckBox" Tag="OverlayCompatibility" Content="Совместимость с играми и оверлеем" Checked="MiniPlayerContextMenuActionCheckBox_Changed" Unchecked="MiniPlayerContextMenuActionCheckBox_Changed" />
                                </Grid>
                            </Border>
                            <Border Tag="SecondaryButton" Style="{StaticResource ReorderRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource ReorderGripStyle}" />
                                    <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="0" x:Name="MiniContextSecondaryButtonCheckBox" Tag="SecondaryButton" Content="Выбор второй кнопки" Checked="MiniPlayerContextMenuActionCheckBox_Changed" Unchecked="MiniPlayerContextMenuActionCheckBox_Changed" />
                                </Grid>
                            </Border>
                            <Border Tag="PlaybackRate" Style="{StaticResource ReorderRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource ReorderGripStyle}" />
                                    <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="0" x:Name="MiniContextPlaybackRateCheckBox" Tag="PlaybackRate" Content="Скорость" Checked="MiniPlayerContextMenuActionCheckBox_Changed" Unchecked="MiniPlayerContextMenuActionCheckBox_Changed" />
                                </Grid>
                            </Border>
                            <Border Tag="Pitch" Style="{StaticResource ReorderRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource ReorderGripStyle}" />
                                    <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="0" x:Name="MiniContextPitchCheckBox" Tag="Pitch" Content="Тон" Checked="MiniPlayerContextMenuActionCheckBox_Changed" Unchecked="MiniPlayerContextMenuActionCheckBox_Changed" />
                                </Grid>
                            </Border>
                            <Border Tag="Opacity" Style="{StaticResource ReorderRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource ReorderGripStyle}" />
                                    <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="0" x:Name="MiniContextOpacityCheckBox" Tag="Opacity" Content="Прозрачность" Checked="MiniPlayerContextMenuActionCheckBox_Changed" Unchecked="MiniPlayerContextMenuActionCheckBox_Changed" />
                                </Grid>
                            </Border>
                            <Border Tag="SnapToEdges" Style="{StaticResource ReorderRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource ReorderGripStyle}" />
                                    <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="0" x:Name="MiniContextSnapToEdgesCheckBox" Tag="SnapToEdges" Content="Прилипание к краям экрана" Checked="MiniPlayerContextMenuActionCheckBox_Changed" Unchecked="MiniPlayerContextMenuActionCheckBox_Changed" />
                                </Grid>
                            </Border>
                            <Border Tag="ShowProgress" Style="{StaticResource ReorderRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource ReorderGripStyle}" />
                                    <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="0" x:Name="MiniContextShowProgressCheckBox" Tag="ShowProgress" Content="Показывать полосу прогресса" Checked="MiniPlayerContextMenuActionCheckBox_Changed" Unchecked="MiniPlayerContextMenuActionCheckBox_Changed" />
                                </Grid>
                            </Border>
                            <Border Tag="ShowArtworkProgress" Style="{StaticResource ReorderRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource ReorderGripStyle}" />
                                    <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="0" x:Name="MiniContextShowArtworkProgressCheckBox" Tag="ShowArtworkProgress" Content="Прогресс вокруг обложки" Checked="MiniPlayerContextMenuActionCheckBox_Changed" Unchecked="MiniPlayerContextMenuActionCheckBox_Changed" />
                                </Grid>
                            </Border>
                            <Border Tag="ArtworkStyle" Style="{StaticResource ReorderRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource ReorderGripStyle}" />
                                    <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="0" x:Name="MiniContextArtworkStyleCheckBox" Tag="ArtworkStyle" Content="Отображение обложки" Checked="MiniPlayerContextMenuActionCheckBox_Changed" Unchecked="MiniPlayerContextMenuActionCheckBox_Changed" />
                                </Grid>
                            </Border>
                            <Border Tag="ButtonsLayout" Style="{StaticResource ReorderRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource ReorderGripStyle}" />
                                    <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="0" x:Name="MiniContextButtonsLayoutCheckBox" Tag="ButtonsLayout" Content="Расположение кнопок" Checked="MiniPlayerContextMenuActionCheckBox_Changed" Unchecked="MiniPlayerContextMenuActionCheckBox_Changed" />
                                </Grid>
                            </Border>
                        </UniformGrid>
                    </Border>
                    <Border Padding="20,0,20,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingsHelperTextStyle}" Margin="0,0,0,6" Text="Отключенные пункты не показываются по ПКМ на мини-плеере." />
                            <TextBlock Style="{StaticResource SettingsHelperTextStyle}" Margin="0,0,0,6" Text="Чтобы изменить порядок, перетаскивайте пункты за значок ⋮⋮ слева." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- В компактном мини-плеере места хватает лишь на одну "вторую" кнопку: здесь выбираем её функцию из трёх
             (AppSettings.MiniPlayerSecondaryButton, MiniPlayerWindow.UpdateSecondaryButton). -->
        <StackPanel Margin="0,0,0,24">
            <Border Style="{StaticResource SettingsGroupCardStyle}" Margin="0,0,0,0">
                <StackPanel>
                    <Border Style="{StaticResource SettingsRowStyle}" BorderThickness="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="Вторая кнопка в мини-плеере">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsRowTitleStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled, ElementName=MiniSecondaryButtonRadioCombo}" Value="False">
                                                    <Setter Property="Opacity" Value="0.45" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel x:Name="MiniSecondaryButtonRadioGroup" Grid.Column="1" VerticalAlignment="Center">
                                <ComboBox x:Name="MiniSecondaryButtonRadioCombo" Tag="RadioGroup" AutomationProperties.Name="Вторая кнопка в мини-плеере" MinWidth="220" HorizontalAlignment="Right">
                                    <ComboBoxItem Content="Повтор" Tag="MiniSecondaryRepeatRadio" />
                                    <ComboBoxItem Content="Перемешать" Tag="MiniSecondaryShuffleRadio" />
                                    <ComboBoxItem Content="Избранное" Tag="MiniSecondaryFavoriteRadio" />
                                </ComboBox>
                                <StackPanel Visibility="Collapsed">
                                    <RadioButton x:Name="MiniSecondaryRepeatRadio" Content="Повтор" GroupName="MiniSecondaryButton"
                                    Checked="MiniSecondaryButtonRadio_Changed" />
                                    <RadioButton x:Name="MiniSecondaryShuffleRadio" Content="Перемешать" GroupName="MiniSecondaryButton"
                                    Checked="MiniSecondaryButtonRadio_Changed" />
                                    <RadioButton x:Name="MiniSecondaryFavoriteRadio" Content="Избранное" GroupName="MiniSecondaryButton"
                                    Checked="MiniSecondaryButtonRadio_Changed" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Padding="20,0,20,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingsHelperTextStyle}" Margin="0,0,0,6" Text="Выберите действие дополнительной кнопки рядом с основными элементами управления." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- См. AppSettings.MiniPlayerButtonsLayout и MiniPlayerWindow.ApplyButtonsLayoutMode
             за подробностями, чем отличаются режимы. -->
        <StackPanel Margin="0,0,0,24">
            <Border Style="{StaticResource SettingsGroupCardStyle}" Margin="0,0,0,0">
                <StackPanel>
                    <Border Style="{StaticResource SettingsRowStyle}" BorderThickness="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="Расположение кнопок управления">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsRowTitleStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled, ElementName=MiniButtonsLayoutRadioCombo}" Value="False">
                                                    <Setter Property="Opacity" Value="0.45" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel x:Name="MiniButtonsLayoutRadioGroup" Grid.Column="1" VerticalAlignment="Center">
                                <ComboBox x:Name="MiniButtonsLayoutRadioCombo" Tag="RadioGroup" AutomationProperties.Name="Расположение кнопок управления" MinWidth="420" HorizontalAlignment="Right">
                                    <ComboBoxItem Content="Снизу (окно немного подрастает при наведении)" Tag="MiniButtonsBelowRadio" />
                                    <ComboBoxItem Content="На месте обложки и названия (размер окна не меняется)" Tag="MiniButtonsOverlayRadio" />
                                </ComboBox>
                                <StackPanel Visibility="Collapsed">
                                    <RadioButton x:Name="MiniButtonsBelowRadio"
                                    Content="Снизу (окно немного подрастает при наведении)"
                                    GroupName="MiniButtonsLayout" Checked="MiniButtonsLayoutRadio_Changed"
                                    />
                                    <RadioButton x:Name="MiniButtonsOverlayRadio"
                                    Content="На месте обложки и названия (размер окна не меняется)"
                                    GroupName="MiniButtonsLayout" Checked="MiniButtonsLayoutRadio_Changed" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Padding="20,0,20,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingsHelperTextStyle}" Margin="0,0,0,6" Text="Нижний вариант раскрывает управление при наведении, а вариант поверх обложки сохраняет постоянный размер окна." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Margin="0,0,0,24">
            <Border Style="{StaticResource SettingsGroupCardStyle}" Margin="0,0,0,0">
                <StackPanel>
                    <Border Style="{StaticResource SettingsRowStyle}" BorderThickness="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="Отображение обложки">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsRowTitleStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled, ElementName=MiniPlayerArtworkStyleRadioCombo}" Value="False">
                                                    <Setter Property="Opacity" Value="0.45" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel x:Name="MiniPlayerArtworkStyleRadioGroup" Grid.Column="1" VerticalAlignment="Center">
                                <ComboBox x:Name="MiniPlayerArtworkStyleRadioCombo" Tag="RadioGroup" AutomationProperties.Name="Отображение обложки" MinWidth="420" HorizontalAlignment="Right">
                                    <ComboBoxItem Content="По умолчанию" Tag="MiniArtworkDefaultRadio" />
                                    <ComboBoxItem Content="Винил (медленное вращение во время воспроизведения)" Tag="MiniArtworkVinylRadio" />
                                    <ComboBoxItem Content="Круглая (без вращения)" Tag="MiniArtworkStaticCircleRadio" />
                                </ComboBox>
                                <StackPanel Visibility="Collapsed">
                                    <RadioButton x:Name="MiniArtworkDefaultRadio" Content="По умолчанию"
                                    GroupName="MiniPlayerArtworkStyle"
                                    Checked="MiniArtworkStyleRadio_Changed" />
                                    <RadioButton x:Name="MiniArtworkVinylRadio" Content="Винил (медленное вращение во время воспроизведения)"
                                    GroupName="MiniPlayerArtworkStyle"
                                    Checked="MiniArtworkStyleRadio_Changed" />
                                    <RadioButton x:Name="MiniArtworkStaticCircleRadio" Content="Круглая (без вращения)"
                                    GroupName="MiniPlayerArtworkStyle"
                                    Checked="MiniArtworkStyleRadio_Changed" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Padding="20,0,20,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingsHelperTextStyle}" Margin="0,0,0,6" Text="Виниловый режим делает обложку круглой и приостанавливает её вращение вместе с треком. Круглый режим оставляет обложку неподвижной." TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- См. AppSettings.MiniPlayerShowProgress и MiniPlayerWindow.ApplyProgressBarVisibility. -->
        <StackPanel Margin="0,0,0,24">
            <Border Style="{StaticResource SettingsGroupCardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Border Style="{StaticResource SettingsRowStyle}" BorderThickness="0" Visibility="{Binding Visibility, ElementName=MiniShowProgressCheckBox}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="Показывать полосу прогресса">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsRowTitleStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled, ElementName=MiniShowProgressCheckBox}" Value="False">
                                                    <Setter Property="Opacity" Value="0.45" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Style="{StaticResource SettingsHelperTextStyle}" Margin="0,4,0,0" Text="Окно мини-плеера становится немного компактнее, если полоса не нужна. Перемотка кликом по обложке/названию по-прежнему недоступна — только сама полоса." TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource SettingsHelperTextStyle}" Margin="0,4,0,0" Text="Вид, цвет и размеры полосы мини-плеера выбираются на вкладке «Воспроизведение», в разделе «Полоса воспроизведения»." TextWrapping="Wrap" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" x:Name="MiniShowProgressCheckBox" AutomationProperties.Name="Показывать полосу прогресса"
                            Checked="MiniShowProgressCheckBox_Changed" Unchecked="MiniShowProgressCheckBox_Changed" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingsRowStyle}" Visibility="{Binding Visibility, ElementName=MiniShowArtworkProgressCheckBox}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="Показывать прогресс вокруг обложки">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsRowTitleStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled, ElementName=MiniShowArtworkProgressCheckBox}" Value="False">
                                                    <Setter Property="Opacity" Value="0.45" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Style="{StaticResource SettingsHelperTextStyle}" Margin="0,4,0,0" Text="Тонкий акцентный контур повторяет скруглённую форму обложки и показывает прогресс текущего трека. Его можно включить отдельно от обычной полосы прогресса." TextWrapping="Wrap" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" x:Name="MiniShowArtworkProgressCheckBox" AutomationProperties.Name="Показывать прогресс вокруг обложки"
                            Checked="MiniShowArtworkProgressCheckBox_Changed"
                            Unchecked="MiniShowArtworkProgressCheckBox_Changed" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingsRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="Вид контура">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsRowTitleStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled, ElementName=MiniPlayerArtworkProgressStyleRadioCombo}" Value="False">
                                                    <Setter Property="Opacity" Value="0.45" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel x:Name="MiniPlayerArtworkProgressStyleRadioGroup" Grid.Column="1" VerticalAlignment="Center">
                                <ComboBox x:Name="MiniPlayerArtworkProgressStyleRadioCombo" Tag="RadioGroup" AutomationProperties.Name="Вид контура" MinWidth="420" HorizontalAlignment="Right">
                                    <ComboBoxItem Content="Обычный (по умолчанию)" Tag="MiniArtworkProgressStyleDefaultRadio" />
                                    <ComboBoxItem Content="Material (волнистая линия, как в Android)" Tag="MiniArtworkProgressStyleMaterialRadio" />
                                    <ComboBoxItem Content="Material Slider (ползунок с зазором, как в Android)" Tag="MiniArtworkProgressStyleMaterialSliderRadio" />
                                </ComboBox>
                                <StackPanel Visibility="Collapsed">
                                    <RadioButton x:Name="MiniArtworkProgressStyleDefaultRadio" Content="Обычный (по умолчанию)"
                                    GroupName="MiniPlayerArtworkProgressStyle" Checked="MiniArtworkProgressStyleRadio_Changed" />
                                    <RadioButton x:Name="MiniArtworkProgressStyleMaterialRadio" Content="Material (волнистая линия, как в Android)"
                                    GroupName="MiniPlayerArtworkProgressStyle" Checked="MiniArtworkProgressStyleRadio_Changed" />
                                    <RadioButton x:Name="MiniArtworkProgressStyleMaterialSliderRadio" Content="Material Slider (ползунок с зазором, как в Android)"
                                    GroupName="MiniPlayerArtworkProgressStyle" Checked="MiniArtworkProgressStyleRadio_Changed" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingsRowStyle}">
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="MiniArtworkProgressThicknessLabelText" Grid.Column="0"
                                       Style="{StaticResource SettingsFieldLabelStyle}" />
                            <TextBlock x:Name="MiniArtworkProgressThicknessValueText" Grid.Column="1"
                                       VerticalAlignment="Center" FontSize="12" Opacity="0.7" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingsRowStyle}">
                        <Grid Height="28" Margin="0,0,0,0">
                            <Slider x:Name="MiniArtworkProgressThicknessSlider" AutomationProperties.Name="Толщина контура вокруг обложки" Style="{StaticResource SettingsAccentSliderStyle}"
                                    Minimum="2" Maximum="4" TickFrequency="0.5" SmallChange="0.5" LargeChange="0.5"
                                    local:SliderMilestoneMarkers.IsEnabled="True"
                                    IsMoveToPointEnabled="True" IsSnapToTickEnabled="True"
                                    ValueChanged="MiniArtworkProgressThicknessSlider_ValueChanged" />
                        </Grid>
                    </Border>
                    <Border Padding="20,0,20,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingsHelperTextStyle}" Margin="0,0,0,6" x:Name="MiniArtworkProgressThicknessDescriptionText" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SettingsGroupCardStyle}" Margin="0,0,0,0">
                <StackPanel>
                    <Border Style="{StaticResource SettingsRowStyle}" BorderThickness="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="Цвет контура">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsRowTitleStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled, ElementName=MiniArtworkProgressColorModeRadioCombo}" Value="False">
                                                    <Setter Property="Opacity" Value="0.45" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel x:Name="MiniArtworkProgressColorModeRadioGroup" Grid.Column="1" VerticalAlignment="Center">
                                <ComboBox x:Name="MiniArtworkProgressColorModeRadioCombo" Tag="RadioGroup" AutomationProperties.Name="Цвет контура" MinWidth="420" HorizontalAlignment="Right">
                                    <ComboBoxItem Content="Как у полосы воспроизведения (вкладка «Воспроизведение»)" Tag="MiniArtworkProgressAccentRadio" />
                                    <ComboBoxItem Content="Фиксированный цвет" Tag="MiniArtworkProgressFixedRadio" />
                                </ComboBox>
                                <StackPanel Visibility="Collapsed">
                                    <RadioButton x:Name="MiniArtworkProgressAccentRadio"
                                    Content="Как у полосы воспроизведения (вкладка «Воспроизведение»)"
                                    GroupName="MiniArtworkProgressColorMode"
                                    Checked="MiniArtworkProgressColorModeRadio_Changed" />
                                    <RadioButton x:Name="MiniArtworkProgressFixedRadio" Content="Фиксированный цвет"
                                    GroupName="MiniArtworkProgressColorMode"
                                    Checked="MiniArtworkProgressColorModeRadio_Changed" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingsRowAttachedStyle}" Visibility="{Binding Visibility, ElementName=MiniArtworkProgressColorSwatchesPanel}">
                        <WrapPanel x:Name="MiniArtworkProgressColorSwatchesPanel" Margin="26,0,0,0">
                            <Border x:Name="MiniArtworkProgressColorSwatch0" Width="26" Height="26" CornerRadius="6"
                                    Margin="0,0,8,8" Background="#0078D4" BorderThickness="2"
                                    BorderBrush="Transparent" Cursor="Hand"
                                    MouseLeftButtonDown="MiniArtworkProgressColorSwatch_MouseLeftButtonDown" />
                            <Border x:Name="MiniArtworkProgressColorSwatch1" Width="26" Height="26" CornerRadius="6"
                                    Margin="0,0,8,8" Background="#8764B8" BorderThickness="2"
                                    BorderBrush="Transparent" Cursor="Hand"
                                    MouseLeftButtonDown="MiniArtworkProgressColorSwatch_MouseLeftButtonDown" />
                            <Border x:Name="MiniArtworkProgressColorSwatch2" Width="26" Height="26" CornerRadius="6"
                                    Margin="0,0,8,8" Background="#E3008C" BorderThickness="2"
                                    BorderBrush="Transparent" Cursor="Hand"
                                    MouseLeftButtonDown="MiniArtworkProgressColorSwatch_MouseLeftButtonDown" />
                            <Border x:Name="MiniArtworkProgressColorSwatch3" Width="26" Height="26" CornerRadius="6"
                                    Margin="0,0,8,8" Background="#E81123" BorderThickness="2"
                                    BorderBrush="Transparent" Cursor="Hand"
                                    MouseLeftButtonDown="MiniArtworkProgressColorSwatch_MouseLeftButtonDown" />
                            <Border x:Name="MiniArtworkProgressColorSwatch4" Width="26" Height="26" CornerRadius="6"
                                    Margin="0,0,8,8" Background="#FF8C00" BorderThickness="2"
                                    BorderBrush="Transparent" Cursor="Hand"
                                    MouseLeftButtonDown="MiniArtworkProgressColorSwatch_MouseLeftButtonDown" />
                            <Border x:Name="MiniArtworkProgressColorSwatch5" Width="26" Height="26" CornerRadius="6"
                                    Margin="0,0,8,8" Background="#FFB900" BorderThickness="2"
                                    BorderBrush="Transparent" Cursor="Hand"
                                    MouseLeftButtonDown="MiniArtworkProgressColorSwatch_MouseLeftButtonDown" />
                            <Border x:Name="MiniArtworkProgressColorSwatch6" Width="26" Height="26" CornerRadius="6"
                                    Margin="0,0,8,8" Background="#107C10" BorderThickness="2"
                                    BorderBrush="Transparent" Cursor="Hand"
                                    MouseLeftButtonDown="MiniArtworkProgressColorSwatch_MouseLeftButtonDown" />
                            <Border x:Name="MiniArtworkProgressColorSwatch7" Width="26" Height="26" CornerRadius="6"
                                    Margin="0,0,8,8" Background="#00B7C3" BorderThickness="2"
                                    BorderBrush="Transparent" Cursor="Hand"
                                    MouseLeftButtonDown="MiniArtworkProgressColorSwatch_MouseLeftButtonDown" />

                            <ui:Button x:Name="MiniArtworkProgressColorCustomButton" Width="26" Height="26" Padding="0"
                                       Margin="0,0,8,8" Appearance="Secondary" ToolTip="Свой цвет через палитру" AutomationProperties.Name="{Binding RelativeSource={RelativeSource Self}, Path=ToolTip}"
                                       Click="MiniArtworkProgressColorCustomButton_Click">
                                <ui:Button.Icon>
                                    <local:SvgPathIcon Icon="IconEdit" Size="12" />
                                </ui:Button.Icon>
                            </ui:Button>
                        </WrapPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- См. AppSettings.MiniPlayerSizePreset/MiniPlayerWindow.ApplySizePreset: размер получается масштабом раскладки. -->
        <StackPanel Margin="0,0,0,24">
            <Border Style="{StaticResource SettingsGroupCardStyle}" Margin="0,0,0,0">
                <StackPanel>
                    <Border Style="{StaticResource SettingsRowStyle}" BorderThickness="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="Размер мини-плеера">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsRowTitleStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled, ElementName=MiniPlayerSizePresetRadioCombo}" Value="False">
                                                    <Setter Property="Opacity" Value="0.45" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel x:Name="MiniPlayerSizePresetRadioGroup" Grid.Column="1" VerticalAlignment="Center">
                                <ComboBox x:Name="MiniPlayerSizePresetRadioCombo" Tag="RadioGroup" AutomationProperties.Name="Размер мини-плеера" MinWidth="350" HorizontalAlignment="Right">
                                    <ComboBoxItem Content="Классический — 220×97, как в версии 1.21" Tag="MiniSizeClassicRadio" />
                                    <ComboBoxItem Content="Текущий — 200×88" Tag="MiniSizeCurrentRadio" />
                                    <ComboBoxItem Content="Компактный — 180×79" Tag="MiniSizeCompactRadio" />
                                </ComboBox>
                                <StackPanel Visibility="Collapsed">
                                    <RadioButton x:Name="MiniSizeClassicRadio" Content="Классический — 220×97, как в версии 1.21" GroupName="MiniPlayerSizePreset"
                                    Checked="MiniSizePresetRadio_Changed" />
                                    <RadioButton x:Name="MiniSizeCurrentRadio" Content="Текущий — 200×88" GroupName="MiniPlayerSizePreset"
                                    Checked="MiniSizePresetRadio_Changed" />
                                    <RadioButton x:Name="MiniSizeCompactRadio" Content="Компактный — 180×79" GroupName="MiniPlayerSizePreset"
                                    Checked="MiniSizePresetRadio_Changed" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Padding="20,0,20,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingsHelperTextStyle}" Margin="0,0,0,6" Text="Меняется масштаб всего мини-плеера, положение левого верхнего угла сохраняется." TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- См. AppSettings.MiniPlayerInfoMode/MiniPlayerWindow.UpdateSecondaryLine; название трека видно всегда, выбор — только для второй строки. -->
        <StackPanel Margin="0,0,0,24">
            <Border Style="{StaticResource SettingsGroupCardStyle}" Margin="0,0,0,0">
                <StackPanel>
                    <Border Style="{StaticResource SettingsRowStyle}" BorderThickness="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="Вторая строка в мини-плеере">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsRowTitleStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled, ElementName=MiniInfoModeRadioCombo}" Value="False">
                                                    <Setter Property="Opacity" Value="0.45" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel x:Name="MiniInfoModeRadioGroup" Grid.Column="1" VerticalAlignment="Center">
                                <ComboBox x:Name="MiniInfoModeRadioCombo" Tag="RadioGroup" AutomationProperties.Name="Вторая строка в мини-плеере" MinWidth="270" HorizontalAlignment="Right">
                                    <ComboBoxItem Content="Исполнитель" Tag="MiniInfoArtistRadio" />
                                    <ComboBoxItem Content="Ничего (только название трека)" Tag="MiniInfoOnlyTitleRadio" />
                                    <ComboBoxItem Content="Оставшееся время трека" Tag="MiniInfoRemainingRadio" />
                                </ComboBox>
                                <StackPanel Visibility="Collapsed">
                                    <RadioButton x:Name="MiniInfoArtistRadio" Content="Исполнитель" GroupName="MiniInfoMode"
                                    Checked="MiniInfoModeRadio_Changed" />
                                    <RadioButton x:Name="MiniInfoOnlyTitleRadio" Content="Ничего (только название трека)"
                                    GroupName="MiniInfoMode" Checked="MiniInfoModeRadio_Changed" />
                                    <RadioButton x:Name="MiniInfoRemainingRadio" Content="Оставшееся время трека"
                                    GroupName="MiniInfoMode" Checked="MiniInfoModeRadio_Changed" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingsRowStyle}" Visibility="{Binding Visibility, ElementName=MiniArtistMarqueeCheckBox}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="Прокручивать длинного исполнителя">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsRowTitleStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled, ElementName=MiniArtistMarqueeCheckBox}" Value="False">
                                                    <Setter Property="Opacity" Value="0.45" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Style="{StaticResource SettingsHelperTextStyle}" Margin="0,4,0,0" Text="Эта настройка меняет только вторую строку: название трека остаётся видимым всегда." />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" x:Name="MiniArtistMarqueeCheckBox" AutomationProperties.Name="Прокручивать длинного исполнителя"
                            Checked="MiniArtistMarqueeCheckBox_Changed"
                            Unchecked="MiniArtistMarqueeCheckBox_Changed" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>
