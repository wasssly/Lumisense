<UserControl x:Class="Lumisense.LyricsSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:Lumisense">
    <StackPanel x:Name="PageLyrics">
        <TextBlock Text="Тексты песен" Style="{StaticResource PageTitleStyle}" />
        <TextBlock Text="Отображение, поиск и источники текстов песен." Style="{StaticResource PageDescriptionStyle}" />

        <!-- Одна карточка для всего, что влияет на вид текста песни, и один общий предпросмотр сверху:
             AppSettings.SyncedLyricsFontSize/SyncedLyricsHighlightEffect, LyricsTextAlignment, LyricsDisplayMode. -->
        <StackPanel x:Name="LyricsAppearanceCard" Margin="0,0,0,24">
            <TextBlock Text="Текст песни" Style="{StaticResource SettingsGroupTitleStyle}" />
            <Border Style="{StaticResource SettingsGroupCardStyle}" Margin="0,0,0,0" Panel.ZIndex="10">
                <StackPanel>
                    <Border Style="{StaticResource SettingsRowStyle}" BorderThickness="0" Panel.ZIndex="10">
                        <Border x:Name="LyricsPreviewPanel" Panel.ZIndex="10" Padding="16,12" CornerRadius="10"
                                BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="LyricsPreviewTranslate" />
                            </Border.RenderTransform>
                            <StackPanel>
                                <TextBlock Text="Предпросмотр" FontSize="11" Opacity="0.6" Margin="0,0,0,6" />
                                <local:LyricsPreviewControl x:Name="LyricsPreview" />
                            </StackPanel>
                        </Border>
                    </Border>
                    <Border Style="{StaticResource SettingsRowStyle}">
                        <StackPanel>
                            <TextBlock Margin="0,0,0,8" Text="Пресет оформления" Style="{StaticResource SettingsFieldLabelStyle}" />
                            <TextBlock Style="{StaticResource SettingsHelperTextStyle}" Margin="0,4,0,0" Text="Пресет задаёт сразу всё оформление текста песни: размеры, эффект, размытие, выравнивание, режим и переход. Если после выбора что-то поменять вручную, пресет станет «Своими настройками». Свои пресеты можно сохранить под любым именем." TextWrapping="Wrap" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="LyricsPresetCombo" AutomationProperties.Name="Пресет оформления текста" Grid.Column="0" HorizontalAlignment="Stretch"
                                          SelectionChanged="LyricsPresetCombo_SelectionChanged" />
                                <ui:Button x:Name="LyricsPresetSaveButton" Grid.Column="1" Content="Сохранить как…" Appearance="Secondary"
                                           Margin="8,0,0,0" Click="LyricsPresetSaveButton_Click" />
                                <ui:Button x:Name="LyricsPresetDeleteButton" Grid.Column="2" Content="Удалить" Appearance="Secondary"
                                           Margin="8,0,0,0" Click="LyricsPresetDeleteButton_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SettingsRowStyle}" Visibility="{Binding Visibility, ElementName=LyricsTransitionCombo}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="Переход между строками">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsRowTitleStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled, ElementName=LyricsTransitionCombo}" Value="False">
                                                    <Setter Property="Opacity" Value="0.45" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Style="{StaticResource SettingsHelperTextStyle}" Margin="0,4,0,0" Text="Как строки меняются при смене активной: прокрутка, длительность и волна по строкам ниже. «Как в Apple Music» ставит активную строку выше центра и пускает волну по строкам ниже." TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" x:Name="LyricsTransitionCombo" AutomationProperties.Name="Переход между строками" MinWidth="260"
                                      SelectionChanged="LyricsTransitionCombo_SelectionChanged">
                                <ComboBoxItem Tag="Smooth" Content="Плавный (по умолчанию)" />
                                <ComboBoxItem Tag="AppleMusic" Content="Как в Apple Music" />
                                <ComboBoxItem Tag="Soft" Content="Мягкое растворение" />
                                <ComboBoxItem Tag="Quick" Content="Быстрый" />
                                <ComboBoxItem Tag="None" Content="Без анимации" />
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingsRowStyle}" Visibility="{Binding Visibility, ElementName=SyncedLyricsFontSizeSlider}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="Размер шрифта" Style="{StaticResource SettingsRowTitleStyle}" />
                            </StackPanel>
                            <Grid Grid.Column="1" Width="340" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Height="28">
                                    <Slider x:Name="SyncedLyricsFontSizeSlider" AutomationProperties.Name="Размер шрифта текста песни" Style="{StaticResource SettingsAccentSliderStyle}"
                                            Minimum="12" Maximum="20" TickFrequency="1"
                                            local:SliderMilestoneMarkers.IsEnabled="True"
                                            IsMoveToPointEnabled="True" IsSnapToTickEnabled="True"
                                            ValueChanged="SyncedLyricsFontSizeSlider_ValueChanged" />
                                </Grid>
                                <Border Grid.Column="1" MinWidth="64" Margin="14,0,0,0" Padding="10,5" CornerRadius="8"
                                        Background="{DynamicResource ControlFillColorTertiaryBrush}">
                                    <TextBlock x:Name="SyncedLyricsFontSizeValueText"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"
                                               TextAlignment="Center" />
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingsRowStyle}" Visibility="{Binding Visibility, ElementName=NowPlayingLyricsFontSizeSlider}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="Размер текста в Now Playing" Style="{StaticResource SettingsRowTitleStyle}" />
                            </StackPanel>
                            <Grid Grid.Column="1" Width="340" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Height="28">
                                    <Slider x:Name="NowPlayingLyricsFontSizeSlider" AutomationProperties.Name="Размер текста в Now Playing" Style="{StaticResource SettingsAccentSliderStyle}"
                                            Minimum="14" Maximum="32" TickFrequency="1"
                                            IsMoveToPointEnabled="True" IsSnapToTickEnabled="True"
                                            ValueChanged="NowPlayingLyricsFontSizeSlider_ValueChanged" />
                                </Grid>
                                <Border Grid.Column="1" MinWidth="64" Margin="14,0,0,0" Padding="10,5" CornerRadius="8"
                                        Background="{DynamicResource ControlFillColorTertiaryBrush}">
                                    <TextBlock x:Name="NowPlayingLyricsFontSizeValueText"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"
                                               TextAlignment="Center" />
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingsRowStyle}">
                        <Border Margin="0,0,0,0" Padding="14,12" CornerRadius="10"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <StackPanel>
                                <TextBlock Text="Эффект активной строки" Style="{StaticResource SettingsFieldLabelStyle}" Margin="0,0,0,8" />
                                <RadioButton x:Name="SyncedLyricsEffectGlowRadio" Content="Мягкое свечение"
                                             GroupName="SyncedLyricsEffect" Checked="SyncedLyricsEffectRadio_Changed"
                                             />
                                <RadioButton x:Name="SyncedLyricsEffectGlowPillRadio" Content="Свечение и подложка"
                                             GroupName="SyncedLyricsEffect" Checked="SyncedLyricsEffectRadio_Changed"
                                             />
                                <RadioButton x:Name="SyncedLyricsEffectPillRadio" Content="Только подложка"
                                             GroupName="SyncedLyricsEffect" Checked="SyncedLyricsEffectRadio_Changed"
                                             />
                                <RadioButton x:Name="SyncedLyricsEffectBarRadio" Content="Полоска слева"
                                             GroupName="SyncedLyricsEffect" Checked="SyncedLyricsEffectRadio_Changed"
                                             />
                                <RadioButton x:Name="SyncedLyricsEffectNoneRadio" Content="Без эффекта"
                                             GroupName="SyncedLyricsEffect" Checked="SyncedLyricsEffectRadio_Changed" />
                                <TextBlock Text="Сила свечения активной строки" Style="{StaticResource SettingsFieldLabelStyle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" Height="28">
                                        <Slider x:Name="SyncedLyricsGlowStrengthSlider" AutomationProperties.Name="Сила свечения активной строки" Style="{StaticResource SettingsAccentSliderStyle}"
                                                Minimum="10" Maximum="100" TickFrequency="10"
                                                IsMoveToPointEnabled="True" IsSnapToTickEnabled="True"
                                                ValueChanged="SyncedLyricsHighlightSlider_ValueChanged" />
                                    </Grid>
                                    <Border Grid.Column="1" MinWidth="64" Margin="14,0,0,0" Padding="10,5" CornerRadius="8"
                                            Background="{DynamicResource ControlFillColorTertiaryBrush}">
                                        <TextBlock x:Name="SyncedLyricsGlowStrengthValueText" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontWeight="SemiBold" TextAlignment="Center" />
                                    </Border>
                                </Grid>
                                <CheckBox x:Name="SyncedLyricsScaleCheckBox" Content="Увеличивать активную строку"
                                          Checked="SyncedLyricsEffectRadio_Changed" Unchecked="SyncedLyricsEffectRadio_Changed"
                                          Margin="0,14,0,0" />
                                <CheckBox x:Name="SyncedLyricsFadeCheckBox" Content="Приглушать дальние строки"
                                          Checked="SyncedLyricsEffectRadio_Changed" Unchecked="SyncedLyricsEffectRadio_Changed"
                                          Margin="0,8,0,0" />
                                <TextBlock Text="Степень приглушения дальних строк" Style="{StaticResource SettingsFieldLabelStyle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" Height="28">
                                        <Slider x:Name="SyncedLyricsFadeStrengthSlider" AutomationProperties.Name="Степень приглушения дальних строк" Style="{StaticResource SettingsAccentSliderStyle}"
                                                Minimum="0" Maximum="100" TickFrequency="10"
                                                IsMoveToPointEnabled="True" IsSnapToTickEnabled="True"
                                                ValueChanged="SyncedLyricsHighlightSlider_ValueChanged" />
                                    </Grid>
                                    <Border Grid.Column="1" MinWidth="64" Margin="14,0,0,0" Padding="10,5" CornerRadius="8"
                                            Background="{DynamicResource ControlFillColorTertiaryBrush}">
                                        <TextBlock x:Name="SyncedLyricsFadeStrengthValueText" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontWeight="SemiBold" TextAlignment="Center" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="Степень увеличения активной строки" Style="{StaticResource SettingsFieldLabelStyle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" Height="28">
                                        <Slider x:Name="SyncedLyricsScalePercentSlider" AutomationProperties.Name="Степень увеличения активной строки" Style="{StaticResource SettingsAccentSliderStyle}"
                                                Minimum="2" Maximum="15" TickFrequency="1"
                                                IsMoveToPointEnabled="True" IsSnapToTickEnabled="True"
                                                ValueChanged="SyncedLyricsHighlightSlider_ValueChanged" />
                                    </Grid>
                                    <Border Grid.Column="1" MinWidth="64" Margin="14,0,0,0" Padding="10,5" CornerRadius="8"
                                            Background="{DynamicResource ControlFillColorTertiaryBrush}">
                                        <TextBlock x:Name="SyncedLyricsScalePercentValueText" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontWeight="SemiBold" TextAlignment="Center" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="Видимых строк в Now Playing" Style="{StaticResource SettingsFieldLabelStyle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" Height="28">
                                        <Slider x:Name="SyncedLyricsVisibleLinesSlider" AutomationProperties.Name="Видимых строк в Now Playing" Style="{StaticResource SettingsAccentSliderStyle}"
                                                Minimum="3" Maximum="17" TickFrequency="2"
                                                IsMoveToPointEnabled="True" IsSnapToTickEnabled="True"
                                                ValueChanged="SyncedLyricsHighlightSlider_ValueChanged" />
                                    </Grid>
                                    <Border Grid.Column="1" MinWidth="64" Margin="14,0,0,0" Padding="10,5" CornerRadius="8"
                                            Background="{DynamicResource ControlFillColorTertiaryBrush}">
                                        <TextBlock x:Name="SyncedLyricsVisibleLinesValueText" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontWeight="SemiBold" TextAlignment="Center" />
                                    </Border>
                                </Grid>
                                <CheckBox x:Name="SyncedLyricsBlurCheckBox" Content="Размывать неактивные строки"
                                          Checked="SyncedLyricsEffectRadio_Changed" Unchecked="SyncedLyricsEffectRadio_Changed"
                                          Margin="0,8,0,0" />
                                <TextBlock Text="Сила размытия неактивных строк" Style="{StaticResource SettingsFieldLabelStyle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" Height="28">
                                        <Slider x:Name="SyncedLyricsBlurStrengthSlider" AutomationProperties.Name="Сила размытия неактивных строк" Style="{StaticResource SettingsAccentSliderStyle}"
                                                Minimum="1" Maximum="12" TickFrequency="1"
                                                IsMoveToPointEnabled="True" IsSnapToTickEnabled="True"
                                                ValueChanged="SyncedLyricsHighlightSlider_ValueChanged" />
                                    </Grid>
                                    <Border Grid.Column="1" MinWidth="64" Margin="14,0,0,0" Padding="10,5" CornerRadius="8"
                                            Background="{DynamicResource ControlFillColorTertiaryBrush}">
                                        <TextBlock x:Name="SyncedLyricsBlurStrengthValueText" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontWeight="SemiBold" TextAlignment="Center" />
                                    </Border>
                                </Grid>
                                <TextBlock x:Name="LyricsEffectHelpText" Text="Активная строка остаётся белой, неактивные — приглушённо-серыми. Свечение применяется в панели текста главного окна и в Now Playing; подложка, полоска, увеличение, приглушение, размытие и число видимых строк — только в Now Playing."
                                           Style="{StaticResource SettingsHelperTextStyle}" Margin="0,6,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Border>
                    <Border Style="{StaticResource SettingsRowStyle}">
                        <Border Margin="0,0,0,0" Padding="14,12" CornerRadius="10"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <StackPanel>
                                <TextBlock Text="Выравнивание текста песни" Style="{StaticResource SettingsFieldLabelStyle}" Margin="0,0,0,8" />
                                <TextBlock x:Name="LyricsAlignmentHelpText" Text="Относится к тексту песни в панели главного окна и в режиме Now Playing, и к синхронному, и к обычному."
                                           Style="{StaticResource SettingsHelperTextStyle}" Margin="0,0,0,12" TextWrapping="Wrap" />
                                <WrapPanel>
                                    <RadioButton x:Name="LyricsAlignLeftRadio" Content="Слева"
                                                 GroupName="LyricsTextAlignment" Checked="LyricsTextAlignmentRadio_Changed"
                                                 Margin="0,0,16,0" VerticalAlignment="Center" />
                                    <RadioButton x:Name="LyricsAlignCenterRadio" Content="По центру"
                                                 GroupName="LyricsTextAlignment" Checked="LyricsTextAlignmentRadio_Changed"
                                                 Margin="0,0,16,0" VerticalAlignment="Center" />
                                    <RadioButton x:Name="LyricsAlignRightRadio" Content="Справа"
                                                 GroupName="LyricsTextAlignment" Checked="LyricsTextAlignmentRadio_Changed"
                                                 Margin="0" VerticalAlignment="Center" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </Border>
                    <Border Style="{StaticResource SettingsRowStyle}">
                        <Border Margin="0,0,0,0" Padding="14,12" CornerRadius="10"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <StackPanel>
                                <TextBlock Text="Режим текста песни" Style="{StaticResource SettingsFieldLabelStyle}" Margin="0,0,0,8" />
                                <RadioButton x:Name="LyricsDisplaySyncedRadio" Content="Синхронный, если он есть (по умолчанию)"
                                             GroupName="LyricsDisplayMode" Checked="LyricsDisplayModeRadio_Changed" />
                                <RadioButton x:Name="LyricsDisplayPlainRadio" Content="Всегда обычный текст"
                                             GroupName="LyricsDisplayMode" Checked="LyricsDisplayModeRadio_Changed" />
                                <TextBlock Text="Переключить режим можно и кнопкой LRC/TXT в заголовке панели текста песни. Если у трека только обычный текст, кнопка не показывается."
                                           Style="{StaticResource SettingsHelperTextStyle}" Margin="0,6,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Margin="0,0,0,24">
            <TextBlock Text="Панель текста песни" Style="{StaticResource SettingsGroupTitleStyle}" />
            <Border Style="{StaticResource SettingsGroupCardStyle}" Margin="0,0,0,0">
                <StackPanel>
                    <Border Style="{StaticResource SettingsRowStyle}" BorderThickness="0" Visibility="{Binding Visibility, ElementName=HideCoverInLyricsCheckBox}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="Скрывать обложку при открытом тексте песни">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsRowTitleStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled, ElementName=HideCoverInLyricsCheckBox}" Value="False">
                                                    <Setter Property="Opacity" Value="0.45" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Style="{StaticResource SettingsHelperTextStyle}" Margin="0,4,0,0" Text="Название и исполнитель остаются, а освободившееся место отдаётся тексту. Обложка возвращается, когда панель закрыта." TextWrapping="Wrap" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" x:Name="HideCoverInLyricsCheckBox" AutomationProperties.Name="Скрывать обложку при открытом тексте песни"
                            Checked="HideCoverInLyricsCheckBox_Changed" Unchecked="HideCoverInLyricsCheckBox_Changed" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Margin="0,0,0,24">
            <Border Style="{StaticResource SettingsGroupCardStyle}" Margin="0,0,0,0">
                <StackPanel>
                    <Border Style="{StaticResource SettingsRowStyle}" BorderThickness="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="Поиск текста песен">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsRowTitleStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled, ElementName=LyricsPolicyRadioCombo}" Value="False">
                                                    <Setter Property="Opacity" Value="0.45" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel x:Name="LyricsPolicyRadioGroup" Grid.Column="1" VerticalAlignment="Center">
                                <ComboBox x:Name="LyricsPolicyRadioCombo" Tag="RadioGroup" AutomationProperties.Name="Поиск текста песен" MinWidth="220" HorizontalAlignment="Right">
                                    <ComboBoxItem Content="Только локальные тексты" Tag="LyricsPolicyLocalOnlyRadio" />
                                    <ComboBoxItem Content="Автоматически искать точное совпадение" Tag="LyricsPolicyAutoExactRadio" />
                                    <ComboBoxItem Content="Искать только по моему запросу" Tag="LyricsPolicyManualOnlyRadio" />
                                </ComboBox>
                                <StackPanel Visibility="Collapsed">
                                    <RadioButton x:Name="LyricsPolicyLocalOnlyRadio" Content="Только локальные тексты"
                                    GroupName="LyricsPolicy" Checked="LyricsPolicyRadio_Changed" />
                                    <RadioButton x:Name="LyricsPolicyAutoExactRadio" Content="Автоматически искать точное совпадение"
                                    GroupName="LyricsPolicy" Checked="LyricsPolicyRadio_Changed" />
                                    <RadioButton x:Name="LyricsPolicyManualOnlyRadio" Content="Искать только по моему запросу"
                                    GroupName="LyricsPolicy" Checked="LyricsPolicyRadio_Changed" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Padding="20,0,20,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingsHelperTextStyle}" Margin="0,0,0,6" Text="Локальные .lrc, .txt, теги и сохранённый кэш используются всегда. При онлайн-поиске в LRCLIB отправляются только название и исполнитель; путь к файлу и сам аудиофайл не передаются." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- См. AppSettings.UseExtraLyricsSource и *LyricsSource.cs. -->
        <StackPanel Margin="0,0,0,24">
            <TextBlock Text="Дополнительный источник текстов" Style="{StaticResource SettingsGroupTitleStyle}" />
            <Border Style="{StaticResource SettingsGroupCardStyle}" Margin="0,0,0,0">
                <StackPanel>
                    <Border Style="{StaticResource SettingsRowStyle}" BorderThickness="0" Visibility="{Binding Visibility, ElementName=UseExtraLyricsSourceCheckBox}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingsHelperTextStyle}" Margin="0,0,0,10" Text="Помогает найти тексты русских и других исполнителей, которых нет в LRCLIB. При онлайн-поиске название и исполнитель трека отправляются на серверы отмеченных сервисов: NetEase, QQ Music, Kugou, Paxsenix (для текстов Apple Music трек ещё ищется в каталоге iTunes), а также Better Lyrics, Binimum, LyricsPlus, Deezer и LRCMUX. Эти пять сервисов по умолчанию не отмечены; Better Lyrics отдаёт текст только для треков из своего кэша, а Deezer работает через неофициальный интерфейс и может перестать отвечать. Результаты идут после LRCLIB и помечены источником; сбой одного источника не прерывает поиск в остальных." TextWrapping="Wrap" />
                            <Border CornerRadius="10" Padding="14,12" Background="{DynamicResource ControlFillColorTertiaryBrush}">
                                <StackPanel>
                                    <CheckBox x:Name="UseExtraLyricsSourceCheckBox" Content="Искать тексты в дополнительных сервисах" Margin="0"
                                              FontWeight="SemiBold"
                                              Checked="UseExtraLyricsSourceCheckBox_Changed" Unchecked="UseExtraLyricsSourceCheckBox_Changed" />
                                    <Border Height="1" Margin="0,10,0,10" Opacity="0.35"
                                            Background="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <StackPanel x:Name="ExtraLyricsSourcesPanel" Margin="22,0,0,0">
                <CheckBox x:Name="UseNetEaseLyricsCheckBox" Content="NetEase Cloud Music"
                          Checked="ExtraLyricsServiceCheckBox_Changed" Unchecked="ExtraLyricsServiceCheckBox_Changed" />
                <CheckBox x:Name="UseQqMusicLyricsCheckBox" Content="QQ Music"
                          Checked="ExtraLyricsServiceCheckBox_Changed" Unchecked="ExtraLyricsServiceCheckBox_Changed" />
                <CheckBox x:Name="UseKugouLyricsCheckBox" Content="Kugou"
                          Checked="ExtraLyricsServiceCheckBox_Changed" Unchecked="ExtraLyricsServiceCheckBox_Changed" />
                <CheckBox x:Name="UsePaxsenixLyricsCheckBox" Content="Paxsenix (Apple Music)"
                          Checked="ExtraLyricsServiceCheckBox_Changed" Unchecked="ExtraLyricsServiceCheckBox_Changed" />
                <CheckBox x:Name="UseBetterLyricsCheckBox" Content="Better Lyrics"
                          Checked="ExtraLyricsServiceCheckBox_Changed" Unchecked="ExtraLyricsServiceCheckBox_Changed" />
                <CheckBox x:Name="UseBinimumLyricsCheckBox" Content="Binimum"
                          Checked="ExtraLyricsServiceCheckBox_Changed" Unchecked="ExtraLyricsServiceCheckBox_Changed" />
                <CheckBox x:Name="UseLyricsPlusLyricsCheckBox" Content="LyricsPlus"
                          Checked="ExtraLyricsServiceCheckBox_Changed" Unchecked="ExtraLyricsServiceCheckBox_Changed" />
                <CheckBox x:Name="UseDeezerLyricsCheckBox" Content="Deezer"
                          Checked="ExtraLyricsServiceCheckBox_Changed" Unchecked="ExtraLyricsServiceCheckBox_Changed" />
                <CheckBox x:Name="UseLrcMuxLyricsCheckBox" Content="LRCMUX"
                          Checked="ExtraLyricsServiceCheckBox_Changed" Unchecked="ExtraLyricsServiceCheckBox_Changed" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Margin="0,0,0,24">
            <TextBlock Text="Кэш текстов песен" Style="{StaticResource SettingsGroupTitleStyle}" />
            <Border Style="{StaticResource SettingsGroupCardStyle}" Margin="0,0,0,0">
                <StackPanel>
                    <Border Style="{StaticResource SettingsRowStyle}" BorderThickness="0">
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="LyricsCacheInfoText" VerticalAlignment="Center" Opacity="0.75" />
                            <ui:Button x:Name="ClearLyricsCacheButton" Grid.Column="1" Appearance="Secondary"
                                       Padding="14,8" Click="ClearLyricsCacheButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <local:SvgPathIcon Icon="IconDelete" Size="14" Margin="0,0,7,0" />
                                    <TextBlock Text="Очистить кэш" />
                                </StackPanel>
                            </ui:Button>
                        </Grid>
                    </Border>
                    <Border Padding="20,0,20,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingsHelperTextStyle}" Margin="0,0,0,6" Text="Вставленные тексты хранятся только на этом устройстве. Кэш очищается через 180 дней и ограничен 200 текстами или 32 МБ." TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>

    </StackPanel>
</UserControl>
