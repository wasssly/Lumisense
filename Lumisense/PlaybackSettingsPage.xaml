                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled, ElementName=PlaybackSpeedChangesPitchCheckBox}" Value="False">
                                                    <Setter Property="Opacity" Value="0.45" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Style="{StaticResource SettingsHelperTextStyle}" Margin="0,4,0,0" Text="Ползунок скорости ускоряет или замедляет звук вместе с тоном, без растяжения и артефактов. По умолчанию тон сохраняется." TextWrapping="Wrap" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" x:Name="PlaybackSpeedChangesPitchCheckBox" AutomationProperties.Name="Скорость меняет тон (как на виниле)"
                            Checked="PlaybackSpeedChangesPitchCheckBox_Changed" Unchecked="PlaybackSpeedChangesPitchCheckBox_Changed" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>
