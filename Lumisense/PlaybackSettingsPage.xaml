<UserControl x:Class="Lumisense.PlaybackSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:Lumisense">
    <StackPanel x:Name="PagePlayback">
        <TextBlock Text="Воспроизведение" Style="{StaticResource PageTitleStyle}" />
        <TextBlock Text="Устройство вывода, громкость, продолжение воспроизведения и поведение плейлиста." Style="{StaticResource PageDescriptionStyle}" />

        <StackPanel Margin="0,0,0,24">
            <Border Style="{StaticResource SettingsGroupCardStyle}" Margin="0,0,0,0">
                <StackPanel>
                    <Border Style="{StaticResource SettingsRowStyle}" BorderThickness="0" Visibility="{Binding Visibility, ElementName=RememberVolumeCheckBox}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="Запоминать громкость между запусками">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsRowTitleStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled, ElementName=RememberVolumeCheckBox}" Value="False">
                                                    <Setter Property="Opacity" Value="0.45" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Style="{StaticResource SettingsHelperTextStyle}" Margin="0,4,0,0" Text="При следующем запуске плеер восстановит последний выбранный уровень громкости." />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" x:Name="RememberVolumeCheckBox" AutomationProperties.Name="Запоминать громкость между запусками"
                            Checked="RememberVolumeCheckBox_Changed" Unchecked="RememberVolumeCheckBox_Changed" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingsRowStyle}" Visibility="{Binding Visibility, ElementName=LogarithmicVolumeCheckBox}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="Логарифмическая регулировка громкости">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsRowTitleStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled, ElementName=LogarithmicVolumeCheckBox}" Value="False">
                                                    <Setter Property="Opacity" Value="0.45" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Style="{StaticResource SettingsHelperTextStyle}" Margin="0,4,0,0" Text="Ползунок громкости меняет уровень так, как его воспринимает слух: заметный на глаз ход в начале и в конце шкалы звучит одинаково плавно, без резкого скачка на малой громкости." TextWrapping="Wrap" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" x:Name="LogarithmicVolumeCheckBox" AutomationProperties.Name="Логарифмическая регулировка громкости"
                            Checked="LogarithmicVolumeCheckBox_Changed" Unchecked="LogarithmicVolumeCheckBox_Changed" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Margin="0,0,0,24">
            <TextBlock Text="Устройство вывода" Style="{StaticResource SettingsGroupTitleStyle}" />
            <Border Style="{StaticResource SettingsGroupCardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Border Style="{StaticResource SettingsRowStyle}" BorderThickness="0" Visibility="{Binding Visibility, ElementName=OutputDeviceCombo}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="Устройство вывода">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsRowTitleStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled, ElementName=OutputDeviceCombo}" Value="False">
                                                    <Setter Property="Opacity" Value="0.45" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <ComboBox Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" x:Name="OutputDeviceCombo" AutomationProperties.Name="Устройство вывода" SelectionChanged="OutputDeviceCombo_SelectionChanged" MinWidth="300" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingsRowStyle}" Visibility="{Binding Visibility, ElementName=DeviceConnectStyleCombo}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="Подключение и смена устройства">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsRowTitleStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled, ElementName=DeviceConnectStyleCombo}" Value="False">
                                                    <Setter Property="Opacity" Value="0.45" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <ComboBox Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" x:Name="DeviceConnectStyleCombo" AutomationProperties.Name="Подключение и смена устройства" SelectionChanged="DeviceConnectStyleCombo_SelectionChanged" MinWidth="300">
                                <ComboBoxItem Content="Карточка в острове" Tag="Island" />
                                <ComboBoxItem Content="Не показывать карточку" Tag="Off" />
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingsRowStyle}" Visibility="{Binding Visibility, ElementName=DeviceCardAnimationCombo}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="Анимация карточки">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsRowTitleStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled, ElementName=DeviceCardAnimationCombo}" Value="False">
                                                    <Setter Property="Opacity" Value="0.45" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <ComboBox Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" x:Name="DeviceCardAnimationCombo" AutomationProperties.Name="Анимация карточки устройства" SelectionChanged="DeviceCardAnimationCombo_SelectionChanged" MinWidth="300">
                                <ComboBoxItem Content="Орбита — дуга обегает значок, затем текст всплывает" Tag="Orbit" />
                                <ComboBoxItem Content="Свечение — вспышка цвета акцента за значком" Tag="Glow" />
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingsRowStyle}" Visibility="{Binding Visibility, ElementName=DeviceConnectPreviewButton}">
                        <Button x:Name="DeviceConnectPreviewButton" Content="Показать пример" HorizontalAlignment="Left" Margin="0,0,0,0"
                        Click="DeviceConnectPreviewButton_Click" />
                    </Border>
                    <Border Style="{StaticResource SettingsRowStyle}" Visibility="{Binding Visibility, ElementName=DeviceKindCombo}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="Значок устройства">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsRowTitleStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled, ElementName=DeviceKindCombo}" Value="False">
                                                    <Setter Property="Opacity" Value="0.45" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <ComboBox Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" x:Name="DeviceKindCombo" AutomationProperties.Name="Значок устройства" SelectionChanged="DeviceKindCombo_SelectionChanged" MinWidth="300">
                                <ComboBoxItem Content="Определять автоматически" Tag="" />
                                <ComboBoxItem Content="Наушники" Tag="Headphones" />
                                <ComboBoxItem Content="Колонки" Tag="Speakers" />
                                <ComboBoxItem Content="Bluetooth" Tag="Bluetooth" />
                                <ComboBoxItem Content="Монитор / HDMI" Tag="Display" />
                                <ComboBoxItem Content="USB" Tag="Usb" />
                                <ComboBoxItem Content="Цифровой выход" Tag="Digital" />
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Padding="20,0,20,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingsHelperTextStyle}" Margin="0,0,0,6" x:Name="DeviceKindDetectionText" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource SettingsHelperTextStyle}" Margin="0,0,0,6" Text="Системное устройство по умолчанию следует настройкам Windows. Если выбранные наушники или колонки отключены, Lumisense переключится на него автоматически." TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SettingsGroupCardStyle}" Margin="0,0,0,0">
                <StackPanel>
                    <Border Style="{StaticResource SettingsRowStyle}" BorderThickness="0" Visibility="{Binding Visibility, ElementName=WasapiModeCombo}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="Режим WASAPI">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsRowTitleStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled, ElementName=WasapiModeCombo}" Value="False">
                                                    <Setter Property="Opacity" Value="0.45" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Style="{StaticResource SettingsHelperTextStyle}" Margin="0,4,0,0" Text="Монопольный режим отдаёт устройство целиком Lumisense — другие приложения на время воспроизведения теряют звук на этом устройстве. Поддерживается не всеми звуковыми картами: если устройство откажется работать в этом режиме, Lumisense автоматически вернётся к общему." TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" x:Name="WasapiModeCombo" AutomationProperties.Name="Режим WASAPI" SelectionChanged="WasapiModeCombo_SelectionChanged" MinWidth="300">
                                <ComboBoxItem Content="Общий (Shared)" Tag="Shared" />
                                <ComboBoxItem Content="Монопольный (Exclusive)" Tag="Exclusive" />
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingsRowStyle}" Visibility="{Binding Visibility, ElementName=WasapiLatencyCombo}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="Размер буфера">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsRowTitleStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled, ElementName=WasapiLatencyCombo}" Value="False">
                                                    <Setter Property="Opacity" Value="0.45" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Style="{StaticResource SettingsHelperTextStyle}" Margin="0,4,0,0" Text="Чем больше буфер, тем реже звук щёлкает, когда процессор загружен почти полностью; пауза и перемотка при этом срабатывают на доли секунды позже. Применяется со следующего трека." TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" x:Name="WasapiLatencyCombo" AutomationProperties.Name="Размер буфера WASAPI" SelectionChanged="WasapiLatencyCombo_SelectionChanged" MinWidth="300">
                                <ComboBoxItem Content="Малая задержка (60 мс)" Tag="60" />
                                <ComboBoxItem Content="Стандартный (100 мс, по умолчанию)" Tag="100" />
                                <ComboBoxItem Content="Устойчивый к нагрузке (200 мс)" Tag="200" />
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingsRowStyle}" Visibility="{Binding Visibility, ElementName=RaisePlaybackPriorityCheckBox}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="Повышенный приоритет плеера">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsRowTitleStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled, ElementName=RaisePlaybackPriorityCheckBox}" Value="False">
                                                    <Setter Property="Opacity" Value="0.45" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Style="{StaticResource SettingsHelperTextStyle}" Margin="0,4,0,0" Text="Плеер получает процессор раньше фоновых программ, поэтому при загрузке под 100% звук щёлкает реже. Остальные программы от этого не страдают заметно." TextWrapping="Wrap" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" x:Name="RaisePlaybackPriorityCheckBox" AutomationProperties.Name="Повышенный приоритет плеера"
                            Checked="RaisePlaybackPriorityCheckBox_Changed" Unchecked="RaisePlaybackPriorityCheckBox_Changed" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingsRowStyle}" Visibility="{Binding Visibility, ElementName=OutputDeviceRuntimeExpander}">
                        <Expander x:Name="OutputDeviceRuntimeExpander" Style="{StaticResource FluentExpanderStyle}"
                                  HorizontalAlignment="Stretch" IsExpanded="False" Margin="0,0,0,0">
                            <Expander.Header>
                                <StackPanel>
                                    <TextBlock x:Name="OutputDeviceRuntimeTitleText" Text="Фактическое устройство"
                                               FontSize="11" FontWeight="SemiBold" Opacity="0.7" />
                                    <TextBlock x:Name="OutputDeviceRuntimeValueText" FontSize="12" FontWeight="SemiBold"
                                               TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel Margin="0,4,0,0">
                                <TextBlock x:Name="OutputDeviceRuntimeModeText" FontSize="11" Opacity="0.72"
                                           TextWrapping="Wrap" Margin="0,4,0,0" />
                                <TextBlock x:Name="OutputDeviceRuntimeDiagnosticsText" FontSize="11" Opacity="0.66"
                                           TextWrapping="Wrap" Margin="0,6,0,0" />
                                <TextBlock x:Name="OutputDeviceSignalPathText" FontSize="11" Opacity="0.78"
                                           TextWrapping="Wrap" Margin="0,6,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <ui:Button x:Name="CopyAudioDiagnosticsButton" Appearance="Secondary"
                                               Content="Копировать аудиодиагностику"
                                               Click="CopyAudioDiagnosticsButton_Click" />
                                    <TextBlock x:Name="AudioDiagnosticsCopyStatusText" FontSize="11" Opacity="0.7"
                                               VerticalAlignment="Center" TextWrapping="Wrap" Margin="10,0,0,0" />
                                </StackPanel>
                                <CheckBox x:Name="TrackLoadTraceCheckBox" Content="Подробный trace подготовки трека"
                                          Checked="TrackLoadTraceCheckBox_Changed"
                                          Unchecked="TrackLoadTraceCheckBox_Changed"
                                          Margin="0,12,0,0" />
                                <TextBlock Text="Добавляет в локальный лог длительность этапов загрузки трека; пути и метаданные треков не записываются."
                                           FontSize="11" Opacity="0.62" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Expander>
                    </Border>
                    <Border Padding="20,0,20,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingsHelperTextStyle}" Margin="0,0,0,6" x:Name="OutputDeviceStatusText" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- См. AppSettings.NeverAutoPlayLastTrackOnStartup / WasPlayingOnClose. -->
        <StackPanel Margin="0,0,0,24">
            <Border Style="{StaticResource SettingsGroupCardStyle}" Margin="0,0,0,0">
                <StackPanel>
                    <Border Style="{StaticResource SettingsRowStyle}" BorderThickness="0" Visibility="{Binding Visibility, ElementName=NeverAutoPlayLastTrackOnStartupCheckBox}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="Никогда не запускать трек при старте">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsRowTitleStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled, ElementName=NeverAutoPlayLastTrackOnStartupCheckBox}" Value="False">
                                                    <Setter Property="Opacity" Value="0.45" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Style="{StaticResource SettingsHelperTextStyle}" Margin="0,4,0,0" Text="По умолчанию Lumisense продолжает трек с сохранённой позиции, только если он играл при закрытии приложения. С этой настройкой трек всё равно откроется, но останется на паузе." TextWrapping="Wrap" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" x:Name="NeverAutoPlayLastTrackOnStartupCheckBox"
                            AutomationProperties.Name="Никогда не запускать трек при старте"
                            Checked="NeverAutoPlayLastTrackOnStartupCheckBox_Changed"
                            Unchecked="NeverAutoPlayLastTrackOnStartupCheckBox_Changed" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- См. AppSettings.ShuffleMode и ShuffleModeSelector: как выбирается следующий трек, когда включён шаффл. -->
        <StackPanel Margin="0,0,0,24">
            <Border Style="{StaticResource SettingsGroupCardStyle}" Margin="0,0,0,0">
                <StackPanel>
                    <Border Style="{StaticResource SettingsRowStyle}" BorderThickness="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="Режим шаффла">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsRowTitleStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled, ElementName=ShuffleModeRadioCombo}" Value="False">
                                                    <Setter Property="Opacity" Value="0.45" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel x:Name="ShuffleModeRadioGroup" Grid.Column="1" VerticalAlignment="Center">
                                <ComboBox x:Name="ShuffleModeRadioCombo" Tag="RadioGroup" AutomationProperties.Name="Режим шаффла" MinWidth="220" HorizontalAlignment="Right">
                                    <ComboBoxItem Content="Колода (по умолчанию)" Tag="ShuffleModeDeckRadio" />
                                    <ComboBoxItem Content="Случайный" Tag="ShuffleModeRandomRadio" />
                                    <ComboBoxItem Content="Любимые чаще" Tag="ShuffleModeFavoritesRadio" />
                                    <ComboBoxItem Content="Редкие чаще" Tag="ShuffleModeRareRadio" />
                                    <ComboBoxItem Content="По папкам" Tag="ShuffleModeFoldersRadio" />
                                </ComboBox>
                                <StackPanel Visibility="Collapsed">
                                    <RadioButton x:Name="ShuffleModeDeckRadio" Content="Колода (по умолчанию)"
                                    GroupName="ShuffleMode" Checked="ShuffleModeRadio_Changed" />
                                    <RadioButton x:Name="ShuffleModeRandomRadio" Content="Случайный"
                                    GroupName="ShuffleMode" Checked="ShuffleModeRadio_Changed" />
                                    <RadioButton x:Name="ShuffleModeFavoritesRadio" Content="Любимые чаще"
                                    GroupName="ShuffleMode" Checked="ShuffleModeRadio_Changed" />
                                    <RadioButton x:Name="ShuffleModeRareRadio" Content="Редкие чаще"
                                    GroupName="ShuffleMode" Checked="ShuffleModeRadio_Changed" />
                                    <RadioButton x:Name="ShuffleModeFoldersRadio" Content="По папкам"
                                    GroupName="ShuffleMode" Checked="ShuffleModeRadio_Changed" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Padding="20,0,20,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingsHelperTextStyle}" Margin="0,0,0,6" x:Name="ShuffleModeDescriptionText"
                            TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Margin="0,0,0,24">
            <Border Style="{StaticResource SettingsGroupCardStyle}" Margin="0,0,0,0">
                <StackPanel>
                    <Border Style="{StaticResource SettingsRowStyle}" BorderThickness="0" Visibility="{Binding Visibility, ElementName=SaveQueueBetweenRestartsCheckBox}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="Сохранять очередь «Играть следующим» между запусками">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsRowTitleStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled, ElementName=SaveQueueBetweenRestartsCheckBox}" Value="False">
                                                    <Setter Property="Opacity" Value="0.45" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Style="{StaticResource SettingsHelperTextStyle}" Margin="0,4,0,0" Text="По умолчанию очередь не переживает перезапуск приложения. Если включить — она сохранится и восстановится при следующем запуске (пропавшие с диска файлы будут тихо убраны)." TextWrapping="Wrap" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" x:Name="SaveQueueBetweenRestartsCheckBox" AutomationProperties.Name="Сохранять очередь «Играть следующим» между запусками"
                            Checked="SaveQueueBetweenRestartsCheckBox_Changed" Unchecked="SaveQueueBetweenRestartsCheckBox_Changed" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- См. AppSettings.AutoRefreshPlaylistFolders / MainWindow.StartFolderWatchers. -->
        <StackPanel Margin="0,0,0,24">
            <Border Style="{StaticResource SettingsGroupCardStyle}" Margin="0,0,0,0">
                <StackPanel>
                    <Border Style="{StaticResource SettingsRowStyle}" BorderThickness="0" Visibility="{Binding Visibility, ElementName=AutoRefreshPlaylistFoldersCheckBox}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="Автоматически обновлять папки плейлиста">
                                    <TextBlock.Style>
