<UserControl x:Class="Lumisense.AppearanceSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:Lumisense">
    <StackPanel x:Name="PageAppearance">
        <TextBlock Text="Оформление" Style="{StaticResource PageTitleStyle}" />
        <TextBlock Text="Язык, тема, иконки, акцент, основа окна и доступность." Style="{StaticResource PageDescriptionStyle}" />

        <StackPanel Margin="0,0,0,24">
            <Border Style="{StaticResource SettingsGroupCardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Border Style="{StaticResource SettingsRowStyle}" BorderThickness="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="Язык интерфейса">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsRowTitleStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled, ElementName=InterfaceLanguageRadioCombo}" Value="False">
                                                    <Setter Property="Opacity" Value="0.45" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel x:Name="InterfaceLanguageRadioGroup" Grid.Column="1" VerticalAlignment="Center">
                                <ComboBox x:Name="InterfaceLanguageRadioCombo" Tag="RadioGroup" AutomationProperties.Name="Язык интерфейса" MinWidth="220" HorizontalAlignment="Right">
                                    <ComboBoxItem Content="Русский" Tag="LanguageRussianRadio" />
                                    <ComboBoxItem Content="English" Tag="LanguageEnglishRadio" />
                                </ComboBox>
                                <StackPanel Visibility="Collapsed">
                                    <RadioButton x:Name="LanguageRussianRadio" Content="Русский" GroupName="InterfaceLanguage"
                                    Checked="LanguageRadio_Changed" />
                                    <RadioButton x:Name="LanguageEnglishRadio" Content="English" GroupName="InterfaceLanguage"
                                    Checked="LanguageRadio_Changed" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Padding="20,0,20,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingsHelperTextStyle}" Margin="0,0,0,6" Text="Выберите язык Lumisense. Изменение применяется сразу ко всем открытым окнам." TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SettingsGroupCardStyle}" Margin="0,0,0,0">
                <StackPanel>
                    <Border Style="{StaticResource SettingsRowStyle}" BorderThickness="0" Visibility="{Binding Visibility, ElementName=ChangelogAutoTranslateCheckBox}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="Автоматически переводить журнал изменений на английский">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsRowTitleStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled, ElementName=ChangelogAutoTranslateCheckBox}" Value="False">
                                                    <Setter Property="Opacity" Value="0.45" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Style="{StaticResource SettingsHelperTextStyle}" Margin="0,4,0,0" Text="В английском интерфейсе текст пунктов журнала изменений отправляется на translate.googleapis.com (неофициальный интерфейс Google Translate), а результат сохраняется на этом компьютере. Переведённые пункты помечаются подсказкой «Machine translation». Если выключено, журнал изменений показывается на русском. По умолчанию выключено." TextWrapping="Wrap" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" x:Name="ChangelogAutoTranslateCheckBox"
                            AutomationProperties.Name="Автоматически переводить журнал изменений на английский"
                            Checked="ChangelogAutoTranslateCheckBox_Changed" Unchecked="ChangelogAutoTranslateCheckBox_Changed" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel x:Name="NavigationStyleCard" Margin="0,0,0,24">
            <Border Style="{StaticResource SettingsGroupCardStyle}" Margin="0,0,0,0">
                <StackPanel>
                    <Border Style="{StaticResource SettingsRowStyle}" BorderThickness="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="Навигация в настройках">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsRowTitleStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled, ElementName=SettingsNavigationStyleRadioCombo}" Value="False">
                                                    <Setter Property="Opacity" Value="0.45" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel x:Name="SettingsNavigationStyleRadioGroup" Grid.Column="1" VerticalAlignment="Center">
                                <ComboBox x:Name="SettingsNavigationStyleRadioCombo" Tag="RadioGroup" AutomationProperties.Name="Навигация в настройках" MinWidth="220" HorizontalAlignment="Right">
                                    <ComboBoxItem Content="Боковая панель" Tag="NavStyleSidebarRadio" />
                                    <ComboBoxItem Content="Таблетки сверху" Tag="NavStylePillsRadio" />
                                    <ComboBoxItem Content="Плавающая нижняя панель" Tag="NavStyleFloatingRadio" />
                                </ComboBox>
                                <StackPanel Visibility="Collapsed">
                                    <RadioButton x:Name="NavStyleSidebarRadio" Content="Боковая панель" GroupName="SettingsNavigationStyle"
                                    Checked="NavStyleRadio_Changed" MinHeight="32" />
                                    <RadioButton x:Name="NavStylePillsRadio" Content="Таблетки сверху" GroupName="SettingsNavigationStyle"
                                    Checked="NavStyleRadio_Changed" MinHeight="32" />
                                    <RadioButton x:Name="NavStyleFloatingRadio" Content="Плавающая нижняя панель" GroupName="SettingsNavigationStyle"
                                    Checked="NavStyleRadio_Changed" MinHeight="32" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <StackPanel x:Name="NavLabelOptionsPanel" Visibility="Collapsed">
                        <Border Style="{StaticResource SettingsRowStyle}" Visibility="{Binding Visibility, ElementName=NavShowLabelsCheckBox}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                    <TextBlock Text="Показывать названия рядом с иконками">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsRowTitleStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEnabled, ElementName=NavShowLabelsCheckBox}" Value="False">
                                                        <Setter Property="Opacity" Value="0.45" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" x:Name="NavShowLabelsCheckBox" AutomationProperties.Name="Показывать названия рядом с иконками" MinHeight="32"
                                VerticalContentAlignment="Center"
                                Checked="NavShowLabelsCheckBox_Changed" Unchecked="NavShowLabelsCheckBox_Changed" />
                            </Grid>
                        </Border>
                        <StackPanel x:Name="NavLabelModePanel" Visibility="Collapsed">
                            <Border Style="{StaticResource SettingsRowStyle}" Visibility="{Binding Visibility, ElementName=NavLabelModeBelowRadio}">
                                <RadioButton Style="{StaticResource SettingsRowRadioButtonStyle}" x:Name="NavLabelModeBelowRadio" Content="Под иконками у всех пунктов" GroupName="SettingsNavigationLabelMode"
                                Checked="NavLabelModeRadio_Changed" MinHeight="32" />
                            </Border>
                            <Border Style="{StaticResource SettingsRowStyle}" Visibility="{Binding Visibility, ElementName=NavLabelModeSelectedRadio}">
                                <RadioButton Style="{StaticResource SettingsRowRadioButtonStyle}" x:Name="NavLabelModeSelectedRadio" Content="Рядом с иконкой выбранного пункта" GroupName="SettingsNavigationLabelMode"
                                Checked="NavLabelModeRadio_Changed" MinHeight="32" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    <Border Padding="20,0,20,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingsHelperTextStyle}" Margin="0,0,0,6" Text="Как выглядит переключение разделов в этом окне. Применяется сразу." TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Margin="0,0,0,24">
            <Border Style="{StaticResource SettingsGroupCardStyle}" Margin="0,0,0,0">
                <StackPanel>
                    <Border Style="{StaticResource SettingsRowStyle}" BorderThickness="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="Тема">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsRowTitleStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled, ElementName=ThemeRadioCombo}" Value="False">
                                                    <Setter Property="Opacity" Value="0.45" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel x:Name="ThemeRadioGroup" Grid.Column="1" VerticalAlignment="Center">
                                <ComboBox x:Name="ThemeRadioCombo" Tag="RadioGroup" AutomationProperties.Name="Тема" MinWidth="220" HorizontalAlignment="Right">
                                    <ComboBoxItem Content="Тёмная" Tag="ThemeDarkRadio" />
                                    <ComboBoxItem Content="Светлая" Tag="ThemeLightRadio" />
                                </ComboBox>
                                <StackPanel Visibility="Collapsed">
                                    <RadioButton x:Name="ThemeDarkRadio" Content="Тёмная" GroupName="Theme"
                                    Checked="ThemeRadio_Changed" />
                                    <RadioButton x:Name="ThemeLightRadio" Content="Светлая" GroupName="Theme"
                                    Checked="ThemeRadio_Changed" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- SvgPathIcon.Pack переопределяет IconPacks.Current только для превью в галерее; ЛКМ выбирает пак (применяется сразу, IconPackContext),
             ПКМ открывает IconPackPreviewWindow с полным набором. -->
        <StackPanel Margin="0,0,0,24">
            <TextBlock Text="Набор иконок" Style="{StaticResource SettingsGroupTitleStyle}" />
            <Border Style="{StaticResource SettingsGroupCardStyle}" Margin="0,0,0,0">
                <StackPanel>
                    <Border Style="{StaticResource SettingsRowStyle}" BorderThickness="0">
                        <WrapPanel>
                            <Border x:Name="IconPackCardDuotone" Tag="Duotone" Width="140" Margin="0,0,12,12"
                                    Padding="14,16" CornerRadius="10" Cursor="Hand"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    BorderThickness="1" BorderBrush="Transparent"
                                    MouseLeftButtonDown="IconPackCard_MouseLeftButtonDown"
                                    MouseRightButtonDown="IconPackCard_MouseRightButtonDown">
                                <Grid>
                                    <Border CornerRadius="9" Margin="-14,-16" Opacity="0.16" Visibility="Collapsed" IsHitTestVisible="False"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                                            <local:SvgPathIcon Pack="Duotone" Icon="IconPlay" Size="22" Margin="0,0,10,0" />
                                            <local:SvgPathIcon Pack="Duotone" Icon="IconHeart" Size="22" Margin="0,0,10,0" />
                                            <local:SvgPathIcon Pack="Duotone" Icon="IconSettings" Size="22" />
                                        </StackPanel>
                                        <TextBlock Text="Duotone" HorizontalAlignment="Center" FontSize="13" />
                                        <TextBlock Text="Мягкие, двухцветные" HorizontalAlignment="Center"
                                                   FontSize="11" Opacity="0.6" TextWrapping="Wrap" TextAlignment="Center" />
                                    </StackPanel>
                                    <Border Width="18" Height="18" CornerRadius="9" HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Margin="0,-10,-8,0" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}">
                                        <Border.RenderTransform>
                                            <ScaleTransform />
                                        </Border.RenderTransform>
                                        <Path Data="M1,5 L4.2,8 L10,1.5" Width="11" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Stroke="{DynamicResource TextOnAccentFillColorPrimaryBrush}" StrokeThickness="1.8"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Border x:Name="IconPackCardOutline" Tag="Outline" Width="140" Margin="0,0,12,12"
                                    Padding="14,16" CornerRadius="10" Cursor="Hand"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    BorderThickness="1" BorderBrush="Transparent"
                                    MouseLeftButtonDown="IconPackCard_MouseLeftButtonDown"
                                    MouseRightButtonDown="IconPackCard_MouseRightButtonDown">
                                <Grid>
                                    <Border CornerRadius="9" Margin="-14,-16" Opacity="0.16" Visibility="Collapsed" IsHitTestVisible="False"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                                            <local:SvgPathIcon Pack="Outline" Icon="IconPlay" Size="22" Margin="0,0,10,0" />
                                            <local:SvgPathIcon Pack="Outline" Icon="IconHeart" Size="22" Margin="0,0,10,0" />
                                            <local:SvgPathIcon Pack="Outline" Icon="IconSettings" Size="22" />
                                        </StackPanel>
                                        <TextBlock Text="Outline" HorizontalAlignment="Center" FontSize="13" />
                                        <TextBlock Text="Тонкий контур, round cap" HorizontalAlignment="Center"
                                                   FontSize="11" Opacity="0.6" TextWrapping="Wrap" TextAlignment="Center" />
                                    </StackPanel>
                                    <Border Width="18" Height="18" CornerRadius="9" HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Margin="0,-10,-8,0" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}">
                                        <Border.RenderTransform>
                                            <ScaleTransform />
                                        </Border.RenderTransform>
                                        <Path Data="M1,5 L4.2,8 L10,1.5" Width="11" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Stroke="{DynamicResource TextOnAccentFillColorPrimaryBrush}" StrokeThickness="1.8"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Border x:Name="IconPackCardBold" Tag="Bold" Width="140" Margin="0,0,12,12"
                                    Padding="14,16" CornerRadius="10" Cursor="Hand"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    BorderThickness="1" BorderBrush="Transparent"
                                    MouseLeftButtonDown="IconPackCard_MouseLeftButtonDown"
                                    MouseRightButtonDown="IconPackCard_MouseRightButtonDown">
                                <Grid>
                                    <Border CornerRadius="9" Margin="-14,-16" Opacity="0.16" Visibility="Collapsed" IsHitTestVisible="False"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                                            <local:SvgPathIcon Pack="Bold" Icon="IconPlay" Size="22" Margin="0,0,10,0" />
                                            <local:SvgPathIcon Pack="Bold" Icon="IconHeart" Size="22" Margin="0,0,10,0" />
                                            <local:SvgPathIcon Pack="Bold" Icon="IconSettings" Size="22" />
                                        </StackPanel>
                                        <TextBlock Text="Bold" HorizontalAlignment="Center" FontSize="13" />
                                        <TextBlock Text="Плотный, контрастный" HorizontalAlignment="Center"
                                                   FontSize="11" Opacity="0.6" TextWrapping="Wrap" TextAlignment="Center" />
                                    </StackPanel>
                                    <Border Width="18" Height="18" CornerRadius="9" HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Margin="0,-10,-8,0" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}">
                                        <Border.RenderTransform>
                                            <ScaleTransform />
                                        </Border.RenderTransform>
                                        <Path Data="M1,5 L4.2,8 L10,1.5" Width="11" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Stroke="{DynamicResource TextOnAccentFillColorPrimaryBrush}" StrokeThickness="1.8"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Border x:Name="IconPackCardFill" Tag="Fill" Width="140" Margin="0,0,12,12"
                                    Padding="14,16" CornerRadius="10" Cursor="Hand"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    BorderThickness="1" BorderBrush="Transparent"
                                    MouseLeftButtonDown="IconPackCard_MouseLeftButtonDown"
                                    MouseRightButtonDown="IconPackCard_MouseRightButtonDown">
                                <Grid>
                                    <Border CornerRadius="9" Margin="-14,-16" Opacity="0.16" Visibility="Collapsed" IsHitTestVisible="False"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                                            <local:SvgPathIcon Pack="Fill" Icon="IconPlay" Size="22" Margin="0,0,10,0" />
                                            <local:SvgPathIcon Pack="Fill" Icon="IconHeart" Size="22" Margin="0,0,10,0" />
                                            <local:SvgPathIcon Pack="Fill" Icon="IconSettings" Size="22" />
                                        </StackPanel>
                                        <TextBlock Text="Fill" HorizontalAlignment="Center" FontSize="13" />
                                        <TextBlock Text="Сплошные силуэты" HorizontalAlignment="Center"
                                                   FontSize="11" Opacity="0.6" TextWrapping="Wrap" TextAlignment="Center" />
                                    </StackPanel>
                                    <Border Width="18" Height="18" CornerRadius="9" HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Margin="0,-10,-8,0" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}">
                                        <Border.RenderTransform>
                                            <ScaleTransform />
                                        </Border.RenderTransform>
                                        <Path Data="M1,5 L4.2,8 L10,1.5" Width="11" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Stroke="{DynamicResource TextOnAccentFillColorPrimaryBrush}" StrokeThickness="1.8"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Border x:Name="IconPackCardThin" Tag="Thin" Width="140" Margin="0,0,12,12"
                                    Padding="14,16" CornerRadius="10" Cursor="Hand"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    BorderThickness="1" BorderBrush="Transparent"
                                    MouseLeftButtonDown="IconPackCard_MouseLeftButtonDown"
                                    MouseRightButtonDown="IconPackCard_MouseRightButtonDown">
                                <Grid>
                                    <Border CornerRadius="9" Margin="-14,-16" Opacity="0.16" Visibility="Collapsed" IsHitTestVisible="False"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                                            <local:SvgPathIcon Pack="Thin" Icon="IconPlay" Size="22" Margin="0,0,10,0" />
                                            <local:SvgPathIcon Pack="Thin" Icon="IconHeart" Size="22" Margin="0,0,10,0" />
                                            <local:SvgPathIcon Pack="Thin" Icon="IconSettings" Size="22" />
                                        </StackPanel>
                                        <TextBlock Text="Thin" HorizontalAlignment="Center" FontSize="13" />
                                        <TextBlock Text="Ультратонкая линия" HorizontalAlignment="Center"
                                                   FontSize="11" Opacity="0.6" TextWrapping="Wrap" TextAlignment="Center" />
                                    </StackPanel>
                                    <Border Width="18" Height="18" CornerRadius="9" HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Margin="0,-10,-8,0" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}">
                                        <Border.RenderTransform>
                                            <ScaleTransform />
                                        </Border.RenderTransform>
                                        <Path Data="M1,5 L4.2,8 L10,1.5" Width="11" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Stroke="{DynamicResource TextOnAccentFillColorPrimaryBrush}" StrokeThickness="1.8"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Border x:Name="IconPackCardFontAwesome" Tag="FontAwesome" Width="140" Margin="0,0,12,12"
                                    Padding="14,16" CornerRadius="10" Cursor="Hand"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    BorderThickness="1" BorderBrush="Transparent"
                                    MouseLeftButtonDown="IconPackCard_MouseLeftButtonDown"
                                    MouseRightButtonDown="IconPackCard_MouseRightButtonDown">
                                <Grid>
                                    <Border CornerRadius="9" Margin="-14,-16" Opacity="0.16" Visibility="Collapsed" IsHitTestVisible="False"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                                            <local:SvgPathIcon Pack="FontAwesome" Icon="IconPlay" Size="22" Margin="0,0,10,0" />
                                            <local:SvgPathIcon Pack="FontAwesome" Icon="IconHeart" Size="22" Margin="0,0,10,0" />
                                            <local:SvgPathIcon Pack="FontAwesome" Icon="IconSettings" Size="22" />
                                        </StackPanel>
                                        <TextBlock Text="Font Awesome" HorizontalAlignment="Center" FontSize="13" />
                                        <TextBlock Text="Плотные силуэты (Free)" HorizontalAlignment="Center"
                                                   FontSize="11" Opacity="0.6" TextWrapping="Wrap" TextAlignment="Center" />
                                    </StackPanel>
                                    <Border Width="18" Height="18" CornerRadius="9" HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Margin="0,-10,-8,0" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}">
                                        <Border.RenderTransform>
                                            <ScaleTransform />
                                        </Border.RenderTransform>
                                        <Path Data="M1,5 L4.2,8 L10,1.5" Width="11" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Stroke="{DynamicResource TextOnAccentFillColorPrimaryBrush}" StrokeThickness="1.8"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    </Border>
                                </Grid>
                            </Border>
                        </WrapPanel>
                    </Border>
                    <Border Padding="20,0,20,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingsHelperTextStyle}" Margin="0,0,0,6" Text="Применяется сразу. ПКМ по карточке — посмотреть весь набор." TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Значок приложения (окна, трей; AppIcons.cs) применяется сразу, как набор иконок; .exe и ярлык не меняются — зашиты через ApplicationIcon в csproj. -->
        <StackPanel Margin="0,0,0,24">
            <TextBlock Text="Значок приложения" Style="{StaticResource SettingsGroupTitleStyle}" />
            <Border Style="{StaticResource SettingsGroupCardStyle}" Margin="0,0,0,0">
                <StackPanel>
                    <Border Style="{StaticResource SettingsRowStyle}" BorderThickness="0">
                        <WrapPanel>
                            <Border x:Name="AppIconCardGlass" Tag="Glass" Width="140" Margin="0,0,12,12"
                                    Padding="14,16" CornerRadius="10" Cursor="Hand"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    BorderThickness="1" BorderBrush="Transparent"
                                    MouseLeftButtonDown="AppIconCard_MouseLeftButtonDown">
                                <Grid>
                                    <Border CornerRadius="9" Margin="-14,-16" Opacity="0.16" Visibility="Collapsed" IsHitTestVisible="False"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <StackPanel>
                                        <Image Source="/Icons/app/lumisense-glass.png" Width="44" Height="44" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               SnapsToDevicePixels="True" UseLayoutRounding="True"
                                               Margin="0,0,0,12" />
                                        <TextBlock Text="Glass" HorizontalAlignment="Center" FontSize="13" />
                                        <TextBlock Text="Стекло на ярком фоне" HorizontalAlignment="Center"
                                                   FontSize="11" Opacity="0.6" TextWrapping="Wrap" TextAlignment="Center" />
                                    </StackPanel>
                                    <Border Width="18" Height="18" CornerRadius="9" HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Margin="0,-10,-8,0" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}">
                                        <Border.RenderTransform>
                                            <ScaleTransform />
                                        </Border.RenderTransform>
                                        <Path Data="M1,5 L4.2,8 L10,1.5" Width="11" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Stroke="{DynamicResource TextOnAccentFillColorPrimaryBrush}" StrokeThickness="1.8"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Border x:Name="AppIconCardSpotlight" Tag="Spotlight" Width="140" Margin="0,0,12,12"
                                    Padding="14,16" CornerRadius="10" Cursor="Hand"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    BorderThickness="1" BorderBrush="Transparent"
                                    MouseLeftButtonDown="AppIconCard_MouseLeftButtonDown">
                                <Grid>
                                    <Border CornerRadius="9" Margin="-14,-16" Opacity="0.16" Visibility="Collapsed" IsHitTestVisible="False"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <StackPanel>
                                        <Image Source="/Icons/app/lumisense-spotlight.png" Width="44" Height="44" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               SnapsToDevicePixels="True" UseLayoutRounding="True"
                                               Margin="0,0,0,12" />
                                        <TextBlock Text="Spotlight" HorizontalAlignment="Center" FontSize="13" />
                                        <TextBlock Text="Стекло в луче света" HorizontalAlignment="Center"
                                                   FontSize="11" Opacity="0.6" TextWrapping="Wrap" TextAlignment="Center" />
                                    </StackPanel>
                                    <Border Width="18" Height="18" CornerRadius="9" HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Margin="0,-10,-8,0" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}">
                                        <Border.RenderTransform>
                                            <ScaleTransform />
                                        </Border.RenderTransform>
                                        <Path Data="M1,5 L4.2,8 L10,1.5" Width="11" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Stroke="{DynamicResource TextOnAccentFillColorPrimaryBrush}" StrokeThickness="1.8"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Border x:Name="AppIconCardBacklit" Tag="Backlit" Width="140" Margin="0,0,12,12"
                                    Padding="14,16" CornerRadius="10" Cursor="Hand"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    BorderThickness="1" BorderBrush="Transparent"
                                    MouseLeftButtonDown="AppIconCard_MouseLeftButtonDown">
                                <Grid>
                                    <Border CornerRadius="9" Margin="-14,-16" Opacity="0.16" Visibility="Collapsed" IsHitTestVisible="False"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <StackPanel>
                                        <Image Source="/Icons/app/lumisense-backlit.png" Width="44" Height="44" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               SnapsToDevicePixels="True" UseLayoutRounding="True"
                                               Margin="0,0,0,12" />
                                        <TextBlock Text="Backlit" HorizontalAlignment="Center" FontSize="13" />
                                        <TextBlock Text="Подсветка за стеклом" HorizontalAlignment="Center"
                                                   FontSize="11" Opacity="0.6" TextWrapping="Wrap" TextAlignment="Center" />
                                    </StackPanel>
                                    <Border Width="18" Height="18" CornerRadius="9" HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Margin="0,-10,-8,0" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}">
                                        <Border.RenderTransform>
                                            <ScaleTransform />
                                        </Border.RenderTransform>
                                        <Path Data="M1,5 L4.2,8 L10,1.5" Width="11" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Stroke="{DynamicResource TextOnAccentFillColorPrimaryBrush}" StrokeThickness="1.8"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Border x:Name="AppIconCardStripes" Tag="Stripes" Width="140" Margin="0,0,12,12"
                                    Padding="14,16" CornerRadius="10" Cursor="Hand"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    BorderThickness="1" BorderBrush="Transparent"
                                    MouseLeftButtonDown="AppIconCard_MouseLeftButtonDown">
                                <Grid>
                                    <Border CornerRadius="9" Margin="-14,-16" Opacity="0.16" Visibility="Collapsed" IsHitTestVisible="False"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <StackPanel>
                                        <Image Source="/Icons/app/lumisense-stripes.png" Width="44" Height="44" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               SnapsToDevicePixels="True" UseLayoutRounding="True"
                                               Margin="0,0,0,12" />
                                        <TextBlock Text="Stripes" HorizontalAlignment="Center" FontSize="13" />
                                        <TextBlock Text="Play и звуковые полоски" HorizontalAlignment="Center"
                                                   FontSize="11" Opacity="0.6" TextWrapping="Wrap" TextAlignment="Center" />
                                    </StackPanel>
                                    <Border Width="18" Height="18" CornerRadius="9" HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Margin="0,-10,-8,0" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}">
                                        <Border.RenderTransform>
                                            <ScaleTransform />
                                        </Border.RenderTransform>
                                        <Path Data="M1,5 L4.2,8 L10,1.5" Width="11" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Stroke="{DynamicResource TextOnAccentFillColorPrimaryBrush}" StrokeThickness="1.8"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Border x:Name="AppIconCardBeam" Tag="Beam" Width="140" Margin="0,0,12,12"
                                    Padding="14,16" CornerRadius="10" Cursor="Hand"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    BorderThickness="1" BorderBrush="Transparent"
                                    MouseLeftButtonDown="AppIconCard_MouseLeftButtonDown">
                                <Grid>
                                    <Border CornerRadius="9" Margin="-14,-16" Opacity="0.16" Visibility="Collapsed" IsHitTestVisible="False"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <StackPanel>
                                        <Image Source="/Icons/app/lumisense-beam.png" Width="44" Height="44" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               SnapsToDevicePixels="True" UseLayoutRounding="True"
                                               Margin="0,0,0,12" />
                                        <TextBlock Text="Beam" HorizontalAlignment="Center" FontSize="13" />
                                        <TextBlock Text="Свет из кончика Play" HorizontalAlignment="Center"
                                                   FontSize="11" Opacity="0.6" TextWrapping="Wrap" TextAlignment="Center" />
                                    </StackPanel>
                                    <Border Width="18" Height="18" CornerRadius="9" HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Margin="0,-10,-8,0" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}">
                                        <Border.RenderTransform>
                                            <ScaleTransform />
                                        </Border.RenderTransform>
                                        <Path Data="M1,5 L4.2,8 L10,1.5" Width="11" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Stroke="{DynamicResource TextOnAccentFillColorPrimaryBrush}" StrokeThickness="1.8"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    </Border>
                                </Grid>
                            </Border>
                        </WrapPanel>
                    </Border>
                    <Border Padding="20,0,20,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingsHelperTextStyle}" Margin="0,0,0,6" Text="Применяется сразу ко всем открытым окнам и значку в трее. Значок файла Lumisense.exe и диспетчера задач задаётся сборкой (Spotlight) и здесь не меняется; ярлыки на рабочем столе и в меню «Пуск» обновляются автоматически." TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Пресеты — восемь готовых hex-цветов, "Свой" открывает системный ColorDialog (AccentColorMode/AccentColorHex); рамка у выбранного пресета
             белая (RefreshAccentSwatchSelection). -->
        <StackPanel Margin="0,0,0,24">
            <Border Style="{StaticResource SettingsGroupCardStyle}" Margin="0,0,0,0">
                <StackPanel>
                    <Border Style="{StaticResource SettingsRowStyle}" BorderThickness="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="Акцентный цвет">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsRowTitleStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled, ElementName=AccentModeRadioCombo}" Value="False">
                                                    <Setter Property="Opacity" Value="0.45" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel x:Name="AccentModeRadioGroup" Grid.Column="1" VerticalAlignment="Center">
                                <ComboBox x:Name="AccentModeRadioCombo" Tag="RadioGroup" AutomationProperties.Name="Акцентный цвет" MinWidth="220" HorizontalAlignment="Right">
                                    <ComboBoxItem Content="Системный (как в Windows)" Tag="AccentSystemRadio" />
                                    <ComboBoxItem Content="От текущей обложки" Tag="AccentCoverRadio" />
                                    <ComboBoxItem Content="Свой" Tag="AccentManualRadio" />
                                </ComboBox>
                                <StackPanel Visibility="Collapsed">
                                    <RadioButton x:Name="AccentSystemRadio" Content="Системный (как в Windows)"
                                    GroupName="AccentMode" Checked="AccentModeRadio_Changed" />
                                    <RadioButton x:Name="AccentCoverRadio" Content="От текущей обложки"
                                    GroupName="AccentMode" Checked="AccentModeRadio_Changed" />
                                    <RadioButton x:Name="AccentManualRadio" Content="Свой" GroupName="AccentMode"
                                    Checked="AccentModeRadio_Changed" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingsRowAttachedStyle}" Visibility="{Binding Visibility, ElementName=AccentSwatchesPanel}">
                        <WrapPanel x:Name="AccentSwatchesPanel" Margin="26,0,0,0">
                            <Border x:Name="AccentSwatch0" Width="26" Height="26" CornerRadius="6"
                                    Margin="0,0,8,8" Background="#0078D4" BorderThickness="2"
                                    BorderBrush="Transparent" Cursor="Hand"
                                    MouseLeftButtonDown="AccentSwatch_MouseLeftButtonDown" />
                            <Border x:Name="AccentSwatch1" Width="26" Height="26" CornerRadius="6"
                                    Margin="0,0,8,8" Background="#8764B8" BorderThickness="2"
                                    BorderBrush="Transparent" Cursor="Hand"
                                    MouseLeftButtonDown="AccentSwatch_MouseLeftButtonDown" />
                            <Border x:Name="AccentSwatch2" Width="26" Height="26" CornerRadius="6"
                                    Margin="0,0,8,8" Background="#E3008C" BorderThickness="2"
                                    BorderBrush="Transparent" Cursor="Hand"
                                    MouseLeftButtonDown="AccentSwatch_MouseLeftButtonDown" />
                            <Border x:Name="AccentSwatch3" Width="26" Height="26" CornerRadius="6"
                                    Margin="0,0,8,8" Background="#E81123" BorderThickness="2"
                                    BorderBrush="Transparent" Cursor="Hand"
                                    MouseLeftButtonDown="AccentSwatch_MouseLeftButtonDown" />
                            <Border x:Name="AccentSwatch4" Width="26" Height="26" CornerRadius="6"
                                    Margin="0,0,8,8" Background="#FF8C00" BorderThickness="2"
                                    BorderBrush="Transparent" Cursor="Hand"
                                    MouseLeftButtonDown="AccentSwatch_MouseLeftButtonDown" />
                            <Border x:Name="AccentSwatch5" Width="26" Height="26" CornerRadius="6"
                                    Margin="0,0,8,8" Background="#FFB900" BorderThickness="2"
                                    BorderBrush="Transparent" Cursor="Hand"
                                    MouseLeftButtonDown="AccentSwatch_MouseLeftButtonDown" />
                            <Border x:Name="AccentSwatch6" Width="26" Height="26" CornerRadius="6"
                                    Margin="0,0,8,8" Background="#107C10" BorderThickness="2"
                                    BorderBrush="Transparent" Cursor="Hand"
                                    MouseLeftButtonDown="AccentSwatch_MouseLeftButtonDown" />
                            <Border x:Name="AccentSwatch7" Width="26" Height="26" CornerRadius="6"
                                    Margin="0,0,8,8" Background="#00B7C3" BorderThickness="2"
                                    BorderBrush="Transparent" Cursor="Hand"
                                    MouseLeftButtonDown="AccentSwatch_MouseLeftButtonDown" />

                            <ui:Button x:Name="AccentCustomButton" Width="26" Height="26" Padding="0"
                                       Margin="0,0,8,8" Appearance="Secondary" ToolTip="Свой цвет через палитру" AutomationProperties.Name="{Binding RelativeSource={RelativeSource Self}, Path=ToolTip}"
                                       Click="AccentCustomButton_Click">
                                <ui:Button.Icon>
                                    <local:SvgPathIcon Icon="IconEdit" Size="12" />
                                </ui:Button.Icon>
                            </ui:Button>
                        </WrapPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel x:Name="AccessibilityCard" Margin="0,0,0,24">
            <TextBlock Text="Доступность" Style="{StaticResource SettingsGroupTitleStyle}" />
            <Border Style="{StaticResource SettingsGroupCardStyle}" Margin="0,0,0,0">
                <StackPanel>
                    <Border Style="{StaticResource SettingsRowStyle}" BorderThickness="0" Visibility="{Binding Visibility, ElementName=InterfaceScaleSlider}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="Масштаб интерфейса" Style="{StaticResource SettingsRowTitleStyle}" />
                                <TextBlock Style="{StaticResource SettingsHelperTextStyle}" Margin="0,4,0,0" Text="Увеличивает базовый текст и стандартные элементы во всех основных окнах." />
                            </StackPanel>
                            <Grid Grid.Column="1" Width="340" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Height="28">
                                    <Slider x:Name="InterfaceScaleSlider" AutomationProperties.Name="Масштаб интерфейса" Style="{StaticResource SettingsAccentSliderStyle}" Minimum="85" Maximum="135"
                                            TickFrequency="5" local:SliderMilestoneMarkers.IsEnabled="True"
                                            IsMoveToPointEnabled="True" IsSnapToTickEnabled="True"
                                            PreviewMouseLeftButtonDown="InterfaceScaleSlider_PreviewMouseLeftButtonDown"
                                            PreviewMouseMove="InterfaceScaleSlider_PreviewMouseMove"
                                            PreviewMouseLeftButtonUp="InterfaceScaleSlider_PreviewMouseLeftButtonUp"
                                            ValueChanged="InterfaceScaleSlider_ValueChanged" />
                                </Grid>
                                <Border Grid.Column="1" MinWidth="64" Margin="14,0,0,0" Padding="10,5" CornerRadius="8"
                                        Background="{DynamicResource ControlFillColorTertiaryBrush}">
                                    <TextBlock x:Name="InterfaceScaleValueText" HorizontalAlignment="Center"
                                               FontWeight="SemiBold" TextAlignment="Center" />
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingsRowStyle}">
                        <StackPanel>
                            <TextBlock Margin="0,0,0,8" Text="Анимации" Style="{StaticResource SettingsFieldLabelStyle}" />
                            <TextBlock Style="{StaticResource SettingsHelperTextStyle}" Margin="0,4,0,0" Text="Галочки показывают, где анимации работают. Верхняя включает или выключает все сразу; когда выключено всё, это «Снизить движение». Воспроизведение и управление не меняются." />
                            <Border CornerRadius="10" Padding="14,12" Background="{DynamicResource ControlFillColorTertiaryBrush}">
                                <StackPanel>
                                    <CheckBox x:Name="AnimationsMasterCheckBox" Content="Все анимации" IsThreeState="True" Margin="0"
                                              FontWeight="SemiBold" Click="AnimationsMasterCheckBox_Click" />
                                    <Border Height="1" Margin="0,10,0,10" Opacity="0.35"
                                            Background="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <StackPanel x:Name="AnimationAreasPanel" Margin="22,0,0,0">
                                        <CheckBox Tag="Sliders" Content="Слайдеры в настройках"
                                                  Checked="AnimationAreaCheckBox_Changed" Unchecked="AnimationAreaCheckBox_Changed" />
                                        <CheckBox Tag="SettingsWindow" Content="Окно настроек: переходы и навигация"
                                                  Checked="AnimationAreaCheckBox_Changed" Unchecked="AnimationAreaCheckBox_Changed" />
                                        <CheckBox Tag="Cover" Content="Смена и сворачивание обложки"
                                                  Checked="AnimationAreaCheckBox_Changed" Unchecked="AnimationAreaCheckBox_Changed" />
                                        <CheckBox Tag="Lyrics" Content="Текст песни: прокрутка и подсветка строк"
                                                  Checked="AnimationAreaCheckBox_Changed" Unchecked="AnimationAreaCheckBox_Changed" />
                                        <CheckBox Tag="Progress" Content="Полоса воспроизведения"
                                                  Checked="AnimationAreaCheckBox_Changed" Unchecked="AnimationAreaCheckBox_Changed" />
                                        <CheckBox x:Name="AnimationNowPlayingCheckBox" Tag="NowPlaying" Content="Now Playing: фон и переходы"
                                                  Checked="AnimationAreaCheckBox_Changed" Unchecked="AnimationAreaCheckBox_Changed" />
                                        <CheckBox Tag="MiniPlayer" Content="Мини-плеер: бегущая строка"
                                                  Checked="AnimationAreaCheckBox_Changed" Unchecked="AnimationAreaCheckBox_Changed" />
                                        <CheckBox x:Name="AnimationIslandCheckBox" Tag="Island" Content="Остров"
                                                  Checked="AnimationAreaCheckBox_Changed" Unchecked="AnimationAreaCheckBox_Changed" />
                                        <CheckBox Tag="Tray" Content="Меню трея"
                                                  Checked="AnimationAreaCheckBox_Changed" Unchecked="AnimationAreaCheckBox_Changed" />
                                        <CheckBox Tag="Heart" Content="Анимация сердечка"
                                                  Checked="AnimationAreaCheckBox_Changed" Unchecked="AnimationAreaCheckBox_Changed" />
                                        <CheckBox Tag="Loading" Content="Индикаторы загрузки"
                                                  Checked="AnimationAreaCheckBox_Changed" Unchecked="AnimationAreaCheckBox_Changed" />
                                                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- См. AppSettings.WindowBackdropType. На Windows 10 карточка скрыта (WindowBackdropOptions.IsSelectionSupportedNow). -->
        <StackPanel x:Name="BackdropCard" Margin="0,0,0,24">
            <Border Style="{StaticResource SettingsGroupCardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Border Style="{StaticResource SettingsRowStyle}" BorderThickness="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="Основа окна">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsRowTitleStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled, ElementName=BackdropRadioCombo}" Value="False">
                                                    <Setter Property="Opacity" Value="0.45" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel x:Name="BackdropRadioGroup" Grid.Column="1" VerticalAlignment="Center">
                                <ComboBox x:Name="BackdropRadioCombo" Tag="RadioGroup" AutomationProperties.Name="Основа окна" MinWidth="220" HorizontalAlignment="Right">
                                    <ComboBoxItem Content="Mica (лёгкое размытие, по умолчанию)" Tag="BackdropMicaRadio" />
                                    <ComboBoxItem Content="Mica Alt (более плотная и контрастная основа, Windows 11 22H2+)" Tag="BackdropMicaAltRadio" />
                                    <ComboBoxItem Content="Acrylic (сильнее размытие и прозрачность)" Tag="BackdropAcrylicRadio" />
                                    <ComboBoxItem Content="Размытие" Tag="BackdropBlurRadio" />
                                </ComboBox>
                                <StackPanel Visibility="Collapsed">
                                    <RadioButton x:Name="BackdropMicaRadio" Content="Mica (лёгкое размытие, по умолчанию)"
                                    GroupName="Backdrop" Checked="WindowBackdropRadio_Changed" />
                                    <RadioButton x:Name="BackdropMicaAltRadio" Content="Mica Alt (более плотная и контрастная основа, Windows 11 22H2+)"
                                    GroupName="Backdrop" Checked="WindowBackdropRadio_Changed" />
                                    <RadioButton x:Name="BackdropAcrylicRadio" Content="Acrylic (сильнее размытие и прозрачность)"
                                    GroupName="Backdrop" Checked="WindowBackdropRadio_Changed" />
                                    <RadioButton x:Name="BackdropBlurRadio" Content="Размытие"
                                    GroupName="Backdrop" Checked="WindowBackdropRadio_Changed" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Padding="20,0,20,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingsHelperTextStyle}" Margin="0,0,0,6" Text="Основа применяется к главному окну, окну настроек и статистике." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SettingsGroupCardStyle}" Margin="0,0,0,0">
                <StackPanel>
                    <Border Style="{StaticResource SettingsRowStyle}" BorderThickness="0" Visibility="{Binding Visibility, ElementName=CoverBaseFromCoverCheckBox}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="Цвет основы от текущей обложки">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsRowTitleStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled, ElementName=CoverBaseFromCoverCheckBox}" Value="False">
                                                    <Setter Property="Opacity" Value="0.45" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Style="{StaticResource SettingsHelperTextStyle}" Margin="0,4,0,0" Text="Цвет основы от обложки можно включить независимо от акцентного цвета или совместить с любым акцентом." />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" x:Name="CoverBaseFromCoverCheckBox" AutomationProperties.Name="Цвет основы от текущей обложки"
                            Checked="CoverBaseFromCoverCheckBox_Changed"
                            Unchecked="CoverBaseFromCoverCheckBox_Changed" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>


    </StackPanel>
</UserControl>
