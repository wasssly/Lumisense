<!-- Полноэкранная иммерсивная поверхность под обложку: фон и белые полупрозрачные слои заданы литералами намеренно и не следуют
     светлой/тёмной теме и акценту (светлая тема сделала бы белый текст нечитаемым). Цвета облаков берутся из палитры обложки. -->
<Window x:Class="Lumisense.NowPlayingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:Lumisense"
        Title="Now Playing — Lumisense"
        Icon="{Binding Current, Source={x:Static local:AppIconContext.Instance}}"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Background="#FF101217"
        KeyDown="NowPlayingWindow_KeyDown"
        SizeChanged="NowPlayingWindow_SizeChanged"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- Размер и насыщенность шрифта у всех строк одинаковы: смена активной строки не перекомпоновывает список.
             Прозрачность, подложка, полоска и масштаб текста выставляются из NowPlayingWindow.ApplyLyricLineStates
             по настройкам выделения; здесь только заготовка с неактивным видом. -->
        <Style x:Key="LyricsLineStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <!-- Неактивная строка — белый с прозрачностью 0,65. Яркость строк меняется через альфа-канал цвета текста, а не через
                 Opacity элемента: при Opacity меньше 1 WPF рисует строку через промежуточную поверхность, и в момент, когда
                 прозрачность достигает 1, свечение активной строки внезапно менялось. -->
            <Setter Property="Foreground" Value="#A6FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root" CornerRadius="12" Background="{TemplateBinding Background}">
                            <Grid>
                                <Border x:Name="Bar" Width="3" CornerRadius="2" Margin="4,8" HorizontalAlignment="Left"
                                        Background="White" Opacity="0" />
                                <ContentPresenter x:Name="Content" Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  RenderTransformOrigin="0,0.5" SnapsToDevicePixels="True" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LyricsSearchResultStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root" CornerRadius="12" Background="#10FFFFFF" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              SnapsToDevicePixels="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#24FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#43FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Фон «Облака» (NowPlayingWindow.CloudFlow.cs): всё окно переливается цветами обложки. Поле считается в маленький битмап,
             который растягивается на окно с линейным сглаживанием: без сфер и без BlurEffect, который в WPF считается на CPU.
             Слой не ловит мышь и не влияет на клавиши, кнопки и выбор текста. -->
        <Image x:Name="CloudsBackdrop" IsHitTestVisible="False" Stretch="Fill" RenderOptions.BitmapScalingMode="Linear" />
        <!-- Фон «Цветные шары» (NowPlayingWindow.Dynamic.cs): овалы с мягким радиальным градиентом создаются в коде. -->
        <Canvas x:Name="OrbsBackdrop" IsHitTestVisible="False" ClipToBounds="True" Visibility="Collapsed" />

        <!-- Фон «Волны» (NowPlayingWindow.Dynamic.cs): волны рисуются в маленький битмап, который растягивается на всё окно;
             линейное сглаживание при увеличении даёт размытие и ничего не пересчитывает на каждом кадре (HighQuality дороже). -->
        <Image x:Name="WavesBackdrop" IsHitTestVisible="False" Stretch="Fill" Visibility="Collapsed"
               RenderOptions.BitmapScalingMode="Linear" />
        <Border Background="#70080A0F" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="34,24,34,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <!-- Режим «только название, обложка и текст»: прячет панель текста, полосу прогресса и кнопки на обложке. -->
                    <ui:Button x:Name="FocusModeButton" Width="30" Height="30" Padding="0" Margin="0,0,8,0" Opacity="0.42" Appearance="Secondary"
                               ToolTip="Скрыть панель управления и всё лишнее" Click="FocusModeButton_Click">
                        <ui:Button.Icon><local:SvgPathIcon Icon="IconWindow" Size="13" Foreground="#D0FFFFFF" /></ui:Button.Icon>
                    </ui:Button>
                    <ui:Button Width="30" Height="30" Padding="0" Opacity="0.42" Appearance="Secondary"
                               ToolTip="Закрыть полноэкранный режим (Esc)" Click="CloseButton_Click">
                        <ui:Button.Icon><local:SvgPathIcon Icon="IconDismiss" Size="13" Foreground="#D0FFFFFF" /></ui:Button.Icon>
                    </ui:Button>
                </StackPanel>
            </Grid>

            <Grid x:Name="NowPlayingLayoutGrid" Grid.Row="1" Margin="48,0,48,88" MaxWidth="1560" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ArtworkColumn" Width="560" />
                    <ColumnDefinition x:Name="ArtworkGapColumn" Width="52" />
                    <ColumnDefinition x:Name="LyricsColumn" Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <Grid x:Name="ArtworkTitleHost" HorizontalAlignment="Center">
                    <Border x:Name="ArtworkSurface" Width="540" Height="540" CornerRadius="22" Background="#28FFFFFF"
                            BorderBrush="#2FFFFFFF" BorderThickness="1" Padding="0" HorizontalAlignment="Center"
                            MouseEnter="ArtworkSurface_MouseEnter" MouseLeave="ArtworkSurface_MouseLeave">
                        <Grid>
                            <Border CornerRadius="22">
                                <Image x:Name="ArtworkImage" Stretch="UniformToFill" Visibility="Collapsed">
                                    <!-- Border не обрезает дочернее изображение по округлому контуру.
                                         Явная RectangleGeometry гарантирует реальные скруглённые углы. -->
                                    <Image.Clip>
                                        <RectangleGeometry Rect="0,0,538,538" RadiusX="22" RadiusY="22" />
                                    </Image.Clip>
                                </Image>
                            </Border>
                            <Border x:Name="ArtworkPlaceholder" Background="#25FFFFFF" CornerRadius="22">
                                <local:SvgPathIcon Icon="IconMusicNote" Size="88" Foreground="#C8FFFFFF"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <!-- Управление появляется только над обложкой, поэтому основной экран
                                 остаётся спокойным, пока пользователь просто читает текст. -->
                            <Border x:Name="ArtworkControlsOverlay" Background="#94000000" CornerRadius="22" Opacity="0">
                                <Grid>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                                    <ui:Button Width="50" Height="46" Padding="0" Appearance="Secondary" ToolTip="Предыдущий"
                                               Click="PreviousButton_Click">
                                        <ui:Button.Icon><local:SvgPathIcon Icon="IconPrevious" /></ui:Button.Icon>
                                    </ui:Button>
                                    <ui:Button x:Name="ArtworkPlayPauseButton" Width="68" Height="62" Padding="0" Margin="14,0"
                                               Appearance="Primary" ToolTip="Пуск / пауза" Click="PlayPauseButton_Click">
                                        <ui:Button.Icon><local:SvgPathIcon x:Name="ArtworkPlayPauseIcon" Icon="IconPlay" Size="20" /></ui:Button.Icon>
                                    </ui:Button>
                                    <ui:Button Width="50" Height="46" Padding="0" Appearance="Secondary" ToolTip="Следующий"
                                               Click="NextButton_Click">
                                        <ui:Button.Icon><local:SvgPathIcon Icon="IconNext" /></ui:Button.Icon>
                                    </ui:Button>
                                </StackPanel>
                                <ui:Button x:Name="ShowLyricsOnArtworkButton" Width="40" Height="40" Padding="0"
                                           HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0"
                                           Appearance="Secondary" ToolTip="Показать панель текста" Visibility="Collapsed"
                                           Click="ToggleLyricsButton_Click">
                                    <ui:Button.Icon><local:SvgPathIcon Icon="IconExpand" Size="16" /></ui:Button.Icon>
                                </ui:Button>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                        <!-- Название и исполнитель висят над обложкой: положение задаёт TranslateTransform (см. UpdateInfoPanelOffset),
                             поэтому высота названия не сдвигает обложку и не влияет на центровку относительно текста. -->
                        <StackPanel x:Name="NowPlayingInfoPanel" Width="540" VerticalAlignment="Top" IsHitTestVisible="False">
                            <StackPanel.RenderTransform>
                                <TranslateTransform />
                            </StackPanel.RenderTransform>
                            <TextBlock x:Name="NowPlayingTitleText" Text="Файл не выбран" FontSize="38" FontWeight="Bold"
                                       Foreground="White" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="102" />
                            <TextBlock x:Name="NowPlayingArtistText" Text="—" FontSize="18" Foreground="#C0FFFFFF"
                                       Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>

                    <Border x:Name="ArtworkProgressWrap" Padding="0,18,0,0" HorizontalAlignment="Center">
                    <Grid x:Name="ArtworkProgressGrid" Width="540" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PlaybackTimeText" Text="00:00" Foreground="#D9FFFFFF" FontSize="13" VerticalAlignment="Center" />
                        <!-- Хост ловит клик для всех видов полосы (AppSettings.ProgressBarStyle); Waveform здесь заменяется обычной полосой. -->
                        <Grid x:Name="ArtworkProgressHost" Grid.Column="1" Height="24" Margin="12,0" VerticalAlignment="Center"
                              Background="Transparent" Cursor="Hand"
                              ToolTip="Нажмите, чтобы перейти к выбранному месту трека"
                              PreviewMouseLeftButtonDown="ArtworkProgressBar_PreviewMouseLeftButtonDown">
                            <ProgressBar x:Name="ArtworkProgressBar" Height="8" Minimum="0" Maximum="1"
                                         Value="0" VerticalAlignment="Center" IsHitTestVisible="False" />
                            <local:MaterialProgressView x:Name="ArtworkProgressMaterial" Visibility="Collapsed" IsHitTestVisible="False"
                                                        TrackBrush="#40FFFFFF" />
                            <local:MaterialSliderVisual x:Name="ArtworkProgressMaterialSlider" Visibility="Collapsed" IsHitTestVisible="False"
                                                        InactiveBrush="#40FFFFFF" />
                        </Grid>
                        <TextBlock x:Name="PlaybackDurationText" Grid.Column="2" Text="00:00" Foreground="#D9FFFFFF" FontSize="13" VerticalAlignment="Center" />
                    </Grid>
                    </Border>
                </StackPanel>


                    <Border x:Name="LyricsPanel" Grid.Column="2" VerticalAlignment="Center" Width="900" Height="620" CornerRadius="22" Background="Transparent"
                            BorderBrush="Transparent" BorderThickness="1" Padding="24">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid x:Name="LyricsControlsPanel" Background="Transparent">
                                <Grid.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.35"
                                                                 BeginTime="0:0:2.5" Duration="0:0:0.8" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="Mouse.MouseEnter">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="Mouse.MouseLeave">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.35"
                                                                 BeginTime="0:0:1.5" Duration="0:0:0.8" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Grid.Triggers>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- Подпись и кнопки приглушены, чтобы внимание было на тексте: при наведении на строку
                                     возвращается полная непрозрачность, а через паузу после ухода курсора она снова гаснет. -->
                                <DockPanel VerticalAlignment="Center" HorizontalAlignment="Left" LastChildFill="True">
                                    <!-- Индикатор ожидания, пока ищется текст или другие варианты (SetLyricsStatusText). -->
                                    <local:MaterialLoadingIndicator x:Name="LyricsLoadingIndicator" DockPanel.Dock="Left"
                                                                    Width="24" Height="24" Margin="0,0,8,0" VerticalAlignment="Center"
                                                                    Visibility="Collapsed"
                                                                    ForegroundBrush="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <TextBlock x:Name="LyricsModeText" Text="Нет текста" FontSize="12" Foreground="#A8FFFFFF"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <ui:Button x:Name="LyricsDisplayModeButton" Height="30" MinWidth="30" Padding="8,0" Margin="0,0,6,0"
                                               Appearance="Secondary" FontSize="11" Visibility="Collapsed"
                                               Click="LyricsDisplayModeButton_Click" />
                                    <ui:Button x:Name="NextLyricsVariantButton" Width="30" Height="30" Padding="0" Margin="0,0,6,0" Appearance="Secondary"
                                               ToolTip="Другой вариант текста" Click="NextLyricsVariantButton_Click">
                                        <ui:Button.Icon><local:SvgPathIcon Icon="IconSync" Size="13" /></ui:Button.Icon>
                                    </ui:Button>
                                    <ui:Button x:Name="FindLyricsButton" Width="30" Height="30" Padding="0" Appearance="Secondary"
                                               ToolTip="Открыть встроенный поиск текста" Click="FindLyricsButton_Click">
                                        <ui:Button.Icon><local:SvgPathIcon Icon="IconSearch" Size="13" /></ui:Button.Icon>
                                    </ui:Button>
                                    <ui:Button x:Name="ImportLyricsButton" Width="30" Height="30" Padding="0" Margin="6,0,0,0" Appearance="Secondary"
                                               ToolTip="Загрузить .lrc или .txt" Click="ImportLyricsButton_Click">
                                        <ui:Button.Icon><local:SvgPathIcon Icon="IconAddFile" Size="13" /></ui:Button.Icon>
                                    </ui:Button>
                                    <ui:Button x:Name="ToggleLyricsButton" Width="30" Height="30" Padding="0" Margin="6,0,0,0"
                                               Appearance="Secondary" ToolTip="Скрыть панель текста" Click="ToggleLyricsButton_Click">
                                        <ui:Button.Icon><local:SvgPathIcon Icon="IconMinimizePlayer" Size="14" /></ui:Button.Icon>
                                    </ui:Button>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,16,0,0">
                                <ListBox x:Name="SyncedLyricsList" BorderThickness="0" Background="Transparent" FontSize="18"
                                         TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale"
                                         ItemContainerStyle="{StaticResource LyricsLineStyle}"
                                         SelectionChanged="SyncedLyricsList_SelectionChanged"
                                         PreviewMouseLeftButtonDown="SyncedLyricsList_PreviewMouseLeftButtonDown"
                                         PreviewMouseLeftButtonUp="SyncedLyricsList_PreviewMouseLeftButtonUp"
                                         ScrollViewer.CanContentScroll="False"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Hidden">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <ScrollViewer x:Name="PlainLyricsScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Hidden">
                                    <TextBlock x:Name="PlainLyricsText" TextWrapping="Wrap" FontSize="17" LineHeight="28" Foreground="#E6FFFFFF" />
                                </ScrollViewer>
                                <StackPanel x:Name="NoLyricsPanel" Width="330" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                    <local:SvgPathIcon Icon="IconMusicNote" Size="28" Foreground="#62FFFFFF" HorizontalAlignment="Center" />
                                    <TextBlock Text="Текст песни не найден" Foreground="#C8FFFFFF" FontSize="16" Margin="0,12,0,0"
                                               HorizontalAlignment="Stretch" TextAlignment="Center" />
                                    <TextBlock Text="Ищем текст автоматически. При необходимости можно загрузить файл .lrc / .txt."
                                               Foreground="#8CFFFFFF" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                                               HorizontalAlignment="Stretch" Margin="0,6,0,0" />
                                </StackPanel>

                                <!-- Отдельный слой результатов не меняет размеры карточки и позволяет
                                     вернуться к текущему тексту одной кнопкой. -->
                                <Border x:Name="OnlineLyricsSearchPanel" Background="#F5222733" BorderBrush="#42FFFFFF"
                                        BorderThickness="1" CornerRadius="16" Padding="14" Margin="0,8,0,0"
                                        Height="420" VerticalAlignment="Top" Visibility="Collapsed">
                                    <Grid ClipToBounds="True">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Результаты поиска" FontSize="16" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                                            <ui:Button Grid.Column="1" Width="30" Height="30" Padding="0" Appearance="Secondary"
                                                       ToolTip="Назад к тексту" Click="CloseOnlineLyricsSearchButton_Click">
                                                <ui:Button.Icon><local:SvgPathIcon Icon="IconDismiss" Size="13" /></ui:Button.Icon>
                                            </ui:Button>
                                        </Grid>
                                        <Grid Grid.Row="1" Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Height="44" Background="#2A303B" BorderBrush="#5FFFFFFF"
                                                    BorderThickness="1" CornerRadius="8" ClipToBounds="False">
                                                <TextBox x:Name="LyricsSearchQueryTextBox" BorderThickness="0" Background="Transparent"
                                                         Height="42" Padding="12,0" VerticalContentAlignment="Center"
                                                         TextAlignment="Left" FontSize="14" TextWrapping="NoWrap" AcceptsReturn="False"
                                                         Foreground="White" CaretBrush="White"
                                                         ToolTip="Исполнитель — название или название трека"
                                                         KeyDown="LyricsSearchQueryTextBox_KeyDown" />
                                            </Border>
                                            <Button x:Name="RunLyricsSearchButton" Grid.Column="1" Height="44" MinWidth="82"
                                                    VerticalAlignment="Center" Content="Искать" Margin="8,0,0,0"
                                                    Padding="14,0" FontSize="13" FontWeight="SemiBold"
                                                    VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                                    Background="#3D9BEA" BorderBrush="#70B8F4" BorderThickness="1" Foreground="White"
                                                    Click="RunLyricsSearchButton_Click" />
                                        </Grid>
                                        <TextBlock x:Name="OnlineLyricsSearchStatusText" Grid.Row="2" Foreground="#A8FFFFFF" FontSize="12"
                                                   TextWrapping="Wrap" Margin="0,8,0,4" MaxHeight="36" />
                                        <StackPanel Grid.Row="3" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Нет подходящего варианта?" FontSize="12" Foreground="#86FFFFFF" VerticalAlignment="Center" />
                                            <ui:Button Content="Genius" Appearance="Secondary" Padding="10,4" Margin="10,0,0,0"
                                                       ToolTip="Открыть поиск на Genius" Click="OpenGeniusSearchButton_Click" />
                                            <ui:Button Content="Вставить текст" Appearance="Secondary" Padding="10,4" Margin="6,0,0,0"
                                                       ToolTip="Сохранить текст песни из буфера обмена" Click="PasteLyricsFromClipboardButton_Click" />
                                        </StackPanel>
                                        <Border Grid.Row="4" Margin="0,8,0,0" Padding="0,0,8,0" Background="Transparent" ClipToBounds="True">
                                            <ListBox x:Name="OnlineLyricsResultsList" Padding="0,0,12,0" Background="Transparent" BorderThickness="0"

                                                 ItemContainerStyle="{StaticResource LyricsSearchResultStyle}"
                                                 MouseDoubleClick="OnlineLyricsResultsList_MouseDoubleClick"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding DisplayName}" Foreground="White" FontSize="14" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding AlbumName}" Foreground="#9EFFFFFF" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                                        <TextBlock Text="{Binding Duration, StringFormat={}{0:0} сек.}" Foreground="#78FFFFFF" FontSize="11" Margin="0,3,0,0" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
