<Window x:Class="Lumisense.NowPlayingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:Lumisense"
        Title="Now Playing — Lumisense"
        Icon="/Icons/app/lumisense.ico"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Background="#FF101217"
        KeyDown="NowPlayingWindow_KeyDown"
        SizeChanged="NowPlayingWindow_SizeChanged"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style x:Key="LyricsLineStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="#B8FFFFFF" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root" CornerRadius="12" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              SnapsToDevicePixels="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#3BFFFFFF" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="FontSize" Value="20" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LyricsSearchResultStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root" CornerRadius="12" Background="#10FFFFFF" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              SnapsToDevicePixels="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#24FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#43FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Декоративный слой: крупные размытые световые сферы быстро проходят через экран.
             Он не ловит мышь и поэтому не влияет на клавиши, кнопки или выбор текста. -->
        <Canvas IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse x:Name="AmbientBlobOne" RenderTransformOrigin="0.5,0.5" Width="540" Height="540" Fill="#D45278FF" Opacity="0.82" Canvas.Left="0" Canvas.Top="0">
                <Ellipse.Effect><BlurEffect Radius="140" /></Ellipse.Effect>
                <Ellipse.RenderTransform><TransformGroup><ScaleTransform x:Name="AmbientBlobOneScale" /><TranslateTransform x:Name="AmbientBlobOneTransform" /></TransformGroup></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="AmbientBlobTwo" RenderTransformOrigin="0.5,0.5" Width="540" Height="540" Fill="#C14CE0FF" Opacity="0.76" Canvas.Left="0" Canvas.Top="0">
                <Ellipse.Effect><BlurEffect Radius="140" /></Ellipse.Effect>
                <Ellipse.RenderTransform><TransformGroup><ScaleTransform x:Name="AmbientBlobTwoScale" /><TranslateTransform x:Name="AmbientBlobTwoTransform" /></TransformGroup></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="AmbientBlobThree" RenderTransformOrigin="0.5,0.5" Width="540" Height="540" Fill="#D8FF9F54" Opacity="0.68" Canvas.Left="0" Canvas.Top="0">
                <Ellipse.Effect><BlurEffect Radius="140" /></Ellipse.Effect>
                <Ellipse.RenderTransform><TransformGroup><ScaleTransform x:Name="AmbientBlobThreeScale" /><TranslateTransform x:Name="AmbientBlobThreeTransform" /></TransformGroup></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="AmbientBlobFour" RenderTransformOrigin="0.5,0.5" Width="540" Height="540" Fill="#C943E7D1" Opacity="0.64" Canvas.Left="0" Canvas.Top="0">
                <Ellipse.Effect><BlurEffect Radius="140" /></Ellipse.Effect>
                <Ellipse.RenderTransform><TransformGroup><ScaleTransform x:Name="AmbientBlobFourScale" /><TranslateTransform x:Name="AmbientBlobFourTransform" /></TransformGroup></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="AmbientBlobFive" RenderTransformOrigin="0.5,0.5" Width="540" Height="540" Fill="#B9FFFFFF" Opacity="0.54" Canvas.Left="0" Canvas.Top="0">
                <Ellipse.Effect><BlurEffect Radius="140" /></Ellipse.Effect>
                <Ellipse.RenderTransform><TransformGroup><ScaleTransform x:Name="AmbientBlobFiveScale" /><TranslateTransform x:Name="AmbientBlobFiveTransform" /></TransformGroup></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="AmbientBlobSix" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5" Width="300" Height="300" Fill="#A9FFFFFF" Opacity="0.50" Canvas.Left="0" Canvas.Top="0">
                <Ellipse.Effect><BlurEffect Radius="90" /></Ellipse.Effect>
                <Ellipse.RenderTransform><TransformGroup><ScaleTransform x:Name="AmbientBlobSixScale" /><TranslateTransform x:Name="AmbientBlobSixTransform" /></TransformGroup></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="AmbientBlobSeven" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5" Width="280" Height="280" Fill="#A9FFFFFF" Opacity="0.46" Canvas.Left="0" Canvas.Top="0">
                <Ellipse.Effect><BlurEffect Radius="84" /></Ellipse.Effect>
                <Ellipse.RenderTransform><TransformGroup><ScaleTransform x:Name="AmbientBlobSevenScale" /><TranslateTransform x:Name="AmbientBlobSevenTransform" /></TransformGroup></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="AmbientBlobEight" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5" Width="260" Height="260" Fill="#A9FFFFFF" Opacity="0.43" Canvas.Left="0" Canvas.Top="0">
                <Ellipse.Effect><BlurEffect Radius="78" /></Ellipse.Effect>
                <Ellipse.RenderTransform><TransformGroup><ScaleTransform x:Name="AmbientBlobEightScale" /><TranslateTransform x:Name="AmbientBlobEightTransform" /></TransformGroup></Ellipse.RenderTransform>
            </Ellipse>
        </Canvas>
        <Border Background="#70080A0F" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="34,24,34,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:Button Grid.Column="1" Width="30" Height="30" Padding="0" Opacity="0.42" Appearance="Secondary"
                           ToolTip="Закрыть полноэкранный режим (Esc)" Click="CloseButton_Click">
                    <ui:Button.Icon><local:SvgPathIcon Icon="IconDismiss" Size="13" Foreground="#D0FFFFFF" /></ui:Button.Icon>
                </ui:Button>
            </Grid>

            <Grid x:Name="NowPlayingLayoutGrid" Grid.Row="1" Margin="48,0,48,88" MaxWidth="1560" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="22" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ArtworkColumn" Width="560" />
                    <ColumnDefinition x:Name="ArtworkGapColumn" Width="52" />
                    <ColumnDefinition x:Name="LyricsColumn" Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Grid.Row="2" VerticalAlignment="Top">
                    <Border x:Name="ArtworkSurface" Width="540" Height="540" CornerRadius="22" Background="#28FFFFFF"
                            BorderBrush="#2FFFFFFF" BorderThickness="1" Padding="0" HorizontalAlignment="Center"
                            MouseEnter="ArtworkSurface_MouseEnter" MouseLeave="ArtworkSurface_MouseLeave">
                        <Grid>
                            <Border CornerRadius="22">
                                <Image x:Name="ArtworkImage" Stretch="UniformToFill" Visibility="Collapsed">
                                    <!-- Border не обрезает дочернее изображение по округлому контуру.
                                         Явная RectangleGeometry гарантирует реальные скруглённые углы. -->
                                    <Image.Clip>
                                        <RectangleGeometry Rect="0,0,538,538" RadiusX="22" RadiusY="22" />
                                    </Image.Clip>
                                </Image>
                            </Border>
                            <Border x:Name="ArtworkPlaceholder" Background="#25FFFFFF" CornerRadius="22">
                                <local:SvgPathIcon Icon="IconMusicNote" Size="88" Foreground="#C8FFFFFF"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <!-- Управление появляется только над обложкой, поэтому основной экран
                                 остаётся спокойным, пока пользователь просто читает текст. -->
                            <Border x:Name="ArtworkControlsOverlay" Background="#94000000" CornerRadius="22" Opacity="0">
                                <Grid>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                                    <ui:Button Width="50" Height="46" Padding="0" Appearance="Secondary" ToolTip="Предыдущий"
                                               Click="PreviousButton_Click">
                                        <ui:Button.Icon><local:SvgPathIcon Icon="IconPrevious" /></ui:Button.Icon>
                                    </ui:Button>
                                    <ui:Button x:Name="ArtworkPlayPauseButton" Width="68" Height="62" Padding="0" Margin="14,0"
                                               Appearance="Primary" ToolTip="Пуск / пауза" Click="PlayPauseButton_Click">
                                        <ui:Button.Icon><local:SvgPathIcon x:Name="ArtworkPlayPauseIcon" Icon="IconPlay" Size="20" /></ui:Button.Icon>
                                    </ui:Button>
                                    <ui:Button Width="50" Height="46" Padding="0" Appearance="Secondary" ToolTip="Следующий"
                                               Click="NextButton_Click">
                                        <ui:Button.Icon><local:SvgPathIcon Icon="IconNext" /></ui:Button.Icon>
                                    </ui:Button>
                                </StackPanel>
                                <ui:Button x:Name="ShowLyricsOnArtworkButton" Width="40" Height="40" Padding="0"
                                           HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0"
                                           Appearance="Secondary" ToolTip="Показать панель текста" Visibility="Collapsed"
                                           Click="ToggleLyricsButton_Click">
                                    <ui:Button.Icon><local:SvgPathIcon Icon="IconExpand" Size="16" /></ui:Button.Icon>
                                </ui:Button>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid x:Name="ArtworkProgressGrid" Width="540" Margin="0,18,0,0" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PlaybackTimeText" Text="00:00" Foreground="#D9FFFFFF" FontSize="13" VerticalAlignment="Center" />
                        <ProgressBar x:Name="ArtworkProgressBar" Grid.Column="1" Height="8" Margin="12,0" Minimum="0" Maximum="1"
                                     Value="0" VerticalAlignment="Center" Cursor="Hand"
                                     ToolTip="Нажмите, чтобы перейти к выбранному месту трека"
                                     PreviewMouseLeftButtonDown="ArtworkProgressBar_PreviewMouseLeftButtonDown" />
                        <TextBlock x:Name="PlaybackDurationText" Grid.Column="2" Text="00:00" Foreground="#D9FFFFFF" FontSize="13" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>

                <StackPanel x:Name="NowPlayingInfoPanel" Grid.Column="2" Grid.Row="0" Width="900" MinWidth="900" VerticalAlignment="Bottom">
                    <TextBlock x:Name="NowPlayingTitleText" Text="Файл не выбран" FontSize="38" FontWeight="Bold"
                               Foreground="White" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="102" />
                    <TextBlock x:Name="NowPlayingArtistText" Text="—" FontSize="18" Foreground="#C0FFFFFF"
                               Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                    <Border x:Name="LyricsPanel" Grid.Column="2" Grid.Row="2" Width="900" Height="620" CornerRadius="22" Background="#1EFFFFFF"
                            BorderBrush="#2BFFFFFF" BorderThickness="1" Padding="24">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <local:SvgPathIcon Icon="IconMusicNote" Size="16" Foreground="#B3FFFFFF" VerticalAlignment="Center" />
                                    <TextBlock x:Name="LyricsHeaderText" Text="Текст песни" FontSize="14" FontWeight="SemiBold"
                                               Foreground="#F2FFFFFF" Margin="9,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="LyricsModeText" Text="Нет текста" FontSize="12" Foreground="#A8FFFFFF"
                                               VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <ui:Button x:Name="FindLyricsButton" Width="30" Height="30" Padding="0" Appearance="Secondary"
                                               ToolTip="Открыть встроенный поиск текста" Click="FindLyricsButton_Click">
                                        <ui:Button.Icon><local:SvgPathIcon Icon="IconSearch" Size="13" /></ui:Button.Icon>
                                    </ui:Button>
                                    <ui:Button x:Name="ImportLyricsButton" Width="30" Height="30" Padding="0" Margin="6,0,0,0" Appearance="Secondary"
                                               ToolTip="Загрузить .lrc или .txt" Click="ImportLyricsButton_Click">
                                        <ui:Button.Icon><local:SvgPathIcon Icon="IconAddFile" Size="13" /></ui:Button.Icon>
                                    </ui:Button>
                                    <ui:Button x:Name="ToggleLyricsButton" Width="30" Height="30" Padding="0" Margin="6,0,0,0"
                                               Appearance="Secondary" ToolTip="Скрыть панель текста" Click="ToggleLyricsButton_Click">
                                        <ui:Button.Icon><local:SvgPathIcon Icon="IconMinimizePlayer" Size="14" /></ui:Button.Icon>
                                    </ui:Button>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,16,0,0">
                                <ListBox x:Name="SyncedLyricsList" BorderThickness="0" Background="Transparent" Padding="0,0,18,0"
                                         ItemContainerStyle="{StaticResource LyricsLineStyle}"
                                         SelectionChanged="SyncedLyricsList_SelectionChanged"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <ScrollViewer x:Name="PlainLyricsScroll" Padding="0,0,18,0" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                                    <TextBlock x:Name="PlainLyricsText" TextWrapping="Wrap" FontSize="17" LineHeight="28" Foreground="#E6FFFFFF"
                                               Padding="0,0,12,0" />
                                </ScrollViewer>
                                <StackPanel x:Name="NoLyricsPanel" Width="330" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                    <local:SvgPathIcon Icon="IconMusicNote" Size="28" Foreground="#62FFFFFF" HorizontalAlignment="Center" />
                                    <TextBlock Text="Текст песни не найден" Foreground="#C8FFFFFF" FontSize="16" Margin="0,12,0,0"
                                               HorizontalAlignment="Stretch" TextAlignment="Center" />
                                    <TextBlock Text="Ищем текст автоматически. При необходимости можно загрузить файл .lrc / .txt."
                                               Foreground="#8CFFFFFF" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                                               HorizontalAlignment="Stretch" Margin="0,6,0,0" />
                                </StackPanel>

                                <!-- Отдельный слой результатов не меняет размеры карточки и позволяет
                                     вернуться к текущему тексту одной кнопкой. -->
                                <Border x:Name="OnlineLyricsSearchPanel" Background="#F5222733" BorderBrush="#42FFFFFF"
                                        BorderThickness="1" CornerRadius="16" Padding="14" Margin="0,8,0,0"
                                        Height="420" VerticalAlignment="Top" Visibility="Collapsed">
                                    <Grid ClipToBounds="True">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Результаты поиска" FontSize="16" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                                            <ui:Button Grid.Column="1" Width="30" Height="30" Padding="0" Appearance="Secondary"
                                                       ToolTip="Назад к тексту" Click="CloseOnlineLyricsSearchButton_Click">
                                                <ui:Button.Icon><local:SvgPathIcon Icon="IconDismiss" Size="13" /></ui:Button.Icon>
                                            </ui:Button>
                                        </Grid>
                                        <Grid Grid.Row="1" Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Height="44" Background="#2A303B" BorderBrush="#5FFFFFFF"
                                                    BorderThickness="1" CornerRadius="8" ClipToBounds="False">
                                                <TextBox x:Name="LyricsSearchQueryTextBox" BorderThickness="0" Background="Transparent"
                                                         Height="42" Padding="12,0" VerticalContentAlignment="Center"
                                                         TextAlignment="Left" FontSize="14" TextWrapping="NoWrap" AcceptsReturn="False"
                                                         Foreground="White" CaretBrush="White"
                                                         ToolTip="Исполнитель — название или название трека"
                                                         KeyDown="LyricsSearchQueryTextBox_KeyDown" />
                                            </Border>
                                            <Button x:Name="RunLyricsSearchButton" Grid.Column="1" Height="44" MinWidth="82"
                                                    VerticalAlignment="Center" Content="Искать" Margin="8,0,0,0"
                                                    Padding="14,0" FontSize="13" FontWeight="SemiBold"
                                                    VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                                    Background="#3D9BEA" BorderBrush="#70B8F4" BorderThickness="1" Foreground="White"
                                                    Click="RunLyricsSearchButton_Click" />
                                        </Grid>
                                        <TextBlock x:Name="OnlineLyricsSearchStatusText" Grid.Row="2" Foreground="#A8FFFFFF" FontSize="12"
                                                   TextWrapping="Wrap" Margin="0,8,0,4" MaxHeight="36" />
                                        <StackPanel Grid.Row="3" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Нет подходящего варианта?" FontSize="12" Foreground="#86FFFFFF" VerticalAlignment="Center" />
                                            <ui:Button Content="Genius" Appearance="Secondary" Padding="10,4" Margin="10,0,0,0"
                                                       ToolTip="Открыть поиск на Genius" Click="OpenGeniusSearchButton_Click" />
                                            <ui:Button Content="Вставить текст" Appearance="Secondary" Padding="10,4" Margin="6,0,0,0"
                                                       ToolTip="Сохранить текст песни из буфера обмена" Click="PasteLyricsFromClipboardButton_Click" />
                                        </StackPanel>
                                        <Border Grid.Row="4" Margin="0,8,0,0" Padding="0,0,8,0" Background="Transparent" ClipToBounds="True">
                                            <ListBox x:Name="OnlineLyricsResultsList" Padding="0,0,12,0" Background="Transparent" BorderThickness="0"

                                                 ItemContainerStyle="{StaticResource LyricsSearchResultStyle}"
                                                 MouseDoubleClick="OnlineLyricsResultsList_MouseDoubleClick"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding DisplayName}" Foreground="White" FontSize="14" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding AlbumName}" Foreground="#9EFFFFFF" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                                        <TextBlock Text="{Binding Duration, StringFormat={}{0:0} сек.}" Foreground="#78FFFFFF" FontSize="11" Margin="0,3,0,0" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
