<UserControl x:Class="Lumisense.LibrarySettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:Lumisense">
    <StackPanel x:Name="PageLibrary">
        <TextBlock Text="Библиотека и файлы" Style="{StaticResource PageTitleStyle}" />
        <TextBlock Text="Кэш обложек, имена файлов и действия контекстного меню трека." Style="{StaticResource PageDescriptionStyle}" />

        <!-- Кэш обложек из CoverArtSearchWindow хранится локально в %AppData%\Lumisense\cover-cache. -->
        <StackPanel Margin="0,0,0,24">
            <TextBlock Text="Кэш интернет-обложек" Style="{StaticResource SettingsGroupTitleStyle}" />
            <Border Style="{StaticResource SettingsGroupCardStyle}" Margin="0,0,0,0">
                <StackPanel>
                    <Border Style="{StaticResource SettingsRowStyle}" BorderThickness="0">
                        <StackPanel>
                            <ui:Button x:Name="ClearArtworkCacheButton" Appearance="Secondary"
                            HorizontalAlignment="Left" Margin="0,0,0,0"
                            Click="ClearArtworkCacheButton_Click"
                            Content="Очистить кэш обложек" />
                            <TextBlock Style="{StaticResource SettingsHelperTextStyle}" Margin="0,4,0,0" x:Name="ArtworkCacheClearResultText" Visibility="Collapsed" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Padding="20,0,20,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingsHelperTextStyle}" Margin="0,0,0,6" Text="Повторно открытые варианты обложек берутся из локальной папки, чтобы не скачивать изображения заново." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Нормализация меняет только имена уже добавленных файлов после явного
             предпросмотра и подтверждения; см. FileNameNormalizer/MainWindow. -->
        <StackPanel Margin="0,0,0,24">
            <TextBlock Text="Нормализация имён файлов" Style="{StaticResource SettingsGroupTitleStyle}" />
            <Border Style="{StaticResource SettingsGroupCardStyle}" Margin="0,0,0,0">
                <StackPanel>
                    <Border Style="{StaticResource SettingsRowStyle}" BorderThickness="0">
                        <StackPanel>
                            <TextBlock Margin="0,0,0,8" Text="Шаблон" Style="{StaticResource SettingsFieldLabelStyle}" />
                            <ui:TextBox x:Name="FileNameNormalizationTemplateTextBox"
                                        PlaceholderText="Например: {Artist} - {Title}{Extension}"
                                        TextChanged="FileNameNormalizationTemplateTextBox_TextChanged">
                                <ui:TextBox.Icon>
                                    <local:SvgPathIcon Icon="IconEdit" />
                                </ui:TextBox.Icon>
                            </ui:TextBox>
                        </StackPanel>
                    </Border>
                    <Border Padding="20,0,20,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingsHelperTextStyle}" Margin="0,0,0,6" Text="Переименовывает файлы в исходных папках по тегам. Перед изменением Lumisense покажет примеры и пропустит занятые имена или текущий трек." TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource SettingsHelperTextStyle}" Margin="0,0,0,6" Text="Токены: {Artist}, {Title}, {Album}, {Track}, {Extension}. Расширение исходного файла сохраняется автоматически." TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SettingsRowAttachedStyle}">
                        <StackPanel>
                            <Button x:Name="NormalizePlaylistFileNamesButton" Content="Показать предпросмотр и нормализовать"
                            HorizontalAlignment="Left" Margin="0,0,0,0"
                            Click="NormalizePlaylistFileNamesButton_Click" />
                            <local:MaterialLoadingIndicator x:Name="FileNameNormalizationLoadingIndicator" Width="40" Height="40"
                            HorizontalAlignment="Left" Margin="0,10,0,0" Visibility="Collapsed"
                            ForegroundBrush="{DynamicResource AccentFillColorDefaultBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Padding="20,0,20,14" Visibility="{Binding Visibility, ElementName=FileNameNormalizationResultText}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingsHelperTextStyle}" Margin="0,0,0,6" x:Name="FileNameNormalizationResultText" Visibility="Collapsed" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Margin="0,0,0,24">
            <TextBlock Text="Действия контекстного меню трека" Style="{StaticResource SettingsGroupTitleStyle}" />
            <Border Style="{StaticResource SettingsGroupCardStyle}" Margin="0,0,0,0">
                <StackPanel>
                    <Border Style="{StaticResource SettingsRowStyle}" BorderThickness="0">
                        <ui:Button Tag="Track" Content="Порядок по умолчанию" Appearance="Secondary"
                        HorizontalAlignment="Left" Margin="0,0,0,0"
                        Click="ContextMenuOrderReset_Click" />
                    </Border>
                    <Border Style="{StaticResource SettingsRowStyle}" Visibility="{Binding Visibility, ElementName=TrackContextMenuActionsPanel}">
                        <UniformGrid x:Name="TrackContextMenuActionsPanel" Columns="1" Margin="0,0,0,0">
                            <Border Tag="PlayNext" Style="{StaticResource ReorderRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource ReorderGripStyle}" />
                                    <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="0" x:Name="TrackContextPlayNextCheckBox" Tag="PlayNext" Content="Играть следующим" Checked="TrackContextMenuActionCheckBox_Changed" Unchecked="TrackContextMenuActionCheckBox_Changed" />
                                </Grid>
                            </Border>
                            <Border Tag="AddToQueue" Style="{StaticResource ReorderRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource ReorderGripStyle}" />
                                    <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="0" x:Name="TrackContextAddToQueueCheckBox" Tag="AddToQueue" Content="Добавить в очередь" Checked="TrackContextMenuActionCheckBox_Changed" Unchecked="TrackContextMenuActionCheckBox_Changed" />
                                </Grid>
                            </Border>
                            <Border Tag="FindFile" Style="{StaticResource ReorderRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource ReorderGripStyle}" />
                                    <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="0" x:Name="TrackContextFindFileCheckBox" Tag="FindFile" Content="Найти файл" Checked="TrackContextMenuActionCheckBox_Changed" Unchecked="TrackContextMenuActionCheckBox_Changed" />
                                </Grid>
                            </Border>
                            <Border Tag="Favorite" Style="{StaticResource ReorderRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource ReorderGripStyle}" />
                                    <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="0" x:Name="TrackContextFavoriteCheckBox" Tag="Favorite" Content="Избранное" Checked="TrackContextMenuActionCheckBox_Changed" Unchecked="TrackContextMenuActionCheckBox_Changed" />
                                </Grid>
                            </Border>
                            <Border Tag="ShowInExplorer" Style="{StaticResource ReorderRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource ReorderGripStyle}" />
                                    <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="0" x:Name="TrackContextShowInExplorerCheckBox" Tag="ShowInExplorer" Content="Показать в проводнике" Checked="TrackContextMenuActionCheckBox_Changed" Unchecked="TrackContextMenuActionCheckBox_Changed" />
                                </Grid>
                            </Border>
                            <Border Tag="CopyTrackName" Style="{StaticResource ReorderRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource ReorderGripStyle}" />
                                    <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="0" x:Name="TrackContextCopyNameCheckBox" Tag="CopyTrackName" Content="Копировать имя трека" Checked="TrackContextMenuActionCheckBox_Changed" Unchecked="TrackContextMenuActionCheckBox_Changed" />
                                </Grid>
                            </Border>
                            <Border Tag="CopyPath" Style="{StaticResource ReorderRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource ReorderGripStyle}" />
                                    <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="0" x:Name="TrackContextCopyPathCheckBox" Tag="CopyPath" Content="Копировать путь к файлу" Checked="TrackContextMenuActionCheckBox_Changed" Unchecked="TrackContextMenuActionCheckBox_Changed" />
                                </Grid>
                            </Border>
                            <Border Tag="CopyFile" Style="{StaticResource ReorderRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource ReorderGripStyle}" />
                                    <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="0" x:Name="TrackContextCopyFileCheckBox" Tag="CopyFile" Content="Копировать файл" Checked="TrackContextMenuActionCheckBox_Changed" Unchecked="TrackContextMenuActionCheckBox_Changed" />
                                </Grid>
                            </Border>
                            <Border Tag="ExportProcessedCopy" Style="{StaticResource ReorderRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource ReorderGripStyle}" />
                                    <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="0" x:Name="TrackContextExportProcessedCopyCheckBox" Tag="ExportProcessedCopy" Content="Сохранить обработанную копию" Checked="TrackContextMenuActionCheckBox_Changed" Unchecked="TrackContextMenuActionCheckBox_Changed" />
                                </Grid>
                            </Border>
                            <Border Tag="Properties" Style="{StaticResource ReorderRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource ReorderGripStyle}" />
                                    <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="0" x:Name="TrackContextPropertiesCheckBox" Tag="Properties" Content="Свойства" Checked="TrackContextMenuActionCheckBox_Changed" Unchecked="TrackContextMenuActionCheckBox_Changed" />
                                </Grid>
                            </Border>
                            <Border Tag="EditTags" Style="{StaticResource ReorderRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource ReorderGripStyle}" />
                                    <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="0" x:Name="TrackContextEditTagsCheckBox" Tag="EditTags" Content="Изменить теги" Checked="TrackContextMenuActionCheckBox_Changed" Unchecked="TrackContextMenuActionCheckBox_Changed" />
                                </Grid>
                            </Border>
                            <Border Tag="NormalizeFileName" Style="{StaticResource ReorderRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource ReorderGripStyle}" />
                                    <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="0" x:Name="TrackContextNormalizeFileNameCheckBox" Tag="NormalizeFileName" Content="Нормализовать имя файла" Checked="TrackContextMenuActionCheckBox_Changed" Unchecked="TrackContextMenuActionCheckBox_Changed" />
                                </Grid>
                            </Border>
                            <Border Tag="RemoveFromPlaylist" Style="{StaticResource ReorderRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource ReorderGripStyle}" />
                                    <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="0" x:Name="TrackContextRemoveFromPlaylistCheckBox" Tag="RemoveFromPlaylist" Content="Убрать из плейлиста" Checked="TrackContextMenuActionCheckBox_Changed" Unchecked="TrackContextMenuActionCheckBox_Changed" />
                                </Grid>
                            </Border>
                            <Border Tag="DeleteFromDisk" Style="{StaticResource ReorderRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource ReorderGripStyle}" />
                                    <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="0" x:Name="TrackContextDeleteFromDiskCheckBox" Tag="DeleteFromDisk" Content="Удалить с диска" Checked="TrackContextMenuActionCheckBox_Changed" Unchecked="TrackContextMenuActionCheckBox_Changed" />
                                </Grid>
                            </Border>
                        </UniformGrid>
                    </Border>
                    <Border Padding="20,0,20,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingsHelperTextStyle}" Margin="0,0,0,6" Text="Снимите галочки, чтобы скрыть ненужные действия при нажатии правой кнопкой по треку в плейлисте. «Воспроизвести» остаётся доступным всегда." TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource SettingsHelperTextStyle}" Margin="0,0,0,6" Text="Чтобы изменить порядок, перетаскивайте пункты за значок ⋮⋮ слева." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>

    </StackPanel>
</UserControl>
