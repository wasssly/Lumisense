<Window x:Class="AudioPlayer.MiniPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:AudioPlayer"
        Title="Мини-плеер"
        Width="220" Height="96"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <!-- Мини-плеер теперь следует ТЕКУЩЕЙ теме приложения (светлая/тёмная), а не всегда
             тёмный, как было раньше. Текст, иконки и системные кнопки WPF-UI (ui:Button) внутри
             этого окна по умолчанию расшарены на DynamicResource-ресурсы ТЕКУЩЕЙ темы приложения
             — этого было бы достаточно самого по себе, НО фон окна (RootBorder) у нас не берётся
             из темы приложения, а всегда полупрозрачный (см. ApplyBackground) — поэтому светлый
             текст на светлом полупрозрачном фоне в светлой теме был бы плохо читаем без подгонки
             контраста под альфу фона.

             Переопределяем здесь, на уровне Window.Resources, те же самые ключи ресурсов, что
             использует и остальное приложение (TextFillColorPrimaryBrush и т.д.) — WPF ищет
             ресурс снизу вверх по дереву и найдёт ЭТИ значения раньше глобальных ресурсов темы
             приложения, поэтому автоматически подхватятся везде внутри окна: и в наших
             TextBlock/Border с DynamicResource, и во ВСТРОЕННЫХ шаблонах ui:Button — без
             необходимости лезть и переопределять их шаблоны вручную.

             Ресурсы намеренно получаются в code-behind через FindResource(...) по x:Key (см.
             ApplyTheme), а не через x:Name: WPF markup-компилятор не генерирует поле в
             code-behind для элемента внутри ResourceDictionary, если у него уже задан x:Key —
             x:Name в этом случае просто регистрируется в NameScope, но не создаёт поле класса,
             из-за чего сборка падает с CS0103 "имя не существует в текущем контексте". -->
        <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#C5FFFFFF" />
        <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#14FFFFFF" />
        <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#1AFFFFFF" />
        <SolidColorBrush x:Key="ControlStrongFillColorDefaultBrush" Color="#4DFFFFFF" />
        <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#26FFFFFF" />

        <!-- Индикатор громкости (см. VolumeIndicator ниже): плавно появляется и, спустя
             паузу, сам плавно исчезает. Запускается заново с нуля при каждом изменении
             громкости — см. ShowVolumeIndicator() в code-behind, которая останавливает
             предыдущий прогон анимации перед стартом нового, чтобы быстрые повторные
             нажатия хоткея не давали резких скачков прозрачности.

             Синхронно с ним (те же тайминги, тот же Storyboard) обложка+название+исполнитель
             (HeaderPanel) гаснут в ноль и появляются обратно — пока крутится громкость, в
             мини-плеере видно ТОЛЬКО процент громкости, а не обе надписи разом друг на друге. -->
        <Storyboard x:Key="VolumeIndicatorStoryboard">
            <DoubleAnimation Storyboard.TargetName="VolumeIndicator" Storyboard.TargetProperty="Opacity"
                              From="0" To="1" Duration="0:0:0.12" />
            <DoubleAnimation Storyboard.TargetName="VolumeIndicator" Storyboard.TargetProperty="Opacity"
                              From="1" To="0" BeginTime="0:0:0.9" Duration="0:0:0.35" />

            <DoubleAnimation Storyboard.TargetName="HeaderPanel" Storyboard.TargetProperty="Opacity"
                              From="1" To="0" Duration="0:0:0.12" />
            <DoubleAnimation Storyboard.TargetName="HeaderPanel" Storyboard.TargetProperty="Opacity"
                              From="0" To="1" BeginTime="0:0:0.9" Duration="0:0:0.35" />
        </Storyboard>
    </Window.Resources>

    <!-- Фон мини-плеера прошёл через несколько неудачных попыток, прежде чем осесть на нынешнем
         виде (см. git-историю, если интересны подробности): сначала Mica через ui:FluentWindow —
         не подошла именно этому маленькому окну без рамки (WindowStyle="None", 220×82/140):
         падала при входе в мини-режим, а после починки давала совсем не тот размер окна на
         экране. Затем — блюр через SetWindowCompositionAttribute (ACCENT_ENABLE_ACRYLICBLURBEHIND)
         — тоже отказались: это Win32-эффект композиции DWM, рассчитанный на обычные окна, а наше
         окно уже само по себе AllowsTransparency="True" (layered window, композитится через
         собственный, отдельный от DWM механизм альфа-смешивания WPF). Комбинация двух разных
         механизмов прозрачности на одном HWND ведёт себя непредсказуемо в зависимости от системы:
         на части машин итоговая видимая прозрачность переставала зависеть от нашего слайдера
         вообще (DWM просто держал свой собственный альфа-канал тонировки блюра поверх того, что
         выставляли мы), на части — эффект отключался тихо, если у пользователя в Параметрах
         Windows выключены эффекты прозрачности, и никакой ошибки за этим не следовало.

         Теперь фон — это ЕДИНСТВЕННЫЙ и полностью надёжный слой: RootBorder заливается сплошным
         цветом темы (см. ApplyTheme) с альфа-каналом из настройки "прозрачность мини-плеера" (см.
         ApplyBackground в code-behind). Поскольку окно уже AllowsTransparency="True", WPF сам,
         без всякого Win32-API, честно смешивает этот полупрозрачный цвет с тем, что реально
         находится на экране позади окна — рабочий стол или окна под мини-плеером становятся
         видны сквозь него тем отчётливее, чем ниже прозрачность в настройках. Это не блюр
         (то, что видно позади, не размывается), зато работает одинаково на любой системе и
         честно откликается на каждое движение слайдера — что и было целью. -->
    <Grid>
    <Border x:Name="RootBorder" CornerRadius="14"
            MouseEnter="RootBorder_MouseEnter" MouseLeave="RootBorder_MouseLeave"
            MouseWheel="RootBorder_MouseWheel"
            MouseLeftButtonDown="RootBorder_MouseLeftButtonDown">
        <Border.Background>
            <!-- Цвет и альфа-канал полностью выставляются в code-behind: базовый цвет — из
                 ApplyTheme (тёмный графит либо светло-серый, под тему приложения), альфа —
                 из ApplyBackground (настройка "прозрачность мини-плеера"). Значение ниже —
                 просто дефолт на первый кадр. -->
            <SolidColorBrush x:Name="MiniBackgroundBrush" Color="#F51C1C1E" />
        </Border.Background>
        <!-- ПКМ по любому месту мини-плеера: закрепление, «поверх окон», вторая кнопка,
             скорость, тон и прозрачность — быстрый доступ к связанным настройкам. Перед каждым
             показом MiniPlayerContextMenu_Opened подставляет актуальные значения, поэтому
             галочки, иконки и ползунки не расходятся с реальным состоянием приложения. -->
        <Border.ContextMenu>
            <ContextMenu x:Name="MiniPlayerContextMenu" Opened="MiniPlayerContextMenu_Opened">
                <ContextMenu.Resources>
                    <!-- Локальный шаблон применяется исключительно к двум переключаемым пунктам.
                         Используется тот же штатный WPF-UI CheckBox, что и на странице настроек:
                         размер и геометрия индикатора полностью совпадают. IsChecked принадлежит
                         самому MenuItem, а CheckBox служит только некликабельным отображением. -->
                    <Style x:Key="MiniPlayerToggleMenuItemStyle" TargetType="{x:Type MenuItem}">
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Padding" Value="8,5" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type MenuItem}">
                                    <Border x:Name="ItemBackground" Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <!-- WPF-UI 4 CheckBox имеет более широкую visual geometry,
                                                     чем прежняя 3.x; 32 DIP предотвращает обрезание glyph
                                                     у левой границы popup. -->
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox x:Name="ToggleCheckBox" Grid.Column="0"
                                                      Style="{DynamicResource MiniPlayerSettingsCheckBoxStyle}"
                                                      IsHitTestVisible="False" Focusable="False"
                                                      VerticalAlignment="Center" HorizontalAlignment="Center"
                                                      RenderTransformOrigin="0.5,0.5"
                                                      IsChecked="{TemplateBinding IsChecked}">
                                                <CheckBox.RenderTransform>
                                                    <ScaleTransform ScaleX="1" ScaleY="1" />
                                                </CheckBox.RenderTransform>
                                            </CheckBox>
                                            <!-- Чуть компактнее, чем у полного CheckBox в настройках:
                                                 подпись остаётся визуально связанной с галочкой в меню. -->
                                            <ContentPresenter Grid.Column="1" ContentSource="Header"
                                                              Margin="5,0,0,0"
                                                              VerticalAlignment="Center"
                                                              RecognizesAccessKey="True" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBackground" Property="Background"
                                                    Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                        </Trigger>
                                        <!-- Accent-resources заполняются в ApplyContextMenuAccent: popup
                                             использует выбранный в Lumisense цвет, а не системный Windows accent. -->
                                        <Trigger Property="IsChecked" Value="True">
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="ToggleCheckBox"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         From="0" To="1" Duration="0:0:0.16" />
                                                        <DoubleAnimation Storyboard.TargetName="ToggleCheckBox"
                                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                         From="0.72" To="1" Duration="0:0:0.20" />
                                                        <DoubleAnimation Storyboard.TargetName="ToggleCheckBox"
                                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                         From="0.72" To="1" Duration="0:0:0.20" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.45" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <!-- Popup должен быть компактным, но indicator обязан совпадать с
                         CheckBox в Settings. Поэтому воспроизводим штатную 20-DIP геометрию
                         и палитру WPF-UI 4, не наследуя его 120-DIP minimum для пункта с text. -->
                    <Style x:Key="MiniPlayerSettingsCheckBoxStyle" TargetType="{x:Type CheckBox}">
                        <Setter Property="Width" Value="20" />
                        <Setter Property="Height" Value="20" />
                        <Setter Property="MinWidth" Value="20" />
                        <Setter Property="MinHeight" Value="20" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Background" Value="{DynamicResource CheckBoxBackground}" />
                        <Setter Property="Foreground" Value="{DynamicResource CheckBoxForeground}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxBorderBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="Border.CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
                        <Setter Property="OverridesDefaultStyle" Value="True" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type CheckBox}">
                                    <Border x:Name="ControlBorderIconPresenter" Width="20" Height="20"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="{TemplateBinding Border.CornerRadius}">
                                        <Border x:Name="StrokeBorder"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="{TemplateBinding Border.CornerRadius}">
                                            <ui:SymbolIcon x:Name="ControlIcon"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontSize="13" FontWeight="Bold"
                                                           Foreground="{DynamicResource CheckBoxCheckGlyphForeground}"
                                                           Symbol="Checkmark48" Visibility="Collapsed" />
                                        </Border>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="ControlIcon" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="ControlBorderIconPresenter" Property="Background"
                                                    Value="{DynamicResource CheckBoxCheckBackgroundFillChecked}" />
                                            <Setter TargetName="StrokeBorder" Property="BorderBrush"
                                                    Value="{DynamicResource CheckBoxCheckBorderBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="ControlBorderIconPresenter" Property="Opacity" Value="0.45" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ContextMenu.Resources>
                <MenuItem Header="Настройки" Click="SettingsMenuItem_Click" />
                <MenuItem Header="Now Playing (полный экран)" Click="NowPlayingMenuItem_Click" />
                <Separator />
                <MenuItem x:Name="PinnedMenuItem" Header="Закрепить" IsCheckable="True"
                          Style="{StaticResource MiniPlayerToggleMenuItemStyle}"
                          Click="PinnedMenuItem_Click" />
                <MenuItem x:Name="TopmostMenuItem" Header="Поверх окон" IsCheckable="True"
                          Style="{StaticResource MiniPlayerToggleMenuItemStyle}"
                          Click="TopmostMenuItem_Click" />
                <Separator />
                <!-- Выбор единственной второй кнопки управления. Три компактные иконки сохраняют
                     главное меню коротким, а Tooltip раскрывает назначение без постоянного текста. -->
                <MenuItem StaysOpenOnClick="True" Focusable="False">
                    <MenuItem.Header>
                        <Grid Width="220">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Вторая кнопка" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <ui:Button x:Name="MiniSecondaryRepeatContextButton" Tag="Repeat" Appearance="Secondary"
                                           Width="28" Height="28" Padding="0" Margin="2,0" ToolTip="Повтор"
                                           Click="MiniSecondaryContextButton_Click">
                                    <ui:Button.Icon><local:SvgPathIcon Icon="IconRepeatAll" Size="12" /></ui:Button.Icon>
                                </ui:Button>
                                <ui:Button x:Name="MiniSecondaryShuffleContextButton" Tag="Shuffle" Appearance="Secondary"
                                           Width="28" Height="28" Padding="0" Margin="2,0" ToolTip="Перемешать"
                                           Click="MiniSecondaryContextButton_Click">
                                    <ui:Button.Icon><local:SvgPathIcon Icon="IconShuffle" Size="12" /></ui:Button.Icon>
                                </ui:Button>
                                <ui:Button x:Name="MiniSecondaryFavoriteContextButton" Tag="Favorite" Appearance="Secondary"
                                           Width="28" Height="28" Padding="0" Margin="2,0" ToolTip="Избранное"
                                           Click="MiniSecondaryContextButton_Click">
                                    <ui:Button.Icon><local:SvgPathIcon Icon="IconHeart" Size="12" /></ui:Button.Icon>
                                </ui:Button>
                            </StackPanel>
                        </Grid>
                    </MenuItem.Header>
                </MenuItem>
                <Separator />
                <!-- Скорость и тон используют такие же прозрачные overlay-области, как
                     прозрачность ниже: Slider живёт в Popup ContextMenu, поэтому явный захват
                     мыши надёжнее нативного Thumb. Двойной клик возвращает 1.00× и 0 st. -->
                <MenuItem StaysOpenOnClick="True" Focusable="False">
                    <MenuItem.Header>
                        <Grid Width="240">
                            <Grid.ColumnDefinitions>
                                <!-- Запас по ширине предотвращает обрезание подписи «Скорость». -->
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Скорость" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Slider x:Name="MiniPlaybackRateContextSlider" Grid.Column="1" IsHitTestVisible="False"
                                    Minimum="0.5" Maximum="2.0" Value="1.0" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center" ValueChanged="MiniPlaybackRateContextSlider_ValueChanged" />
                            <Border Grid.Column="1" Background="Transparent" Height="24" VerticalAlignment="Center"
                                    MouseLeftButtonDown="MiniPlaybackRateContextOverlay_MouseLeftButtonDown"
                                    MouseMove="MiniPlaybackRateContextOverlay_MouseMove"
                                    MouseLeftButtonUp="MiniPlaybackRateContextOverlay_MouseLeftButtonUp"
                                    MouseWheel="MiniPlaybackRateContextOverlay_MouseWheel" />
                            <TextBlock x:Name="MiniPlaybackRateContextValueText" Grid.Column="2" Text="1.00×"
                                       Width="38" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </Grid>
                    </MenuItem.Header>
                </MenuItem>
                <MenuItem StaysOpenOnClick="True" Focusable="False">
                    <MenuItem.Header>
                        <Grid Width="240">
                            <Grid.ColumnDefinitions>
                                <!-- Та же ширина, что и у строки скорости. -->
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Тон" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Slider x:Name="MiniPlaybackPitchContextSlider" Grid.Column="1" IsHitTestVisible="False"
                                    Minimum="-12" Maximum="12" Value="0" TickFrequency="1" IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center" ValueChanged="MiniPlaybackPitchContextSlider_ValueChanged" />
                            <Border Grid.Column="1" Background="Transparent" Height="24" VerticalAlignment="Center"
                                    MouseLeftButtonDown="MiniPlaybackPitchContextOverlay_MouseLeftButtonDown"
                                    MouseMove="MiniPlaybackPitchContextOverlay_MouseMove"
                                    MouseLeftButtonUp="MiniPlaybackPitchContextOverlay_MouseLeftButtonUp"
                                    MouseWheel="MiniPlaybackPitchContextOverlay_MouseWheel" />
                            <TextBlock x:Name="MiniPlaybackPitchContextValueText" Grid.Column="2" Text="0 st"
                                       Width="38" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </Grid>
                    </MenuItem.Header>
                </MenuItem>
                <Separator />
                <!-- Та же настройка, что и ползунок "Прозрачность мини-плеера" в окне настроек
                     (см. MainWindow.SetMiniPlayerOpacity) — синхронизирована в обе стороны:
                     здесь подставляется актуальное значение при каждом открытии меню, а
                     перетаскивание сразу же обновляет и сам мини-плеер, и слайдер в окне
                     настроек, если оно сейчас открыто (см. SettingsWindow.RefreshMiniPlayerToggles).

                     Перетаскивание сделано ТЕМ ЖЕ приёмом, что и у MiniOpacitySlider в
                     SettingsWindow.xaml, а не нативным Thumb'ом слайдера: сам Slider —
                     IsHitTestVisible="False", поверх него отдельный прозрачный Border ловит
                     мышь и сам вычисляет значение по X-координате клика (см.
                     MiniOpacityContextOverlay_* в code-behind). Нативное перетаскивание Thumb'а
                     здесь не подошло бы — Slider живёт внутри ContextMenu (это отдельный Popup),
                     где перехват и последующее удержание мыши самим Thumb'ом при разворачивании
                     из MenuItem ведёт себя нестабильно; overlay-Border, захватывающий мышь сам
                     явным CaptureMouse(), от этого не зависит и работает предсказуемо в любом
                     контейнере, включая всплывающее меню.

                     StaysOpenOnClick="True" — иначе меню закрылось бы от самого первого клика
                     по слайдеру, не дав его толком перетащить. Focusable="False" — чтобы пункт
                     не вёл себя как обычный кликабельный пункт меню с рамкой выделения: у него
                     нет осмысленного "клика" самого по себе, только перетаскивание слайдера
                     внутри. Диапазон 0.3–1.0 — тот же, что и у слайдера в окне настроек;
                     Value="1.0" — совпадает с Minimum по умолчанию не может, поэтому WPF никогда
                     не подтягивает значение принудительно при разборе XAML (см. подробный
                     комментарий у MiniOpacityContextSlider_ValueChanged в code-behind — там же
                     объяснено, почему это в принципе важно). -->
                <MenuItem StaysOpenOnClick="True" Focusable="False">
                    <MenuItem.Header>
                        <Grid Width="220">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Прозрачность" VerticalAlignment="Center" Margin="0,0,10,0" />

                            <Slider x:Name="MiniOpacityContextSlider" Grid.Column="1" IsHitTestVisible="False"
                                    Minimum="0.3" Maximum="1.0" Value="1.0" VerticalAlignment="Center"
                                    ValueChanged="MiniOpacityContextSlider_ValueChanged" />
                            <Border Grid.Column="1" Background="Transparent" Height="24" VerticalAlignment="Center"
                                    MouseLeftButtonDown="MiniOpacityContextOverlay_MouseLeftButtonDown"
                                    MouseMove="MiniOpacityContextOverlay_MouseMove"
                                    MouseLeftButtonUp="MiniOpacityContextOverlay_MouseLeftButtonUp" />

                            <TextBlock x:Name="MiniOpacityContextValueText" Grid.Column="2" Text="100%"
                                       Width="34" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </Grid>
                    </MenuItem.Header>
                </MenuItem>
            </ContextMenu>
        </Border.ContextMenu>
        <Grid>
            <Grid x:Name="ContentGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Обложка + название/исполнитель. Здесь же перетаскиваем окно (своего заголовка нет). -->
            <StackPanel x:Name="HeaderPanel" Grid.Row="0" Orientation="Horizontal" Margin="14,10,14,2"
                        Background="Transparent"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <!-- Индикатор прогресса не влияет на размер или перетаскивание заголовка:
                     это только визуальный слой поверх обложки. Его скруглённый контур
                     повторяет обложку 42×42 с CornerRadius=8. -->
                <Grid Width="42" Height="42" ClipToBounds="True"
                      SnapsToDevicePixels="True" UseLayoutRounding="True">
                    <Border x:Name="ArtBorder" Width="42" Height="42" CornerRadius="8"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                        <!-- В режиме Vinyl вращается только этот слой обложки. Контур прогресса
                             остаётся неподвижным и продолжает точно показывать позицию трека. -->
                        <Border.RenderTransform>
                            <RotateTransform x:Name="ArtRotateTransform" CenterX="21" CenterY="21" />
                        </Border.RenderTransform>
                        <Grid ClipToBounds="True">
                            <Image x:Name="ArtImage" Stretch="UniformToFill" Visibility="Collapsed"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   RenderOptions.EdgeMode="Unspecified"
                                   SnapsToDevicePixels="True" UseLayoutRounding="True" />
                            <local:SvgPathIcon x:Name="ArtIcon" Icon="IconMusicNote" Size="15"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </Border>
                    <Border x:Name="ArtProgressTrack" Width="42" Height="42" CornerRadius="8"
                            BorderThickness="1" BorderBrush="{DynamicResource ControlStrongFillColorDefaultBrush}"
                            Visibility="Collapsed" IsHitTestVisible="False" />
                    <Path x:Name="ArtProgressOutline" StrokeThickness="1.5"
                          Stroke="{DynamicResource AccentFillColorDefaultBrush}"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          SnapsToDevicePixels="True" UseLayoutRounding="True"
                          Visibility="Collapsed" IsHitTestVisible="False" />
                </Grid>

                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <!-- Ширина 140 подобрана под фактически доступное место: 220 (окно) минус
                         14+14 (отступы StackPanel-заголовка) минус 42 (обложка) минус 10 (отступ
                         перед текстом) = 140. Окно мини-плеера имеет фиксированный размер
                         (ResizeMode="NoResize"), поэтому число не "поедет" при изменении окна.

                         TextBlock лежит внутри Canvas, а не прямо внутри Border: если бы он был
                         прямым ребёнком Border с фиксированной шириной 140, WPF сам, ещё ДО
                         применения RenderTransform, обрезал бы его отрисовку до этих 140px —
                         это автоматическое поведение layout-системы (обрезка элемента по
                         выделенному ему месту у родителя, когда его DesiredSize больше), отдельное
                         от ClipToBounds на самом Border. В результате прокручивать оказывалось
                         попросту нечего: часть названия за пределами 140px никогда не рисовалась,
                         и бегущая строка visually показывала только начало, сколько бы TitleTranslate
                         её ни сдвигал. Canvas же не обрезает детей по своим границам (даёт им
                         столько места, сколько они просят), поэтому TextBlock рисуется на полную
                         естественную ширину — а нужную видимую "рамку" по-прежнему обеспечивает
                         ClipToBounds самого Border снаружи. -->
                    <Border x:Name="TitleClipBorder" Width="140" ClipToBounds="True" HorizontalAlignment="Left">
                        <Canvas Height="18">
                            <TextBlock x:Name="TitleText" Text="Файл не выбран"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       TextWrapping="NoWrap" TextTrimming="None">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform x:Name="TitleTranslate" X="0" />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Canvas>
                    </Border>
                    <TextBlock x:Name="ArtistText" Text="—" FontSize="11"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <!-- Прогресс (простая полоса + прозрачный слой для перемотки кликом/перетаскиванием).
                 См. AppSettings.MiniPlayerShowProgress/ApplyProgressBarVisibility — скрывается
                 целиком через Visibility, высота строки (Auto) при этом схлопывается сама, окно
                 дополнительно уменьшается на ProgressRowHeight в самом ApplyProgressBarVisibility,
                 чтобы не оставалось пустого места на месте спрятанной полосы. -->
            <Grid x:Name="ProgressRow" Grid.Row="1" Margin="14,4,14,0" Height="20">
                <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                        Background="{DynamicResource ControlStrongFillColorDefaultBrush}" />
                <Border x:Name="ProgressFill" Height="4" CornerRadius="2" Width="0"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        Background="{DynamicResource AccentFillColorDefaultBrush}" />
                <Border Background="Transparent"
                        MouseLeftButtonDown="Progress_MouseLeftButtonDown"
                        MouseMove="Progress_MouseMove"
                        MouseLeftButtonUp="Progress_MouseLeftButtonUp" />
            </Grid>

            <!-- Кнопки — показываются только при наведении курсора на окно. Margin здесь —
                 дефолт для режима "снизу" (Below), тот же, что и был всегда (8+10=18 суммарно).
                 Для overlay-режима ApplyButtonsLayoutMode в code-behind подменяет его на другой,
                 сдвинутый чуть ниже (но с той же суммой отступов 18, чтобы общая высота строки
                 не поехала — см. подробности там же). -->
            <StackPanel x:Name="ControlsPanel" Grid.Row="2" Orientation="Horizontal"
                        HorizontalAlignment="Center" Margin="0,8,0,10" Visibility="Collapsed">
                <ui:Button x:Name="SecondaryButton" Appearance="Secondary"
                           Width="26" Height="26" Padding="0" Margin="3,0"
                           Click="SecondaryButton_Click">
                    <ui:Button.Icon>
                        <local:SvgPathIcon Icon="IconRepeatAll" Size="12" />
                    </ui:Button.Icon>
                </ui:Button>
                <ui:Button x:Name="PrevButton" Appearance="Secondary"
                           Width="30" Height="30" Padding="0" Margin="3,0"
                           Click="PrevButton_Click">
                    <ui:Button.Icon>
                        <local:SvgPathIcon Icon="IconPrevious" />
                    </ui:Button.Icon>
                </ui:Button>
                <!-- Appearance="Secondary" — фон красится вручную в коде под текущий акцент
                     (см. RefreshAccentButtons), а не через ControlAppearance.Primary: у него
                     подтверждённый баг WPF-UI, фон не обновляется вживую при смене акцента. -->
                <ui:Button x:Name="PlayPauseButton" Appearance="Secondary"
                           Width="36" Height="36" Padding="0" Margin="3,0"
                           Click="PlayPauseButton_Click">
                    <ui:Button.Icon>
                        <local:SvgPathIcon Icon="IconPlay" />
                    </ui:Button.Icon>
                </ui:Button>
                <ui:Button x:Name="NextButton" Appearance="Secondary"
                           Width="30" Height="30" Padding="0" Margin="3,0"
                           Click="NextButton_Click">
                    <ui:Button.Icon>
                        <local:SvgPathIcon Icon="IconNext" />
                    </ui:Button.Icon>
                </ui:Button>
                <ui:Button x:Name="RestoreButton" Appearance="Secondary"
                           Width="28" Height="28" Padding="0" Margin="3,0"
                           Click="RestoreButton_Click">
                    <ui:Button.Icon>
                        <local:SvgPathIcon Icon="IconExpand" />
                    </ui:Button.Icon>
                </ui:Button>
            </StackPanel>
        </Grid>

        <!-- Отдельный overlay-слой: индикатор не участвует в измерении auto-строк ContentGrid,
             поэтому VerticalAlignment="Center" рассчитывается относительно всей видимой площади
             мини-плеера, включая высоту панели управления. IsHitTestVisible=False сохраняет
             прокрутку и перетаскивание окна. В Overlay-режиме ControlsPanel скрывается на время
             показа индикатора из code-behind, поэтому слои не перекрываются. -->
        <Border x:Name="VolumeIndicator" Panel.ZIndex="10"
                CornerRadius="10" Padding="12,6"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Opacity="0" IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal">
                <local:SvgPathIcon x:Name="VolumeIndicatorIcon" Icon="IconSpeaker" Size="14"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock x:Name="VolumeIndicatorText" Text="30%" FontSize="14" FontWeight="SemiBold"
                           Margin="7,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </StackPanel>
            </Border>
        </Grid>
    </Border>
</Grid>
</Window>
