<Window x:Class="Lumisense.MiniPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:Lumisense"
        Title="Мини-плеер"
        Width="200" Height="88"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <!-- Ресурсы темы (TextFillColorPrimaryBrush и т.д.) переопределены здесь: фон окна всегда полупрозрачный, и WPF найдёт их раньше глобальных,
             в т.ч. во встроенных шаблонах ui:Button. В code-behind — через FindResource по x:Key: x:Name у элемента с x:Key поля не создаёт (CS0103). -->
        <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#C5FFFFFF" />
        <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#14FFFFFF" />
        <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#1AFFFFFF" />
        <SolidColorBrush x:Key="ControlStrongFillColorDefaultBrush" Color="#4DFFFFFF" />
        <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#26FFFFFF" />

        <!-- Поле ручного ввода процента прозрачности (MiniOpacityContextValueEditor): ui:TextBox не годится — его рамка/иконка/крестик
             не помещаются в ячейке 44px и перекрывают число, поэтому минимальный шаблон обычного TextBox. -->
        <Style x:Key="MiniOpacityInlineEditorStyle" TargetType="TextBox">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Root" CornerRadius="4"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          Focusable="False"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush"
                                        Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Индикатор громкости (VolumeIndicator): плавно появляется и исчезает, перезапускаясь при каждом изменении (ShowVolumeIndicator
             останавливает прошлый прогон); тем же Storyboard HeaderPanel гаснет, чтобы надписи не накладывались на процент. -->
        <Storyboard x:Key="VolumeIndicatorStoryboard">
            <DoubleAnimation Storyboard.TargetName="VolumeIndicator" Storyboard.TargetProperty="Opacity"
                              From="0" To="1" Duration="0:0:0.12" />
            <DoubleAnimation Storyboard.TargetName="VolumeIndicator" Storyboard.TargetProperty="Opacity"
                              From="1" To="0" BeginTime="0:0:0.9" Duration="0:0:0.35" />

            <DoubleAnimation Storyboard.TargetName="HeaderPanel" Storyboard.TargetProperty="Opacity"
                              From="1" To="0" Duration="0:0:0.12" />
            <DoubleAnimation Storyboard.TargetName="HeaderPanel" Storyboard.TargetProperty="Opacity"
                              From="0" To="1" BeginTime="0:0:0.9" Duration="0:0:0.35" />
        </Storyboard>
    </Window.Resources>

    <!-- Фон — один слой: RootBorder заливается цветом темы (ApplyTheme) с альфой из настройки (ApplyBackground); окно уже AllowsTransparency="True",
         и WPF сам смешивает его с содержимым за окном. Mica и Win32-блюр (ACCENT_ENABLE_ACRYLICBLURBEHIND) отвергнуты: конфликтуют с layered window. -->
    <Grid>
    <Border x:Name="RootBorder" CornerRadius="14"
            MouseEnter="RootBorder_MouseEnter" MouseLeave="RootBorder_MouseLeave"
            MouseWheel="RootBorder_MouseWheel"
            MouseLeftButtonDown="RootBorder_MouseLeftButtonDown">
        <Border.Background>
            <!-- Цвет и альфа выставляются в code-behind (ApplyTheme — тема, ApplyBackground — прозрачность); значение здесь — дефолт на первый кадр. -->
            <SolidColorBrush x:Name="MiniBackgroundBrush" Color="#F51C1C1E" />
        </Border.Background>
        <!-- ПКМ по мини-плееру: быстрый доступ к закреплению, «поверх окон», второй кнопке, скорости, тону и прозрачности;
             MiniPlayerContextMenu_Opened подставляет актуальные значения перед показом. -->
        <Border.ContextMenu>
            <ContextMenu x:Name="MiniPlayerContextMenu" Opened="MiniPlayerContextMenu_Opened"
                         Closed="MiniPlayerContextMenu_Closed">
                <ContextMenu.Resources>
                    <local:MiniPlayerContextMenuActionVisibilityConverter x:Key="MiniPlayerContextMenuActionVisibilityConverter" />
                    <local:MiniPlayerContextMenuGroupVisibilityConverter x:Key="MiniPlayerContextMenuGroupVisibilityConverter" />
                    <!-- Локальный шаблон только для двух переключаемых пунктов, с тем же размером и геометрией индикатора, что на странице настроек;
                         IsChecked принадлежит MenuItem, а CheckBox — только некликабельное отображение. -->
                    <Style x:Key="MiniPlayerToggleMenuItemStyle" TargetType="{x:Type MenuItem}">
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Padding" Value="8,5" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type MenuItem}">
                                    <Border x:Name="ItemBackground" Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <!-- У CheckBox в WPF-UI 4 более широкая геометрия, чем в 3.x: 32 DIP не даёт обрезать glyph у левой границы popup. -->
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox x:Name="ToggleCheckBox" Grid.Column="0"
                                                      Style="{DynamicResource MiniPlayerSettingsCheckBoxStyle}"
                                                      IsHitTestVisible="False" Focusable="False"
                                                      VerticalAlignment="Center" HorizontalAlignment="Center"
                                                      RenderTransformOrigin="0.5,0.5"
                                                      IsChecked="{TemplateBinding IsChecked}">
                                                <CheckBox.RenderTransform>
                                                    <ScaleTransform ScaleX="1" ScaleY="1" />
                                                </CheckBox.RenderTransform>
                                            </CheckBox>
                                            <!-- Чуть компактнее, чем у полного CheckBox в настройках:
                                                 подпись остаётся визуально связанной с галочкой в меню. -->
                                            <ContentPresenter Grid.Column="1" ContentSource="Header"
                                                              Margin="5,0,0,0"
                                                              VerticalAlignment="Center"
                                                              RecognizesAccessKey="True" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBackground" Property="Background"
                                                    Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                        </Trigger>
                                        <!-- Accent-resources заполняются в ApplyContextMenuAccent: popup
                                             использует выбранный в Lumisense цвет, а не системный Windows accent. -->
                                        <Trigger Property="IsChecked" Value="True">
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="ToggleCheckBox"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         From="0" To="1" Duration="0:0:0.16" />
                                                        <DoubleAnimation Storyboard.TargetName="ToggleCheckBox"
                                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                         From="0.72" To="1" Duration="0:0:0.20" />
                                                        <DoubleAnimation Storyboard.TargetName="ToggleCheckBox"
                                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                         From="0.72" To="1" Duration="0:0:0.20" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.45" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <!-- Popup компактный, но индикатор должен совпадать с CheckBox в Settings: воспроизводим 20-DIP геометрию и палитру WPF-UI 4,
                         не наследуя его 120-DIP minimum для пункта с текстом. -->
                    <Style x:Key="MiniPlayerSettingsCheckBoxStyle" TargetType="{x:Type CheckBox}">
                        <Setter Property="Width" Value="20" />
                        <Setter Property="Height" Value="20" />
                        <Setter Property="MinWidth" Value="20" />
                        <Setter Property="MinHeight" Value="20" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Background" Value="{DynamicResource CheckBoxBackground}" />
                        <Setter Property="Foreground" Value="{DynamicResource CheckBoxForeground}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxBorderBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="Border.CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
                        <Setter Property="OverridesDefaultStyle" Value="True" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type CheckBox}">
                                    <Border x:Name="ControlBorderIconPresenter" Width="20" Height="20"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="{TemplateBinding Border.CornerRadius}">
                                        <Border x:Name="StrokeBorder"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="{TemplateBinding Border.CornerRadius}">
                                            <Path x:Name="ControlIcon"
                                                  Width="10" Height="10"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Stretch="None"
                                                  Stroke="{DynamicResource CheckBoxCheckGlyphForeground}"
                                                  StrokeThickness="2"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  Data="M 1,5 L 4,8 L 9,2"
                                                  Opacity="0"
                                                  RenderTransformOrigin="0.5,0.5" />
                                        </Border>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="ControlIcon" Property="Opacity" Value="1" />
                                            <Setter TargetName="ControlBorderIconPresenter" Property="Background"
                                                    Value="{DynamicResource CheckBoxCheckBackgroundFillChecked}" />
                                            <Setter TargetName="StrokeBorder" Property="BorderBrush"
                                                    Value="{DynamicResource CheckBoxCheckBorderBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="ControlBorderIconPresenter" Property="Opacity" Value="0.45" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ContextMenu.Resources>
                <MenuItem Header="Настройки" Click="SettingsMenuItem_Click"
                          Visibility="{Binding Source={x:Static local:MiniPlayerContextMenuActions.Instance}, Path=Epoch, Converter={StaticResource MiniPlayerContextMenuActionVisibilityConverter}, ConverterParameter=Settings}" />
                <MenuItem Header="Now Playing (полный экран)" Click="NowPlayingMenuItem_Click"
                          Visibility="{Binding Source={x:Static local:MiniPlayerContextMenuActions.Instance}, Path=Epoch, Converter={StaticResource MiniPlayerContextMenuActionVisibilityConverter}, ConverterParameter=NowPlaying}" />
                <Separator Visibility="{Binding Source={x:Static local:MiniPlayerContextMenuActions.Instance}, Path=Epoch, Converter={StaticResource MiniPlayerContextMenuGroupVisibilityConverter}, ConverterParameter='Pin|Topmost|OverlayCompatibility'}" />
                <MenuItem x:Name="PinnedMenuItem" Header="Закрепить" IsCheckable="True"
                          Style="{StaticResource MiniPlayerToggleMenuItemStyle}"
                          Click="PinnedMenuItem_Click"
                          Visibility="{Binding Source={x:Static local:MiniPlayerContextMenuActions.Instance}, Path=Epoch, Converter={StaticResource MiniPlayerContextMenuActionVisibilityConverter}, ConverterParameter=Pin}" />
                <MenuItem x:Name="TopmostMenuItem" Header="Поверх окон" IsCheckable="True"
                          Style="{StaticResource MiniPlayerToggleMenuItemStyle}"
                          Click="TopmostMenuItem_Click"
                          Visibility="{Binding Source={x:Static local:MiniPlayerContextMenuActions.Instance}, Path=Epoch, Converter={StaticResource MiniPlayerContextMenuActionVisibilityConverter}, ConverterParameter=Topmost}" />
                <MenuItem x:Name="OverlayCompatibilityMenuItem"
                          Header="Совместимость с играми и оверлеем"
                          IsCheckable="True"
                          Style="{StaticResource MiniPlayerToggleMenuItemStyle}"
                          ToolTip="Упрощает рендеринг плавающих окон для снижения риска сбоев Steam Overlay"
                          Click="OverlayCompatibilityMenuItem_Click"
                          Visibility="{Binding Source={x:Static local:MiniPlayerContextMenuActions.Instance}, Path=Epoch, Converter={StaticResource MiniPlayerContextMenuActionVisibilityConverter}, ConverterParameter=OverlayCompatibility}" />
                <Separator Visibility="{Binding Source={x:Static local:MiniPlayerContextMenuActions.Instance}, Path=Epoch, Converter={StaticResource MiniPlayerContextMenuGroupVisibilityConverter}, ConverterParameter=SecondaryButton}" />
                <!-- Выбор единственной второй кнопки управления. Три компактные иконки сохраняют
                     главное меню коротким, а Tooltip раскрывает назначение без постоянного текста. -->
                <MenuItem StaysOpenOnClick="True" Focusable="False"
                          Visibility="{Binding Source={x:Static local:MiniPlayerContextMenuActions.Instance}, Path=Epoch, Converter={StaticResource MiniPlayerContextMenuActionVisibilityConverter}, ConverterParameter=SecondaryButton}">
                    <MenuItem.Header>
                        <Grid Width="220">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Вторая кнопка" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <ui:Button x:Name="MiniSecondaryRepeatContextButton" Tag="Repeat" Appearance="Secondary"
                                           Width="28" Height="28" Padding="0" Margin="2,0" ToolTip="Повтор"
                                           Click="MiniSecondaryContextButton_Click">
                                    <ui:Button.Icon><local:SvgPathIcon Icon="IconRepeatAll" Size="12" /></ui:Button.Icon>
                                </ui:Button>
                                <ui:Button x:Name="MiniSecondaryShuffleContextButton" Tag="Shuffle" Appearance="Secondary"
                                           Width="28" Height="28" Padding="0" Margin="2,0" ToolTip="Перемешать"
                                           Click="MiniSecondaryContextButton_Click">
                                    <ui:Button.Icon><local:SvgPathIcon Icon="IconShuffle" Size="12" /></ui:Button.Icon>
                                </ui:Button>
                                <ui:Button x:Name="MiniSecondaryFavoriteContextButton" Tag="Favorite" Appearance="Secondary"
                                           Width="28" Height="28" Padding="0" Margin="2,0" ToolTip="Избранное"
                                           Click="MiniSecondaryContextButton_Click">
                                    <ui:Button.Icon><local:SvgPathIcon Icon="IconHeart" Size="12" /></ui:Button.Icon>
                                </ui:Button>
                            </StackPanel>
                        </Grid>
                    </MenuItem.Header>
                </MenuItem>
                <Separator Visibility="{Binding Source={x:Static local:MiniPlayerContextMenuActions.Instance}, Path=Epoch, Converter={StaticResource MiniPlayerContextMenuGroupVisibilityConverter}, ConverterParameter='PlaybackRate|Pitch'}" />
                <!-- Скорость и тон — такие же прозрачные overlay-области, как прозрачность ниже (Slider в Popup ContextMenu: явный захват мыши
                     надёжнее нативного Thumb); двойной клик возвращает 1.00× и 0 st. -->
                <MenuItem StaysOpenOnClick="True" Focusable="False"
                          Visibility="{Binding Source={x:Static local:MiniPlayerContextMenuActions.Instance}, Path=Epoch, Converter={StaticResource MiniPlayerContextMenuActionVisibilityConverter}, ConverterParameter=PlaybackRate}">
                    <MenuItem.Header>
                        <Grid Width="240">
                            <Grid.ColumnDefinitions>
                                <!-- Запас по ширине предотвращает обрезание подписи «Скорость». -->
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Скорость" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Slider x:Name="MiniPlaybackRateContextSlider" Grid.Column="1" IsHitTestVisible="False"
                                    Minimum="0.5" Maximum="2.0" Value="1.0" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center" ValueChanged="MiniPlaybackRateContextSlider_ValueChanged" />
                            <Border Grid.Column="1" Background="Transparent" Height="24" VerticalAlignment="Center"
                                    MouseLeftButtonDown="MiniPlaybackRateContextOverlay_MouseLeftButtonDown"
                                    MouseMove="MiniPlaybackRateContextOverlay_MouseMove"
                                    MouseLeftButtonUp="MiniPlaybackRateContextOverlay_MouseLeftButtonUp"
                                    MouseWheel="MiniPlaybackRateContextOverlay_MouseWheel" />
                            <TextBlock x:Name="MiniPlaybackRateContextValueText" Grid.Column="2" Text="1.00×"
                                       Width="38" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </Grid>
                    </MenuItem.Header>
                </MenuItem>
                <MenuItem StaysOpenOnClick="True" Focusable="False"
                          Visibility="{Binding Source={x:Static local:MiniPlayerContextMenuActions.Instance}, Path=Epoch, Converter={StaticResource MiniPlayerContextMenuActionVisibilityConverter}, ConverterParameter=Pitch}">
                    <MenuItem.Header>
                        <Grid Width="240">
                            <Grid.ColumnDefinitions>
                                <!-- Та же ширина, что и у строки скорости. -->
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Тон" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Slider x:Name="MiniPlaybackPitchContextSlider" Grid.Column="1" IsHitTestVisible="False"
                                    Minimum="-12" Maximum="12" Value="0" TickFrequency="1" IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center" ValueChanged="MiniPlaybackPitchContextSlider_ValueChanged" />
                            <Border Grid.Column="1" Background="Transparent" Height="24" VerticalAlignment="Center"
                                    MouseLeftButtonDown="MiniPlaybackPitchContextOverlay_MouseLeftButtonDown"
                                    MouseMove="MiniPlaybackPitchContextOverlay_MouseMove"
                                    MouseLeftButtonUp="MiniPlaybackPitchContextOverlay_MouseLeftButtonUp"
                                    MouseWheel="MiniPlaybackPitchContextOverlay_MouseWheel" />
                            <TextBlock x:Name="MiniPlaybackPitchContextValueText" Grid.Column="2" Text="0 st"
                                       Width="38" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </Grid>
                    </MenuItem.Header>
                </MenuItem>
                <Separator Visibility="{Binding Source={x:Static local:MiniPlayerContextMenuActions.Instance}, Path=Epoch, Converter={StaticResource MiniPlayerContextMenuGroupVisibilityConverter}, ConverterParameter=Opacity}" />
                <!-- Та же настройка, что в окне настроек (MainWindow.SetMiniPlayerOpacity), синхронизируется в обе стороны; перетаскивание — overlay-Border
                     с CaptureMouse (Thumb в Popup нестабилен). StaysOpenOnClick — иначе меню закроется от первого клика; Focusable="False" — у пункта нет своего клика. -->
                <MenuItem StaysOpenOnClick="True" Focusable="False"
                          Visibility="{Binding Source={x:Static local:MiniPlayerContextMenuActions.Instance}, Path=Epoch, Converter={StaticResource MiniPlayerContextMenuActionVisibilityConverter}, ConverterParameter=Opacity}">
                    <MenuItem.Header>
                        <Grid Width="220">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Прозрачность" VerticalAlignment="Center" Margin="0,0,10,0" />

                            <Slider x:Name="MiniOpacityContextSlider" Grid.Column="1" IsHitTestVisible="False"
                                    Minimum="0.3" Maximum="1.0" Value="1.0" VerticalAlignment="Center"
                                    ValueChanged="MiniOpacityContextSlider_ValueChanged" />
                            <Border Grid.Column="1" Background="Transparent" Height="24" VerticalAlignment="Center"
                                    MouseLeftButtonDown="MiniOpacityContextOverlay_MouseLeftButtonDown"
                                    MouseMove="MiniOpacityContextOverlay_MouseMove"
                                    MouseLeftButtonUp="MiniOpacityContextOverlay_MouseLeftButtonUp"
                                    MouseWheel="MiniOpacityContextOverlay_MouseWheel" />

                            <!-- Клик по числу переключает его на TextBox для ввода точного значения (BeginOpacityValueEdit). -->
                            <Grid Grid.Column="2" Width="44" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="MiniOpacityContextValueText" Text="100%"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Background="Transparent" Cursor="IBeam"
                                           MouseLeftButtonDown="MiniOpacityContextValueText_MouseLeftButtonDown"
                                           ToolTip="Нажмите, чтобы ввести значение с клавиатуры" />
                                <TextBox x:Name="MiniOpacityContextValueEditor"
                                         Style="{StaticResource MiniOpacityInlineEditorStyle}"
                                         Visibility="Collapsed"
                                         PreviewKeyDown="MiniOpacityContextValueEditor_PreviewKeyDown"
                                         LostKeyboardFocus="MiniOpacityContextValueEditor_LostKeyboardFocus" />
                            </Grid>
                        </Grid>
                    </MenuItem.Header>
                </MenuItem>
                <Separator Visibility="{Binding Source={x:Static local:MiniPlayerContextMenuActions.Instance}, Path=Epoch, Converter={StaticResource MiniPlayerContextMenuGroupVisibilityConverter}, ConverterParameter='SnapToEdges|ShowProgress|ShowArtworkProgress|ArtworkStyle|ButtonsLayout'}" />
                <MenuItem x:Name="MiniContextSnapToEdgesMenuItem" Header="Прилипание к краям экрана" IsCheckable="True"
                          Style="{StaticResource MiniPlayerToggleMenuItemStyle}"
                          Click="SnapToEdgesMenuItem_Click"
                          Visibility="{Binding Source={x:Static local:MiniPlayerContextMenuActions.Instance}, Path=Epoch, Converter={StaticResource MiniPlayerContextMenuActionVisibilityConverter}, ConverterParameter=SnapToEdges}" />
                <MenuItem x:Name="MiniContextShowProgressMenuItem" Header="Показывать полосу прогресса" IsCheckable="True"
                          Style="{StaticResource MiniPlayerToggleMenuItemStyle}"
                          Click="ShowProgressMenuItem_Click"
                          Visibility="{Binding Source={x:Static local:MiniPlayerContextMenuActions.Instance}, Path=Epoch, Converter={StaticResource MiniPlayerContextMenuActionVisibilityConverter}, ConverterParameter=ShowProgress}" />
                <MenuItem x:Name="MiniContextShowArtworkProgressMenuItem" Header="Прогресс вокруг обложки" IsCheckable="True"
                          Style="{StaticResource MiniPlayerToggleMenuItemStyle}"
                          Click="ShowArtworkProgressMenuItem_Click"
                          Visibility="{Binding Source={x:Static local:MiniPlayerContextMenuActions.Instance}, Path=Epoch, Converter={StaticResource MiniPlayerContextMenuActionVisibilityConverter}, ConverterParameter=ShowArtworkProgress}" />
                <!-- 3 и 2 варианта соответственно — компактнее вложенного подменю: клик переключает
                     на следующее значение по кругу, текущее видно прямо в Header. -->
                <MenuItem x:Name="MiniContextArtworkStyleMenuItem" Click="ArtworkStyleMenuItem_Click"
                          Visibility="{Binding Source={x:Static local:MiniPlayerContextMenuActions.Instance}, Path=Epoch, Converter={StaticResource MiniPlayerContextMenuActionVisibilityConverter}, ConverterParameter=ArtworkStyle}" />
                <MenuItem x:Name="MiniContextButtonsLayoutMenuItem" Click="ButtonsLayoutMenuItem_Click"
                          Visibility="{Binding Source={x:Static local:MiniPlayerContextMenuActions.Instance}, Path=Epoch, Converter={StaticResource MiniPlayerContextMenuActionVisibilityConverter}, ConverterParameter=ButtonsLayout}" />
            </ContextMenu>
        </Border.ContextMenu>
        <Grid>
            <Grid x:Name="ContentGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Обложка + название/исполнитель. Здесь же перетаскиваем окно (своего заголовка нет). -->
            <StackPanel x:Name="HeaderPanel" Grid.Row="0" Orientation="Horizontal" Margin="10,8,10,2"
                        Background="Transparent"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <!-- Контур прогресса идёт по границе обложки: половина толщины внутри 42×42, половина снаружи; ArtworkCanvas не обрезает внешнюю часть. -->
                <Grid x:Name="ArtworkCanvas" Width="50" Height="50" ClipToBounds="False"
                      SnapsToDevicePixels="True" UseLayoutRounding="True">
                    <Border x:Name="ArtBorder" Width="42" Height="42" CornerRadius="8"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                        <!-- В режиме Vinyl вращается только этот слой обложки. Контур прогресса
                             остаётся неподвижным и рисуется отдельным верхним слоем. -->
                        <Border.RenderTransform>
                            <RotateTransform x:Name="ArtRotateTransform" CenterX="21" CenterY="21" />
                        </Border.RenderTransform>
                        <Grid ClipToBounds="True">
                            <Image x:Name="ArtImage" Stretch="UniformToFill" Visibility="Collapsed"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   RenderOptions.EdgeMode="Unspecified"
                                   SnapsToDevicePixels="True" UseLayoutRounding="True" />
                            <local:SvgPathIcon x:Name="ArtIcon" Icon="IconMusicNote" Size="15"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </Border>
                    <Border x:Name="ArtProgressTrack" Width="42" Height="42" CornerRadius="8"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            BorderThickness="1" BorderBrush="Transparent"
                            Visibility="Collapsed" IsHitTestVisible="False" />
                    <Path x:Name="ArtProgressOutline" Width="50" Height="50"
                          Stretch="None"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          StrokeThickness="1.5"
                          Stroke="{DynamicResource AccentFillColorDefaultBrush}"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          SnapsToDevicePixels="False" UseLayoutRounding="False"
                          Visibility="Collapsed" IsHitTestVisible="False" />
                </Grid>

                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <!-- Ширина 120 = 200 (окно) − 20 (отступы) − 50 (ArtworkCanvas) − 10 (отступ до текста); размер окна фиксирован (NoResize).
                         TextBlock в Canvas, а не в Border: иначе layout обрезал бы его до 120px до RenderTransform, и бегущей строке нечего прокручивать. -->
                    <Border x:Name="TitleClipBorder" Width="120" ClipToBounds="True" HorizontalAlignment="Left">
                        <Canvas Height="18">
                            <TextBlock x:Name="TitleText" Text="Файл не выбран"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       TextWrapping="NoWrap" TextTrimming="None">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform x:Name="TitleTranslate" X="0" />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Canvas>
                    </Border>
                    <TextBlock x:Name="ArtistText" Text="—" FontSize="11"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <!-- Прогресс: полоса + прозрачный слой для перемотки; скрывается через Visibility (строка Auto схлопывается), а окно
                 уменьшается на ProgressRowHeight в ApplyProgressBarVisibility (AppSettings.MiniPlayerShowProgress). -->
            <Grid x:Name="ProgressRow" Grid.Row="1" Margin="10,4,10,0" Height="20">
                <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                        Background="{DynamicResource ControlStrongFillColorDefaultBrush}" />
                <Border x:Name="ProgressFill" Height="4" CornerRadius="2" Width="0"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        Background="{DynamicResource AccentFillColorDefaultBrush}" />
                <Border Background="Transparent"
                        MouseLeftButtonDown="Progress_MouseLeftButtonDown"
                        MouseMove="Progress_MouseMove"
                        MouseLeftButtonUp="Progress_MouseLeftButtonUp" />
            </Grid>

            <!-- Кнопки видны только при наведении. Margin — дефолт режима "Below" (8+10=18); ApplyButtonsLayoutMode подменяет его для Overlay
                 со смещением вниз, но с той же суммой 18, чтобы высота строки не поехала. -->
            <StackPanel x:Name="ControlsPanel" Grid.Row="2" Orientation="Horizontal"
                        HorizontalAlignment="Center" Margin="0,8,0,10" Visibility="Collapsed">
                <ui:Button x:Name="SecondaryButton" Appearance="Secondary"
                           Width="26" Height="26" Padding="0" Margin="3,0"
                           Click="SecondaryButton_Click">
                    <ui:Button.Icon>
                        <local:SvgPathIcon Icon="IconRepeatAll" Size="12" />
                    </ui:Button.Icon>
                </ui:Button>
                <ui:Button x:Name="PrevButton" Appearance="Secondary"
                           Width="30" Height="30" Padding="0" Margin="3,0"
                           Click="PrevButton_Click">
                    <ui:Button.Icon>
                        <local:SvgPathIcon Icon="IconPrevious" />
                    </ui:Button.Icon>
                </ui:Button>
                <!-- Appearance="Secondary": фон красится вручную под акцент (RefreshAccentButtons), а не через ControlAppearance.Primary —
                     баг WPF-UI: фон не обновляется вживую при смене акцента. -->
                <ui:Button x:Name="PlayPauseButton" Appearance="Secondary"
                           Width="36" Height="36" Padding="0" Margin="3,0"
                           Click="PlayPauseButton_Click">
                    <ui:Button.Icon>
                        <local:SvgPathIcon Icon="IconPlay" />
                    </ui:Button.Icon>
                </ui:Button>
                <ui:Button x:Name="NextButton" Appearance="Secondary"
                           Width="30" Height="30" Padding="0" Margin="3,0"
                           Click="NextButton_Click">
                    <ui:Button.Icon>
                        <local:SvgPathIcon Icon="IconNext" />
                    </ui:Button.Icon>
                </ui:Button>
                <ui:Button x:Name="RestoreButton" Appearance="Secondary"
                           Width="28" Height="28" Padding="0" Margin="3,0"
                           Click="RestoreButton_Click">
                    <ui:Button.Icon>
                        <local:SvgPathIcon Icon="IconExpand" />
                    </ui:Button.Icon>
                </ui:Button>
            </StackPanel>
        </Grid>

        <!-- Отдельный overlay-слой: индикатор не участвует в измерении auto-строк ContentGrid, поэтому Center считается от всей площади
             мини-плеера; IsHitTestVisible=False сохраняет прокрутку и перетаскивание; в Overlay-режиме ControlsPanel скрывается на время показа. -->
        <Border x:Name="VolumeIndicator" Panel.ZIndex="10"
                CornerRadius="10" Padding="12,6"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Opacity="0" IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal">
                <local:SvgPathIcon x:Name="VolumeIndicatorIcon" Icon="IconSpeaker" Size="14"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock x:Name="VolumeIndicatorText" Text="30%" FontSize="14" FontWeight="SemiBold"
                           Margin="7,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </StackPanel>
            </Border>
        </Grid>
    </Border>
</Grid>
</Window>
