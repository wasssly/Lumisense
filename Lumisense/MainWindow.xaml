<ui:FluentWindow x:Class="Lumisense.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:Lumisense"
        Title="Lumisense"
        Icon="{Binding Current, Source={x:Static local:AppIconContext.Instance}}"
        Height="720" Width="440"
        MinHeight="680" MinWidth="400"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        DragEnter="MainWindow_DragEnter"
        DragOver="MainWindow_DragEnter"
        DragLeave="MainWindow_DragLeave"
        Drop="MainWindow_Drop"
        PreviewKeyDown="MainWindow_PreviewKeyDown">

    <Window.Resources>
        <local:FileNameConverter x:Key="FileNameConverter" />
        <local:BoolToOpacityConverter x:Key="BoolToOpacityConverter" />
        <local:ExpandChevronConverter x:Key="ExpandChevronConverter" />
        <local:IsFavoriteMultiConverter x:Key="IsFavoriteMultiConverter" />
        <local:IsPinnedMultiConverter x:Key="IsPinnedMultiConverter" />
        <local:PlayCountMultiConverter x:Key="PlayCountMultiConverter" />
        <local:TrackContextMenuActionVisibilityConverter x:Key="TrackContextMenuActionVisibilityConverter" />
        <local:TrackContextMenuGroupVisibilityConverter x:Key="TrackContextMenuGroupVisibilityConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />

        <!-- Выбирают DataTemplate/Style контейнера для плоского PlaylistFoldersControl (RefreshPlaylistView) по CLR-типу:
             PlaylistFolder — заголовок (PlaylistFolderHeaderTemplate), PlaylistTrackRow — строка трека (TrackItemTemplate); см. Converters.cs. -->
        <local:PlaylistDisplayItemTemplateSelector x:Key="PlaylistDisplayItemTemplateSelector" />
        <local:PlaylistDisplayItemContainerStyleSelector x:Key="PlaylistDisplayItemContainerStyleSelector" />

        <!-- Шаблон строки трека общий для плейлиста (PlaylistFoldersControl) и FavoritesTrackListView; DataContext — PlaylistTrackRow
             (Folder + FilePath + IndexInFolder), поэтому путь и папка приходят вместе, без Tag/PlacementTarget-трюков (DataContext наследуется в ContextMenu). -->
        <DataTemplate x:Key="TrackItemTemplate">
            <Grid Opacity="{Binding Folder.IsEnabled, Converter={StaticResource BoolToOpacityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Воспроизвести" Click="PlayTrackMenuItem_Click">
                            <MenuItem.Icon>
                                <local:SvgPathIcon Icon="IconPlay" Size="13" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Играть следующим" Click="PlayNextMenuItem_Click"
                                  Visibility="{Binding Source={x:Static local:TrackContextMenuActions.Instance}, Path=Epoch, Converter={StaticResource TrackContextMenuActionVisibilityConverter}, ConverterParameter=PlayNext}">
                            <MenuItem.Icon>
                                <local:SvgPathIcon Icon="IconNext" Size="13" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Добавить в очередь" Click="AddToQueueMenuItem_Click"
                                  Visibility="{Binding Source={x:Static local:TrackContextMenuActions.Instance}, Path=Epoch, Converter={StaticResource TrackContextMenuActionVisibilityConverter}, ConverterParameter=AddToQueue}">
                            <MenuItem.Icon>
                                <local:SvgPathIcon Icon="IconAdd" Size="13" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Найти файл…" Click="RelinkTrackMenuItem_Click"
                                  Visibility="{Binding Source={x:Static local:TrackContextMenuActions.Instance}, Path=Epoch, Converter={StaticResource TrackContextMenuActionVisibilityConverter}, ConverterParameter=FindFile}">
                            <MenuItem.Icon>
                                <local:SvgPathIcon Icon="IconAddFile" Size="13" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Добавить/убрать из избранного" Click="FavoriteMenuItem_Click"
                                  Visibility="{Binding Source={x:Static local:TrackContextMenuActions.Instance}, Path=Epoch, Converter={StaticResource TrackContextMenuActionVisibilityConverter}, ConverterParameter=Favorite}">
                            <MenuItem.Icon>
                                <local:SvgPathIcon Icon="IconHeart" Size="13" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <!-- Видно только в самом "Избранном" — см. подробный комментарий у
                             TrackFavoriteButton/TrackPinButton ниже про Folder.IsFavoritesGroup. -->
                        <MenuItem Header="Закрепить/открепить в избранном" Click="PinMenuItem_Click"
                                  Visibility="{Binding Folder.IsFavoritesGroup, Converter={StaticResource BoolToVisibilityConverter}}">
                            <MenuItem.Icon>
                                <local:SvgPathIcon Icon="IconPin" Size="13" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator Visibility="{Binding Source={x:Static local:TrackContextMenuActions.Instance}, Path=Epoch, Converter={StaticResource TrackContextMenuGroupVisibilityConverter}, ConverterParameter='ShowInExplorer|CopyTrackName|CopyPath|CopyFile|ExportProcessedCopy'}" />
                        <MenuItem Header="Показать в проводнике" Click="ShowInExplorerMenuItem_Click"
                                  Visibility="{Binding Source={x:Static local:TrackContextMenuActions.Instance}, Path=Epoch, Converter={StaticResource TrackContextMenuActionVisibilityConverter}, ConverterParameter=ShowInExplorer}" />
                        <MenuItem Header="Копировать имя трека" Click="CopyTrackNameMenuItem_Click"
                                  Visibility="{Binding Source={x:Static local:TrackContextMenuActions.Instance}, Path=Epoch, Converter={StaticResource TrackContextMenuActionVisibilityConverter}, ConverterParameter=CopyTrackName}" />
                        <MenuItem Header="Копировать путь к файлу" Click="CopyPathMenuItem_Click"
                                  Visibility="{Binding Source={x:Static local:TrackContextMenuActions.Instance}, Path=Epoch, Converter={StaticResource TrackContextMenuActionVisibilityConverter}, ConverterParameter=CopyPath}" />
                        <MenuItem Header="Копировать файл" Click="CopyFileMenuItem_Click"
                                  Visibility="{Binding Source={x:Static local:TrackContextMenuActions.Instance}, Path=Epoch, Converter={StaticResource TrackContextMenuActionVisibilityConverter}, ConverterParameter=CopyFile}" />
                        <MenuItem Header="Сохранить обработанную копию…" Click="ExportProcessedCopyMenuItem_Click"
                                  ToolTip="MP3-копия с текущими скоростью и тоном"
                                  Visibility="{Binding Source={x:Static local:TrackContextMenuActions.Instance}, Path=Epoch, Converter={StaticResource TrackContextMenuActionVisibilityConverter}, ConverterParameter=ExportProcessedCopy}" />
                        <Separator Visibility="{Binding Source={x:Static local:TrackContextMenuActions.Instance}, Path=Epoch, Converter={StaticResource TrackContextMenuGroupVisibilityConverter}, ConverterParameter='Properties|EditTags|NormalizeFileName'}" />
                        <MenuItem Header="Свойства" Click="TrackPropertiesMenuItem_Click"
                                  Visibility="{Binding Source={x:Static local:TrackContextMenuActions.Instance}, Path=Epoch, Converter={StaticResource TrackContextMenuActionVisibilityConverter}, ConverterParameter=Properties}" />
                        <MenuItem Header="Изменить теги" Click="EditTagsMenuItem_Click"
                                  Visibility="{Binding Source={x:Static local:TrackContextMenuActions.Instance}, Path=Epoch, Converter={StaticResource TrackContextMenuActionVisibilityConverter}, ConverterParameter=EditTags}">
                            <MenuItem.Icon>
                                <local:SvgPathIcon Icon="IconEdit" Size="13" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Нормализовать имя файла…" Click="NormalizeTrackFileNameMenuItem_Click"
                                  Visibility="{Binding Source={x:Static local:TrackContextMenuActions.Instance}, Path=Epoch, Converter={StaticResource TrackContextMenuActionVisibilityConverter}, ConverterParameter=NormalizeFileName}">
                            <MenuItem.Icon>
                                <local:SvgPathIcon Icon="IconEdit" Size="13" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator Visibility="{Binding Source={x:Static local:TrackContextMenuActions.Instance}, Path=Epoch, Converter={StaticResource TrackContextMenuGroupVisibilityConverter}, ConverterParameter='RemoveFromPlaylist|DeleteFromDisk'}" />
                        <MenuItem Header="Убрать из плейлиста" Click="RemoveTrackMenuItem_Click"
                                  Visibility="{Binding Source={x:Static local:TrackContextMenuActions.Instance}, Path=Epoch, Converter={StaticResource TrackContextMenuActionVisibilityConverter}, ConverterParameter=RemoveFromPlaylist}">
                            <MenuItem.Icon>
                                <local:SvgPathIcon Icon="IconDelete" Size="13" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Удалить трек с диска…" Click="DeleteTrackFromDiskMenuItem_Click"
                                  Foreground="#E53935"
                                  Visibility="{Binding Source={x:Static local:TrackContextMenuActions.Instance}, Path=Epoch, Converter={StaticResource TrackContextMenuActionVisibilityConverter}, ConverterParameter=DeleteFromDisk}">
                            <MenuItem.Icon>
                                <local:SvgPathIcon Icon="IconDelete" Size="13" Foreground="#E53935" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Grid.ContextMenu>

                <Grid Grid.Column="0" Width="26" Margin="0,0,4,0">
                    <TextBlock x:Name="TrackIndexText" Text="{Binding IndexInFolder}"
                               FontSize="11" Opacity="0.5"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <local:SvgPathIcon x:Name="TrackPlayIcon" Icon="IconPlay" Size="10"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed" />
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding FilePath, Converter={StaticResource FileNameConverter}}"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel x:Name="MissingFileStatusPanel" Orientation="Horizontal" Margin="0,1,0,0"
                                Visibility="Collapsed">
                        <TextBlock Text="{Binding MissingStatus}" Foreground="#E5A04B" FontSize="10"
                                   VerticalAlignment="Center" />
                        <ui:Button Appearance="Secondary" MinWidth="66" Height="22" Padding="7,0" Margin="7,0,0,0"
                                   Content="Найти…" FontSize="10" VerticalAlignment="Center"
                                   ToolTip="Заменить путь к файлу" Click="RelinkTrackMenuItem_Click" />
                    </StackPanel>
                </StackPanel>

                <!-- Счётчик прослушиваний — MultiBinding как у сердечка (IsFavoriteMultiConverter): путь не меняется, PlayCountChangeNotifier.Epoch
                     даёт повод перечитать значение; пустая строка при 0 прослушиваний не рисует иконку/текст. -->
                <StackPanel x:Name="TrackPlayCountPanel" Grid.Column="2" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="6,0,0,0" Opacity="0.45"
                            ToolTip="Сколько раз прослушан этот трек">
                    <local:SvgPathIcon Icon="IconRepeat" Size="11" Margin="0,0,3,0" />
                    <TextBlock x:Name="TrackPlayCountText" FontSize="11" VerticalAlignment="Center">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource PlayCountMultiConverter}">
                                <Binding Path="FilePath" />
                                <Binding Source="{x:Static local:PlayCountChangeNotifier.Instance}" Path="Epoch" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>

                <!-- Сердечко избранного: контур — не избранный, красное закрашенное — избранный (DataTrigger по IsFavoriteMultiConverter);
                     Foreground задан у иконки: на выделенной строке фиксируем тёмный #141414 (MultiDataTrigger ниже), чтобы читалось на светлом акценте. -->
                <ui:Button x:Name="TrackFavoriteButton" Grid.Column="3" Appearance="Transparent"
                           Width="26" Height="26" Padding="0" Margin="4,0,0,0"
                           Click="FavoriteButton_Click"
                           FocusVisualStyle="{StaticResource RoundedIconButtonFocusVisualStyle}"
                           AutomationProperties.Name="{Binding RelativeSource={RelativeSource Self}, Path=ToolTip}"
                           ToolTip="Добавить/убрать из избранного">
                    <ui:Button.Icon>
                        <local:SvgPathIcon x:Name="TrackFavoriteIcon" Icon="IconHeart" Size="14" Opacity="0.5"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </ui:Button.Icon>
                </ui:Button>

                <!-- Кнопка закрепления видна только в "Избранном" (Folder.IsFavoritesGroup); тёплый янтарный цвет, чтобы не путать ни с красным
                     избранным, ни с акцентом — это отдельный признак трека. -->
                <ui:Button x:Name="TrackPinButton" Grid.Column="4" Appearance="Transparent"
                           Width="26" Height="26" Padding="0" Margin="2,0,0,0"
                           Click="PinButton_Click"
                           FocusVisualStyle="{StaticResource RoundedIconButtonFocusVisualStyle}"
                           AutomationProperties.Name="{Binding RelativeSource={RelativeSource Self}, Path=ToolTip}"
                           ToolTip="Закрепить/открепить в избранном"
                           Visibility="{Binding Folder.IsFavoritesGroup, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ui:Button.Icon>
                        <local:SvgPathIcon x:Name="TrackPinIcon" Icon="IconPin" Size="13" Opacity="0.5"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </ui:Button.Icon>
                </ui:Button>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFileAvailable}" Value="False">
                    <Setter TargetName="MissingFileStatusPanel" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=IsMouseOver}" Value="True">
                    <Setter TargetName="TrackIndexText" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="TrackPlayIcon" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <!-- Пустая строка (0 прослушиваний) — не рисуем ни иконку, ни текст, вместо
                     показа "0" на каждом ещё не проигранном треке. -->
                <DataTrigger Binding="{Binding Text, ElementName=TrackPlayCountText}" Value="">
                    <Setter TargetName="TrackPlayCountPanel" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <!-- MultiBinding вместо Binding по пути: путь трека не меняется, и обычный Binding не перевычислялся бы при изменении избранного —
                     второе плечо (FavoritesChangeNotifier) даёт триггеру повод перевычислиться, иначе нужен полный пересбор ItemsSource. -->
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource IsFavoriteMultiConverter}">
                            <Binding Path="FilePath" />
                            <Binding Source="{x:Static local:FavoritesChangeNotifier.Instance}" Path="Epoch" />
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter TargetName="TrackFavoriteIcon" Property="Icon" Value="IconHeartFilled" />
                    <Setter TargetName="TrackFavoriteIcon" Property="Foreground" Value="#E53935" />
                    <Setter TargetName="TrackFavoriteIcon" Property="Opacity" Value="1" />
                </DataTrigger>
                <!-- Закреплённый трек — та же MultiBinding-механика и тот же FavoritesChangeNotifier (TogglePin тоже вызывает Bump):
                     для перерисовки строки «избранное» и «закрепление» — один повод, отдельный notifier не нужен. -->
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource IsPinnedMultiConverter}">
                            <Binding Path="FilePath" />
                            <Binding Source="{x:Static local:FavoritesChangeNotifier.Instance}" Path="Epoch" />
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter TargetName="TrackPinIcon" Property="Foreground" Value="#F5A623" />
                    <Setter TargetName="TrackPinIcon" Property="Opacity" Value="1" />
                </DataTrigger>
                <!-- Контурное (не избранное) сердечко на выделенной строке — см. TrackFavoriteButton; второе условие (IsFavoriteMultiConverter = False)
                     не даёт перебить красный Foreground избранного, который и так читается на выделении. -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Value="True">
                            <Condition.Binding>
                                <Binding RelativeSource="{RelativeSource AncestorType=ListViewItem}" Path="IsSelected" />
                            </Condition.Binding>
                        </Condition>
                        <Condition Value="False">
                            <Condition.Binding>
                                <MultiBinding Converter="{StaticResource IsFavoriteMultiConverter}">
                                    <Binding Path="FilePath" />
                                    <Binding Source="{x:Static local:FavoritesChangeNotifier.Instance}" Path="Epoch" />
                                </MultiBinding>
                            </Condition.Binding>
                        </Condition>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="TrackFavoriteIcon" Property="Foreground" Value="#141414" />
                </MultiDataTrigger>
                <!-- То же самое, тем же поводом, для незакреплённого контурного значка
                     закрепления на выделенной строке — см. комментарий у MultiDataTrigger выше. -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Value="True">
                            <Condition.Binding>
                                <Binding RelativeSource="{RelativeSource AncestorType=ListViewItem}" Path="IsSelected" />
                            </Condition.Binding>
                        </Condition>
                        <Condition Value="False">
                            <Condition.Binding>
                                <MultiBinding Converter="{StaticResource IsPinnedMultiConverter}">
                                    <Binding Path="FilePath" />
                                    <Binding Source="{x:Static local:FavoritesChangeNotifier.Instance}" Path="Epoch" />
                                </MultiBinding>
                            </Condition.Binding>
                        </Condition>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="TrackPinIcon" Property="Foreground" Value="#141414" />
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Заголовок папки — отдельный ресурс для элемента типа PlaylistFolder в плоском PlaylistFoldersControl.ItemsSource
             (выбирается PlaylistDisplayItemTemplateSelector); DataContext — сам PlaylistFolder. -->
        <DataTemplate x:Key="PlaylistFolderHeaderTemplate">
            <Border Margin="2,2,2,10" CornerRadius="8" Padding="10,8"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,0"
                              IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                              ToolTip="Включить/выключить эту папку в проигрывании" />

                    <ui:Button Grid.Column="1" Appearance="Secondary"
                               Width="26" Height="26" Margin="0,0,4,0" Padding="0"
                               Click="ToggleFolderExpand_Click"
                               ToolTip="Свернуть/развернуть список треков">
                        <ui:Button.Icon>
                            <local:SvgPathIcon Icon="{Binding IsExpanded, Converter={StaticResource ExpandChevronConverter}}" />
                        </ui:Button.Icon>
                    </ui:Button>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                Opacity="{Binding IsEnabled, Converter={StaticResource BoolToOpacityConverter}}">
                        <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding SubtitleText}" FontSize="10" Opacity="0.6"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- Только у "Отдельные файлы" и у папок, созданных вручную (не привязанных
                         к реальной папке на диске) — добавить файлы прямо в эту группу -->
                    <ui:Button Grid.Column="3" Appearance="Secondary"
                               Width="28" Height="28" Padding="0" Margin="0,0,4,0"
                               Click="AddFilesToFolderButton_Click"
                               Visibility="{Binding CanAddFilesDirectly, Converter={StaticResource BoolToVisibilityConverter}}"
                               ToolTip="Добавить файлы в эту папку">
                        <ui:Button.Icon>
                            <local:SvgPathIcon Icon="IconAddFile" Size="13" />
                        </ui:Button.Icon>
                    </ui:Button>

                    <!-- Только для групп, привязанных к папке на диске: проверить, не появились ли новые файлы (RescanFolderButton_Click). -->
                    <ui:Button Grid.Column="4" Appearance="Secondary"
                               Width="28" Height="28" Padding="0" Margin="0,0,4,0"
                               Click="RescanFolderButton_Click"
                               Visibility="{Binding CanRescan, Converter={StaticResource BoolToVisibilityConverter}}"
                               ToolTip="Проверить папку на новые треки">
                        <ui:Button.Icon>
                            <local:SvgPathIcon Icon="IconRefresh" Size="13" />
                        </ui:Button.Icon>
                    </ui:Button>

                    <ui:Button Grid.Column="5" Appearance="Secondary"
                               Width="28" Height="28" Padding="0"
                               Click="RemoveFolderButton_Click"
                               ToolTip="Убрать эту папку из плейлиста">
                        <ui:Button.Icon>
                            <local:SvgPathIcon Icon="IconDelete" />
                        </ui:Button.Icon>
                    </ui:Button>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Заголовок папки не ведёт себя как выбираемая строка (без hover/selection из глобального ListViewItem-стиля в App.xaml):
             Focusable="False", а IsHitTestVisible оставлен true, чтобы кнопки заголовка (чекбокс, шеврон, пересканировать, удалить) ловили клики. -->
        <Style x:Key="PlaylistFolderHeaderContainerStyle" TargetType="ListViewItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsHitTestVisible" Value="True" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <!-- Без BasedOn на глобальный ListViewItem-стиль (не нужны его отступы и ховер) терялся и Foreground: без явного Setter текст и иконки
                 заголовка были бы дефолтным чёрным вместо темизированного и почти нечитаемы на тёмном фоне. -->
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Общий стиль строк трека: поиск формирует отфильтрованный ItemsSource в фоне (MainWindow.QueuePlaylistSearch), поэтому здесь нет
             MultiBinding, который пересчитывал Visibility каждого контейнера на каждый символ и мог надолго блокировать раскладку. -->
        <Style x:Key="SearchableTrackListViewItemStyle" TargetType="ListViewItem"
               BasedOn="{StaticResource {x:Type ListViewItem}}" />

        <!-- Полосы времени и громкости рисуются часто и занимают 4 DIP: локальный template фиксирует их на физических пикселях,
             убирая размытые края и "дрожание" линии на дробном DPI; крупные вертикальные слайдеры в настройках не затронуты. -->
        <Style x:Key="MainWindowPlaybackSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="24" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Margin="0,5" Background="Transparent"
                              SnapsToDevicePixels="True" UseLayoutRounding="True">
                            <!-- Один renderer рисует обе части полосы в одном DrawingContext.
                                 Поэтому сглаженные границы не перекрывают друг друга и не дают швов. -->
                            <!-- Цвет и выравнивание совпадают с одобренным SettingsAccentSliderStyle. -->
                            <local:MainWindowSliderTrackRenderer x:Name="PART_TrackRenderer"
                                                                 IsHitTestVisible="False"
                                                                 SnapsToDevicePixels="True"
                                                                 UseLayoutRounding="True"
                                                                 BackgroundBrush="{DynamicResource ControlFillColorTertiaryBrush}"
                                                                 FillBrush="{DynamicResource AccentFillColorDefaultBrush}" />

                            <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}"
                                   IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                   SnapsToDevicePixels="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False"
                                                  Background="Transparent" BorderThickness="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <!-- Геометрию дорожки рисует PART_TrackRenderer; кнопка остаётся
                                                     прозрачной зоной Track для штатной логики Slider. -->
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>

                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False"
                                                  Background="Transparent" BorderThickness="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>

                                <Track.Thumb>
                                    <Thumb Width="14" Height="14" Cursor="Hand"
                                           SnapsToDevicePixels="True" UseLayoutRounding="True">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{DynamicResource AccentFillColorDefaultBrush}"
                                                         Stroke="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                                         StrokeThickness="1"
                                                         SnapsToDevicePixels="True" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- Заголовок -->
            <RowDefinition Height="*" />      <!-- Тело: центрируется и масштабируется в полноэкранном режиме -->
        </Grid.RowDefinitions>

        <!-- Заголовок окна (Fluent TitleBar). ВАЖНО: ui:TitleBar перехватывает клики в своих границах на уровне Win32 (WM_NCHITTEST → HTCAPTION),
             поэтому кликабельная область "Lumisense" вынесена в отдельную колонку слева от него, а не наложена поверх. -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="TitleClickArea" Grid.Column="0" VerticalAlignment="Stretch"
                    Background="Transparent" Cursor="Hand" Padding="16,0,4,0"
                    MouseLeftButtonUp="TitleClickArea_MouseLeftButtonUp"
                    ToolTip="Вид плеера">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- PNG сохраняет детализированный 256px artwork (лучше 16px-кадра ICO для этой области), а layout/scaling flags не дают ему
                         размыться на дробном DPI. -->
                    <Image Source="/Icons/app/lumisense.png" Width="14" Height="14" Margin="0,0,6,0"
                           Stretch="Uniform" SnapsToDevicePixels="True" UseLayoutRounding="True"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Lumisense" FontSize="12" VerticalAlignment="Center" Opacity="0.9" />
                </StackPanel>
                <Border.ContextMenu>
                    <ContextMenu x:Name="MainViewContextMenu" Placement="Bottom"
                                 Opened="MainViewContextMenu_Opened">
                        <ContextMenu.Resources>
                            <!-- Wpf.Ui не всегда рисует штатный check-glyph MenuItem в Popup: локальный шаблон для трёх пунктов выбора вида показывает
                                 тот же Fluent CheckBox, что в меню мини-плеера, без новых пунктов и состояний. -->
                            <Style x:Key="MainViewToggleMenuItemStyle" TargetType="{x:Type MenuItem}">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Padding" Value="8,5" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type MenuItem}">
                                            <Border x:Name="ItemBackground" Background="{TemplateBinding Background}"
                                                    Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24" />
                                                        <ColumnDefinition Width="24" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.Column="0" IsHitTestVisible="False" Focusable="False"
                                                              Style="{DynamicResource MainViewAccentCheckBoxStyle}"
                                                              VerticalAlignment="Center" IsChecked="{TemplateBinding IsChecked}" />
                                                    <ContentPresenter Grid.Column="1" Content="{TemplateBinding Icon}"
                                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <ContentPresenter Grid.Column="2" ContentSource="Header"
                                                                      Margin="5,0,0,0" VerticalAlignment="Center"
                                                                      RecognizesAccessKey="True" />
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsHighlighted" Value="True">
                                                    <Setter TargetName="ItemBackground" Property="Background"
                                                            Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.45" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <!-- Активный вид должен быть заметен и в Popup: вместо системного CheckBox — локальный акцент Lumisense и белая галочка. -->
                            <Style x:Key="MainViewAccentCheckBoxStyle" TargetType="{x:Type CheckBox}">
                                <Setter Property="Width" Value="18" />
                                <Setter Property="Height" Value="18" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type CheckBox}">
                                            <Border x:Name="CheckBorder" Width="18" Height="18" CornerRadius="4"
                                                    BorderThickness="1"
                                                    BorderBrush="{DynamicResource ControlStrongFillColorDefaultBrush}"
                                                    Background="Transparent">
                                                <Viewbox Margin="4">
                                                    <Path x:Name="CheckGlyph" Data="M 1,5 L 4,8 L 10,1"
                                                          Stroke="White" StrokeThickness="2.1"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round" Visibility="Collapsed" />
                                                </Viewbox>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="CheckBorder" Property="Background"
                                                            Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                    <Setter TargetName="CheckBorder" Property="BorderBrush"
                                                            Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                    <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="CheckBorder" Property="Opacity" Value="0.45" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ContextMenu.Resources>
                        <MenuItem x:Name="SquareViewMenuItem" Header="Обычный (квадратный)"
                                  Style="{StaticResource MainViewToggleMenuItemStyle}"
                                  IsCheckable="True" Tag="Square" Click="ViewModeMenuItem_Click">
                            <MenuItem.Icon>
                                <local:SvgPathIcon Icon="IconWindow" Size="14" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="RectangularViewMenuItem" Header="Прямоугольный"
                                  Style="{StaticResource MainViewToggleMenuItemStyle}"
                                  IsCheckable="True" Tag="Rectangular" Click="ViewModeMenuItem_Click">
                            <MenuItem.Icon>
                                <local:SvgPathIcon Icon="IconPictureInPicture" Size="14" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Now Playing (полный экран)" Click="ShowNowPlayingMenuItem_Click">
                            <MenuItem.Icon>
                                <local:SvgPathIcon Icon="IconExpand" Size="14" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem x:Name="MiniViewMenuItem" Header="Мини-плеер"
                                  Style="{StaticResource MainViewToggleMenuItemStyle}"
                                  IsCheckable="True" Tag="Mini" Click="ViewModeMenuItem_Click">
                            <MenuItem.Icon>
                                <local:SvgPathIcon Icon="IconMinimizePlayer" Size="14" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Border.ContextMenu>
            </Border>

            <!-- Title="" — стандартный текст TitleBar скрыт, вместо него слева стоит
                 кликабельный TitleClickArea из отдельной колонки выше -->
            <ui:TitleBar x:Name="AppTitleBar" Grid.Column="1" Title="" ShowMaximize="True" />
        </Grid>

        <!-- ContentHost: при полном экране интерфейс не растягивается на весь монитор, а центрируется и увеличивается — размеры считают
             ApplyFullscreenLayout()/UpdateContentMaxWidth() по StateChanged; в обычном окне ведёт себя как раньше. -->
        <Border Grid.Row="1" x:Name="ContentHost" HorizontalAlignment="Stretch" MaxWidth="440">
            <Grid x:Name="BodyGrid">
                <Grid.RowDefinitions>
                                    <RowDefinition Height="0" />      <!-- Техническая заглушка -->
                <RowDefinition Height="Auto" />   <!-- Обложка / инфо о треке -->
                <RowDefinition Height="Auto" />   <!-- Прогресс и время -->
                <RowDefinition Height="Auto" />   <!-- Кнопки управления -->
                <RowDefinition Height="Auto" />   <!-- Громкость и кнопка скорости -->
                <RowDefinition Height="Auto" />   <!-- Панель плейлиста: заголовок + кнопки добавления -->
                <RowDefinition Height="*" />      <!-- Плейлист (тянется, не вылезает за края) -->

                </Grid.RowDefinitions>

        <!-- Блок с обложкой и названием трека -->
        <StackPanel x:Name="AlbumArtPanel" Grid.Row="1" HorizontalAlignment="Center" Margin="0,8,0,8">
            <!-- ClipToBounds="False": при анимации смены обложки (AnimateAlbumArtTransition) старая и новая временно выходят за 150x150. -->
            <Grid x:Name="AlbumArtContainer" Width="150" Height="150" ClipToBounds="False">
                <!-- Копия предыдущей обложки поверх основной на время анимации (убирается по её завершению); IsHitTestVisible="False" —
                     чтобы не перехватывать клики и контекстное меню. -->
                <Border x:Name="AlbumArtGhostBorder" Width="150" Height="150" CornerRadius="16"
                        Visibility="Collapsed" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="AlbumArtGhostScale" ScaleX="1" ScaleY="1" />
                            <TranslateTransform x:Name="AlbumArtGhostTransform" X="0" />
                        </TransformGroup>
                    </Border.RenderTransform>
                    <!-- Отдельный Image, а не ImageBrush фона: тот же высококачественный
                         слой, что уже исправил отрисовку мини-плеера и уведомления. -->
                    <Grid ClipToBounds="True" SnapsToDevicePixels="True" UseLayoutRounding="True">
                        <Image x:Name="AlbumArtGhostImage" Stretch="UniformToFill" Visibility="Collapsed"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               RenderOptions.EdgeMode="Unspecified"
                               SnapsToDevicePixels="True" UseLayoutRounding="True">
                            <!-- Border.CornerRadius не обрезает дочерний Image: задаём маску
                                 самому пиксельному слою, чтобы ghost сохранял прежние углы. -->
                            <Image.Clip>
                                <RectangleGeometry Rect="0,0,150,150" RadiusX="16" RadiusY="16" />
                            </Image.Clip>
                        </Image>
                        <local:SvgPathIcon x:Name="AlbumArtGhostIcon" Icon="IconMusicNote" Size="36"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Visibility="Collapsed" />
                    </Grid>
                </Border>

                <Border x:Name="AlbumArtBorder" Width="150" Height="150" CornerRadius="16"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                         Cursor="Hand" RenderTransformOrigin="0.5,0.5"
                         PreviewMouseLeftButtonDown="AlbumArtBorder_PreviewMouseLeftButtonDown"
                         PreviewMouseMove="AlbumArtBorder_PreviewMouseMove"
                         PreviewMouseLeftButtonUp="AlbumArtBorder_PreviewMouseLeftButtonUp"
                         ContextMenuOpening="AlbumArtBorder_ContextMenuOpening">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="AlbumArtBorderScale" ScaleX="1" ScaleY="1" />
                            <TranslateTransform x:Name="AlbumArtBorderTransform" X="0" />
                        </TransformGroup>
                    </Border.RenderTransform>
                    <Border.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Открыть обложку" Click="OpenAlbumArtMenuItem_Click">
                                <MenuItem.Icon>
                                    <local:SvgPathIcon Icon="IconExpand" Size="13" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Скачать изображение…" Click="DownloadAlbumArtMenuItem_Click">
                                <MenuItem.Icon>
                                    <local:SvgPathIcon Icon="IconAddFile" Size="13" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Копировать изображение" Click="CopyAlbumArtMenuItem_Click">
                                <MenuItem.Icon>
                                    <local:SvgPathIcon Icon="IconCopy" Size="13" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Свойства" Click="AlbumArtPropertiesMenuItem_Click">
                                <MenuItem.Icon>
                                    <local:SvgPathIcon Icon="IconInfo" Size="13" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Border.ContextMenu>
                    <!-- Image-слой повторяет проверенный mini-player/toast-паттерн. Он даёт
                         предсказуемое HighQuality масштабирование вместо артефактов ImageBrush. -->
                    <Grid ClipToBounds="True" SnapsToDevicePixels="True" UseLayoutRounding="True">
                        <Image x:Name="AlbumArtImage" Stretch="UniformToFill" Visibility="Collapsed"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               RenderOptions.EdgeMode="Unspecified"
                               SnapsToDevicePixels="True" UseLayoutRounding="True">
                            <!-- Скругление применяется к пикселям изображения, а не только к
                                 рамке: это повторяет прежний вид главной обложки. -->
                            <Image.Clip>
                                <RectangleGeometry Rect="0,0,150,150" RadiusX="16" RadiusY="16" />
                            </Image.Clip>
                        </Image>
                        <local:SvgPathIcon x:Name="AlbumArtIcon" Icon="IconMusicNote" Size="36"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </Border>
            </Grid>

            <TextBlock x:Name="TrackTitleText" Text="Файл не выбран"
                       FontSize="17" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,12,0,2"
                       TextTrimming="CharacterEllipsis" MaxWidth="360" />

            <TextBlock x:Name="TrackArtistText" Text="—"
                       FontSize="12" Opacity="0.6"
                       HorizontalAlignment="Center" />

            <Border x:Name="TrackStateBadge" CornerRadius="8" Padding="8,3" Margin="0,8,0,0"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    HorizontalAlignment="Center">
                <TextBlock x:Name="TrackStateText" Text="Трек не выбран" FontSize="11" Opacity="0.78"
                           ToolTip="Выберите трек в плейлисте или нажмите воспроизведение." />
            </Border>
        </StackPanel>

        <Grid Grid.Row="2" Margin="24,4,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Slider x:Name="ProgressSlider" Style="{StaticResource MainWindowPlaybackSliderStyle}"
                        IsHitTestVisible="False" Minimum="0" Maximum="1" Value="0"
                        ValueChanged="ProgressSlider_ValueChanged" />

                <!-- Альтернативный вид полосы — форма звука (AppSettings.ProgressBarStyle/ApplyProgressBarStyle): показывается вместо ProgressSlider,
                     который остаётся источником истины для позиции и перемотки, просто скрыт. -->
                <local:WaveformView x:Name="ProgressWaveform" Height="28" IsHitTestVisible="False"
                                     Visibility="Collapsed"
                                     UnplayedBrush="{DynamicResource ControlStrongFillColorDefaultBrush}" />

                <!-- Прозрачный слой поверх слайдера: сам обрабатывает мышь целиком,
                     чтобы не зависеть от того, куда именно попал клик — на трек или на шарик -->
                <Border Background="Transparent" Height="24"
                        MouseLeftButtonDown="ProgressOverlay_MouseLeftButtonDown"
                        MouseMove="ProgressOverlay_MouseMove"
                        MouseLeftButtonUp="ProgressOverlay_MouseLeftButtonUp"
                        MouseWheel="ProgressOverlay_MouseWheel" />
            </Grid>

            <Grid Grid.Row="1" Margin="0,2,0,0">
                <TextBlock x:Name="CurrentTimeText" Text="00:00" HorizontalAlignment="Left" FontSize="11" Opacity="0.6" />
                <TextBlock x:Name="TotalTimeText" Text="00:00" HorizontalAlignment="Right" FontSize="11" Opacity="0.6" />
            </Grid>
        </Grid>

        <StackPanel x:Name="ControlsPanel" Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,14,0,6">

            <ui:Button x:Name="ShuffleButton" Appearance="Secondary"
                       Width="40" Height="40" Margin="4,0"
                       Click="ShuffleButton_Click" ToolTip="Перемешать">
                <ui:Button.Icon>
                    <local:SvgPathIcon x:Name="ShuffleIcon" Icon="IconShuffle" />
                </ui:Button.Icon>
            </ui:Button>

            <ui:Button x:Name="RepeatButton" Appearance="Secondary"
                       Width="40" Height="40" Margin="4,0"
                       Click="RepeatButton_Click" ToolTip="Повтор: выключен">
                <ui:Button.Icon>
                    <local:SvgPathIcon Icon="IconRepeatAll" />
                </ui:Button.Icon>
            </ui:Button>

            <ui:Button x:Name="PrevButton" Appearance="Secondary"
                       Width="44" Height="44" Margin="4,0"
                       Click="PrevButton_Click" ToolTip="Предыдущий">
                <ui:Button.Icon>
                    <local:SvgPathIcon Icon="IconPrevious" />
                </ui:Button.Icon>
            </ui:Button>

            <!-- Appearance="Secondary", а не "Primary": фон красится вручную (RefreshAccentDependentIcons/SetAccentButtonActive) — у Primary баг WPF-UI:
                 фон не обновляется вживую при смене акцента (lepoco/wpfui #965/#981). -->
            <ui:Button x:Name="PlayPauseButton" Appearance="Secondary"
                       Width="54" Height="54" Margin="4,0"
                       Click="PlayPauseButton_Click" ToolTip="Пуск/Пауза">
                <ui:Button.Icon>
                    <local:SvgPathIcon x:Name="PlayPauseIcon" Icon="IconPlay" Size="15" />
                </ui:Button.Icon>
            </ui:Button>

            <ui:Button x:Name="NextButton" Appearance="Secondary"
                       Width="44" Height="44" Margin="4,0"
                       Click="NextButton_Click" ToolTip="Следующий">
                <ui:Button.Icon>
                    <local:SvgPathIcon Icon="IconNext" />
                </ui:Button.Icon>
            </ui:Button>

            <ui:Button x:Name="StopButton" Appearance="Secondary"
                       Width="40" Height="40" Margin="4,0"
                       Click="StopButton_Click" ToolTip="Стоп">
                <ui:Button.Icon>
                    <local:SvgPathIcon Icon="IconStop" />
                </ui:Button.Icon>
            </ui:Button>

            <ui:Button x:Name="MiniModeButton" Appearance="Secondary"
                       Width="40" Height="40" Margin="4,0"
                       Click="MiniModeButton_Click" ToolTip="Свернуть в мини-плеер">
                <ui:Button.Icon>
                    <local:SvgPathIcon Icon="IconMinimizePlayer" />
                </ui:Button.Icon>
            </ui:Button>
        </StackPanel>

        <!-- Громкость и компактное управление скоростью -->
        <Grid x:Name="VolumeRow" Grid.Row="4" Margin="24,0,24,10" MouseWheel="VolumeRow_MouseWheel">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button x:Name="PlaybackControlButton" Appearance="Transparent"
                           Width="26" Height="26" Padding="0" Margin="0,0,4,0"
                           Click="PlaybackControlButton_Click" MouseWheel="PlaybackControlButton_MouseWheel"
                           ToolTip="Скорость и тон воспроизведения">
                    <ui:Button.Icon>
                        <local:SvgPathIcon Icon="IconSpeed" Size="15" />
                    </ui:Button.Icon>
                </ui:Button>
                <ui:Button x:Name="MuteButton" Appearance="Transparent"
                           Width="26" Height="26" Padding="0" Margin="0,0,6,0"
                           Click="MuteButton_Click" ToolTip="Без звука">
                    <ui:Button.Icon>
                        <local:SvgPathIcon x:Name="SpeakerIcon" Icon="IconSpeaker" Size="15" />
                    </ui:Button.Icon>
                </ui:Button>
            </StackPanel>

            <Grid Grid.Column="1">
                <Slider x:Name="VolumeSlider" Style="{StaticResource MainWindowPlaybackSliderStyle}"
                        IsHitTestVisible="False" Minimum="0" Maximum="1" Value="0.3"
                        ValueChanged="VolumeSlider_ValueChanged" VerticalAlignment="Center" />

                <Border Background="Transparent" Height="24" VerticalAlignment="Center"
                        MouseLeftButtonDown="VolumeOverlay_MouseLeftButtonDown"
                        MouseMove="VolumeOverlay_MouseMove"
                        MouseLeftButtonUp="VolumeOverlay_MouseLeftButtonUp" />
            </Grid>

            <TextBlock x:Name="VolumeValueText" Grid.Column="2" Text="30%"
                       FontSize="11" Opacity="0.6" Width="34" Margin="8,0,0,0"
                       VerticalAlignment="Center" HorizontalAlignment="Right" />
        </Grid>

        <Popup x:Name="PlaybackControlPopup" PlacementTarget="{Binding ElementName=PlaybackControlButton}"
               Placement="Top" StaysOpen="False" AllowsTransparency="True"
               VerticalOffset="-8" PopupAnimation="Fade" Opened="PlaybackControlPopup_Opened"
               Closed="PlaybackControlPopup_Closed">
            <Border x:Name="PlaybackControlPopupBorder" Background="#FF242424"
                    BorderBrush="#FF707070" BorderThickness="1" CornerRadius="8" Padding="12,8"
                    >
                <Grid Width="230">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <!-- Фиксированная ширина подписки выравнивает оба слайдера. -->
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Скорость" Grid.Column="0" Foreground="#D8D8D8"
                                   FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Slider x:Name="PlaybackRateSlider" Grid.Column="1"
                                Minimum="0.5" Maximum="2.0" Value="1.0"
                                TickFrequency="0.05" IsSnapToTickEnabled="True"
                                ValueChanged="PlaybackRateSlider_ValueChanged"
                                MouseDoubleClick="PlaybackRateSlider_MouseDoubleClick"
                                MouseWheel="PlaybackRateSlider_MouseWheel"
                                VerticalAlignment="Center" />
                        <TextBlock x:Name="PlaybackRateValueText" Grid.Column="2" Text="1.00×"
                                   Foreground="White" FontWeight="SemiBold" FontSize="11" Width="38"
                                   Margin="10,0,0,0" VerticalAlignment="Center"
                                   HorizontalAlignment="Right" />
                                        </Grid>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <!-- Та же ширина, что и у строки скорости. -->
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Тон" Grid.Column="0" Foreground="#D8D8D8"
                                   FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Slider x:Name="PlaybackPitchSlider" Grid.Column="1"
                                Minimum="-12" Maximum="12" Value="0"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                ValueChanged="PlaybackPitchSlider_ValueChanged"
                                MouseDoubleClick="PlaybackPitchSlider_MouseDoubleClick"
                                MouseWheel="PlaybackPitchSlider_MouseWheel"
                                VerticalAlignment="Center" />
                        <TextBlock x:Name="PlaybackPitchValueText" Grid.Column="2" Text="0 st"
                                   Foreground="White" FontWeight="SemiBold" FontSize="11" Width="38"
                                   Margin="10,0,0,0" VerticalAlignment="Center"
                                   HorizontalAlignment="Right" />
                    </Grid>
                </Grid>
            </Border>
        </Popup>

        <Popup x:Name="QueuePopup"
               Placement="Top" StaysOpen="False" AllowsTransparency="True"
               VerticalOffset="-8" PopupAnimation="Fade">
            <!-- Popup живёт в отдельном WPF-окне. Используем явные непрозрачные цвета, а не
                 Mica/Acrylic theme brushes, иначе нижний плейлист просвечивает через карточки. -->
            <!-- Ширина выбирается по содержимому в пределах 500–640 DIP: Popup не остаётся
                 искусственно узким, но и не разрастается из-за очень длинного пути трека. -->
            <Border MinWidth="500" MaxWidth="640" Background="#FF242424" BorderBrush="#FF5A5A5A"
                    BorderThickness="1" CornerRadius="12" Padding="14">
                <StackPanel x:Name="QueuePopupContent" MinWidth="472" MaxWidth="612">
                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Очередь «Играть следующим»" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock x:Name="QueueCountText" Text="В очереди: 0" FontSize="11" Opacity="0.62" Margin="0,2,0,0" />
                        </StackPanel>
                        <ui:Button x:Name="ClearQueueButton" Grid.Column="1" Appearance="Secondary"
                                   Height="28" Padding="9,0" VerticalAlignment="Top" Visibility="Collapsed"
                                   ToolTip="Очистить" Click="ClearQueueButton_Click">
                            <ui:Button.Icon>
                                <local:SvgPathIcon Icon="IconDelete" Size="13" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </Grid>
                    <TextBlock x:Name="QueueHintText" Text="Треки будут воспроизведены сверху вниз."
                               FontSize="11" Opacity="0.62" TextWrapping="Wrap" Margin="0,6,0,12" />
                    <!-- Вертикальная компоновка даёт обоим контролам всю ширину Popup; высота 40 DIP и явные отступы сохраняют глифы при любом масштабе/DPI. -->
                    <StackPanel x:Name="QueueToolsPanel" Margin="0,0,0,12">
                        <TextBlock Text="Поиск" FontSize="11" Opacity="0.68" Margin="0,0,0,4" />
                        <ui:TextBox x:Name="QueueSearchBox" Height="40" Padding="10,5"
                                    VerticalContentAlignment="Center" HorizontalContentAlignment="Stretch"
                                    PlaceholderText="Поиск по названию" ClearButtonEnabled="True"
                                    ToolTip="Поиск в очереди" TextChanged="QueueSearchBox_TextChanged" Margin="0,0,0,10">
                            <ui:TextBox.Icon>
                                <local:SvgPathIcon Icon="IconSearch" Size="14" />
                            </ui:TextBox.Icon>
                        </ui:TextBox>
                        <TextBlock Text="Порядок очереди" FontSize="11" Opacity="0.68" Margin="0,0,0,4" />
                        <ComboBox x:Name="QueueSortCombo" Height="40" Padding="10,5,36,5"
                                  VerticalContentAlignment="Center" HorizontalContentAlignment="Stretch"
                                  SelectedIndex="0" SelectionChanged="QueueSortCombo_SelectionChanged">
                            <ComboBoxItem Content="Порядок добавления" />
                            <ComboBoxItem Content="По названию: А–Я" />
                            <ComboBoxItem Content="По названию: Я–А" />
                        </ComboBox>
                    </StackPanel>
                    <TextBlock x:Name="QueueEmptyText"
                               Text="Пусто. Правый клик по треку → «Играть следующим» или «Добавить в очередь»."
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap"
                               Margin="2,4,2,6" />
                    <!-- Длинный путь не должен расширять Item за пределы Popup: обрезается в центральной колонке, кнопка удаления остаётся справа;
                         scrollbar у собственного ScrollViewer — в отдельной колонке 16 DIP, а не поверх карточек. -->
                    <ListBox x:Name="QueueItemsList" MaxHeight="280" Background="Transparent"
                             BorderThickness="0" HorizontalContentAlignment="Stretch" Visibility="Collapsed">
                        <ListBox.Template>
                            <ControlTemplate TargetType="{x:Type ListBox}">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                    <ScrollViewer x:Name="PART_ScrollViewer"
                                                  CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto"
                                                  Focusable="False">
                                        <ScrollViewer.Template>
                                            <ControlTemplate TargetType="{x:Type ScrollViewer}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="16" />
                                                    </Grid.ColumnDefinitions>
                                                    <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                                            Grid.Column="0"
                                                                            CanContentScroll="{TemplateBinding CanContentScroll}"
                                                                            Content="{TemplateBinding Content}"
                                                                            ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                            ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                                                            ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                                    <!-- Полоса начинается через 2 DIP после карточек; у track темы есть верхний отступ, поэтому ScrollBar поднят на 8 DIP. -->
                                                    <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1"
                                                               Width="5" Margin="2,-8,0,0" HorizontalAlignment="Left"
                                                               Orientation="Vertical"
                                                               Maximum="{TemplateBinding ScrollableHeight}"
                                                               ViewportSize="{TemplateBinding ViewportHeight}"
                                                               Value="{TemplateBinding VerticalOffset}"
                                                               Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                                               Focusable="False" />
                                                </Grid>
                                            </ControlTemplate>
                                        </ScrollViewer.Template>
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </ControlTemplate>
                        </ListBox.Template>
                        <!-- У карточек нет самостоятельного действия по клику: стандартные
                             Selected/Focus-эффекты ListBox только отвлекают от кнопки удаления. -->
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                            <ContentPresenter Content="{TemplateBinding Content}"
                                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                                              ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                                              ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FF303030" CornerRadius="7"
                                        Padding="8,5" Margin="0,0,0,3">
                                    <Grid ClipToBounds="True">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="20" Height="20" CornerRadius="10"
                                                Background="#FF414141"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Position}" FontSize="10" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" Opacity="0.74" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="6,0,8,0" MinWidth="0"
                                                    HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold"
                                                       HorizontalAlignment="Stretch" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding FilePath}" FontSize="10" Opacity="0.55"
                                                       HorizontalAlignment="Stretch" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <ui:Button Grid.Column="2" Appearance="Transparent" Width="26" Height="26" Padding="0"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   ToolTip="Убрать из очереди" Tag="{Binding}" Click="RemoveFromQueueButton_Click">
                                            <ui:Button.Icon>
                                                <local:SvgPathIcon Icon="IconDismiss" Size="12" />
                                            </ui:Button.Icon>
                                        </ui:Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
        </Popup>


        <!-- Панель плейлиста: заголовок + переключатель видимости + кнопки добавления -->
        <Grid x:Name="PlaylistHeaderRow" Grid.Row="5" Margin="16,4,16,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Скрывает/показывает весь блок плейлиста целиком (не путать с шевроном
                 отдельной папки внутри него) -->
            <ui:Button Grid.Column="0" x:Name="TogglePlaylistButton" Appearance="Transparent"
                       Width="26" Height="26" Padding="0" Margin="0,0,4,0"
                       Click="TogglePlaylistButton_Click" ToolTip="Скрыть плейлист">
                <ui:Button.Icon>
                    <local:SvgPathIcon Icon="IconChevronDown" />
                </ui:Button.Icon>
            </ui:Button>

            <TextBlock x:Name="PlaylistHeaderText" Grid.Column="1" Text="Плейлист" FontSize="14" FontWeight="SemiBold"
                       VerticalAlignment="Center" Opacity="0.85" />

            <!-- Переключает плейлист и виртуальное "Избранное" (собирается из треков с сердечком, FavoritesManager); активное состояние подсвечено
                 акцентом вручную (SetAccentButtonActive), как ShuffleButton/RepeatButton (см. SetFavoritesViewActive). -->
            <ui:Button Grid.Column="2" x:Name="FavoritesButton" Appearance="Secondary"
                       Width="32" Height="32" Padding="0" Margin="4,0,0,0"
                       Click="FavoritesButton_Click" ToolTip="Избранное">
                <ui:Button.Icon>
                    <local:SvgPathIcon x:Name="FavoritesButtonIcon" Icon="IconHeart" Size="15" />
                </ui:Button.Icon>
            </ui:Button>

            <!-- Одна кнопка вместо "Файлы"/"Папка" — по клику меню выбора; скрыта в виртуальном "Избранном", куда файлы напрямую не добавляются. -->
            <ui:Button Grid.Column="3" x:Name="AddButton" Appearance="Secondary"
                       Content="Добавить" Margin="4,0"
                       Click="AddButton_Click" ToolTip="Добавить файлы или папку">
                <ui:Button.Icon>
                    <local:SvgPathIcon Icon="IconAdd" />
                </ui:Button.Icon>
                <ui:Button.ContextMenu>
                    <ContextMenu Placement="Bottom">
                        <MenuItem Header="Файлы…" Click="AddFilesMenuItem_Click">
                            <MenuItem.Icon>
                                <local:SvgPathIcon Icon="IconAddFile" Size="14" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Папку…" Click="AddFolderMenuItem_Click">
                            <MenuItem.Icon>
                                <local:SvgPathIcon Icon="IconAddFolder" Size="14" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Новую папку…" Click="CreateFolderMenuItem_Click"
                                  ToolTip="Создать пустую папку в плейлисте и добавлять в неё файлы вручную">
                            <MenuItem.Icon>
                                <local:SvgPathIcon Icon="IconAdd" Size="14" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Проверить недоступные файлы" Click="CheckUnavailableFilesMenuItem_Click">
                            <MenuItem.Icon>
                                <local:SvgPathIcon Icon="IconSearch" Size="14" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </ui:Button.ContextMenu>
            </ui:Button>

            <ui:Button Grid.Column="4" x:Name="ClearPlaylistButton" Appearance="Secondary"
                       Width="32" Height="32" Padding="0" Margin="4,0,0,0"
                       Click="ClearPlaylistButton_Click" ToolTip="Очистить плейлист">
                <ui:Button.Icon>
                    <local:SvgPathIcon Icon="IconDelete" />
                </ui:Button.Icon>
            </ui:Button>

            <ui:Button Grid.Column="5" x:Name="StatisticsButton" Appearance="Secondary"
                       Width="32" Height="32" Padding="0" Margin="4,0,0,0"
                       Click="StatisticsButton_Click" ToolTip="Статистика">
                <ui:Button.Icon>
                    <local:SvgPathIcon Icon="IconMusicNote" Size="15" />
                </ui:Button.Icon>
            </ui:Button>

            <ui:Button Grid.Column="7" x:Name="SettingsButton" Appearance="Secondary"
                       Width="32" Height="32" Padding="0" Margin="4,0,0,0"
                       Click="SettingsButton_Click" ToolTip="Настройки">
                <ui:Button.Icon>
                    <local:SvgPathIcon Icon="IconSettings" />
                </ui:Button.Icon>
            </ui:Button>

            <!-- Раскрывает мини-меню с двумя редко используемыми действиями (очередь и текст
                 песни) вместо двух отдельных кнопок в общем ряду — см. MoreActionsPopup ниже. -->
            <ui:Button Grid.Column="6" x:Name="MoreActionsButton" Appearance="Secondary"
                       Width="32" Height="32" Padding="0" Margin="4,0,0,0"
                       Click="MoreActionsButton_Click" ToolTip="Ещё">
                <ui:Button.Icon>
                    <local:SvgPathIcon Icon="IconMoreHorizontal" Size="15" />
                </ui:Button.Icon>
            </ui:Button>
        </Grid>

        <Popup x:Name="MoreActionsPopup" PlacementTarget="{Binding ElementName=MoreActionsButton}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
               VerticalOffset="6" PopupAnimation="Fade">
            <Border Background="#FF242424" BorderBrush="#FF707070" BorderThickness="1" CornerRadius="8" Padding="8">
                <StackPanel Width="136">
                    <ui:Button x:Name="QueueButton" Appearance="Secondary" Width="136" Height="32" Margin="0,0,0,4"
                               Content="Очередь" ToolTip="Очередь «Играть следующим»" Click="QueueButton_Click">
                        <ui:Button.Icon>
                            <local:SvgPathIcon Icon="IconMusicNote" Size="15" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button x:Name="LyricsPanelButton" Appearance="Secondary" Width="136" Height="32"
                               Content="Текст песни" ToolTip="Текст песни" Click="LyricsPanelButton_Click">
                        <ui:Button.Icon>
                            <local:SvgPathIcon x:Name="LyricsPanelButtonIcon" Icon="IconLyrics" Size="15" />
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Плейлист: список групп (папки/отдельные файлы); чекбокс выключает группу — она пропускается при воспроизведении, но остаётся
             видна полупрозрачной; шеврон сворачивает/разворачивает треки группы. -->
        <Border x:Name="PlaylistBorder" Grid.Row="6" Margin="16,0,16,16" CornerRadius="10"
                Background="{DynamicResource ControlFillColorDefaultBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                </Grid.ColumnDefinitions>

                <!-- Поиск фильтрует имя файла без расширения (как в строке): отдельный ItemsSource после debounce, _folders не меняется —
                     «Далее/Назад/Перемешать» всегда работают с полным плейлистом, а не с результатами. -->
                <ui:TextBox x:Name="PlaylistSearchBox" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                            Margin="8,8,8,4"
                            PlaceholderText="Поиск по плейлисту"
                            ClearButtonEnabled="True"
                            TextChanged="PlaylistSearchBox_TextChanged">
                    <ui:TextBox.Icon>
                        <local:SvgPathIcon Icon="IconSearch" />
                    </ui:TextBox.Icon>
                </ui:TextBox>

                <Border x:Name="UnavailableFilesBanner" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                        Background="#FF3B3126" BorderBrush="#B6E5A04B" BorderThickness="1" CornerRadius="8"
                        Padding="5" Margin="8,2,8,4" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:Button x:Name="UnavailableFilesDetailsButton" Grid.Column="0" Appearance="Transparent"
                                   Padding="7,4" HorizontalContentAlignment="Left" ToolTip="Нажмите, чтобы показать файлы"
                                   Click="UnavailableFilesDetailsButton_Click">
                            <StackPanel>
                                <TextBlock x:Name="UnavailableFilesCountText" Text="Недоступные: 0"
                                           Foreground="#E5A04B" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="Нажмите, чтобы показать файлы" FontSize="11" Opacity="0.72"
                                           TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Grid.Column="1" Appearance="Secondary" Height="30" Margin="8,0,0,0"
                                   Padding="10,0" Content="Проверить файлы" ToolTip="Проверить недоступные файлы"
                                   Click="CheckUnavailableFilesMenuItem_Click" />
                    </Grid>
                </Border>

                <Popup x:Name="UnavailableFilesPopup" PlacementTarget="{Binding ElementName=UnavailableFilesDetailsButton}"
                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True" VerticalOffset="4"
                       PopupAnimation="Fade">
                    <!-- Ширина растёт по самому длинному имени, но не бывает слишком узкой или шире окна плеера. -->
                    <Border MinWidth="280" MaxWidth="470" Background="#FF242424" BorderBrush="#FF5A5A5A" BorderThickness="1"
                            CornerRadius="10" Padding="12">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Недоступные файлы" FontSize="13" FontWeight="SemiBold" />
                                <ui:Button Grid.Column="1" Appearance="Transparent" Width="26" Height="26" Padding="0"
                                           ToolTip="Закрыть список" Click="CloseUnavailableFilesPopupButton_Click">
                                    <ui:Button.Icon>
                                        <local:SvgPathIcon Icon="IconDismiss" Size="12" />
                                    </ui:Button.Icon>
                                </ui:Button>
                            </Grid>
                            <ListBox x:Name="UnavailableFilesList" MaxHeight="220" Background="Transparent" BorderThickness="0"
                                     HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#FF303030" CornerRadius="6" Padding="8,6" Margin="0,0,0,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,8,0" MinWidth="0">
                                                    <TextBlock Text="{Binding FilePath, Converter={StaticResource FileNameConverter}}"
                                                               FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding FilePath}" FontSize="10" Opacity="0.58"
                                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <ui:Button Grid.Column="1" Appearance="Secondary" MinWidth="72" Height="28" Padding="8,0"
                                                           Content="Перейти" ToolTip="Перейти к треку" Tag="{Binding}"
                                                           Click="GoToUnavailableTrackButton_Click" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                </Popup>

                <!-- Плоский ItemsSource (PlaylistFolder + PlaylistTrackRow, шаблон — PlaylistDisplayItemTemplateSelector); scrollbar Hidden (свой PlaylistScrollTrack).
                     VirtualizationMode="Standard", не Recycling: при смене типа элемента контейнер сохранял чужой шаблон, и у папки пропадало название. -->
                <ListView x:Name="PlaylistFoldersControl" Grid.Row="2" Grid.Column="0" Margin="4"
                          Background="Transparent" BorderThickness="0"
                          AlternationCount="100000"
                          SelectionMode="Extended"
                          ItemTemplateSelector="{StaticResource PlaylistDisplayItemTemplateSelector}"
                          ItemContainerStyleSelector="{StaticResource PlaylistDisplayItemContainerStyleSelector}"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.VerticalScrollBarVisibility="Hidden"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Standard"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          SizeChanged="PlaylistScrollViewer_SizeChanged"
                          ScrollViewer.ScrollChanged="PlaylistScrollViewer_ScrollChanged"
                          MouseDoubleClick="PlaylistTrackList_MouseDoubleClick"
                          PreviewMouseWheel="PlaylistTrackList_PreviewMouseWheel"
                          PreviewKeyDown="PlaylistTrackList_PreviewKeyDown" />

                <!-- Виртуальное "Избранное": плоский список тех же PlaylistTrackRow (RefreshFavoritesTrackList) без группировки, поэтому обычный ItemTemplate,
                     а не селектор; VirtualizingPanel.* лишь делают явной виртуализацию, которая и так включена. -->
                <ListView x:Name="FavoritesTrackListView" Grid.Row="2" Grid.Column="0" Margin="4"
                          Background="Transparent" BorderThickness="0"
                          AlternationCount="100000"
                          Visibility="Collapsed"
                          SelectionMode="Extended"
                          ItemTemplate="{StaticResource TrackItemTemplate}"
                          ItemContainerStyle="{StaticResource SearchableTrackListViewItemStyle}"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.VerticalScrollBarVisibility="Hidden"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          SizeChanged="PlaylistScrollViewer_SizeChanged"
                          ScrollViewer.ScrollChanged="PlaylistScrollViewer_ScrollChanged"
                          MouseDoubleClick="PlaylistTrackList_MouseDoubleClick"
                          PreviewMouseWheel="PlaylistTrackList_PreviewMouseWheel"
                          PreviewKeyDown="PlaylistTrackList_PreviewKeyDown" />

                <!-- Свой скроллбар без ScrollBar/Track: дорожка (Grid) и ползунок (Border) считаются вручную в MainWindow.xaml.cs; клик по дорожке — прыжок.
                     Margin="0,4,0,4" как у PlaylistScrollViewer: иначе дорожка на 8px выше видимой области, и ползунок «убегает»; ClipToBounds — страховка. -->
                <Grid x:Name="PlaylistScrollTrack" Grid.Row="2" Grid.Column="1" Background="Transparent"
                      Margin="0,4,0,4" ClipToBounds="True"
                      SizeChanged="PlaylistScrollTrack_SizeChanged"
                      MouseLeftButtonDown="PlaylistScrollTrack_MouseLeftButtonDown">
                    <Border x:Name="PlaylistScrollThumb" Width="5" CornerRadius="2.5"
                            HorizontalAlignment="Center" VerticalAlignment="Top"
                            Background="{DynamicResource ControlStrongFillColorDefaultBrush}"
                            Cursor="Hand" Visibility="Collapsed"
                            MouseLeftButtonDown="PlaylistScrollThumb_MouseLeftButtonDown"
                            MouseMove="PlaylistScrollThumb_MouseMove"
                            MouseLeftButtonUp="PlaylistScrollThumb_MouseLeftButtonUp" />
                </Grid>

                <!-- Панель лежит поверх области плейлиста и включается кнопкой «Текст песни».
                     Благодаря этому размер и расположение основного окна остаются прежними. -->
                <Grid x:Name="LyricsPanel" Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Grid.ColumnSpan="2"
                      Margin="12,10" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <local:SvgPathIcon Icon="IconChangelog" Size="16"
                                           Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                           VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock x:Name="LyricsPanelTitleText" Text="Текст песни"
                                       FontSize="14" FontWeight="SemiBold" />
                            <TextBlock x:Name="LyricsPanelSourceText" Text=""
                                       FontSize="11" Opacity="0.65" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- Для LRC отдельный список строк с состоянием IsActive: текущая строка подсвечивается и остаётся в видимой области. -->
                    <ListBox x:Name="LyricsPanelSyncedList" Grid.Row="1" Visibility="Collapsed"
                             Background="Transparent" BorderThickness="0" Cursor="Hand"
                             Focusable="False" PreviewMouseLeftButtonUp="LyricsPanelSyncedList_PreviewMouseLeftButtonUp"
                             ScrollViewer.CanContentScroll="False"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <!-- ListBox нужен для виртуализации и поиска контейнера, но выбор не должен рисовать системную бирюзовую подложку:
                             клик — команда перемотки, а не выбор текста. -->
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter Content="{TemplateBinding Content}"
                                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                  ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="2,4"
                                           FontSize="{Binding FontSize}" LineHeight="{Binding LineHeight}"
                                           Foreground="{Binding Foreground}" Effect="{Binding GlowEffect}"
                                           RenderTransform="{Binding ScaleTransform}" RenderTransformOrigin="0.5,0.5"
                                           FontWeight="SemiBold" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <ScrollViewer x:Name="LyricsPanelScrollViewer" Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="2,0,6,2">
                        <TextBlock x:Name="LyricsPanelText" TextWrapping="Wrap"
                                   FontSize="14" LineHeight="23" Opacity="0.9" />
                    </ScrollViewer>

                    <StackPanel x:Name="LyricsPanelEmptyState" Grid.Row="1"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Width="260" Visibility="Collapsed">
                        <local:SvgPathIcon Icon="IconChangelog" Size="28" Opacity="0.35"
                                           HorizontalAlignment="Center" />
                        <TextBlock x:Name="LyricsPanelEmptyTitleText" Text="Текст не найден"
                                   FontWeight="SemiBold" TextAlignment="Center" Margin="0,10,0,0" />
                        <TextBlock x:Name="LyricsPanelEmptyDescriptionText"
                                   Text="Для этого трека пока нет локального текста, текста из тега или подходящего результата поиска."
                                   TextWrapping="Wrap" TextAlignment="Center" Opacity="0.65"
                                   FontSize="12" Margin="0,5,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
            </Grid>
        </Border>

        <!-- Оверлей "перетащите файлы сюда": виден при drag&drop из Проводника (MainWindow_DragEnter/DragLeave/Drop), Grid.RowSpan — на всё окно,
             IsHitTestVisible="False" — все события drag&drop обрабатывает окно (AllowDrop на ui:FluentWindow). -->
        <Border x:Name="DragDropOverlay" Grid.Row="0" Grid.RowSpan="2"
                Background="#B0000000" IsHitTestVisible="False" Visibility="Collapsed">
            <Border Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="12"
                    Padding="28,20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <local:SvgPathIcon Icon="IconAddFile" Size="22" Foreground="White" VerticalAlignment="Center" />
                    <TextBlock Text="Отпустите, чтобы добавить в плейлист" Foreground="White"
                               FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</ui:FluentWindow>
