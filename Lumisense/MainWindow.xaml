<ui:FluentWindow x:Class="AudioPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:AudioPlayer"
        Title="Lumisense"
        Icon="/Icons/app/lumisense.ico"
        Height="720" Width="440"
        MinHeight="680" MinWidth="400"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        DragEnter="MainWindow_DragEnter"
        DragOver="MainWindow_DragEnter"
        DragLeave="MainWindow_DragLeave"
        Drop="MainWindow_Drop"
        PreviewKeyDown="MainWindow_PreviewKeyDown">

    <Window.Resources>
        <local:FileNameConverter x:Key="FileNameConverter" />
        <local:BoolToOpacityConverter x:Key="BoolToOpacityConverter" />
        <local:ExpandChevronConverter x:Key="ExpandChevronConverter" />
        <local:IsFavoriteMultiConverter x:Key="IsFavoriteMultiConverter" />
        <local:IsPinnedMultiConverter x:Key="IsPinnedMultiConverter" />
        <local:PlayCountMultiConverter x:Key="PlayCountMultiConverter" />
        <local:TrackContextMenuActionVisibilityConverter x:Key="TrackContextMenuActionVisibilityConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />

        <!-- Выбирают DataTemplate/Style контейнера для ЕДИНОГО плоского списка PlaylistFoldersControl
             (см. MainWindow.RefreshPlaylistView) по CLR-типу элемента: PlaylistFolder — заголовок
             папки (PlaylistFolderHeaderTemplate), PlaylistTrackRow — строка трека (TrackItemTemplate,
             тот же, что и у "Избранного"). См. Converters.cs. -->
        <local:PlaylistDisplayItemTemplateSelector x:Key="PlaylistDisplayItemTemplateSelector" />
        <local:PlaylistDisplayItemContainerStyleSelector x:Key="PlaylistDisplayItemContainerStyleSelector" />

        <!-- Шаблон строки трека — общий и для обычных групп плейлиста (единый
             PlaylistFoldersControl, элементы типа PlaylistTrackRow), и для отдельного
             FavoritesTrackListView виртуального плейлиста "Избранное". DataContext — сам
             PlaylistTrackRow (Folder + FilePath + IndexInFolder, см. PlaylistTrackRow.cs) — то
             есть путь к файлу и его папка приходят ВМЕСТЕ, одним объектом, без Tag/
             PlacementTarget/RelativeSource-трюков, которые раньше были нужны только чтобы
             дотянуться до DataContext охватывающего ListView (пока у каждой папки был свой
             отдельный ListView) — обычный Binding и обычное наследование DataContext внутрь
             ContextMenu (оно работает и через границу Popup, см. существующие обработчики вида
             "sender is MenuItem { DataContext: ... }") дают оба значения сразу. -->
        <DataTemplate x:Key="TrackItemTemplate">
            <Grid Opacity="{Binding Folder.IsEnabled, Converter={StaticResource BoolToOpacityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Воспроизвести" Click="PlayTrackMenuItem_Click">
                            <MenuItem.Icon>
                                <local:SvgPathIcon Icon="IconPlay" Size="13" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Добавить/убрать из избранного" Click="FavoriteMenuItem_Click"
                                  Visibility="{Binding Source={x:Static local:TrackContextMenuActions.Instance}, Path=Epoch, Converter={StaticResource TrackContextMenuActionVisibilityConverter}, ConverterParameter=Favorite}">
                            <MenuItem.Icon>
                                <local:SvgPathIcon Icon="IconHeart" Size="13" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <!-- Видно только в самом "Избранном" — см. подробный комментарий у
                             TrackFavoriteButton/TrackPinButton ниже про Folder.IsFavoritesGroup. -->
                        <MenuItem Header="Закрепить/открепить в избранном" Click="PinMenuItem_Click"
                                  Visibility="{Binding Folder.IsFavoritesGroup, Converter={StaticResource BoolToVisibilityConverter}}">
                            <MenuItem.Icon>
                                <local:SvgPathIcon Icon="IconPin" Size="13" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Показать в проводнике" Click="ShowInExplorerMenuItem_Click"
                                  Visibility="{Binding Source={x:Static local:TrackContextMenuActions.Instance}, Path=Epoch, Converter={StaticResource TrackContextMenuActionVisibilityConverter}, ConverterParameter=ShowInExplorer}" />
                        <MenuItem Header="Копировать имя трека" Click="CopyTrackNameMenuItem_Click"
                                  Visibility="{Binding Source={x:Static local:TrackContextMenuActions.Instance}, Path=Epoch, Converter={StaticResource TrackContextMenuActionVisibilityConverter}, ConverterParameter=CopyTrackName}" />
                        <MenuItem Header="Копировать путь к файлу" Click="CopyPathMenuItem_Click"
                                  Visibility="{Binding Source={x:Static local:TrackContextMenuActions.Instance}, Path=Epoch, Converter={StaticResource TrackContextMenuActionVisibilityConverter}, ConverterParameter=CopyPath}" />
                        <MenuItem Header="Копировать файл" Click="CopyFileMenuItem_Click"
                                  Visibility="{Binding Source={x:Static local:TrackContextMenuActions.Instance}, Path=Epoch, Converter={StaticResource TrackContextMenuActionVisibilityConverter}, ConverterParameter=CopyFile}" />
                        <Separator />
                        <MenuItem Header="Свойства" Click="TrackPropertiesMenuItem_Click"
                                  Visibility="{Binding Source={x:Static local:TrackContextMenuActions.Instance}, Path=Epoch, Converter={StaticResource TrackContextMenuActionVisibilityConverter}, ConverterParameter=Properties}" />
                        <MenuItem Header="Изменить теги" Click="EditTagsMenuItem_Click"
                                  Visibility="{Binding Source={x:Static local:TrackContextMenuActions.Instance}, Path=Epoch, Converter={StaticResource TrackContextMenuActionVisibilityConverter}, ConverterParameter=EditTags}">
                            <MenuItem.Icon>
                                <local:SvgPathIcon Icon="IconEdit" Size="13" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Нормализовать имя файла…" Click="NormalizeTrackFileNameMenuItem_Click"
                                  Visibility="{Binding Source={x:Static local:TrackContextMenuActions.Instance}, Path=Epoch, Converter={StaticResource TrackContextMenuActionVisibilityConverter}, ConverterParameter=NormalizeFileName}">
                            <MenuItem.Icon>
                                <local:SvgPathIcon Icon="IconEdit" Size="13" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Убрать из плейлиста" Click="RemoveTrackMenuItem_Click"
                                  Visibility="{Binding Source={x:Static local:TrackContextMenuActions.Instance}, Path=Epoch, Converter={StaticResource TrackContextMenuActionVisibilityConverter}, ConverterParameter=RemoveFromPlaylist}">
                            <MenuItem.Icon>
                                <local:SvgPathIcon Icon="IconDelete" Size="13" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Удалить трек с диска…" Click="DeleteTrackFromDiskMenuItem_Click"
                                  Foreground="#E53935"
                                  Visibility="{Binding Source={x:Static local:TrackContextMenuActions.Instance}, Path=Epoch, Converter={StaticResource TrackContextMenuActionVisibilityConverter}, ConverterParameter=DeleteFromDisk}">
                            <MenuItem.Icon>
                                <local:SvgPathIcon Icon="IconDelete" Size="13" Foreground="#E53935" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Grid.ContextMenu>

                <Grid Grid.Column="0" Width="26" Margin="0,0,4,0">
                    <TextBlock x:Name="TrackIndexText" Text="{Binding IndexInFolder}"
                               FontSize="11" Opacity="0.5"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <local:SvgPathIcon x:Name="TrackPlayIcon" Icon="IconPlay" Size="10"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed" />
                </Grid>

                <TextBlock Grid.Column="1"
                           Text="{Binding FilePath, Converter={StaticResource FileNameConverter}}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />

                <!-- Счётчик прослушиваний — MultiBinding по тому же принципу, что и сердечко
                     ниже (см. IsFavoriteMultiConverter): путь к файлу сам по себе не меняется,
                     PlayCountChangeNotifier.Epoch даёт WPF повод перечитать значение, когда
                     счётчик где-то обновился. Пустая строка при 0 прослушиваний просто не рисует
                     иконку/текст — свойство Visibility завязано на тот же текст ниже. -->
                <StackPanel x:Name="TrackPlayCountPanel" Grid.Column="2" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="6,0,0,0" Opacity="0.45"
                            ToolTip="Сколько раз прослушан этот трек">
                    <local:SvgPathIcon Icon="IconRepeat" Size="11" Margin="0,0,3,0" />
                    <TextBlock x:Name="TrackPlayCountText" FontSize="11" VerticalAlignment="Center">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource PlayCountMultiConverter}">
                                <Binding Path="FilePath" />
                                <Binding Source="{x:Static local:PlayCountChangeNotifier.Instance}" Path="Epoch" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>

                <!-- Сердечко "добавить/убрать из избранного" на строке трека. Контур,
                     приглушённый — трек не избранный; закрашенное красное — избранный
                     (переключается DataTrigger-ом ниже по IsFavoriteMultiConverter).

                     Раньше здесь стоял FocusVisualStyle="{x:Null}" — без него при клике по кнопке
                     (который заодно выделяет и саму строку) WPF рисовал вокруг кнопки штатную
                     прямоугольную пунктирную рамку фокуса поверх скруглённого выделения строки —
                     на выделенном (залитом акцентом, со скруглёнными углами) треке это смотрелось
                     как явный визуальный баг, острый прямоугольник поверх скруглённого фона.
                     Теперь вместо полного отключения используется RoundedIconButtonFocusVisualStyle
                     (см. App.xaml) — своя скруглённая рамка, которая не ломает выделение строки,
                     но и не оставляет клавиатурный фокус совсем невидимым.

                     Foreground у самой иконки (не у кнопки) — TrackFavoriteIcon ничего не
                     задаёт сам и по умолчанию наследует Foreground от ближайшего предка;
                     обычно это TextFillColorPrimaryBrush от строки-ListViewItem, но когда трек
                     выделен, ListViewItem подменяет Foreground на TextOnAccentFillColorPrimaryBrush
                     (см. App.xaml, Trigger IsSelected) — светлый на светлом акценте читался бы
                     плохо, поэтому на выделенном треке (см. MultiDataTrigger в
                     DataTemplate.Triggers ниже) явно фиксируем тёмный #141414 вместо него. На
                     обычном (невыделенном) треке ничего не переопределяем — используется
                     светлый TextFillColorPrimaryBrush, заданный явно ниже, как было раньше.
                     Заполненное (избранное) сердечко в этот механизм не входит — у него свой
                     явный красный Foreground ниже, и он неплохо читается в обоих случаях.

                     AutomationProperties.Name привязан к собственному ToolTip (а не задан
                     статической строкой) — так его переводит тот же runtime-обход visual tree,
                     что переводит и ToolTip (см. LocalizationService.ApplyToElement), без
                     отдельного кода для automation-имени. -->
                <ui:Button x:Name="TrackFavoriteButton" Grid.Column="3" Appearance="Transparent"
                           Width="26" Height="26" Padding="0" Margin="4,0,0,0"
                           Click="FavoriteButton_Click"
                           FocusVisualStyle="{StaticResource RoundedIconButtonFocusVisualStyle}"
                           AutomationProperties.Name="{Binding RelativeSource={RelativeSource Self}, Path=ToolTip}"
                           ToolTip="Добавить/убрать из избранного">
                    <ui:Button.Icon>
                        <local:SvgPathIcon x:Name="TrackFavoriteIcon" Icon="IconHeart" Size="14" Opacity="0.5"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </ui:Button.Icon>
                </ui:Button>

                <!-- Кнопка закрепления — видна только в самом "Избранном" (Folder.IsFavoritesGroup;
                     в обычном плейлисте закреплять нечего и незачем, см. тот же комментарий у
                     пункта контекстного меню "Закрепить/открепить в избранном" выше). Цвет —
                     тёплый янтарный, а не красный (как у избранного) и не акцентный синий
                     приложения, чтобы закрепление визуально не путалось ни с тем, ни с другим —
                     это самостоятельный, третий признак трека. -->
                <ui:Button x:Name="TrackPinButton" Grid.Column="4" Appearance="Transparent"
                           Width="26" Height="26" Padding="0" Margin="2,0,0,0"
                           Click="PinButton_Click"
                           FocusVisualStyle="{StaticResource RoundedIconButtonFocusVisualStyle}"
                           AutomationProperties.Name="{Binding RelativeSource={RelativeSource Self}, Path=ToolTip}"
                           ToolTip="Закрепить/открепить в избранном"
                           Visibility="{Binding Folder.IsFavoritesGroup, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ui:Button.Icon>
                        <local:SvgPathIcon x:Name="TrackPinIcon" Icon="IconPin" Size="13" Opacity="0.5"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </ui:Button.Icon>
                </ui:Button>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=IsMouseOver}" Value="True">
                    <Setter TargetName="TrackIndexText" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="TrackPlayIcon" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <!-- Пустая строка (0 прослушиваний) — не рисуем ни иконку, ни текст, вместо
                     показа "0" на каждом ещё не проигранном треке. -->
                <DataTrigger Binding="{Binding Text, ElementName=TrackPlayCountText}" Value="">
                    <Setter TargetName="TrackPlayCountPanel" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <!-- MultiBinding, а не обычный Binding по одному только пути к файлу — путь у
                     трека никогда не меняется, поэтому обычный Binding никогда бы не
                     перевычислился заново сам по себе при изменении избранного, и сердечко
                     обновлялось бы только через полный пересбор ItemsSource всего плейлиста
                     (см. FavoritesChangeNotifier — второе плечо этого MultiBinding как раз и
                     даёт триггеру повод перевычислиться, когда избранное действительно
                     поменялось, независимо от того, у какого именно трека). -->
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource IsFavoriteMultiConverter}">
                            <Binding Path="FilePath" />
                            <Binding Source="{x:Static local:FavoritesChangeNotifier.Instance}" Path="Epoch" />
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter TargetName="TrackFavoriteIcon" Property="Icon" Value="IconHeartFilled" />
                    <Setter TargetName="TrackFavoriteIcon" Property="Foreground" Value="#E53935" />
                    <Setter TargetName="TrackFavoriteIcon" Property="Opacity" Value="1" />
                </DataTrigger>
                <!-- Закреплённый трек — та же MultiBinding-механика, что и у сердечка выше, тот
                     же FavoritesChangeNotifier (TogglePin тоже вызывает Bump, см. FavoritesManager) —
                     заводить для этого отдельный notifier не нужно, "избранное поменялось" и
                     "закрепление поменялось" для целей перерисовки строки — один и тот же повод. -->
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource IsPinnedMultiConverter}">
                            <Binding Path="FilePath" />
                            <Binding Source="{x:Static local:FavoritesChangeNotifier.Instance}" Path="Epoch" />
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter TargetName="TrackPinIcon" Property="Foreground" Value="#F5A623" />
                    <Setter TargetName="TrackPinIcon" Property="Opacity" Value="1" />
                </DataTrigger>
                <!-- Контурное (НЕ избранное) сердечко на выделенной строке — см. подробный
                     комментарий выше, у TrackFavoriteButton. Второе условие
                     (IsFavoriteMultiConverter = False) — чтобы не перебивать явный красный
                     Foreground избранного сердечка из триггера выше: избранное и так неплохо
                     читается на выделении, этот триггер только про обычный контур. -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Value="True">
                            <Condition.Binding>
                                <Binding RelativeSource="{RelativeSource AncestorType=ListViewItem}" Path="IsSelected" />
                            </Condition.Binding>
                        </Condition>
                        <Condition Value="False">
                            <Condition.Binding>
                                <MultiBinding Converter="{StaticResource IsFavoriteMultiConverter}">
                                    <Binding Path="FilePath" />
                                    <Binding Source="{x:Static local:FavoritesChangeNotifier.Instance}" Path="Epoch" />
                                </MultiBinding>
                            </Condition.Binding>
                        </Condition>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="TrackFavoriteIcon" Property="Foreground" Value="#141414" />
                </MultiDataTrigger>
                <!-- То же самое, тем же поводом, для незакреплённого контурного значка
                     закрепления на выделенной строке — см. комментарий у MultiDataTrigger выше. -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Value="True">
                            <Condition.Binding>
                                <Binding RelativeSource="{RelativeSource AncestorType=ListViewItem}" Path="IsSelected" />
                            </Condition.Binding>
                        </Condition>
                        <Condition Value="False">
                            <Condition.Binding>
                                <MultiBinding Converter="{StaticResource IsPinnedMultiConverter}">
                                    <Binding Path="FilePath" />
                                    <Binding Source="{x:Static local:FavoritesChangeNotifier.Instance}" Path="Epoch" />
                                </MultiBinding>
                            </Condition.Binding>
                        </Condition>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="TrackPinIcon" Property="Foreground" Value="#141414" />
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Заголовок папки плейлиста — раньше был инлайновой частью ItemTemplate у ItemsControl
             (см. историю), теперь отдельный ресурс: элемент верхнего уровня в плоском
             PlaylistFoldersControl.ItemsSource, выбирается PlaylistDisplayItemTemplateSelector
             для элементов типа PlaylistFolder. DataContext — сам PlaylistFolder, все биндинги
             ниже те же самые, что были и раньше. -->
        <DataTemplate x:Key="PlaylistFolderHeaderTemplate">
            <Border Margin="2,2,2,10" CornerRadius="8" Padding="10,8"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,0"
                              IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                              ToolTip="Включить/выключить эту папку в проигрывании" />

                    <ui:Button Grid.Column="1" Appearance="Secondary"
                               Width="26" Height="26" Margin="0,0,4,0" Padding="0"
                               Click="ToggleFolderExpand_Click"
                               ToolTip="Свернуть/развернуть список треков">
                        <ui:Button.Icon>
                            <local:SvgPathIcon Icon="{Binding IsExpanded, Converter={StaticResource ExpandChevronConverter}}" />
                        </ui:Button.Icon>
                    </ui:Button>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                Opacity="{Binding IsEnabled, Converter={StaticResource BoolToOpacityConverter}}">
                        <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding SubtitleText}" FontSize="10" Opacity="0.6"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- Только у "Отдельные файлы" и у папок, созданных вручную (не привязанных
                         к реальной папке на диске) — добавить файлы прямо в эту группу -->
                    <ui:Button Grid.Column="3" Appearance="Secondary"
                               Width="28" Height="28" Padding="0" Margin="0,0,4,0"
                               Click="AddFilesToFolderButton_Click"
                               Visibility="{Binding CanAddFilesDirectly, Converter={StaticResource BoolToVisibilityConverter}}"
                               ToolTip="Добавить файлы в эту папку">
                        <ui:Button.Icon>
                            <local:SvgPathIcon Icon="IconAddFile" Size="13" />
                        </ui:Button.Icon>
                    </ui:Button>

                    <!-- Только у групп, привязанных к реальной папке на диске — проверить,
                         не появились ли в ней новые файлы после добавления в плейлист
                         (см. RescanFolderButton_Click) -->
                    <ui:Button Grid.Column="4" Appearance="Secondary"
                               Width="28" Height="28" Padding="0" Margin="0,0,4,0"
                               Click="RescanFolderButton_Click"
                               Visibility="{Binding CanRescan, Converter={StaticResource BoolToVisibilityConverter}}"
                               ToolTip="Проверить папку на новые треки">
                        <ui:Button.Icon>
                            <local:SvgPathIcon Icon="IconRefresh" Size="13" />
                        </ui:Button.Icon>
                    </ui:Button>

                    <ui:Button Grid.Column="5" Appearance="Secondary"
                               Width="28" Height="28" Padding="0"
                               Click="RemoveFolderButton_Click"
                               ToolTip="Убрать эту папку из плейлиста">
                        <ui:Button.Icon>
                            <local:SvgPathIcon Icon="IconDelete" />
                        </ui:Button.Icon>
                    </ui:Button>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Стиль контейнера заголовка папки — НЕ должен вести себя как выбираемая строка
             списка (никакого hover/selection-акцента из общего Style TargetType="ListViewItem"
             в App.xaml): Focusable="False" и IsHitTestVisible оставлен true только чтобы кнопки
             внутри самого заголовка (чекбокс, шеврон, пересканировать, удалить) продолжали
             ловить клики. -->
        <Style x:Key="PlaylistFolderHeaderContainerStyle" TargetType="ListViewItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsHitTestVisible" Value="True" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <!-- Без BasedOn на глобальный Style TargetType="ListViewItem" (сделано намеренно —
                 не нужны его отступы/ховер-подсветка на заголовке), но вместе с этим по
                 умолчанию терялся и Foreground, который в оригинале тоже задаётся тем самым
                 глобальным стилем: без явного Setter здесь TextBlock/иконки внутри заголовка
                 падали на дефолтный чёрный цвет вместо темизированного — на тёмном фоне
                 карточки текст был почти нечитаем. -->
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Общий стиль строк трека. Поиск теперь формирует отдельный отфильтрованный
             ItemsSource в фоне (см. MainWindow.QueuePlaylistSearch), поэтому здесь нет
             MultiBinding, который раньше пересчитывал Visibility каждого контейнера при любом
             введённом символе и мог надолго блокировать раскладку большого списка. -->
        <Style x:Key="SearchableTrackListViewItemStyle" TargetType="ListViewItem"
               BasedOn="{StaticResource {x:Type ListViewItem}}" />

        <!-- Главные полосы времени и громкости рисуются часто (progress обновляется во время
             воспроизведения) и занимают всего 4 DIP. Локальный template фиксирует их на
             физических пикселях: это убирает размытые края и «дрожание» тонкой линии на
             дробном Windows DPI, не меняя более крупные вертикальные слайдеры в настройках. -->
        <Style x:Key="MainWindowPlaybackSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="24" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Margin="0,5" Background="Transparent"
                              SnapsToDevicePixels="True" UseLayoutRounding="True">
                            <Border Height="4" CornerRadius="2"
                                    Background="{DynamicResource ControlStrongFillColorDefaultBrush}"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                    SnapsToDevicePixels="True" />

                            <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}"
                                   IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                   SnapsToDevicePixels="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False"
                                                  Background="Transparent" BorderThickness="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2"
                                                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                        HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                                        SnapsToDevicePixels="True" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>

                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False"
                                                  Background="Transparent" BorderThickness="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>

                                <Track.Thumb>
                                    <Thumb Width="14" Height="14" Cursor="Hand"
                                           SnapsToDevicePixels="True" UseLayoutRounding="True">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{DynamicResource AccentFillColorDefaultBrush}"
                                                         Stroke="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                                         StrokeThickness="1"
                                                         SnapsToDevicePixels="True" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- Заголовок -->
            <RowDefinition Height="*" />      <!-- Тело: центрируется и масштабируется в полноэкранном режиме -->
        </Grid.RowDefinitions>

        <!-- Заголовок окна (Fluent TitleBar).
             ВАЖНО: ui:TitleBar перехватывает клики в СВОИХ границах на уровне Win32
             (WM_NCHITTEST → HTCAPTION) ещё до того, как они доходят до обычных WPF-элементов —
             поэтому прозрачный элемент, просто наложенный поверх TitleBar, кликов не получает.
             Чтобы кликабельная область на "Lumisense" реально работала, она вынесена в
             отдельную колонку СЛЕВА от TitleBar, а не поверх него — так эта часть экрана
             вообще не входит в границы TitleBar, и клики по ней обрабатываются как обычно. -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="TitleClickArea" Grid.Column="0" VerticalAlignment="Stretch"
                    Background="Transparent" Cursor="Hand" Padding="16,0,4,0"
                    MouseLeftButtonUp="TitleClickArea_MouseLeftButtonUp"
                    ToolTip="Вид плеера">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- PNG сохраняет исходный детализированный 256px artwork. Для этой
                         custom title area он лучше, чем упрощённый 16px frame ICO, а layout/
                         scaling flags не дают ему размыться на дробном Windows DPI. -->
                    <Image Source="/Icons/app/lumisense.png" Width="14" Height="14" Margin="0,0,6,0"
                           Stretch="Uniform" SnapsToDevicePixels="True" UseLayoutRounding="True"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Lumisense" FontSize="12" VerticalAlignment="Center" Opacity="0.9" />
                </StackPanel>
                <Border.ContextMenu>
                    <ContextMenu x:Name="MainViewContextMenu" Placement="Bottom"
                                 Opened="MainViewContextMenu_Opened">
                        <ContextMenu.Resources>
                            <!-- Wpf.Ui не всегда рисует штатный check-glyph MenuItem в Popup.
                                 Этот локальный шаблон применён только к трём исходным пунктам
                                 выбора вида и показывает тот же Fluent CheckBox, что в меню
                                 мини-плеера, не добавляя новых пунктов или состояний. -->
                            <Style x:Key="MainViewToggleMenuItemStyle" TargetType="{x:Type MenuItem}">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Padding" Value="8,5" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type MenuItem}">
                                            <Border x:Name="ItemBackground" Background="{TemplateBinding Background}"
                                                    Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24" />
                                                        <ColumnDefinition Width="24" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.Column="0" IsHitTestVisible="False" Focusable="False"
                                                              Style="{DynamicResource MainViewAccentCheckBoxStyle}"
                                                              VerticalAlignment="Center" IsChecked="{TemplateBinding IsChecked}" />
                                                    <ContentPresenter Grid.Column="1" Content="{TemplateBinding Icon}"
                                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <ContentPresenter Grid.Column="2" ContentSource="Header"
                                                                      Margin="5,0,0,0" VerticalAlignment="Center"
                                                                      RecognizesAccessKey="True" />
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsHighlighted" Value="True">
                                                    <Setter TargetName="ItemBackground" Property="Background"
                                                            Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.45" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <!-- Активный вид должен быть заметен и в Popup: не полагаемся на
                                 системный шаблон CheckBox, а используем локальный акцент
                                 Lumisense и белую галочку. -->
                            <Style x:Key="MainViewAccentCheckBoxStyle" TargetType="{x:Type CheckBox}">
                                <Setter Property="Width" Value="18" />
                                <Setter Property="Height" Value="18" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type CheckBox}">
                                            <Border x:Name="CheckBorder" Width="18" Height="18" CornerRadius="4"
                                                    BorderThickness="1"
                                                    BorderBrush="{DynamicResource ControlStrongFillColorDefaultBrush}"
                                                    Background="Transparent">
                                                <Viewbox Margin="4">
                                                    <Path x:Name="CheckGlyph" Data="M 1,5 L 4,8 L 10,1"
                                                          Stroke="White" StrokeThickness="2.1"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round" Visibility="Collapsed" />
                                                </Viewbox>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="CheckBorder" Property="Background"
                                                            Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                    <Setter TargetName="CheckBorder" Property="BorderBrush"
                                                            Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                    <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="CheckBorder" Property="Opacity" Value="0.45" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ContextMenu.Resources>
                        <MenuItem x:Name="SquareViewMenuItem" Header="Обычный (квадратный)"
                                  Style="{StaticResource MainViewToggleMenuItemStyle}"
                                  IsCheckable="True" Tag="Square" Click="ViewModeMenuItem_Click">
                            <MenuItem.Icon>
                                <local:SvgPathIcon Icon="IconWindow" Size="14" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="RectangularViewMenuItem" Header="Прямоугольный"
                                  Style="{StaticResource MainViewToggleMenuItemStyle}"
                                  IsCheckable="True" Tag="Rectangular" Click="ViewModeMenuItem_Click">
                            <MenuItem.Icon>
                                <local:SvgPathIcon Icon="IconPictureInPicture" Size="14" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Now Playing (полный экран)" Click="ShowNowPlayingMenuItem_Click">
                            <MenuItem.Icon>
                                <local:SvgPathIcon Icon="IconExpand" Size="14" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem x:Name="MiniViewMenuItem" Header="Мини-плеер"
                                  Style="{StaticResource MainViewToggleMenuItemStyle}"
                                  IsCheckable="True" Tag="Mini" Click="ViewModeMenuItem_Click">
                            <MenuItem.Icon>
                                <local:SvgPathIcon Icon="IconMinimizePlayer" Size="14" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Border.ContextMenu>
            </Border>

            <!-- Title="" — стандартный текст TitleBar скрыт, вместо него слева стоит
                 кликабельный TitleClickArea из отдельной колонки выше -->
            <ui:TitleBar x:Name="AppTitleBar" Grid.Column="1" Title="" ShowMaximize="True" />
        </Grid>

        <!-- Тело окна обёрнуто в ContentHost: при разворачивании окна в полный экран кнопкой
             "Развернуть" в заголовке (WindowState -> Maximized) интерфейс не растягивается на
             всю ширину монитора "простынёй", а аккуратно центрируется и увеличивается — размеры
             считает ApplyFullscreenLayout()/UpdateContentMaxWidth() в MainWindow.xaml.cs по
             событию StateChanged. В обычном окне ContentHost ведёт себя как раньше (без изменений). -->
        <Border Grid.Row="1" x:Name="ContentHost" HorizontalAlignment="Stretch" MaxWidth="440">
            <Grid x:Name="BodyGrid">
                <Grid.RowDefinitions>
                                    <RowDefinition Height="0" />      <!-- Техническая заглушка -->
                <RowDefinition Height="Auto" />   <!-- Обложка / инфо о треке -->
                <RowDefinition Height="Auto" />   <!-- Прогресс и время -->
                <RowDefinition Height="Auto" />   <!-- Кнопки управления -->
                <RowDefinition Height="Auto" />   <!-- Громкость и кнопка скорости -->
                <RowDefinition Height="Auto" />   <!-- Панель плейлиста: заголовок + кнопки добавления -->
                <RowDefinition Height="*" />      <!-- Плейлист (тянется, не вылезает за края) -->

                </Grid.RowDefinitions>

        <!-- Блок с обложкой и названием трека -->
        <StackPanel x:Name="AlbumArtPanel" Grid.Row="1" HorizontalAlignment="Center" Margin="0,8,0,8">
            <!-- ClipToBounds="False": во время анимации смены обложки (см.
                 MainWindow.AnimateAlbumArtTransition) старая и новая обложки временно уезжают
                 за пределы своего 150x150 места — им нужно куда "вылетать"/"влетать". -->
            <Grid x:Name="AlbumArtContainer" Width="150" Height="150" ClipToBounds="False">
                <!-- "Улетающая" копия предыдущей обложки — накладывается поверх основной на
                     время анимации и убирается после её завершения (см. AnimateAlbumArtTransition).
                     IsHitTestVisible="False", чтобы не перехватывать клики/контекстное меню. -->
                <Border x:Name="AlbumArtGhostBorder" Width="150" Height="150" CornerRadius="16"
                        Visibility="Collapsed" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="AlbumArtGhostScale" ScaleX="1" ScaleY="1" />
                            <TranslateTransform x:Name="AlbumArtGhostTransform" X="0" />
                        </TransformGroup>
                    </Border.RenderTransform>
                    <local:SvgPathIcon x:Name="AlbumArtGhostIcon" Icon="IconMusicNote" Size="36"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Visibility="Collapsed" />
                </Border>

                <Border x:Name="AlbumArtBorder" Width="150" Height="150" CornerRadius="16"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                         Cursor="Hand" RenderTransformOrigin="0.5,0.5"
                         PreviewMouseLeftButtonDown="AlbumArtBorder_PreviewMouseLeftButtonDown"
                         PreviewMouseMove="AlbumArtBorder_PreviewMouseMove"
                         PreviewMouseLeftButtonUp="AlbumArtBorder_PreviewMouseLeftButtonUp"
                         ContextMenuOpening="AlbumArtBorder_ContextMenuOpening">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="AlbumArtBorderScale" ScaleX="1" ScaleY="1" />
                            <TranslateTransform x:Name="AlbumArtBorderTransform" X="0" />
                        </TransformGroup>
                    </Border.RenderTransform>
                    <Border.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Открыть обложку" Click="OpenAlbumArtMenuItem_Click">
                                <MenuItem.Icon>
                                    <local:SvgPathIcon Icon="IconExpand" Size="13" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Скачать изображение…" Click="DownloadAlbumArtMenuItem_Click">
                                <MenuItem.Icon>
                                    <local:SvgPathIcon Icon="IconAddFile" Size="13" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Копировать изображение" Click="CopyAlbumArtMenuItem_Click">
                                <MenuItem.Icon>
                                    <local:SvgPathIcon Icon="IconCopy" Size="13" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Свойства" Click="AlbumArtPropertiesMenuItem_Click">
                                <MenuItem.Icon>
                                    <local:SvgPathIcon Icon="IconInfo" Size="13" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Border.ContextMenu>
                    <local:SvgPathIcon x:Name="AlbumArtIcon" Icon="IconMusicNote" Size="36"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Border>
            </Grid>

            <TextBlock x:Name="TrackTitleText" Text="Файл не выбран"
                       FontSize="17" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,12,0,2"
                       TextTrimming="CharacterEllipsis" MaxWidth="360" />

            <TextBlock x:Name="TrackArtistText" Text="—"
                       FontSize="12" Opacity="0.6"
                       HorizontalAlignment="Center" />

            <Border x:Name="TrackStateBadge" CornerRadius="8" Padding="8,3" Margin="0,8,0,0"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    HorizontalAlignment="Center">
                <TextBlock x:Name="TrackStateText" Text="Трек не выбран" FontSize="11" Opacity="0.78"
                           ToolTip="Выберите трек в плейлисте или нажмите воспроизведение." />
            </Border>
        </StackPanel>

        <!-- Прогресс воспроизведения -->
        <Grid Grid.Row="2" Margin="24,4,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Slider x:Name="ProgressSlider" Style="{StaticResource MainWindowPlaybackSliderStyle}"
                        IsHitTestVisible="False" Minimum="0" Maximum="1" Value="0"
                        ValueChanged="ProgressSlider_ValueChanged" />

                <!-- Альтернативный вид полосы — форма звука вместо сплошной заливки, см.
                     AppSettings.ProgressBarStyle/MainWindow.ApplyProgressBarStyle. Показывается
                     вместо ProgressSlider (Visibility переключается в коде), а не вместе с ним —
                     но сам ProgressSlider всё равно остаётся источником истины для позиции
                     (Value/Maximum) и перемотки, просто визуально скрыт. -->
                <local:WaveformView x:Name="ProgressWaveform" Height="28" IsHitTestVisible="False"
                                     Visibility="Collapsed"
                                     UnplayedBrush="{DynamicResource ControlStrongFillColorDefaultBrush}" />

                <!-- Прозрачный слой поверх слайдера: сам обрабатывает мышь целиком,
                     чтобы не зависеть от того, куда именно попал клик — на трек или на шарик -->
                <Border Background="Transparent" Height="24"
                        MouseLeftButtonDown="ProgressOverlay_MouseLeftButtonDown"
                        MouseMove="ProgressOverlay_MouseMove"
                        MouseLeftButtonUp="ProgressOverlay_MouseLeftButtonUp"
                        MouseWheel="ProgressOverlay_MouseWheel" />
            </Grid>

            <Grid Grid.Row="1" Margin="0,2,0,0">
                <TextBlock x:Name="CurrentTimeText" Text="00:00" HorizontalAlignment="Left" FontSize="11" Opacity="0.6" />
                <TextBlock x:Name="TotalTimeText" Text="00:00" HorizontalAlignment="Right" FontSize="11" Opacity="0.6" />
            </Grid>
        </Grid>

        <!-- Кнопки управления воспроизведением -->
        <StackPanel x:Name="ControlsPanel" Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,14,0,6">

            <ui:Button x:Name="ShuffleButton" Appearance="Secondary"
                       Width="40" Height="40" Margin="4,0"
                       Click="ShuffleButton_Click" ToolTip="Перемешать">
                <ui:Button.Icon>
                    <local:SvgPathIcon x:Name="ShuffleIcon" Icon="IconShuffle" />
                </ui:Button.Icon>
            </ui:Button>

            <ui:Button x:Name="RepeatButton" Appearance="Secondary"
                       Width="40" Height="40" Margin="4,0"
                       Click="RepeatButton_Click" ToolTip="Повтор: выключен">
                <ui:Button.Icon>
                    <local:SvgPathIcon Icon="IconRepeatAll" />
                </ui:Button.Icon>
            </ui:Button>

            <ui:Button x:Name="PrevButton" Appearance="Secondary"
                       Width="44" Height="44" Margin="4,0"
                       Click="PrevButton_Click" ToolTip="Предыдущий">
                <ui:Button.Icon>
                    <local:SvgPathIcon Icon="IconPrevious" />
                </ui:Button.Icon>
            </ui:Button>

            <!-- Appearance="Secondary", а не "Primary" — фон под текущий акцент красится
                 вручную в коде (см. MainWindow.RefreshAccentDependentIcons/
                 SetAccentButtonActive): у ControlAppearance.Primary в WPF-UI подтверждённый
                 баг библиотеки — фон не обновляется вживую при смене акцента, только при
                 перезапуске (см. github.com/lepoco/wpfui issues #965/#981). -->
            <ui:Button x:Name="PlayPauseButton" Appearance="Secondary"
                       Width="54" Height="54" Margin="4,0"
                       Click="PlayPauseButton_Click" ToolTip="Пуск/Пауза">
                <ui:Button.Icon>
                    <local:SvgPathIcon x:Name="PlayPauseIcon" Icon="IconPlay" Size="15" />
                </ui:Button.Icon>
            </ui:Button>

            <ui:Button x:Name="NextButton" Appearance="Secondary"
                       Width="44" Height="44" Margin="4,0"
                       Click="NextButton_Click" ToolTip="Следующий">
                <ui:Button.Icon>
                    <local:SvgPathIcon Icon="IconNext" />
                </ui:Button.Icon>
            </ui:Button>

            <ui:Button x:Name="StopButton" Appearance="Secondary"
                       Width="40" Height="40" Margin="4,0"
                       Click="StopButton_Click" ToolTip="Стоп">
                <ui:Button.Icon>
                    <local:SvgPathIcon Icon="IconStop" />
                </ui:Button.Icon>
            </ui:Button>

            <ui:Button x:Name="MiniModeButton" Appearance="Secondary"
                       Width="40" Height="40" Margin="4,0"
                       Click="MiniModeButton_Click" ToolTip="Свернуть в мини-плеер">
                <ui:Button.Icon>
                    <local:SvgPathIcon Icon="IconMinimizePlayer" />
                </ui:Button.Icon>
            </ui:Button>
        </StackPanel>

        <!-- Громкость и компактное управление скоростью -->
        <Grid x:Name="VolumeRow" Grid.Row="4" Margin="24,0,24,10" MouseWheel="VolumeRow_MouseWheel">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button x:Name="PlaybackControlButton" Appearance="Transparent"
                           Width="26" Height="26" Padding="0" Margin="0,0,4,0"
                           Click="PlaybackControlButton_Click" MouseWheel="PlaybackControlButton_MouseWheel"
                           ToolTip="Скорость воспроизведения">
                    <ui:Button.Icon>
                        <local:SvgPathIcon Icon="IconSpeed" Size="15" />
                    </ui:Button.Icon>
                </ui:Button>
                <ui:Button x:Name="MuteButton" Appearance="Transparent"
                           Width="26" Height="26" Padding="0" Margin="0,0,6,0"
                           Click="MuteButton_Click" ToolTip="Без звука">
                    <ui:Button.Icon>
                        <local:SvgPathIcon x:Name="SpeakerIcon" Icon="IconSpeaker" Size="15" />
                    </ui:Button.Icon>
                </ui:Button>
            </StackPanel>

            <Grid Grid.Column="1">
                <Slider x:Name="VolumeSlider" Style="{StaticResource MainWindowPlaybackSliderStyle}"
                        IsHitTestVisible="False" Minimum="0" Maximum="1" Value="0.3"
                        ValueChanged="VolumeSlider_ValueChanged" VerticalAlignment="Center" />

                <Border Background="Transparent" Height="24" VerticalAlignment="Center"
                        MouseLeftButtonDown="VolumeOverlay_MouseLeftButtonDown"
                        MouseMove="VolumeOverlay_MouseMove"
                        MouseLeftButtonUp="VolumeOverlay_MouseLeftButtonUp" />
            </Grid>

            <TextBlock x:Name="VolumeValueText" Grid.Column="2" Text="30%"
                       FontSize="11" Opacity="0.6" Width="34" Margin="8,0,0,0"
                       VerticalAlignment="Center" HorizontalAlignment="Right" />
        </Grid>

        <Popup x:Name="PlaybackControlPopup" PlacementTarget="{Binding ElementName=PlaybackControlButton}"
               Placement="Top" StaysOpen="False" AllowsTransparency="True"
               VerticalOffset="-8" PopupAnimation="Fade" Opened="PlaybackControlPopup_Opened"
               Closed="PlaybackControlPopup_Closed">
            <Border x:Name="PlaybackControlPopupBorder" Background="#FF242424"
                    BorderBrush="#FF707070" BorderThickness="1" CornerRadius="8" Padding="12,8"
                    >
                <Grid Width="230">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Скорость" Grid.Column="0" Foreground="#D8D8D8"
                                   FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Slider x:Name="PlaybackRateSlider" Grid.Column="1"
                                Minimum="0.5" Maximum="2.0" Value="1.0"
                                TickFrequency="0.05" IsSnapToTickEnabled="True"
                                ValueChanged="PlaybackRateSlider_ValueChanged"
                                MouseDoubleClick="PlaybackRateSlider_MouseDoubleClick"
                                MouseWheel="PlaybackRateSlider_MouseWheel"
                                VerticalAlignment="Center" />
                        <TextBlock x:Name="PlaybackRateValueText" Grid.Column="2" Text="1.00×"
                                   Foreground="White" FontWeight="SemiBold" FontSize="11" Width="38"
                                   Margin="10,0,0,0" VerticalAlignment="Center"
                                   HorizontalAlignment="Right" />
                                        </Grid>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Тон" Grid.Column="0" Foreground="#D8D8D8"
                                   FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Slider x:Name="PlaybackPitchSlider" Grid.Column="1"
                                Minimum="-12" Maximum="12" Value="0"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                ValueChanged="PlaybackPitchSlider_ValueChanged"
                                MouseDoubleClick="PlaybackPitchSlider_MouseDoubleClick"
                                MouseWheel="PlaybackPitchSlider_MouseWheel"
                                VerticalAlignment="Center" />
                        <TextBlock x:Name="PlaybackPitchValueText" Grid.Column="2" Text="0 st"
                                   Foreground="White" FontWeight="SemiBold" FontSize="11" Width="38"
                                   Margin="10,0,0,0" VerticalAlignment="Center"
                                   HorizontalAlignment="Right" />
                    </Grid>
                </Grid>
            </Border>
        </Popup>


        <!-- Панель плейлиста: заголовок + переключатель видимости + кнопки добавления -->
        <Grid x:Name="PlaylistHeaderRow" Grid.Row="5" Margin="16,4,16,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Скрывает/показывает весь блок плейлиста целиком (не путать с шевроном
                 отдельной папки внутри него) -->
            <ui:Button Grid.Column="0" x:Name="TogglePlaylistButton" Appearance="Transparent"
                       Width="26" Height="26" Padding="0" Margin="0,0,4,0"
                       Click="TogglePlaylistButton_Click" ToolTip="Скрыть плейлист">
                <ui:Button.Icon>
                    <local:SvgPathIcon Icon="IconChevronDown" />
                </ui:Button.Icon>
            </ui:Button>

            <TextBlock x:Name="PlaylistHeaderText" Grid.Column="1" Text="Плейлист" FontSize="14" FontWeight="SemiBold"
                       VerticalAlignment="Center" Opacity="0.85" />

            <!-- Переключает показ обычного плейлиста на виртуальный плейлист "Избранное"
                 (собирается на лету из треков, отмеченных сердечком, см. FavoritesManager) и
                 обратно. Активное состояние подсвечено акцентным фоном (красится вручную, см.
                 MainWindow.SetAccentButtonActive), как и у ShuffleButton/RepeatButton — см.
                 MainWindow.SetFavoritesViewActive. -->
            <ui:Button Grid.Column="2" x:Name="FavoritesButton" Appearance="Secondary"
                       Width="32" Height="32" Padding="0" Margin="4,0,0,0"
                       Click="FavoritesButton_Click" ToolTip="Избранное">
                <ui:Button.Icon>
                    <local:SvgPathIcon x:Name="FavoritesButtonIcon" Icon="IconHeart" Size="15" />
                </ui:Button.Icon>
            </ui:Button>

            <!-- Одна кнопка вместо прежних "Файлы"/"Папка": клик открывает её собственное
                 контекстное меню с выбором, что именно добавлять. Скрыта, пока открыт
                 виртуальный плейлист "Избранное" — добавлять файлы напрямую в него нельзя. -->
            <ui:Button Grid.Column="3" x:Name="AddButton" Appearance="Secondary"
                       Content="Добавить" Margin="4,0"
                       Click="AddButton_Click" ToolTip="Добавить файлы или папку">
                <ui:Button.Icon>
                    <local:SvgPathIcon Icon="IconAdd" />
                </ui:Button.Icon>
                <ui:Button.ContextMenu>
                    <ContextMenu Placement="Bottom">
                        <MenuItem Header="Файлы…" Click="AddFilesMenuItem_Click">
                            <MenuItem.Icon>
                                <local:SvgPathIcon Icon="IconAddFile" Size="14" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Папку…" Click="AddFolderMenuItem_Click">
                            <MenuItem.Icon>
                                <local:SvgPathIcon Icon="IconAddFolder" Size="14" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Новую папку…" Click="CreateFolderMenuItem_Click"
                                  ToolTip="Создать пустую папку в плейлисте и добавлять в неё файлы вручную">
                            <MenuItem.Icon>
                                <local:SvgPathIcon Icon="IconAdd" Size="14" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </ui:Button.ContextMenu>
            </ui:Button>

            <ui:Button Grid.Column="4" x:Name="ClearPlaylistButton" Appearance="Secondary"
                       Width="32" Height="32" Padding="0" Margin="4,0,0,0"
                       Click="ClearPlaylistButton_Click" ToolTip="Очистить плейлист">
                <ui:Button.Icon>
                    <local:SvgPathIcon Icon="IconDelete" />
                </ui:Button.Icon>
            </ui:Button>

            <ui:Button Grid.Column="5" x:Name="StatisticsButton" Appearance="Secondary"
                       Width="32" Height="32" Padding="0" Margin="4,0,0,0"
                       Click="StatisticsButton_Click" ToolTip="Статистика">
                <ui:Button.Icon>
                    <local:SvgPathIcon Icon="IconMusicNote" Size="15" />
                </ui:Button.Icon>
            </ui:Button>

            <ui:Button Grid.Column="7" x:Name="SettingsButton" Appearance="Secondary"
                       Width="32" Height="32" Padding="0" Margin="4,0,0,0"
                       Click="SettingsButton_Click" ToolTip="Настройки">
                <ui:Button.Icon>
                    <local:SvgPathIcon Icon="IconSettings" />
                </ui:Button.Icon>
            </ui:Button>

            <!-- Переключает содержимое той же панели: вместо плейлиста показывает текст
                 текущей композиции. Настройки расположены последними в ряду, поэтому кнопка
                 текста остаётся непосредственно перед ними. -->
            <ui:Button Grid.Column="6" x:Name="LyricsPanelButton" Appearance="Secondary"
                       Width="32" Height="32" Padding="0" Margin="4,0,0,0"
                       Click="LyricsPanelButton_Click" ToolTip="Текст песни">
                <ui:Button.Icon>
                    <local:SvgPathIcon x:Name="LyricsPanelButtonIcon" Icon="IconChangelog" Size="15" />
                </ui:Button.Icon>
            </ui:Button>
        </Grid>

        <!-- Плейлист: список групп (папок/отдельных файлов). Каждую группу можно включить
             или выключить чекбоксом — выключенные пропускаются при воспроизведении,
             но остаются видны в списке (полупрозрачные). Клик по шеврону сворачивает/
             разворачивает список треков внутри группы. -->
        <Border x:Name="PlaylistBorder" Grid.Row="6" Margin="16,0,16,16" CornerRadius="10"
                Background="{DynamicResource ControlFillColorDefaultBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                </Grid.ColumnDefinitions>

                <!-- Поиск по плейлисту фильтрует имя файла без расширения, то есть тот же
                     текст, что показан в строке. Он создаёт отдельный ItemsSource после короткого
                     debounce и не меняет _folders: «Далее/Назад/Перемешать» всегда используют
                     полный плейлист, а не временный список результатов. -->
                <ui:TextBox x:Name="PlaylistSearchBox" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                            Margin="8,8,8,4"
                            PlaceholderText="Поиск по плейлисту"
                            ClearButtonEnabled="True"
                            TextChanged="PlaylistSearchBox_TextChanged">
                    <ui:TextBox.Icon>
                        <local:SvgPathIcon Icon="IconSearch" />
                    </ui:TextBox.Icon>
                </ui:TextBox>

                <!-- ЕДИНЫЙ виртуализированный список на весь плейлист — заголовки папок и строки
                     треков вперемешку в одном плоском ItemsSource (List<object> из PlaylistFolder
                     и PlaylistTrackRow, см. MainWindow.RefreshPlaylistView), а какой DataTemplate
                     показать для каждого элемента — решает PlaylistDisplayItemTemplateSelector
                     (App.xaml/Converters.cs) по CLR-типу самого элемента.

                     Раньше здесь был ItemsControl с ОТДЕЛЬНЫМ вложенным ListView треков НА
                     КАЖДУЮ папку, а собственная прокрутка этих вложенных списков была отключена
                     (ScrollViewer.VerticalScrollBarVisibility="Disabled") — весь скролл был общий,
                     через отдельный внешний PlaylistScrollViewer. У этой схемы виртуализация была
                     принципиально невозможна: ScrollViewer всегда измеряет своё содержимое с
                     БЕСКОНЕЧНОЙ доступной высотой (иначе ему неоткуда узнать реальный Extent) — а
                     значит и каждый вложенный, лишённый своего скролла ListView внутри него тоже
                     измерялся с бесконечной высотой, и был вынужден реализовать (создать визуальные
                     контейнеры) КАЖДУЮ строку целиком, а не только видимые, чтобы вообще посчитать
                     свой итоговый размер. На 1000+ треках это было главной причиной заметной
                     задержки перед тем, как плейлист полностью появлялся на экране при каждом
                     запуске.

                     Теперь это ОДИН настоящий ListView с НАСТОЯЩИМ собственным скроллом (не
                     обёрнутый снаружи ещё одним ScrollViewer — именно тот внешний и вызывал
                     бесконечное измерение выше) — VirtualizingPanel.IsVirtualizing="True" реально
                     реализует только те строки, что физически видны сейчас плюс небольшой запас, и
                     ничего больше, независимо от того, сколько всего треков в плейлисте.

                     ScrollViewer.VerticalScrollBarVisibility="Hidden" (не "Disabled"!) — список
                     по-прежнему честно скроллится (программно и колесом мыши), просто не показывает
                     родной скроллбар — вместо него отрисован свой (PlaylistScrollTrack ниже),
                     подключённый к тому же внутреннему ScrollViewer через SizeChanged/ScrollChanged
                     и GetActivePlaylistScrollViewer() в code-behind.

                     VirtualizationMode="Standard", а НЕ "Recycling" — здесь это важно: список
                     показывает вперемешку РАЗНОРОДНЫЕ элементы (PlaylistFolder-заголовки и
                     PlaylistTrackRow-строки), выбор шаблона под конкретный элемент решает
                     ItemTemplateSelector. У Recycling есть известная особенность WPF: при
                     переиспользовании уже отрисованного контейнера под НОВЫЙ элемент другого типа
                     (например, был трек — стал заголовок папки, после пересборки списка при
                     сворачивании/разворачивании других папок) шаблон контейнера иногда не
                     пересчитывается заново под новый DataContext и остаётся от предыдущего
                     элемента — на практике это выглядело как "у папки вдруг пропало название"
                     (внутри неверно оставался TrackItemTemplate, у которого просто нет свойства
                     DisplayName). Standard всё ещё полноценно виртуализирует (контейнеры для
                     невидимых строк не создаются вовсе) — просто не переиспользует старые
                     контейнеры под новые элементы, а создаёт для них новые, что стоит немного
                     памяти/GC-нагрузки, но не воспроизводимо ломает выбор шаблона. FavoritesTrackListView
                     ниже (без селектора, только один тип элемента — PlaylistTrackRow) от этой
                     проблемы не страдает, там Recycling оставлен как есть. -->
                <ListView x:Name="PlaylistFoldersControl" Grid.Row="1" Grid.Column="0" Margin="4"
                          Background="Transparent" BorderThickness="0"
                          AlternationCount="100000"
                          SelectionMode="Extended"
                          ItemTemplateSelector="{StaticResource PlaylistDisplayItemTemplateSelector}"
                          ItemContainerStyleSelector="{StaticResource PlaylistDisplayItemContainerStyleSelector}"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.VerticalScrollBarVisibility="Hidden"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Standard"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          SizeChanged="PlaylistScrollViewer_SizeChanged"
                          ScrollViewer.ScrollChanged="PlaylistScrollViewer_ScrollChanged"
                          MouseDoubleClick="PlaylistTrackList_MouseDoubleClick"
                          PreviewMouseWheel="PlaylistTrackList_PreviewMouseWheel"
                          PreviewKeyDown="PlaylistTrackList_PreviewKeyDown" />

                <!-- Виртуальный плейлист "Избранное" — отдельный, плоский список того же типа
                     строк (PlaylistTrackRow, см. MainWindow.RefreshFavoritesTrackList), просто без
                     группировки по папкам (чекбокс/пересканирование/удаление папки к нему не
                     применимы, см. заголовок "Избранное" в тулбаре плейлиста вместо этого) —
                     поэтому обычный ItemTemplate (а не селектор) сразу на TrackItemTemplate.
                     Виртуализация у обычного ListBox/ListView включена по умолчанию самим WPF
                     (в отличие от прежних вложенных списков выше, здесь никогда не было ни
                     отключённого скролла, ни обёртки внешним ScrollViewer, так что этот список
                     виртуализировался и раньше) — VirtualizingPanel.* ниже просто делают это
                     явным, а не полагаются на дефолт. -->
                <ListView x:Name="FavoritesTrackListView" Grid.Row="1" Grid.Column="0" Margin="4"
                          Background="Transparent" BorderThickness="0"
                          AlternationCount="100000"
                          Visibility="Collapsed"
                          SelectionMode="Extended"
                          ItemTemplate="{StaticResource TrackItemTemplate}"
                          ItemContainerStyle="{StaticResource SearchableTrackListViewItemStyle}"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.VerticalScrollBarVisibility="Hidden"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          SizeChanged="PlaylistScrollViewer_SizeChanged"
                          ScrollViewer.ScrollChanged="PlaylistScrollViewer_ScrollChanged"
                          MouseDoubleClick="PlaylistTrackList_MouseDoubleClick"
                          PreviewMouseWheel="PlaylistTrackList_PreviewMouseWheel"
                          PreviewKeyDown="PlaylistTrackList_PreviewKeyDown" />

                <!-- Свой скроллбар с нуля: никаких ScrollBar/Track — просто дорожка (Grid) и
                     ползунок (Border), позиция и размер которого целиком считаются вручную в
                     MainWindow.xaml.cs (PlaylistScrollViewer_ScrollChanged / Update...Thumb).
                     Клик по дорожке — мгновенный прыжок к месту клика, перетаскивание ползунка —
                     обычный драг за мышью. Никакой зависимости от внутренностей WPF ScrollBar.

                     Margin="0,4,0,4" — те же верхний/нижний отступы, что и у PlaylistScrollViewer
                     слева (Margin="4" со всех сторон): раньше у дорожки отступов не было вовсе,
                     из-за чего её ActualHeight была на 8px больше настоящей высоты видимой
                     прокручиваемой области — координаты ползунка считались по завышенной шкале
                     и на длинных плейлистах заметно "убегали" за пределы видимой дорожки.
                     ClipToBounds="True" — подстраховка на случай любых будущих округлений:
                     ползунок физически не может отрисоваться выше/ниже границ дорожки, даже
                     если Margin/Height на долю пикселя выйдут за расчётный диапазон. -->
                <Grid x:Name="PlaylistScrollTrack" Grid.Row="1" Grid.Column="1" Background="Transparent"
                      Margin="0,4,0,4" ClipToBounds="True"
                      SizeChanged="PlaylistScrollTrack_SizeChanged"
                      MouseLeftButtonDown="PlaylistScrollTrack_MouseLeftButtonDown">
                    <Border x:Name="PlaylistScrollThumb" Width="5" CornerRadius="2.5"
                            HorizontalAlignment="Center" VerticalAlignment="Top"
                            Background="{DynamicResource ControlStrongFillColorDefaultBrush}"
                            Cursor="Hand" Visibility="Collapsed"
                            MouseLeftButtonDown="PlaylistScrollThumb_MouseLeftButtonDown"
                            MouseMove="PlaylistScrollThumb_MouseMove"
                            MouseLeftButtonUp="PlaylistScrollThumb_MouseLeftButtonUp" />
                </Grid>

                <!-- Панель лежит поверх области плейлиста и включается кнопкой «Текст песни».
                     Благодаря этому размер и расположение основного окна остаются прежними. -->
                <Grid x:Name="LyricsPanel" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="2"
                      Margin="12,10" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <local:SvgPathIcon Icon="IconChangelog" Size="16"
                                           Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                           VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock x:Name="LyricsPanelTitleText" Text="Текст песни"
                                       FontSize="14" FontWeight="SemiBold" />
                            <TextBlock x:Name="LyricsPanelSourceText" Text=""
                                       FontSize="11" Opacity="0.65" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- Для LRC используем отдельный список строк: у каждой есть состояние
                         IsActive, поэтому текущая строка может подсвечиваться и оставаться в
                         видимой области по ходу воспроизведения. -->
                    <ListBox x:Name="LyricsPanelSyncedList" Grid.Row="1" Visibility="Collapsed"
                             Background="Transparent" BorderThickness="0" Cursor="Hand"
                             Focusable="False" PreviewMouseLeftButtonUp="LyricsPanelSyncedList_PreviewMouseLeftButtonUp"
                             ScrollViewer.CanContentScroll="False"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <!-- ListBox остаётся нужен для виртуализации и поиска контейнера строки,
                             но выбор элемента не должен рисовать системную бирюзовую подложку:
                             клик является командой перемотки, а не выбором текста. -->
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter Content="{TemplateBinding Content}"
                                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                  ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="2,4"
                                           FontSize="{Binding FontSize}" LineHeight="{Binding LineHeight}"
                                           Foreground="{Binding Foreground}" Effect="{Binding GlowEffect}"
                                           RenderTransform="{Binding ScaleTransform}" RenderTransformOrigin="0.5,0.5"
                                           FontWeight="SemiBold" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <ScrollViewer x:Name="LyricsPanelScrollViewer" Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="2,0,6,2">
                        <TextBlock x:Name="LyricsPanelText" TextWrapping="Wrap"
                                   FontSize="14" LineHeight="23" Opacity="0.9" />
                    </ScrollViewer>

                    <StackPanel x:Name="LyricsPanelEmptyState" Grid.Row="1"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Width="260" Visibility="Collapsed">
                        <local:SvgPathIcon Icon="IconChangelog" Size="28" Opacity="0.35"
                                           HorizontalAlignment="Center" />
                        <TextBlock x:Name="LyricsPanelEmptyTitleText" Text="Текст не найден"
                                   FontWeight="SemiBold" TextAlignment="Center" Margin="0,10,0,0" />
                        <TextBlock x:Name="LyricsPanelEmptyDescriptionText"
                                   Text="Для этого трека пока нет локального текста, текста из тега или подходящего результата поиска."
                                   TextWrapping="Wrap" TextAlignment="Center" Opacity="0.65"
                                   FontSize="12" Margin="0,5,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
            </Grid>
        </Border>

        <!-- Оверлей "перетащите файлы сюда" — виден только пока идёт активный drag&drop с
             файлами/папками из Проводника (см. MainWindow_DragEnter/DragLeave/Drop). Grid.RowSpan
             — перекрывает и заголовок, и тело окна целиком, а не только "тело" (Grid.Row="1"),
             чтобы было явно видно, что бросить файл можно куда угодно на окне, а не только в
             область плейлиста. IsHitTestVisible="False" — сам оверлей ничего не должен ловить,
             все события drag&drop обрабатывает окно целиком (AllowDrop на самом ui:FluentWindow). -->
        <Border x:Name="DragDropOverlay" Grid.Row="0" Grid.RowSpan="2"
                Background="#B0000000" IsHitTestVisible="False" Visibility="Collapsed">
            <Border Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="12"
                    Padding="28,20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <local:SvgPathIcon Icon="IconAddFile" Size="22" Foreground="White" VerticalAlignment="Center" />
                    <TextBlock Text="Отпустите, чтобы добавить в плейлист" Foreground="White"
                               FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</ui:FluentWindow>
